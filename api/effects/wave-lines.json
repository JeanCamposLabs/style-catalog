  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Wave Lines</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"wave-lines\",\n    \"title\": \"Wave Lines\",\n    \"summary\": \"Parallel wavy rules across the surface.\",\n    \"description\": \"Parallel wavy rules across the surface. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"waves\", \"lines\", \"undulating\", \"water\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Line colour\", \"default\": \"rgba(45,212,191,.35)\" },\n      { \"name\": \"--s\", \"description\": \"Wavelength\", \"default\": \"30px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Water, audio, and calm themes. Two half-offset arc layers join into a continuous sine — a single layer produces disconnected humps.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(45,212,191,.35); --s: 30px; }\n    .bg { background-color: #0b0d12;\n      background-image: radial-gradient(circle at 50% 100%, transparent 0 12px, var(--c) 12px 14px, transparent 14px),\n        radial-gradient(circle at 50% 0, transparent 0 12px, var(--c) 12px 14px, transparent 14px);\n      background-size: var(--s) var(--s); background-position: 0 0, calc(var(--s) / 2) 0; }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
