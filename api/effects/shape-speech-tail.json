  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Speech Bubble</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"shape-speech-tail\",\n    \"title\": \"Speech Bubble\",\n    \"summary\": \"A rounded bubble with a pointed tail.\",\n    \"description\": \"A rounded bubble with a pointed tail. Purely decorative and self-contained, so it drops between any two sections.\",\n    \"theme\": \"dividers-shapes\",\n    \"categories\": [\"divider\", \"shape\"],\n    \"tags\": [\"divider\", \"separator\", \"speech\", \"bubble\", \"chat\", \"tail\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dividers are decorative: mark them aria-hidden so they are not announced as content.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Bubble colour\", \"default\": \"#1c2437\" }\n    ],\n    \"variations\": [\"Flip vertically for the opposite section\", \"Recolour to match the next section\"],\n    \"ai_usage\": \"Chat and testimonial UIs. background:inherit on the tail keeps it matched to the bubble even when the bubble is a gradient.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .top { background: #151b2a; padding: 1.6rem; text-align: center; color: #8b93a7; font-size: .85rem; }\n    .bottom { background: #7c5cff; padding: 1.6rem; text-align: center; color: #1a1030; font-size: .85rem; font-weight: 700; }\n    .stage { width: min(92vw, 340px); }\n    .stage { display: grid; place-items: center; padding: 1.4rem 0; }\n    .bub { position: relative; max-width: 230px; padding: .9rem 1.1rem; border-radius: 16px; background: #1c2437; color: #e7ebf3; font-size: .92rem; }\n    .bub::after { content: \"\"; position: absolute; left: 22px; top: 100%; width: 20px; height: 14px; background: inherit;\n      clip-path: polygon(0 0, 100% 0, 15% 100%); }\n  </style>\n</head>\n<body>\n  <div class=\"stage\"><div class=\"bub\">The tail inherits the bubble's background.</div></div>\n</body>\n</html>\n"
