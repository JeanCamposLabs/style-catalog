  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Totals Footer</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"table-footer-totals\",\n    \"title\": \"Totals Footer\",\n    \"summary\": \"A table footer that sums the columns.\",\n    \"description\": \"A table footer that sums the columns.\",\n    \"theme\": \"tables-data\",\n    \"categories\": [\"table\", \"data\"],\n    \"tags\": [\"table\", \"data\", \"totals\", \"footer\", \"sum\", \"tfoot\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use real table markup with <th scope> and a <caption>; sortable headers need aria-sort, and row selection needs real checkboxes.\",\n    \"customization\": [\n      { \"name\": \"--foot\", \"description\": \"Footer background\", \"default\": \"#171d33\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"Financial tables. Use a real <tfoot> so the totals row is announced as a summary and stays with the table when it is printed across pages.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; border-radius: 12px; overflow: hidden; border: 1px solid #263149; }\n    .fx table { width: 100%; border-collapse: collapse; font-size: .82rem; }\n    .fx th { background: #1c2437; color: #8b93a7; text-align: left; padding: .5rem .8rem; font-size: .68rem; text-transform: uppercase; }\n    .fx td { padding: .5rem .8rem; border-top: 1px solid #1e2740; color: #cbd5e1; font-variant-numeric: tabular-nums; }\n    .fx tfoot td { border-top: 2px solid #2b3450; font-weight: 800; color: #e7ebf3; background: #171d33; }\n    .fx td:last-child, .fx th:last-child { text-align: right; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><table><caption class=\"sr\" style=\"position:absolute;left:-9999px\">Invoice lines</caption>\n  <thead><tr><th scope=\"col\">Item</th><th scope=\"col\">Amount</th></tr></thead>\n  <tbody><tr><td>Studio plan</td><td>$24.00</td></tr><tr><td>Extra seats (3)</td><td>$18.00</td></tr>\n  <tr><td>Tax</td><td>$8.40</td></tr></tbody>\n  <tfoot><tr><td>Total</td><td>$50.40</td></tr></tfoot></table></div>\n</body>\n</html>\n"
}
