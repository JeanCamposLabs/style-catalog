  "path": "effects/text-effects/stripe-clip-text.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Striped Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"stripe-clip-text\",\n    \"title\": \"Striped Text\",\n    \"summary\": \"Diagonal stripes run through the letterforms and drift sideways.\",\n    \"description\": \"A repeating-linear-gradient clipped to the text moves with background-position, so the stripes appear to slide behind the glyphs.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"pattern\"],\n    \"tags\": [\"stripes\", \"repeating-gradient\", \"background-clip\", \"pattern\", \"kinetic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Stripe color A\", \"default\": \"#e7ebf3\" },\n      { \"name\": \"--b\", \"description\": \"Stripe color B\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--dur\", \"description\": \"Drift\", \"default\": \"2s\" }\n    ],\n    \"variations\": [\"Vertical or horizontal stripes\", \"Freeze the stripes and animate on hover\", \"Two-tone caution stripes for warnings\"],\n    \"ai_usage\": \"Warning banners, sport, or construction themes. Because the stripes are a background, everything is one element — but set background-size explicitly or the drift distance will not match the stripe period and the loop will stutter.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --a: #e7ebf3; --b: #7c5cff; --dur: 2s; }\n    .stripe { font-size: clamp(2.2rem, 9vw, 4.2rem); font-weight: 900;\n      background: repeating-linear-gradient(45deg, var(--a) 0 10px, var(--b) 10px 20px);\n      background-size: 200% 200%; -webkit-background-clip: text; background-clip: text; color: transparent;\n      animation: drift var(--dur) linear infinite; }\n    @keyframes drift { to { background-position: 28px 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <h1 class=\"stripe\">STRIPED</h1>\n</body>\n</html>\n"
}
