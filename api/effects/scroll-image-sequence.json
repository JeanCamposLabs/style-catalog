  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Scroll Scrub</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"scroll-image-sequence\",\n    \"title\": \"Scroll Scrub\",\n    \"summary\": \"An element scrubbed frame by frame with scroll.\",\n    \"description\": \"An element scrubbed frame by frame with scroll.\",\n    \"theme\": \"scroll-effects\",\n    \"categories\": [\"scroll\", \"motion\"],\n    \"tags\": [\"scroll\", \"scrub\", \"scroll\", \"sequence\", \"sticky\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Scroll-linked motion must be disabled under prefers-reduced-motion, and content must never depend on scrolling to become readable.\",\n    \"customization\": [\n      { \"name\": \"--frames\", \"description\": \"Frame count\", \"default\": \"36\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Product explainers. Map scroll progress to a discrete frame index and clamp it; feeding an unclamped value straight into a transform is what makes scrubbed sequences jitter at the edges.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n    body { min-height: 260vh; margin: 0; }\n    .stage { position: sticky; top: 0; height: 100vh; display: grid; place-items: center; background: #0b0d12; }\n    .dial { width: 180px; height: 180px; border-radius: 50%; border: 12px solid #22304a; border-top-color: #7c5cff; }\n    .hint { position: absolute; bottom: 12vh; color: #8b93a7; font-size: .85rem; }\n  </style>\n</head>\n<body>\n  <div class=\"stage\"><div class=\"dial\" id=\"dl\"></div><p class=\"hint\">Scroll to rotate</p></div>\n  <script>\n    (function () {\n      var d = document.getElementById(\"dl\");\n      if (matchMedia(\"(prefers-reduced-motion: reduce)\").matches) return;\n      addEventListener(\"scroll\", function () {\n        var p = Math.min(scrollY / (document.body.scrollHeight - innerHeight), 1);\n        d.style.transform = \"rotate(\" + Math.round(p * 36) * 10 + \"deg)\";\n      }, { passive: true });\n    })();\n  </script>\n</body>\n</html>\n"
