  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Aurora Ribbons</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"aurora-ribbons-bg\",\n    \"title\": \"Aurora Ribbons\",\n    \"summary\": \"Vertical light curtains sway and change colour.\",\n    \"description\": \"Tall blurred gradient columns skew and translate independently, producing the curtain motion aurora photos actually show.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"ambient\"],\n    \"tags\": [\"aurora\", \"ribbons\", \"curtain\", \"night\", \"ambient\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Sway period\", \"default\": \"14s\" }\n    ],\n    \"variations\": [\"Pink and violet substorm palette\", \"Fewer, wider curtains\", \"Add a star layer behind\"],\n    \"ai_usage\": \"Night, arctic, and dreamy themes. Curtains must be vertical, blurred, and skewed — a horizontal blurred gradient reads as a sunset, not an aurora.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    .bg { background: linear-gradient(180deg, #04070f 0%, #071427 60%, #04070f 100%); overflow: hidden; }\n    .bg i { position: absolute; top: -20%; height: 140%; width: 26vw; filter: blur(38px); opacity: .55;\n      animation: sway var(--d) ease-in-out infinite alternate; }\n    @keyframes sway {\n      from { transform: translateX(-6vw) skewX(-8deg) scaleY(1); }\n      to { transform: translateX(8vw) skewX(10deg) scaleY(1.12); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bg\">\n    <i style=\"left:6%;background:linear-gradient(180deg,transparent,#34d399,transparent);--d:14s\"></i>\n    <i style=\"left:34%;background:linear-gradient(180deg,transparent,#22d3ee,transparent);--d:19s\"></i>\n    <i style=\"left:62%;background:linear-gradient(180deg,transparent,#a78bfa,transparent);--d:23s\"></i>\n  </div>\n</body>\n</html>\n"
}
