  "ai_usage": "Interactive hero scenes. Put the pointer-driven rotation on one wrapper and let each layer's translateZ create the parallax automatically — moving layers individually is far more code and less consistent.",
  "path": "effects/3d-transforms/layered-parallax-scene.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Layered 3D Scene</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"layered-parallax-scene\",\n    \"title\": \"Layered 3D Scene\",\n    \"summary\": \"Layers at different Z depths moving with the pointer.\",\n    \"description\": \"Layers at different Z depths moving with the pointer.\",\n    \"theme\": \"3d-transforms\",\n    \"categories\": [\"3d\", \"transform\"],\n    \"tags\": [\"3d\", \"transform\", \"parallax\", \"layers\", \"pointer\", \"depth\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"3D motion is a common trigger for vestibular discomfort — keep rotations small and stop them under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--max\", \"description\": \"Maximum tilt\", \"default\": \"12deg\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Interactive hero scenes. Put the pointer-driven rotation on one wrapper and let each layer's translateZ create the parallax automatically — moving layers individually is far more code and less consistent.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .scene { width: 260px; height: 180px; perspective: 700px; border-radius: 16px; overflow: hidden; background: #0d1220; }\n    .world { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform .2s ease-out; }\n    .l { position: absolute; inset: 0; display: grid; place-items: center; }\n    .l1 { transform: translateZ(-120px); background: radial-gradient(circle at 40% 30%, #1e1b4b, #0d1220 70%); }\n    .l2 { transform: translateZ(-40px); }\n    .l2 span { width: 90px; height: 90px; border-radius: 50%; background: linear-gradient(150deg, #7c5cff, #2dd4bf); }\n    .l3 { transform: translateZ(40px); color: #fff; font-weight: 900; font-size: 1.2rem; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"scene\" id=\"sc\"><div class=\"world\">\n    <div class=\"l l1\"></div><div class=\"l l2\"><span></span></div><div class=\"l l3\">DEPTH</div></div></div>\n  <script>\n    (function () {\n      var s = document.getElementById(\"sc\"), w = s.querySelector(\".world\");\n      s.addEventListener(\"pointermove\", function (e) {\n        var r = s.getBoundingClientRect();\n        var x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;\n        w.style.transform = \"rotateY(\" + x * 24 + \"deg) rotateX(\" + -y * 24 + \"deg)\";\n      });\n      s.addEventListener(\"pointerleave\", function () { w.style.transform = \"\"; });\n    })();\n  </script>\n</body>\n</html>\n"
}
