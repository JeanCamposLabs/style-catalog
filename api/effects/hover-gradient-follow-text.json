  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Gradient Follows Pointer</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hover-gradient-follow-text\",\n    \"title\": \"Gradient Follows Pointer\",\n    \"summary\": \"Heading colour tracking the cursor.\",\n    \"description\": \"Heading colour tracking the cursor.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"interaction\"],\n    \"tags\": [\"hover\", \"pointer\", \"gradient\", \"pointer\", \"text\", \"interactive\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover state here is mirrored on :focus-visible so keyboard users get the same information.\",\n    \"customization\": [\n      { \"name\": \"--r\", \"description\": \"Gradient radius\", \"default\": \"180px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Interactive hero headlines. Because the gradient is a background, only two custom properties change per frame — far cheaper than per-letter colouring.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { font-size: 2rem; font-weight: 900; cursor: default;\n      background: radial-gradient(180px circle at var(--x, 50%) var(--y, 50%), #2dd4bf, #7c5cff 60%);\n      -webkit-background-clip: text; background-clip: text; color: transparent; }\n  </style>\n</head>\n<body>\n  <h2 class=\"fx\" id=\"gt\">Follow the light</h2>\n  <script>\n    (function () {\n      var el = document.getElementById(\"gt\");\n      el.addEventListener(\"pointermove\", function (e) {\n        var r = el.getBoundingClientRect();\n        el.style.setProperty(\"--x\", (e.clientX - r.left) + \"px\");\n        el.style.setProperty(\"--y\", (e.clientY - r.top) + \"px\");\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
