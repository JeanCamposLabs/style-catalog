  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Double Outline</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"double-outline-border\",\n    \"title\": \"Double Outline\",\n    \"summary\": \"An outline and a border sit at different offsets for a framed edge.\",\n    \"description\": \"outline-offset lets a second ring float away from the box without any extra element.\",\n    \"theme\": \"borders-shadows\",\n    \"categories\": [\"border\"],\n    \"tags\": [\"outline\", \"offset\", \"double\", \"frame\", \"minimal\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative edge treatment — never encode meaning in the border colour alone. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c1\", \"description\": \"Inner border\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--c2\", \"description\": \"Outer ring\", \"default\": \"#2dd4bf\" },\n      { \"name\": \"--gap\", \"description\": \"Ring gap\", \"default\": \"6px\" }\n    ],\n    \"variations\": [\"Dashed outer ring\", \"Animate the gap on hover\", \"Three rings for a target motif\"],\n    \"ai_usage\": \"Cheap framed cards and focus treatments. outline-offset never affects layout, so the outer ring can float freely without changing the element's box.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; padding: 1.6rem; color: #e7ebf3; }\n    .demo h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .demo p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    :root { --c1: #7c5cff; --c2: #2dd4bf; --gap: 6px; }\n    .demo { border: 2px solid var(--c1); border-radius: 14px; outline: 2px solid var(--c2); outline-offset: var(--gap); }\n  </style>\n</head>\n<body>\n  <div class=\"demo\"><h3>Double outline</h3><p>Border plus an offset outline.</p></div>\n</body>\n</html>\n"
