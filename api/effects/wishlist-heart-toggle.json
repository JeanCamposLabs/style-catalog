  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Wishlist Toggle</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"wishlist-heart-toggle\",\n    \"title\": \"Wishlist Toggle\",\n    \"summary\": \"A heart that fills with a pop when saved.\",\n    \"description\": \"A heart that fills with a pop when saved.\",\n    \"theme\": \"ecommerce-ui\",\n    \"categories\": [\"ecommerce\", \"commerce\"],\n    \"tags\": [\"ecommerce\", \"shop\", \"wishlist\", \"heart\", \"save\", \"toggle\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Price, stock, and discount information must be in text, never only a colour or a badge shape.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Saved colour\", \"default\": \"#fb7185\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Save-for-later controls. The accessible name must change with state ('Save' vs 'Saved') — aria-pressed alone is often read too tersely.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 46px; height: 46px; border-radius: 50%; border: 1px solid #2b3450; background: #151b2a;\n      color: #8b93a7; font-size: 1.2rem; cursor: pointer; transition: color .2s, border-color .2s; }\n    .fx[aria-pressed=\"true\"] { color: #fb7185; border-color: #fb7185; }\n    .fx[aria-pressed=\"true\"] span { animation: pop .4s cubic-bezier(.34,1.56,.64,1); }\n    @keyframes pop { 0% { transform: scale(.6); } 60% { transform: scale(1.3); } 100% { transform: scale(1); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <button class=\"fx\" type=\"button\" aria-pressed=\"false\" aria-label=\"Save to wishlist\" id=\"wl\"><span>♥</span></button>\n  <script>\n    (function () {\n      var b = document.getElementById(\"wl\");\n      b.addEventListener(\"click\", function () {\n        var on = b.getAttribute(\"aria-pressed\") !== \"true\";\n        b.setAttribute(\"aria-pressed\", String(on));\n        b.setAttribute(\"aria-label\", on ? \"Saved to wishlist\" : \"Save to wishlist\");\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
