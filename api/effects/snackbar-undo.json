  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Undo Snackbar</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"snackbar-undo\",\n    \"title\": \"Undo Snackbar\",\n    \"summary\": \"A destructive action with a time-boxed undo.\",\n    \"description\": \"A destructive action with a time-boxed undo.\",\n    \"theme\": \"notifications-toasts\",\n    \"categories\": [\"notification\", \"feedback\"],\n    \"tags\": [\"notification\", \"feedback\", \"undo\", \"snackbar\", \"destructive\", \"timer\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Announce transient messages through an aria-live region; never convey severity by colour alone, and never auto-dismiss anything the user must act on.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Undo colour\", \"default\": \"#2dd4bf\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Reversible destructive actions. Undo is better than a confirm dialog for common operations; show the remaining time and keep the action for at least five seconds.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: 1rem; width: 290px; padding: .75rem .9rem .75rem 1rem;\n      border-radius: 12px; background: #1a2130; color: #e7ebf3; font-size: .86rem; position: relative; overflow: hidden; }\n    .fx p { margin: 0; flex: 1; }\n    .fx button { border: 0; background: none; color: #2dd4bf; font: inherit; font-weight: 700; cursor: pointer; }\n    .fx .bar { position: absolute; left: 0; bottom: 0; height: 3px; background: #2dd4bf; width: 100%;\n      animation: drain 6s linear forwards; }\n    @keyframes drain { to { width: 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\"><p>3 specimens deleted</p><button type=\"button\">Undo</button><span class=\"bar\"></span></div>\n</body>\n</html>\n"
