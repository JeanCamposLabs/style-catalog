  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Ambient Occlusion Shadow</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"soft-ambient-shadow\",\n    \"title\": \"Ambient Occlusion Shadow\",\n    \"summary\": \"A tight contact shadow plus a wide ambient one.\",\n    \"description\": \"Two shadows model the two real components of shading: a dark contact line and a broad ambient falloff.\",\n    \"theme\": \"borders-shadows\",\n    \"categories\": [\"shadow\"],\n    \"tags\": [\"ambient\", \"contact-shadow\", \"realistic\", \"depth\", \"elevation\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative edge treatment — never encode meaning in the border colour alone. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--contact\", \"description\": \"Contact strength\", \"default\": \"0.5\" },\n      { \"name\": \"--ambient\", \"description\": \"Ambient strength\", \"default\": \"0.25\" }\n    ],\n    \"variations\": [\"Raise the element and widen both\", \"Warm ambient tint\", \"Remove the contact shadow for a floating look\"],\n    \"ai_usage\": \"Realistic elevation in design systems. Ship two tokens per elevation level — a tight, dark contact shadow and a wide, faint ambient one; a single shadow can never do both jobs.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; padding: 1.6rem; color: #e7ebf3; }\n    .demo h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .demo p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    :root { --contact: .5; --ambient: .25; }\n    .demo { background: #151b2a; border-radius: 16px;\n      box-shadow: 0 1px 2px rgba(2,6,23,var(--contact)), 0 20px 50px -12px rgba(2,6,23,var(--ambient)); }\n  </style>\n</head>\n<body>\n  <div class=\"demo\"><h3>Two shadows</h3><p>Contact plus ambient.</p></div>\n</body>\n</html>\n"
