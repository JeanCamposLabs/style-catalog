  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Keyboard Skip Set</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"keyboard-only-skip-nav\",\n    \"title\": \"Keyboard Skip Set\",\n    \"summary\": \"Skip links revealed only on focus.\",\n    \"description\": \"Skip links revealed only on focus.\",\n    \"theme\": \"keyboard-input\",\n    \"categories\": [\"keyboard\", \"input\"],\n    \"tags\": [\"keyboard\", \"shortcut\", \"skip-links\", \"keyboard\", \"bypass\", \"landmarks\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Shortcut hints must reflect the user's platform, and no action should be reachable only by a shortcut.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Link colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Reskin through the custom properties\", \"Swap the copy for your own\"],\n    \"ai_usage\": \"Pages with heavy navigation. Offer more than one skip target (content, search, footer) and put them first in the DOM so they are the very first tab stops.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 290px; height: 150px; border-radius: 14px; overflow: hidden; background: #10141f;\n      border: 1px solid #263149; }\n    .skips { position: absolute; top: 0; left: 0; right: 0; display: flex; gap: 6px; padding: 6px; z-index: 2; }\n    .skips a { position: absolute; top: -40px; padding: .4rem .8rem; border-radius: 0 0 8px 8px; background: #7c5cff;\n      color: #fff; text-decoration: none; font-size: .8rem; transition: top .18s; }\n    .skips a:nth-child(1) { left: 8px; } .skips a:nth-child(2) { left: 120px; }\n    .skips a:focus { top: 0; }\n    .body { padding: 3rem 1rem 1rem; color: #8b93a7; font-size: .82rem; line-height: 1.6; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"skips\"><a href=\"#c1\">Skip to content</a><a href=\"#c2\">Skip to search</a></div>\n  <div class=\"body\" id=\"c1\">Tab inside this frame: two skip links appear before anything else.</div></div>\n</body>\n</html>\n"
