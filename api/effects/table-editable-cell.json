  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Editable Cell</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"table-editable-cell\",\n    \"title\": \"Editable Cell\",\n    \"summary\": \"A cell that becomes an input on double click.\",\n    \"description\": \"A cell that becomes an input on double click.\",\n    \"theme\": \"tables-data\",\n    \"categories\": [\"table\", \"data\"],\n    \"tags\": [\"table\", \"data\", \"editable\", \"inline-edit\", \"spreadsheet\", \"cell\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use real table markup with <th scope> and a <caption>; sortable headers need aria-sort, and row selection needs real checkboxes.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Focus colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"Spreadsheet-style grids. Match the input's padding and font to the static cell exactly, or every edit shifts the row height by a pixel or two.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; border-radius: 12px; overflow: hidden; border: 1px solid #263149; }\n    .fx table { width: 100%; border-collapse: collapse; font-size: .82rem; }\n    .fx th { background: #1c2437; color: #8b93a7; text-align: left; padding: .5rem .8rem; font-size: .68rem; text-transform: uppercase; }\n    .fx td { padding: 0; border-top: 1px solid #1e2740; }\n    .fx td .v { display: block; padding: .5rem .8rem; color: #cbd5e1; cursor: text; }\n    .fx td .v:hover { background: #171d33; }\n    .fx td input { width: 100%; padding: .5rem .8rem; border: 0; background: #10141f; color: #e7ebf3; font: inherit;\n      outline: 2px solid #7c5cff; outline-offset: -2px; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><table><caption class=\"sr\" style=\"position:absolute;left:-9999px\">Editable values</caption>\n  <thead><tr><th scope=\"col\">Token</th><th scope=\"col\">Value</th></tr></thead>\n  <tbody><tr><td><span class=\"v\">--accent</span></td><td><input type=\"text\" value=\"#7c5cff\" aria-label=\"Accent value\" /></td></tr>\n  <tr><td><span class=\"v\">--radius</span></td><td><span class=\"v\">14px</span></td></tr></tbody></table></div>\n</body>\n</html>\n"
