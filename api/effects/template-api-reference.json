  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>API Reference</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"template-api-reference\",\n    \"title\": \"API Reference\",\n    \"summary\": \"An endpoint page with parameters and a response.\",\n    \"description\": \"An endpoint page with parameters and a response.\",\n    \"theme\": \"website-templates\",\n    \"categories\": [\"template\", \"page\"],\n    \"tags\": [\"template\", \"page\", \"api\", \"reference\", \"endpoint\", \"docs\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Full pages keep landmark elements (header, nav, main, footer), a single h1, and a visible focus order that matches the layout.\",\n    \"customization\": [\n      { \"name\": \"--m\", \"description\": \"Method colour\", \"default\": \"#10a894\" }\n    ],\n    \"variations\": [\"Reskin through the custom properties\", \"Swap the copy for your own\"],\n    \"ai_usage\": \"API documentation. Show the response shape immediately after the parameters; developers scan for the payload before they read prose.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n    body { padding: 1.4rem; max-width: 34rem; margin: 0 auto; }\n    h1 { margin: 0 0 .4rem; font-size: 1.3rem; font-family: ui-monospace, monospace; }\n    .method { display: inline-block; padding: .12rem .5rem; border-radius: 6px; background: rgba(16,168,148,.16);\n      color: #7fd8cb; font-size: .7rem; font-weight: 800; margin-right: .4rem; }\n    .sub { margin: 0 0 1.1rem; color: #8b93a7; font-size: .88rem; line-height: 1.6; }\n    h2 { margin: 1.2rem 0 .5rem; font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: #64748b; }\n    table { width: 100%; border-collapse: collapse; font-size: .8rem; }\n    th { text-align: left; color: #64748b; font-size: .68rem; text-transform: uppercase; padding: .3rem 0; }\n    td { padding: .4rem 0; border-top: 1px solid #1e2740; color: #cbd5e1; vertical-align: top; }\n    td code { color: #b9a5ff; font-family: ui-monospace, monospace; }\n    pre { margin: 0; padding: .9rem; border-radius: 10px; background: #0d1117; color: #c9d1d9; overflow-x: auto;\n      font-family: ui-monospace, monospace; font-size: .74rem; line-height: 1.7; }\n  </style>\n</head>\n<body>\n  <h1><span class=\"method\">GET</span>/api/effects/{id}.json</h1>\n  <p class=\"sub\">Returns one complete specimen record, including its source.</p>\n  <main><h2>Parameters</h2><table><thead><tr><th scope=\"col\">Name</th><th scope=\"col\">Type</th><th scope=\"col\">Description</th></tr></thead>\n  <tbody><tr><td><code>id</code></td><td>string</td><td>Kebab-case specimen id, e.g. <code>ripple-button</code>.</td></tr></tbody></table>\n  <h2>Response</h2><pre><code>{\n    \"id\": \"ripple-button\",\n    \"theme\": \"buttons\",\n    \"tech\": [\"css\", \"js\"],\n    \"ai_usage\": \"Touch-first UIs…\",\n    \"source\": \"&lt;!DOCTYPE html&gt;…\"\n  }</code></pre></main>\n</body>\n</html>\n"
}
