ont-size: 1.6rem; font-weight: 900; line-height: 1; }\n    .fx .l { margin-top: .3rem; color: #8b93a7; font-size: .74rem; }\n  </style>\n</head>\n<body>\n  <section class=\"fx\"><div><div class=\"n\">1,181</div><div class=\"l\">Specimens</div></div>\n  <div><div class=\"n\">57</div><div class=\"l\">Themes</div></div>\n  <div><div class=\"n\">0</div><div class=\"l\">Dependencies</div></div>\n  <div><div class=\"n\">100%</div><div class=\"l\">Offline-capable</div></div></section>\n</body>\n</html>\n"
