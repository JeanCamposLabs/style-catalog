  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Foil Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"foil-text-shine\",\n    \"title\": \"Foil Text\",\n    \"summary\": \"Metallic lettering with a travelling highlight.\",\n    \"description\": \"Metallic lettering with a travelling highlight.\",\n    \"theme\": \"holographic-metallic\",\n    \"categories\": [\"material\", \"holographic\"],\n    \"tags\": [\"holographic\", \"metallic\", \"foil\", \"text\", \"shine\", \"metallic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Iridescent surfaces have unpredictable local contrast — never place body text directly on one.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Sweep period\", \"default\": \"4s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Titles and logos. Because the highlight is a background, the glyph edges stay perfectly sharp — a filter-based shine would soften them.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { font-size: 2.6rem; font-weight: 900; letter-spacing: .02em;\n      background: linear-gradient(100deg, #64748b 0 30%, #f8fafc 44%, #ffffff 50%, #e2e8f0 56%, #64748b 70%);\n      background-size: 250% 100%; -webkit-background-clip: text; background-clip: text; color: transparent;\n      animation: sweep 4s linear infinite; }\n    @keyframes sweep { to { background-position: -250% 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\">FOIL</div>\n</body>\n</html>\n"
