  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Cassette Tape</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"vapor-cassette-tape\",\n    \"title\": \"Cassette Tape\",\n    \"summary\": \"A compact cassette drawn in CSS.\",\n    \"description\": \"A compact cassette drawn in CSS.\",\n    \"theme\": \"vaporwave-synthwave\",\n    \"categories\": [\"retro\", \"vaporwave\"],\n    \"tags\": [\"vaporwave\", \"retro\", \"80s\", \"cassette\", \"tape\", \"music\", \"skeuomorphic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2000s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"High-saturation magenta on cyan is a contrast trap — keep body copy on a neutral surface.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Shell colour\", \"default\": \"#f472b6\" }\n    ],\n    \"variations\": [\"Retune the palette via the custom properties\", \"Slow the motion for an ambient version\"],\n    \"ai_usage\": \"Music players and mixtape branding. Spinning reels at a slow constant rate is enough motion — do not animate the whole shell.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 240px; height: 150px; border-radius: 10px; background: linear-gradient(160deg, #f472b6, #7c3aed);\n      padding: 14px; box-shadow: inset 0 2px 0 rgba(255,255,255,.4), 0 14px 30px rgba(0,0,0,.5); }\n    .fx .win { height: 62px; border-radius: 6px; background: #1a1030; display: flex; align-items: center; justify-content: space-around; }\n    .fx .reel { width: 34px; height: 34px; border-radius: 50%; border: 6px solid #cbd5e1; background: #0b0d12;\n      animation: spin 3s linear infinite; }\n    .fx .lbl { margin-top: 12px; height: 34px; border-radius: 5px; background: rgba(255,255,255,.85); color: #4c1d95;\n      display: grid; place-items: center; font-weight: 800; font-size: .8rem; letter-spacing: .1em; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"win\"><span class=\"reel\"></span><span class=\"reel\"></span></div><div class=\"lbl\">SIDE A</div></div>\n</body>\n</html>\n"
