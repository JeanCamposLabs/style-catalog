  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Striped Mask</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"mask-stripes-reveal\",\n    \"title\": \"Striped Mask\",\n    \"summary\": \"Content shows through moving stripes.\",\n    \"description\": \"Content shows through moving stripes. Uses clip-path or mask-image, so the element's box and layout are unaffected by the shape.\",\n    \"theme\": \"masks-clipping\",\n    \"categories\": [\"mask\", \"shape\"],\n    \"tags\": [\"clip-path\", \"mask\", \"stripes\", \"mask\", \"animated\", \"reveal\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Clipping hides content visually but not from assistive tech — anything fully clipped away should also be removed or aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--s\", \"description\": \"Stripe width\", \"default\": \"12px\" }\n    ],\n    \"variations\": [\"Animate the shape on hover\", \"Combine with a gradient fill\"],\n    \"ai_usage\": \"Transitional reveals and loading states. Animate mask-position by exactly one gradient period so the loop is seamless.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .art { width: 210px; height: 210px; background: conic-gradient(from 210deg at 40% 35%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .9rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .shape { -webkit-mask-image: repeating-linear-gradient(45deg, #000 0 12px, transparent 12px 24px);\n      mask-image: repeating-linear-gradient(45deg, #000 0 12px, transparent 12px 24px);\n      animation: slide 2s linear infinite; }\n    @keyframes slide { to { -webkit-mask-position: 34px 0; mask-position: 34px 0; } }\n  </style>\n</head>\n<body>\n  <div><div class=\"art shape\"></div><p class=\"label\">Striped Mask</p></div>\n</body>\n</html>\n"
