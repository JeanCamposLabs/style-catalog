  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Framed Gradient Edge</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"gradient-border-frame-bg\",\n    \"title\": \"Framed Gradient Edge\",\n    \"summary\": \"A luminous gradient frame hugs the viewport edges.\",\n    \"description\": \"A masked gradient border on a fixed overlay draws attention inward without touching the content layer.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"overlay\"],\n    \"tags\": [\"frame\", \"border\", \"gradient\", \"mask\", \"overlay\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Frame color A\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--b\", \"description\": \"Frame color B\", \"default\": \"#2dd4bf\" },\n      { \"name\": \"--w\", \"description\": \"Frame thickness\", \"default\": \"3px\" }\n    ],\n    \"variations\": [\"Animate the gradient angle\", \"Only glow on one edge\", \"Pulse during a live session\"],\n    \"ai_usage\": \"Recording indicators, focus modes, and live states. The mask-composite trick (two masks, xor) is the portable way to show only the border of a gradient-filled box.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --a: #7c5cff; --b: #2dd4bf; --w: 3px; }\n    .bg { background: #0b0d12; }\n    .frame { position: fixed; inset: 0; pointer-events: none; padding: var(--w);\n      background: linear-gradient(135deg, var(--a), var(--b), var(--a)); background-size: 200% 200%;\n      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n      mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);\n      -webkit-mask-composite: xor; mask-composite: exclude; animation: slide 6s linear infinite; }\n    @keyframes slide { to { background-position: 200% 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div><div class=\"frame\" aria-hidden=\"true\"></div>\n</body>\n</html>\n"
