  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Circular Visualizer</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"audio-visualizer-circular\",\n    \"title\": \"Circular Visualizer\",\n    \"summary\": \"Bars radiating from a central disc.\",\n    \"description\": \"Bars radiating from a central disc.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"visualizer\", \"circular\", \"radial\", \"bars\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Bar colour\", \"default\": \"#a855f7\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Music and voice UIs. Rotate then translate each bar so it points outward; give each its own duration or the ring pulses as one.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 180px; height: 180px; display: grid; place-items: center; }\n    .fx i { position: absolute; bottom: 50%; left: 50%; width: 4px; border-radius: 2px; background: #a855f7;\n      transform-origin: 50% 100%; transform: rotate(var(--a)) translateY(-42px);\n      animation: bar var(--d) ease-in-out infinite alternate; }\n    .fx .core { width: 70px; height: 70px; border-radius: 50%; background: linear-gradient(160deg, #7c5cff, #2dd4bf); }\n    @keyframes bar { from { height: 10px; } to { height: 34px; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><i style=\"--a:0deg;--d:.5s\"></i><i style=\"--a:30deg;--d:.7s\"></i><i style=\"--a:60deg;--d:.6s\"></i>\n  <i style=\"--a:90deg;--d:.8s\"></i><i style=\"--a:120deg;--d:.55s\"></i><i style=\"--a:150deg;--d:.75s\"></i>\n  <i style=\"--a:180deg;--d:.65s\"></i><i style=\"--a:210deg;--d:.5s\"></i><i style=\"--a:240deg;--d:.85s\"></i>\n  <i style=\"--a:270deg;--d:.6s\"></i><i style=\"--a:300deg;--d:.7s\"></i><i style=\"--a:330deg;--d:.55s\"></i>\n  <span class=\"core\"></span></div>\n</body>\n</html>\n"
}
