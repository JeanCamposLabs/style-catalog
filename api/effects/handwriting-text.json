  "ai_usage": "Sign-off blocks, testimonials, and checkout confirmations. Measure the path with getTotalLength() and set both dasharray and dashoffset to it; guessing the length leaves a visible gap or a premature finish.",
  "path": "effects/text-effects/handwriting-text.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Handwritten Signature</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"handwriting-text\",\n    \"title\": \"Handwritten Signature\",\n    \"summary\": \"A signature draws itself stroke by stroke.\",\n    \"description\": \"stroke-dasharray equal to the path length with an animated offset renders the pen travelling along the letterform.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"svg\"],\n    \"tags\": [\"handwriting\", \"signature\", \"stroke-dashoffset\", \"svg\", \"draw\"],\n    \"tech\": [\"svg\", \"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Ink color\", \"default\": \"#e7ebf3\" },\n      { \"name\": \"--dur\", \"description\": \"Writing duration\", \"default\": \"2.6s\" }\n    ],\n    \"variations\": [\"Hold the finished signature\", \"Thicker nib for a marker\", \"Replay on hover\"],\n    \"ai_usage\": \"Sign-off blocks, testimonials, and checkout confirmations. Measure the path with getTotalLength() and set both dasharray and dashoffset to it; guessing the length leaves a visible gap or a premature finish.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --c: #e7ebf3; --dur: 2.6s; }\n    .sig { width: 260px; }\n    .sig svg { width: 100%; display: block; }\n    .sig path { fill: none; stroke: var(--c); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round;\n      stroke-dasharray: 620; stroke-dashoffset: 620; animation: write var(--dur) ease-in-out infinite; }\n    @keyframes write { 0% { stroke-dashoffset: 620; } 70%, 100% { stroke-dashoffset: 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"sig\" role=\"img\" aria-label=\"Signature\">\n    <svg viewBox=\"0 0 260 90\" aria-hidden=\"true\">\n      <path d=\"M14 62c14-30 22-44 30-44s6 28-2 44c-6 12-14 16-16 8s10-26 26-30 22 8 16 20-16 14-14 4 14-20 30-20c10 0 12 8 8 16-3 6-9 10-9 4s8-14 20-14c14 0 18 10 34 4 14-5 22-14 26-22\"/>\n    </svg>\n  </div>\n</body>\n</html>\n"
}
