  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Holographic Card Shine</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"card-shine-follow\",\n    \"title\": \"Holographic Card Shine\",\n    \"summary\": \"A rainbow sheen slides across a card as the pointer moves.\",\n    \"description\": \"Pointer position drives both a gradient offset and a tilt, so the sheen behaves like light on a real holographic foil.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"3d\"],\n    \"tags\": [\"holographic\", \"shine\", \"tilt\", \"trading-card\", \"pointer\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--tilt\", \"description\": \"Maximum tilt\", \"default\": \"10deg\" }\n    ],\n    \"variations\": [\"Foil pattern overlay\", \"Sparkle particles on the sheen\", \"Snap-back spring on leave\"],\n    \"ai_usage\": \"Collectible, gaming, and pricing cards. Combine tilt with a moving highlight — tilt alone looks mechanical, and a sheen without tilt looks like a sliding gradient.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .holo { position: relative; width: 220px; height: 300px; border-radius: 18px; overflow: hidden;\n      background: linear-gradient(160deg, #1b2338, #0f1420); border: 1px solid #2b3450;\n      transform-style: preserve-3d; transition: transform .2s ease-out; }\n    .holo::after { content: \"\"; position: absolute; inset: -40%; opacity: .5; pointer-events: none;\n      background: conic-gradient(from calc(var(--a, 0) * 1deg), #ff2d95, #ffd166, #2dd4bf, #7c5cff, #ff2d95);\n      mix-blend-mode: color-dodge; filter: blur(18px); }\n    .holo .label { position: absolute; inset: auto 0 0 0; padding: 1rem; font-weight: 800; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"holo\" id=\"ho\"><div class=\"label\">Holo Rare</div></div>\n  <script>\n    (function () {\n      var el = document.getElementById(\"ho\");\n      el.addEventListener(\"pointermove\", function (e) {\n        var r = el.getBoundingClientRect();\n        var x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;\n        el.style.transform = \"perspective(700px) rotateY(\" + (x * 20) + \"deg) rotateX(\" + (-y * 20) + \"deg)\";\n        el.style.setProperty(\"--a\", (x * 180 + 180).toFixed(0));\n      });\n      el.addEventListener(\"pointerleave\", function () { el.style.transform = \"\"; });\n    })();\n  </script>\n</body>\n</html>\n"
}
