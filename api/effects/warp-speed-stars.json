  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Warp Speed</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"warp-speed-stars\",\n    \"title\": \"Warp Speed\",\n    \"summary\": \"Stars stretching into streaks toward the viewer.\",\n    \"description\": \"Stars stretching into streaks toward the viewer.\",\n    \"theme\": \"space-cosmic\",\n    \"categories\": [\"space\", \"cosmic\"],\n    \"tags\": [\"space\", \"cosmic\", \"warp\", \"hyperspace\", \"streaks\", \"speed\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Deep-space palettes are very low contrast — keep any text on a solid panel above the scene.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Warp period\", \"default\": \"1.4s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Slow it down for an ambient version\"],\n    \"ai_usage\": \"Transitions and launch sequences. Rotate each star to its own angle and scale only on X so the streak always points away from the centre.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 260px; height: 180px; border-radius: 14px; overflow: hidden; background: #04060c; }\n    .fx i { position: absolute; top: 50%; left: 50%; width: 2px; height: 2px; background: #fff; border-radius: 99px;\n      transform-origin: 0 0; animation: warp var(--d) linear infinite; animation-delay: var(--dl); }\n    @keyframes warp {\n      0% { transform: rotate(var(--a)) translateX(10px) scaleX(1); opacity: 0; }\n      20% { opacity: 1; }\n      100% { transform: rotate(var(--a)) translateX(180px) scaleX(28); opacity: 0; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><i style=\"--a:10deg;--d:1.4s;--dl:0s\"></i><i style=\"--a:65deg;--d:1.8s;--dl:-.3s\"></i>\n  <i style=\"--a:130deg;--d:1.2s;--dl:-.6s\"></i><i style=\"--a:200deg;--d:1.6s;--dl:-.9s\"></i>\n  <i style=\"--a:255deg;--d:1.5s;--dl:-.2s\"></i><i style=\"--a:310deg;--d:1.9s;--dl:-1.1s\"></i></div>\n</body>\n</html>\n"
