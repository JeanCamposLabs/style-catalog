  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Hotkey Overlay</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hotkey-cheatsheet-overlay\",\n    \"title\": \"Hotkey Overlay\",\n    \"summary\": \"A full shortcut sheet triggered by ?\",\n    \"description\": \"A full shortcut sheet triggered by ?\",\n    \"theme\": \"keyboard-input\",\n    \"categories\": [\"keyboard\", \"input\"],\n    \"tags\": [\"keyboard\", \"shortcut\", \"cheatsheet\", \"overlay\", \"hotkeys\", \"help\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Shortcut hints must reflect the user's platform, and no action should be reachable only by a shortcut.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Panel background\", \"default\": \"#141a28\" }\n    ],\n    \"variations\": [\"Reskin through the custom properties\", \"Swap the copy for your own\"],\n    \"ai_usage\": \"Keyboard-driven apps. Bind the sheet to ? and mention it in onboarding; an undiscoverable shortcut system is used by almost nobody.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; padding: 1.1rem; border-radius: 16px; background: #141a28; border: 1px solid #2b3450; }\n    .fx h3 { margin: 0 0 .8rem; font-size: 1rem; display: flex; justify-content: space-between; align-items: center; }\n    .fx h3 kbd { padding: .1rem .4rem; border-radius: 5px; background: #1c2437; border: 1px solid #2b3450;\n      font-family: ui-monospace, monospace; font-size: .7rem; color: #8b93a7; }\n    .fx .g { margin-bottom: .8rem; }\n    .fx .lbl { font-size: .66rem; text-transform: uppercase; letter-spacing: .08em; color: #64748b; margin-bottom: .3rem; }\n    .fx .r { display: flex; justify-content: space-between; padding: .2rem 0; color: #cbd5e1; font-size: .82rem; }\n    .fx .r kbd { padding: .05rem .35rem; border-radius: 4px; background: #1c2437; border: 1px solid #2b3450;\n      font-family: ui-monospace, monospace; font-size: .7rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"dialog\" aria-label=\"Keyboard shortcuts\"><h3>Shortcuts <kbd>Esc to close</kbd></h3>\n  <div class=\"g\"><div class=\"lbl\">Navigation</div><div class=\"r\"><span>Search</span><kbd>/</kbd></div>\n  <div class=\"r\"><span>Command palette</span><kbd>⌘K</kbd></div></div>\n  <div class=\"g\"><div class=\"lbl\">Actions</div><div class=\"r\"><span>Copy for AI</span><kbd>C</kbd></div>\n  <div class=\"r\"><span>Add to bundle</span><kbd>B</kbd></div></div></div>\n</body>\n</html>\n"
}
