  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Inline Loading Button</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"button-loading-inline-swap\",\n    \"title\": \"Inline Loading Button\",\n    \"summary\": \"A button that keeps its width while loading.\",\n    \"description\": \"A button that keeps its width while loading.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"action\"],\n    \"tags\": [\"button\", \"action\", \"loading\", \"busy\", \"width\", \"state\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>, keep a visible :focus-visible ring, and never signal state with colour alone.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Button colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Form submissions. Set min-width from the widest label so the button never resizes mid-action, and set aria-busy so the state is announced rather than only shown.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { min-width: 150px; padding: .8rem 1.4rem; border: 0; border-radius: 11px; background: #7c5cff; color: #fff;\n      font: inherit; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }\n    .fx .sp { width: 15px; height: 15px; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%;\n      animation: spin .8s linear infinite; }\n    .fx[aria-busy=\"true\"] { opacity: .85; cursor: progress; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <button class=\"fx\" type=\"button\" aria-busy=\"true\"><span class=\"sp\" aria-hidden=\"true\"></span>Saving…</button>\n</body>\n</html>\n"
