  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Highlighted Pricing Card</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"card-pricing-highlight\",\n    \"title\": \"Highlighted Pricing Card\",\n    \"summary\": \"The recommended plan lifted above its neighbours.\",\n    \"description\": \"The recommended plan lifted above its neighbours. Self-contained card markup you can drop into a grid.\",\n    \"theme\": \"cards-surfaces\",\n    \"categories\": [\"card\", \"surface\"],\n    \"tags\": [\"card\", \"surface\", \"pricing\", \"plan\", \"highlight\", \"conversion\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"A clickable card needs one real link or button inside it; never attach a click handler to a bare div.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Highlight colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt for a light theme\", \"Add a media area at the top\"],\n    \"ai_usage\": \"Pricing pages. Distinguish the recommended plan with border, shadow, and a badge — scale alone breaks alignment in a grid.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .card { width: 260px; border-radius: 18px; padding: 1.4rem; }\n    .card h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .card p { margin: 0; color: #8b93a7; font-size: .88rem; line-height: 1.5; }\n    .card { background: #151b2a; border: 2px solid #7c5cff; box-shadow: 0 20px 50px rgba(124,92,255,.25); position: relative; }\n    .card .tag { position: absolute; top: -12px; left: 50%; translate: -50% 0; padding: .2rem .7rem; border-radius: 999px;\n      background: #7c5cff; color: #fff; font-size: .72rem; font-weight: 800; }\n    .card .price { font-size: 2.2rem; font-weight: 900; margin: .5rem 0; }\n    .card .price span { font-size: .9rem; color: #8b93a7; font-weight: 500; }\n    .card ul { list-style: none; margin: 1rem 0 0; padding: 0; color: #cbd5e1; font-size: .88rem; }\n    .card li { padding: .25rem 0; }\n    .card li::before { content: \"✓ \"; color: #34d399; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <article class=\"card\"><span class=\"tag\">Most popular</span><h3>Studio</h3>\n  <div class=\"price\">$24<span>/mo</span></div>\n  <ul><li>Unlimited projects</li><li>Priority support</li><li>Custom domains</li></ul></article>\n</body>\n</html>\n"
}
