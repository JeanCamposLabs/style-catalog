  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Rubber Band In</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"rubber-band-in\",\n    \"title\": \"Rubber Band In\",\n    \"summary\": \"The element stretches horizontally then snaps back.\",\n    \"description\": \"The element stretches horizontally then snaps back. Applied once on load with animation-fill-mode: both so the element holds its final state.\",\n    \"theme\": \"transitions-animations\",\n    \"categories\": [\"animation\", \"entrance\"],\n    \"tags\": [\"entrance\", \"reveal\", \"rubber\", \"stretch\", \"elastic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Entrance animations must not hide content if they never run — the resting state under prefers-reduced-motion is the finished state.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Animation duration\", \"default\": \".7s\" },\n      { \"name\": \"--ease\", \"description\": \"Timing function\", \"default\": \"cubic-bezier(.2,.8,.3,1)\" }\n    ],\n    \"variations\": [\"Stagger across a list with animation-delay\", \"Play on scroll with IntersectionObserver\"],\n    \"ai_usage\": \"Attention-grabbing for pills and badges. Because only X scales, text inside distorts — use it on elements without long labels.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: .7s; --ease: cubic-bezier(.2,.8,.3,1); }\n    .card { width: 230px; padding: 1.5rem; border-radius: 16px; background: #151b2a; border: 1px solid #263149;\n      animation: rubber-band-in var(--dur) var(--ease) both infinite alternate; }\n    .card h3 { margin: 0 0 .3rem; font-size: 1.05rem; }\n    .card p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    @keyframes rubber-band-in {\n      0% { opacity: 0; transform: scaleX(.5); }\n      50% { opacity: 1; transform: scaleX(1.2); }\n      75% { transform: scaleX(.92); }\n      100% { transform: scaleX(1); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      .card { animation: none; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"card\"><h3>Rubber Band In</h3><p>The element stretches horizontally then snaps back.</p></div>\n</body>\n</html>\n"
