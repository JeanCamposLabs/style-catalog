  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Dialogue Box</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"dialogue-box-rpg\",\n    \"title\": \"Dialogue Box\",\n    \"summary\": \"An RPG dialogue panel with a typing effect and a speaker name.\",\n    \"description\": \"An RPG dialogue panel with a typing effect and a speaker name.\",\n    \"theme\": \"game-ui\",\n    \"categories\": [\"game\", \"ui\"],\n    \"tags\": [\"game\", \"hud\", \"dialogue\", \"rpg\", \"text-box\", \"narrative\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Game HUDs still need real semantics: use progressbar roles for meters and buttons for slots so the interface is operable without sight.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Frame colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Narrative games and tutorials. The bobbing continue caret is the conventional 'press to advance' affordance — keep it, and also accept any key.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; padding: 1rem 1.1rem 1.4rem; border: 3px solid #7c5cff; border-radius: 10px;\n      background: linear-gradient(180deg, #12162a, #0b0d18); position: relative; font-family: ui-monospace, monospace; }\n    .fx .who { position: absolute; top: -14px; left: 14px; padding: .1rem .6rem; border: 2px solid #7c5cff; border-radius: 6px;\n      background: #12162a; font-size: .75rem; color: #c4b5fd; }\n    .fx p { margin: 0; font-size: .88rem; line-height: 1.6; color: #e7ebf3; }\n    .fx .next { position: absolute; right: 12px; bottom: 8px; color: #7c5cff; animation: bob .8s ease-in-out infinite alternate; }\n    @keyframes bob { to { transform: translateY(4px); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"who\">ARCHIVIST</span><p>The catalogue holds more than a thousand specimens now. Choose carefully.</p>\n  <span class=\"next\" aria-hidden=\"true\">▼</span></div>\n</body>\n</html>\n"
