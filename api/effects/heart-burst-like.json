  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Heart Burst</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"heart-burst-like\",\n    \"title\": \"Heart Burst\",\n    \"summary\": \"A like that pops and throws particles.\",\n    \"description\": \"A like that pops and throws particles.\",\n    \"theme\": \"micro-interactions\",\n    \"categories\": [\"micro-interaction\", \"feedback\"],\n    \"tags\": [\"micro-interaction\", \"feedback\", \"like\", \"heart\", \"burst\", \"particles\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every micro-interaction must have a non-animated equivalent: state changes are announced through ARIA, not through motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Active colour\", \"default\": \"#d1478c\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Reaction buttons. The burst is decoration; the state change must still be conveyed by aria-pressed and by the colour, not by the animation.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 64px; height: 64px; border: 0; background: none; cursor: pointer; font-size: 1.8rem;\n      color: #3b465e; }\n    .fx[aria-pressed=\"true\"] { color: #d1478c; }\n    .fx[aria-pressed=\"true\"] .h { animation: pop .45s cubic-bezier(.34,1.56,.64,1); }\n    .fx i { position: absolute; top: 50%; left: 50%; width: 5px; height: 5px; border-radius: 50%; background: #d1478c;\n      opacity: 0; pointer-events: none; }\n    .fx[aria-pressed=\"true\"] i { animation: burst .55s ease-out; }\n    @keyframes pop { 0% { transform: scale(.7); } 55% { transform: scale(1.3); } 100% { transform: scale(1); } }\n    @keyframes burst { 0% { opacity: 1; transform: translate(0,0) scale(1); } 100% { opacity: 0; transform: translate(var(--x), var(--y)) scale(.3); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <button class=\"fx\" type=\"button\" aria-pressed=\"false\" aria-label=\"Like\" id=\"hb\"><span class=\"h\">♥</span>\n  <i style=\"--x:-20px;--y:-22px\"></i><i style=\"--x:18px;--y:-24px\"></i><i style=\"--x:-22px;--y:16px\"></i><i style=\"--x:20px;--y:18px\"></i></button>\n  <script>\n    (function () {\n      var b = document.getElementById(\"hb\");\n      b.addEventListener(\"click\", function () {\n        b.setAttribute(\"aria-pressed\", b.getAttribute(\"aria-pressed\") === \"true\" ? \"false\" : \"true\");\n      });\n    })();\n  </script>\n</body>\n</html>\n"
