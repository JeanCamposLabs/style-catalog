  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Weight Wave</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"variable-weight-wave\",\n    \"title\": \"Weight Wave\",\n    \"summary\": \"A wave of boldness travels through the sentence, letter by letter.\",\n    \"description\": \"Animating font-weight per character with an index delay makes the emphasis ripple through the line instead of jumping.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"typography\"],\n    \"tags\": [\"variable-font\", \"weight\", \"wave\", \"stagger\", \"kinetic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Wave period\", \"default\": \"2s\" },\n      { \"name\": \"--max\", \"description\": \"Peak weight\", \"default\": \"900\" }\n    ],\n    \"variations\": [\"Wave the width axis instead on a variable font\", \"Trigger on hover per letter\", \"Slow it down for an ambient logo\"],\n    \"ai_usage\": \"Works best with a true variable font where weight interpolates smoothly; with static families the browser snaps between the installed weights and the wave stutters. Keep it to one short line.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: 2s; --max: 900; }\n    .vw { font-size: clamp(1.4rem, 5vw, 2.2rem); display: flex; }\n    .vw span { display: inline-block; font-weight: 300; animation: wt var(--dur) ease-in-out infinite;\n      animation-delay: calc(var(--i) * .07s); }\n    @keyframes wt { 0%, 100% { font-weight: 300; } 50% { font-weight: var(--max); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <p class=\"vw\" aria-label=\"Variable weight\">\n    <span aria-hidden=\"true\" style=\"--i:0\">V</span><span aria-hidden=\"true\" style=\"--i:1\">a</span><span aria-hidden=\"true\" style=\"--i:2\">r</span><span aria-hidden=\"true\" style=\"--i:3\">i</span><span aria-hidden=\"true\" style=\"--i:4\">a</span><span aria-hidden=\"true\" style=\"--i:5\">b</span><span aria-hidden=\"true\" style=\"--i:6\">l</span><span aria-hidden=\"true\" style=\"--i:7\">e</span>\n  </p>\n</body>\n</html>\n"
