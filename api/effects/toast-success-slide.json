  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Success Toast</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"toast-success-slide\",\n    \"title\": \"Success Toast\",\n    \"summary\": \"A toast that slides in with an icon and dismiss.\",\n    \"description\": \"A toast that slides in with an icon and dismiss.\",\n    \"theme\": \"notifications-toasts\",\n    \"categories\": [\"notification\", \"feedback\"],\n    \"tags\": [\"notification\", \"feedback\", \"toast\", \"success\", \"slide\", \"dismiss\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Announce transient messages through an aria-live region; never convey severity by colour alone, and never auto-dismiss anything the user must act on.\",\n    \"customization\": [\n      { \"name\": \"--ok\", \"description\": \"Success colour\", \"default\": \"#10a894\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Confirmations. Auto-dismiss after 4–6 seconds, pause the timer on hover and focus, and put the message in an aria-live=polite region.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: .8rem; width: 290px; padding: .8rem 1rem; border-radius: 12px;\n      background: #101f1b; border: 1px solid #10a894; color: #e7ebf3; animation: slide .4s cubic-bezier(.2,.8,.3,1) both; }\n    .fx .ic { width: 26px; height: 26px; border-radius: 50%; background: #10a894; color: #04241f; display: grid;\n      place-items: center; font-weight: 900; flex: none; }\n    .fx p { margin: 0; font-size: .86rem; flex: 1; }\n    .fx button { border: 0; background: none; color: #8b93a7; font-size: 1.1rem; cursor: pointer; }\n    @keyframes slide { from { opacity: 0; transform: translateY(14px); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\"><span class=\"ic\" aria-hidden=\"true\">✓</span><p>Catalogue published to Pages</p>\n  <button type=\"button\" aria-label=\"Dismiss\">×</button></div>\n</body>\n</html>\n"
