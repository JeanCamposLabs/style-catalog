  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Countdown Timer</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"countdown-timer-units\",\n    \"title\": \"Countdown Timer\",\n    \"summary\": \"Days, hours, minutes, and seconds in separate tiles.\",\n    \"description\": \"Days, hours, minutes, and seconds in separate tiles.\",\n    \"theme\": \"calendar-time\",\n    \"categories\": [\"calendar\", \"time\"],\n    \"tags\": [\"calendar\", \"date\", \"countdown\", \"timer\", \"units\", \"launch\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dates need machine-readable markup (<time datetime>) and selected days must be announced, not just highlighted.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Tile background\", \"default\": \"#151b2a\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Launches and deadlines. tabular-nums stops the tiles from resizing as digits change; drive the values from a timestamp, never from a client-side counter that drifts.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 8px; }\n    .u { width: 62px; padding: .7rem .3rem; border-radius: 12px; background: #151b2a; border: 1px solid #263149; text-align: center; }\n    .u .n { font-size: 1.5rem; font-weight: 900; font-variant-numeric: tabular-nums; }\n    .u .l { font-size: .64rem; text-transform: uppercase; letter-spacing: .08em; color: #8b93a7; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"timer\" aria-label=\"4 days 12 hours 38 minutes remaining\">\n    <div class=\"u\"><div class=\"n\">04</div><div class=\"l\">Days</div></div>\n    <div class=\"u\"><div class=\"n\">12</div><div class=\"l\">Hrs</div></div>\n    <div class=\"u\"><div class=\"n\">38</div><div class=\"l\">Min</div></div>\n    <div class=\"u\"><div class=\"n\">07</div><div class=\"l\">Sec</div></div></div>\n</body>\n</html>\n"
