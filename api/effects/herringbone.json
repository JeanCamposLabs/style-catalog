  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Herringbone</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"herringbone\",\n    \"title\": \"Herringbone\",\n    \"summary\": \"Interlocking diagonal blocks, parquet style.\",\n    \"description\": \"Interlocking diagonal blocks, parquet style. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"herringbone\", \"parquet\", \"floor\", \"weave\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Block colour\", \"default\": \"#1a2130\" },\n      { \"name\": \"--b\", \"description\": \"Ground\", \"default\": \"#0e1219\" },\n      { \"name\": \"--s\", \"description\": \"Tile size\", \"default\": \"34px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Flooring, fabric, and heritage design. The two mirrored gradient sets must be offset by exactly one tile to interlock.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --a: #1a2130; --b: #0e1219; --s: 34px; }\n    .bg { background-color: var(--b);\n      background-image: repeating-linear-gradient(45deg, var(--a) 0 8px, transparent 8px 16px),\n        repeating-linear-gradient(-45deg, var(--a) 0 8px, transparent 8px 16px);\n      background-size: var(--s) var(--s), var(--s) var(--s);\n      background-position: 0 0, var(--s) 0; }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
