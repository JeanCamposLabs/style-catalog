  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Layered Waves</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"divider-layered-waves\",\n    \"title\": \"Layered Waves\",\n    \"summary\": \"Three offset waves for a deeper transition.\",\n    \"description\": \"Three offset waves for a deeper transition. Purely decorative and self-contained, so it drops between any two sections.\",\n    \"theme\": \"dividers-shapes\",\n    \"categories\": [\"divider\", \"shape\"],\n    \"tags\": [\"divider\", \"separator\", \"waves\", \"layered\", \"depth\", \"svg\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dividers are decorative: mark them aria-hidden so they are not announced as content.\",\n    \"customization\": [\n      { \"name\": \"--h\", \"description\": \"Divider height\", \"default\": \"70px\" }\n    ],\n    \"variations\": [\"Flip vertically for the opposite section\", \"Recolour to match the next section\"],\n    \"ai_usage\": \"Hero-to-content transitions. Offset each wave horizontally and vary the opacity so the layers read as depth rather than a thick single edge.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .top { background: #151b2a; padding: 1.6rem; text-align: center; color: #8b93a7; font-size: .85rem; }\n    .bottom { background: #7c5cff; padding: 1.6rem; text-align: center; color: #1a1030; font-size: .85rem; font-weight: 700; }\n    .stage { width: min(92vw, 340px); }\n    .divider { position: relative; height: 70px; }\n    .divider svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n    .divider .w1 { fill: rgba(124,92,255,.35); }\n    .divider .w2 { fill: rgba(124,92,255,.6); }\n    .divider .w3 { fill: #7c5cff; }\n  </style>\n</head>\n<body>\n  <div class=\"stage\"><div class=\"top\">Section one</div>\n  <div class=\"divider\" aria-hidden=\"true\">\n    <svg viewBox=\"0 0 340 70\" preserveAspectRatio=\"none\"><path class=\"w1\" d=\"M0 40 C70 10 120 60 190 34 C250 12 300 52 340 32 L340 70 L0 70 Z\"/></svg>\n    <svg viewBox=\"0 0 340 70\" preserveAspectRatio=\"none\"><path class=\"w2\" d=\"M0 48 C60 22 130 66 200 44 C260 26 310 58 340 44 L340 70 L0 70 Z\"/></svg>\n    <svg viewBox=\"0 0 340 70\" preserveAspectRatio=\"none\"><path class=\"w3\" d=\"M0 56 C80 36 140 70 210 54 C270 40 310 64 340 54 L340 70 L0 70 Z\"/></svg>\n  </div><div class=\"bottom\">Section two</div></div>\n</body>\n</html>\n"
