  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Sliding Underline Link</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"underline-slide-link\",\n    \"title\": \"Sliding Underline Link\",\n    \"summary\": \"A text link whose underline slides out and back in from the other side.\",\n    \"description\": \"The underline scales to zero from the right and back in from the left, so hover-out feels intentional rather than a reversal.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"link\"],\n    \"tags\": [\"link\", \"underline\", \"slide\", \"hover\", \"text\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>; keep a visible :focus-visible ring and never rely on hover alone to convey state. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Underline color\", \"default\": \"#2dd4bf\" },\n      { \"name\": \"--dur\", \"description\": \"Slide duration\", \"default\": \"0.3s\" }\n    ],\n    \"variations\": [\"Thicker rule for menu links\", \"Color change on the text as well\", \"Offset the rule further from the baseline\"],\n    \"ai_usage\": \"Body-copy links and text navigation. The direction switch is done by changing transform-origin between the base and :hover rules — one origin gives a plain grow/shrink instead.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    button { font: inherit; cursor: pointer; border: 0; }\n    button:focus-visible { outline: 2px solid #7c5cff; outline-offset: 3px; }\n    :root { --c: #2dd4bf; --dur: .3s; }\n    .slink { position: relative; color: #e7ebf3; text-decoration: none; font-size: 1.2rem; font-weight: 600; }\n    .slink::after { content: \"\"; position: absolute; left: 0; right: 0; bottom: -4px; height: 2px; background: var(--c);\n      transform: scaleX(0); transform-origin: right; transition: transform var(--dur) ease; }\n    .slink:hover::after, .slink:focus-visible::after { transform: scaleX(1); transform-origin: left; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <a class=\"slink\" href=\"#\">Read the documentation</a>\n</body>\n</html>\n"
