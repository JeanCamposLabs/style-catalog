  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Claymorphic Tile</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"claymorphic-tile\",\n    \"title\": \"Claymorphic Tile\",\n    \"summary\": \"A puffy clay surface with double inner highlights.\",\n    \"description\": \"Large radii, a saturated fill, and two inset highlights (top-left light, bottom-right dark) create the inflated clay look.\",\n    \"theme\": \"glass-neumorphism\",\n    \"categories\": [\"claymorphism\"],\n    \"tags\": [\"clay\", \"puffy\", \"3d\", \"soft\", \"playful\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Soft surfaces easily fall below 3:1 contrast — check the border and text against the backdrop before shipping.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Clay colour\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--r\", \"description\": \"Corner radius\", \"default\": \"34px\" }\n    ],\n    \"variations\": [\"Pastel palette\", \"Larger radius for more inflation\", \"Add a drop shadow in the same hue\"],\n    \"ai_usage\": \"Playful, kid-friendly, and app-icon aesthetics. The recipe is: big radius, saturated fill, two inset shadows, and a large soft outer shadow tinted with the fill colour.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --c: #7c5cff; --r: 34px; }\n    .clay { width: 200px; height: 150px; border-radius: var(--r); background: var(--c); display: grid; place-items: center;\n      color: #fff; font-weight: 800;\n      box-shadow: inset 8px 8px 16px rgba(255,255,255,.35), inset -8px -8px 16px rgba(0,0,0,.25),\n        0 22px 40px color-mix(in srgb, var(--c) 40%, transparent); }\n  </style>\n</head>\n<body>\n  <div class=\"clay\">Clay</div>\n</body>\n</html>\n"
