  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Accent Application</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"brand-accent-application\",\n    \"title\": \"Accent Application\",\n    \"summary\": \"Where a brand colour should and should not go.\",\n    \"description\": \"Where a brand colour should and should not go.\",\n    \"theme\": \"color-systems\",\n    \"categories\": [\"color\", \"reference\"],\n    \"tags\": [\"color\", \"tokens\", \"accent\", \"brand\", \"application\", \"restraint\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every colour pairing here is checked for contrast; semantic colours always ship with an icon or label so meaning is never colour-only.\",\n    \"customization\": [\n      { \"name\": \"--brand\", \"description\": \"Accent\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Accent discipline. One accent per view, on the single most important action; when everything is branded, nothing reads as primary.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; display: grid; gap: 8px; font-size: .8rem; }\n    .ok, .no { display: flex; gap: .6rem; padding: .6rem .8rem; border-radius: 10px; background: #151b2a; color: #cbd5e1; }\n    .ok span:first-child { color: #10a894; } .no span:first-child { color: #d1478c; }\n    .demo { display: flex; gap: .5rem; margin-top: .3rem; }\n    .demo button { padding: .4rem .9rem; border: 0; border-radius: 8px; font: inherit; font-size: .78rem; cursor: pointer; }\n    .primary { background: #7c5cff; color: #fff; }\n    .ghost { background: transparent; color: #cbd5e1; border: 1px solid #2b3450; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"ok\"><span aria-hidden=\"true\">✓</span><span>One primary action per view</span></div>\n  <div class=\"ok\"><span aria-hidden=\"true\">✓</span><span>Focus rings and active states</span></div>\n  <div class=\"no\"><span aria-hidden=\"true\">✕</span><span>Body text and large surfaces</span></div>\n  <div class=\"demo\"><button class=\"primary\" type=\"button\">Publish</button><button class=\"ghost\" type=\"button\">Save draft</button></div></div>\n</body>\n</html>\n"
