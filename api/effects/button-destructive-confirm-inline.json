  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Inline Confirm</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"button-destructive-confirm-inline\",\n    \"title\": \"Inline Confirm\",\n    \"summary\": \"A delete button that asks for confirmation in place.\",\n    \"description\": \"A delete button that asks for confirmation in place.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"action\"],\n    \"tags\": [\"button\", \"action\", \"confirm\", \"destructive\", \"inline\", \"two-step\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>, keep a visible :focus-visible ring, and never signal state with colour alone.\",\n    \"customization\": [\n      { \"name\": \"--bad\", \"description\": \"Danger colour\", \"default\": \"#d1478c\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Row-level deletes. Inline confirmation is lighter than a modal and keeps context; move focus to the confirm button so keyboard users are not left behind.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: inline-flex; gap: .4rem; align-items: center; }\n    .fx button { padding: .55rem 1rem; border-radius: 9px; border: 1px solid #2b3450; background: transparent;\n      color: #cbd5e1; font: inherit; font-size: .84rem; cursor: pointer; }\n    .fx .danger { border-color: #d1478c; color: #f0a3c6; }\n    .fx .danger:hover { background: rgba(209,71,140,.15); }\n    .fx .q { color: #8b93a7; font-size: .82rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"q\">Delete this specimen?</span><button type=\"button\">Cancel</button>\n  <button class=\"danger\" type=\"button\">Delete</button></div>\n</body>\n</html>\n"
