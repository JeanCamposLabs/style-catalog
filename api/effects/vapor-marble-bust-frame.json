   .fx::before { content: \"\"; position: absolute; inset: 0;\n      background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.14) 0 1px, transparent 1px 26px),\n        repeating-linear-gradient(0deg, rgba(255,255,255,.14) 0 1px, transparent 1px 26px); }\n    .bust { position: relative; font-size: 5rem; filter: grayscale(1) contrast(1.2) drop-shadow(0 6px 14px rgba(0,0,0,.5)); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"bust\" aria-hidden=\"true\">🗿</span></div>\n</body>\n</html>\n"
