  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Concentric Rings</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"concentric-rings\",\n    \"title\": \"Concentric Rings\",\n    \"summary\": \"Evenly spaced rings radiating from a point.\",\n    \"description\": \"Evenly spaced rings radiating from a point. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"rings\", \"concentric\", \"radial\", \"target\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Ring colour\", \"default\": \"rgba(124,92,255,.3)\" },\n      { \"name\": \"--s\", \"description\": \"Ring spacing\", \"default\": \"26px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Focus points and radar motifs. Move the gradient's centre off-screen for a sweeping arc pattern instead of a bullseye.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(124,92,255,.3); --s: 26px; }\n    .bg { background-color: #0b0d12;\n      background-image: repeating-radial-gradient(circle at 50% 50%, transparent 0 calc(var(--s) - 2px), var(--c) calc(var(--s) - 2px) var(--s)); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
