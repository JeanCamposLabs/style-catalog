  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Depth Blur</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"blur-depth-filter\",\n    \"title\": \"Depth Blur\",\n    \"summary\": \"A gradient of blur that increases toward the edges.\",\n    \"description\": \"A gradient of blur that increases toward the edges. Applied with CSS filters or blend modes, so the underlying content stays live and selectable.\",\n    \"theme\": \"blend-filters\",\n    \"categories\": [\"filter\", \"color\"],\n    \"tags\": [\"filter\", \"css\", \"blur\", \"depth-of-field\", \"mask\", \"focus\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Filters change colour relationships — re-check text contrast after applying one, and never encode meaning in a filtered colour alone.\",\n    \"customization\": [\n      { \"name\": \"--blur\", \"description\": \"Edge blur\", \"default\": \"8px\" }\n    ],\n    \"variations\": [\"Animate the filter value on hover\", \"Apply to a whole section with backdrop-filter\"],\n    \"ai_usage\": \"Fake depth of field. Mask a backdrop-filter layer instead of blurring the element, so the sharp centre stays perfectly crisp.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; height: 170px; border-radius: 16px; overflow: hidden; position: relative;\n      background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .8rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .fx { filter: blur(0); }\n    .fx::after { content: \"\"; position: absolute; inset: 0; backdrop-filter: blur(8px);\n      -webkit-mask-image: radial-gradient(circle at 50% 45%, transparent 30%, #000 70%);\n      mask-image: radial-gradient(circle at 50% 45%, transparent 30%, #000 70%); }\n  </style>\n</head>\n<body>\n  <div><div class=\"demo fx\"></div><p class=\"label\">Depth Blur</p></div>\n</body>\n</html>\n"
