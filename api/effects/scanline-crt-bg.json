  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>CRT Scanlines</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"scanline-crt-bg\",\n    \"title\": \"CRT Scanlines\",\n    \"summary\": \"Fine scanlines plus a rolling refresh bar over a curved vignette.\",\n    \"description\": \"Three cues stack: hard scanlines, a slow rolling band, and a corner vignette — together they read as a CRT rather than a striped overlay.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"retro\"],\n    \"tags\": [\"crt\", \"scanlines\", \"vignette\", \"retro\", \"monitor\"],\n    \"tech\": [\"css\"],\n    \"era\": \"1990s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Scanline color\", \"default\": \"rgba(0,0,0,.45)\" },\n      { \"name\": \"--dur\", \"description\": \"Roll period\", \"default\": \"6s\" }\n    ],\n    \"variations\": [\"Green phosphor tint\", \"Stronger curvature with a radial mask\", \"Occasional horizontal tear\"],\n    \"ai_usage\": \"Retro-terminal and arcade skins. Put this layer above your content with pointer-events:none; the rolling bar should be very subtle (opacity < .06) or it becomes a distraction rather than an artefact.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(0,0,0,.45); --dur: 6s; }\n    .bg { background: radial-gradient(ellipse at center, #0f2318 0%, #050a07 75%); }\n    .bg::before { content: \"\"; position: absolute; inset: 0;\n      background: repeating-linear-gradient(180deg, transparent 0 2px, var(--c) 2px 4px); }\n    .bg::after { content: \"\"; position: absolute; left: 0; right: 0; height: 120px;\n      background: linear-gradient(180deg, transparent, rgba(255,255,255,.05), transparent);\n      animation: roll var(--dur) linear infinite; }\n    @keyframes roll { from { top: -120px; } to { top: 100%; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
