  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Radial Countdown</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"progress-radial-countdown\",\n    \"title\": \"Radial Countdown\",\n    \"summary\": \"A ring that empties as time runs out.\",\n    \"description\": \"A ring that empties as time runs out.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"countdown\", \"timer\", \"ring\", \"conic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Time remaining\", \"default\": \"35\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Session timeouts and resend cooldowns. Drive --p from a real timestamp so a backgrounded tab resumes at the correct position instead of drifting.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .rc { width: 120px; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center;\n      background: conic-gradient(#fbbf24 calc(var(--p) * 1%), #22304a 0);\n      -webkit-mask: radial-gradient(farthest-side, transparent 68%, #000 69%); mask: radial-gradient(farthest-side, transparent 68%, #000 69%); }\n    .wrap { position: relative; display: grid; place-items: center; }\n    .wrap b { position: absolute; font-size: 1.3rem; font-weight: 900; font-variant-numeric: tabular-nums; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\"><div class=\"rc\" style=\"--p:35\" role=\"timer\" aria-label=\"35 seconds remaining\"></div><b>0:35</b></div>\n</body>\n</html>\n"
