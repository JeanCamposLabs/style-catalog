  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Confetti Burst</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"confetti-burst-click\",\n    \"title\": \"Confetti Burst\",\n    \"summary\": \"A burst of confetti fired from a button.\",\n    \"description\": \"A burst of confetti fired from a button.\",\n    \"theme\": \"particles-physics\",\n    \"categories\": [\"particles\", \"physics\"],\n    \"tags\": [\"particles\", \"motion\", \"confetti\", \"burst\", \"celebration\", \"click\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Particle fields are decorative and expensive — cap counts, pause when off-screen, and stop entirely under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--n\", \"description\": \"Pieces per burst\", \"default\": \"18\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Celebration moments. Randomise angle, distance, and rotation per piece, and remove nodes on animationend so repeated clicks do not accumulate DOM.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; display: inline-block; }\n    .fx button { padding: .8rem 1.8rem; border: 0; border-radius: 12px; background: #7c5cff; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }\n    .p { position: absolute; top: 50%; left: 50%; width: 8px; height: 12px; border-radius: 2px; pointer-events: none;\n      animation: fly .9s cubic-bezier(.2,.7,.4,1) forwards; }\n    @keyframes fly {\n      0% { transform: translate(0,0) rotate(0); opacity: 1; }\n      100% { transform: translate(var(--x), var(--y)) rotate(var(--r)); opacity: 0; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" id=\"cf\"><button type=\"button\">Celebrate</button></div>\n  <script>\n    (function () {\n      var host = document.getElementById(\"cf\"), cols = [\"#7c5cff\", \"#10a894\", \"#c2891a\", \"#d1478c\", \"#2f7cc9\"];\n      host.querySelector(\"button\").addEventListener(\"click\", function () {\n        for (var i = 0; i < 18; i++) {\n          var p = document.createElement(\"span\"), a = Math.random() * Math.PI * 2, r = 60 + Math.random() * 70;\n          p.className = \"p\";\n          p.style.background = cols[i % cols.length];\n          p.style.setProperty(\"--x\", Math.cos(a) * r + \"px\");\n          p.style.setProperty(\"--y\", Math.sin(a) * r + \"px\");\n          p.style.setProperty(\"--r\", Math.random() * 720 - 360 + \"deg\");\n          host.appendChild(p);\n          p.addEventListener(\"animationend\", function () { this.remove(); });\n        }\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
