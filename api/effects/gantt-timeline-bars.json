  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Gantt Bars</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"gantt-timeline-bars\",\n    \"title\": \"Gantt Bars\",\n    \"summary\": \"Overlapping task bars across a shared timeline.\",\n    \"description\": \"Overlapping task bars across a shared timeline.\",\n    \"theme\": \"charts-dataviz\",\n    \"categories\": [\"chart\", \"dataviz\"],\n    \"tags\": [\"chart\", \"data\", \"gantt\", \"timeline\", \"schedule\", \"project\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Identity is never colour-alone: every multi-series chart ships a legend, direct labels where they fit, and an equivalent table or accessible summary. Grid lines and axes stay recessive; values wear text colours, not series colours.\",\n    \"customization\": [\n      { \"name\": \"--c1\", \"description\": \"Track one\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--c2\", \"description\": \"Track two\", \"default\": \"#10a894\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"Project schedules. Colour by workstream (categorical, fixed order), not by status — status belongs in a separate icon or label so the two encodings do not collide.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { --c1: #7c5cff; --c2: #10a894; --c3: #c2891a; --c4: #d1478c; --c5: #2f7cc9;\n      --ink: #e7ebf3; --ink-2: #8b93a7; --grid: rgba(139,147,167,.22); --surface: #0b0d12; width: 300px; font-size: .78rem; }\n    .fx h4 { margin: 0 0 .8rem; font-size: .95rem; color: var(--ink); }\n    .fx .row { display: grid; grid-template-columns: 68px 1fr; align-items: center; gap: .6rem; margin-bottom: .5rem; color: var(--ink-2); }\n    .fx .track { position: relative; height: 16px; border-radius: 4px;\n      background: repeating-linear-gradient(90deg, var(--grid) 0 1px, transparent 1px 38px); }\n    .fx .track i { position: absolute; top: 2px; height: 12px; border-radius: 4px; left: calc(var(--s) * 1%); width: calc(var(--w) * 1%); }\n    .fx .axis { display: flex; justify-content: space-between; margin-top: .4rem; font-size: .68rem; color: var(--ink-2); }\n  </style>\n</head>\n<body>\n  <figure class=\"fx\" style=\"margin:0\"><h4>Release plan</h4>\n  <div class=\"row\"><span>Design</span><span class=\"track\"><i style=\"--s:0;--w:38;background:var(--c1)\"></i></span></div>\n  <div class=\"row\"><span>Build</span><span class=\"track\"><i style=\"--s:22;--w:52;background:var(--c2)\"></i></span></div>\n  <div class=\"row\"><span>QA</span><span class=\"track\"><i style=\"--s:58;--w:28;background:var(--c3)\"></i></span></div>\n  <div class=\"row\"><span>Launch</span><span class=\"track\"><i style=\"--s:82;--w:16;background:var(--c5)\"></i></span></div>\n  <div class=\"axis\"><span>W1</span><span>W3</span><span>W5</span><span>W7</span></div></figure>\n</body>\n</html>\n"
}
