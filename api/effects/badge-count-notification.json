   .wrap .n { position: absolute; top: -6px; right: -6px; min-width: 20px; height: 20px; padding: 0 5px;\n      border-radius: 999px; background: #f87171; color: #2a0a0a; font-size: .72rem; font-weight: 800;\n      display: grid; place-items: center; border: 2px solid #0b0d12; }\n  </style>\n</head>\n<body>\n  <span class=\"wrap\" aria-label=\"Notifications, 12 unread\"><span aria-hidden=\"true\">🔔</span><span class=\"n\" aria-hidden=\"true\">12</span></span>\n</body>\n</html>\n"
