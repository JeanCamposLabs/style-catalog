  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Zoom Cursor</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-zoom-hover-image\",\n    \"title\": \"Zoom Cursor\",\n    \"summary\": \"A zoom affordance over an expandable image.\",\n    \"description\": \"A zoom affordance over an expandable image.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"pointer\"],\n    \"tags\": [\"cursor\", \"pointer\", \"zoom\", \"image\", \"cursor\", \"lightbox\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Custom cursors are gated to fine pointers; touch and reduced-motion users keep the native cursor and full functionality.\",\n    \"customization\": [\n      { \"name\": \"--z\", \"description\": \"Zoom scale\", \"default\": \"1.2\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Image galleries. The native zoom-in and zoom-out cursors communicate the toggle for free — pair them with a real button so the interaction is not pointer-only.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 260px; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; cursor: zoom-in;\n      background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #c2891a); transition: transform .4s; }\n    .fx.zoomed { cursor: zoom-out; transform: scale(1.2); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" id=\"zi\" role=\"button\" tabindex=\"0\" aria-label=\"Zoom image\"></div>\n  <script>\n    (function () {\n      var el = document.getElementById(\"zi\");\n      function t() { el.classList.toggle(\"zoomed\"); }\n      el.addEventListener(\"click\", t);\n      el.addEventListener(\"keydown\", function (e) { if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); t(); } });\n    })();\n  </script>\n</body>\n</html>\n"
}
