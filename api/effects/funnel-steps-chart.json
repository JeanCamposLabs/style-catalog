  "path": "effects/charts-dataviz/funnel-steps-chart.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Funnel</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"funnel-steps-chart\",\n    \"title\": \"Funnel\",\n    \"summary\": \"Conversion stages with drop-off percentages.\",\n    \"description\": \"Conversion stages with drop-off percentages.\",\n    \"theme\": \"charts-dataviz\",\n    \"categories\": [\"chart\", \"dataviz\"],\n    \"tags\": [\"chart\", \"data\", \"funnel\", \"conversion\", \"stages\", \"dropoff\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Identity is never colour-alone: every multi-series chart ships a legend, direct labels where they fit, and an equivalent table or accessible summary. Grid lines and axes stay recessive; values wear text colours, not series colours.\",\n    \"customization\": [\n      { \"name\": \"--c1\", \"description\": \"Bar colour\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--c4\", \"description\": \"Drop-off colour\", \"default\": \"#d1478c\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"Sequential conversion. Use plain left-aligned bars rather than a tapering trapezoid — the trapezoid distorts area and makes the drop-off look larger than it is.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { --c1: #7c5cff; --c2: #10a894; --c3: #c2891a; --c4: #d1478c; --c5: #2f7cc9;\n      --ink: #e7ebf3; --ink-2: #8b93a7; --grid: rgba(139,147,167,.22); --surface: #0b0d12; width: 280px; }\n    .fx h4 { margin: 0 0 .9rem; font-size: .95rem; color: var(--ink); }\n    .fx .st { margin-bottom: .5rem; }\n    .fx .lbl { display: flex; justify-content: space-between; font-size: .78rem; color: var(--ink-2); margin-bottom: .25rem; }\n    .fx .lbl b { color: var(--ink); font-variant-numeric: tabular-nums; }\n    .fx .bar { height: 20px; border-radius: 4px; width: calc(var(--v) * 1%); background: var(--c1); }\n    .fx .drop { font-size: .7rem; color: var(--c4); margin-top: .15rem; }\n  </style>\n</head>\n<body>\n  <figure class=\"fx\" style=\"margin:0\"><h4>Signup funnel</h4>\n  <div class=\"st\"><div class=\"lbl\"><span>Visited</span><b>12,480</b></div><div class=\"bar\" style=\"--v:100\"></div></div>\n  <div class=\"st\"><div class=\"lbl\"><span>Started</span><b>6,120</b></div><div class=\"bar\" style=\"--v:49\"></div><div class=\"drop\">−51%</div></div>\n  <div class=\"st\"><div class=\"lbl\"><span>Verified</span><b>3,940</b></div><div class=\"bar\" style=\"--v:32\"></div><div class=\"drop\">−36%</div></div>\n  <div class=\"st\"><div class=\"lbl\"><span>Activated</span><b>2,180</b></div><div class=\"bar\" style=\"--v:17\"></div><div class=\"drop\">−45%</div></div></figure>\n</body>\n</html>\n"
}
