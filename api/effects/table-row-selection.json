  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Row Selection</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"table-row-selection\",\n    \"title\": \"Row Selection\",\n    \"summary\": \"Checkbox selection with a bulk-action bar.\",\n    \"description\": \"Checkbox selection with a bulk-action bar.\",\n    \"theme\": \"tables-data\",\n    \"categories\": [\"table\", \"data\"],\n    \"tags\": [\"table\", \"data\", \"selection\", \"checkbox\", \"bulk\", \"actions\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use real table markup with <th scope> and a <caption>; sortable headers need aria-sort, and row selection needs real checkboxes.\",\n    \"customization\": [\n      { \"name\": \"--sel\", \"description\": \"Selected tint\", \"default\": \"#171d33\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"Bulk-edit tables. The header checkbox needs an indeterminate state when only some rows are selected, and the action bar should announce the count via aria-live.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; border-radius: 12px; overflow: hidden; border: 1px solid #263149; }\n    .fx .bulk { display: flex; justify-content: space-between; align-items: center; padding: .5rem .8rem;\n      background: #1e1740; color: #cbd5e1; font-size: .78rem; }\n    .fx .bulk button { padding: .25rem .7rem; border: 0; border-radius: 7px; background: #7c5cff; color: #fff; font: inherit; font-size: .74rem; cursor: pointer; }\n    .fx table { width: 100%; border-collapse: collapse; font-size: .82rem; }\n    .fx th { background: #1c2437; color: #8b93a7; text-align: left; padding: .5rem .8rem; font-size: .68rem; text-transform: uppercase; }\n    .fx td { padding: .5rem .8rem; border-top: 1px solid #1e2740; color: #cbd5e1; }\n    .fx tr.on td { background: #171d33; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"bulk\"><span>2 selected</span><button type=\"button\">Export</button></div>\n  <table><caption class=\"sr\" style=\"position:absolute;left:-9999px\">Effects</caption>\n  <thead><tr><th scope=\"col\"><input type=\"checkbox\" aria-label=\"Select all\" /></th><th scope=\"col\">Effect</th><th scope=\"col\">Theme</th></tr></thead>\n  <tbody><tr class=\"on\"><td><input type=\"checkbox\" checked aria-label=\"Select Ripple Button\" /></td><td>Ripple Button</td><td>Buttons</td></tr>\n  <tr class=\"on\"><td><input type=\"checkbox\" checked aria-label=\"Select Aurora\" /></td><td>Aurora</td><td>Backgrounds</td></tr>\n  <tr><td><input type=\"checkbox\" aria-label=\"Select Tilt Card\" /></td><td>Tilt Card</td><td>Hover</td></tr></tbody></table></div>\n</body>\n</html>\n"
