  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Boot Sequence</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"terminal-matrix-boot\",\n    \"title\": \"Boot Sequence\",\n    \"summary\": \"System boot lines appearing with status flags.\",\n    \"description\": \"System boot lines appearing with status flags.\",\n    \"theme\": \"terminal-cli\",\n    \"categories\": [\"terminal\", \"code\"],\n    \"tags\": [\"terminal\", \"monospace\", \"boot\", \"sequence\", \"status\", \"stagger\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Terminal output should live in a real text element (not an image) so it can be selected, searched, and read aloud.\",\n    \"customization\": [\n      { \"name\": \"--step\", \"description\": \"Line interval\", \"default\": \"0.35s\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Loading screens with personality. Stagger the lines but keep the total under ~2s; a boot sequence that outlasts the actual load is theatre at the user's expense.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; padding: .9rem; border-radius: 8px; background: #05070d; border: 1px solid #14532d;\n      font-family: ui-monospace, monospace; font-size: .72rem; line-height: 1.9; color: #86efac; }\n    .fx div { display: flex; justify-content: space-between; opacity: 0; animation: in .25s forwards;\n      animation-delay: calc(var(--i) * .35s); }\n    .fx b { color: #4ade80; }\n    @keyframes in { to { opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) {\n      .fx div { animation: none; opacity: 1; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"log\">\n    <div style=\"--i:0\">mounting filesystem<b>[ OK ]</b></div><div style=\"--i:1\">loading catalog<b>[ OK ]</b></div>\n    <div style=\"--i:2\">indexing effects<b>[ OK ]</b></div><div style=\"--i:3\">starting server<b>[ OK ]</b></div>\n  </div>\n</body>\n</html>\n"
