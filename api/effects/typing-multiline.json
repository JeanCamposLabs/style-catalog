  "path": "effects/text-effects/typing-multiline.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Multiline Typewriter</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"typing-multiline\",\n    \"title\": \"Multiline Typewriter\",\n    \"summary\": \"Several lines type out in turn, with a caret that hands off between them.\",\n    \"description\": \"Each line has its own steps() width animation and delay; the caret border only shows on the line currently typing.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"animation\"],\n    \"tags\": [\"typewriter\", \"multiline\", \"steps\", \"caret\", \"terminal\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Caret color\", \"default\": \"#34d399\" },\n      { \"name\": \"--speed\", \"description\": \"Seconds per line\", \"default\": \"2s\" }\n    ],\n    \"variations\": [\"Loop the whole block\", \"Delete a line before the next\", \"Randomize the per-character speed with JS\"],\n    \"ai_usage\": \"Terminal and hero copy. Each line needs width in ch units matching its character count and steps(<chars>) timing — mismatched values cause the caret to drift ahead of the text. Fixed-width fonts only.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --c: #34d399; --speed: 2s; }\n    .tw { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 1.05rem; color: #cbd5e1; }\n    .tw p { margin: .2rem 0; overflow: hidden; white-space: nowrap; width: 0;\n      border-right: 2px solid transparent; animation: type var(--speed) steps(var(--n)) forwards, caret .8s step-end infinite; }\n    .tw p:nth-child(1) { animation-delay: 0s, 0s; }\n    .tw p:nth-child(2) { animation-delay: var(--speed), var(--speed); }\n    .tw p:nth-child(3) { animation-delay: calc(var(--speed) * 2), calc(var(--speed) * 2); }\n    @keyframes type { to { width: calc(var(--n) * 1ch); } }\n    @keyframes caret { 0%, 100% { border-color: transparent; } 50% { border-color: var(--c); } }\n    @media (prefers-reduced-motion: reduce) {\n      .tw p { animation: none; width: auto; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"tw\">\n    <p style=\"--n:22\">$ npm run build --ok</p>\n    <p style=\"--n:26\">> scanning effects/ ...</p>\n    <p style=\"--n:24\">> 1181 effects, 0 errors</p>\n  </div>\n</body>\n</html>\n"
}
