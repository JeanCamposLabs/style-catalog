      "name": "PALETTE",
      "description": "The tokens to cross-check — swap in your own name/hex pairs",
      "default": "6 tokens"
    },
    {
      "name": "thresholds",
      "description": "WCAG 2.1 cutoffs: 7 = AAA, 4.5 = AA, 3 = AA Large (18pt+/14pt bold) and non-text UI",
      "default": "7 / 4.5 / 3"
    }
  ],
  "variations": [
    "Restrict rows to text tokens and columns to surface tokens — the pairs you would actually ship",
