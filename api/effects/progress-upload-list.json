  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Upload Queue</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"progress-upload-list\",\n    \"title\": \"Upload Queue\",\n    \"summary\": \"Multiple files each with their own progress row.\",\n    \"description\": \"Multiple files each with their own progress row.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"upload\", \"queue\", \"files\", \"multiple\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Bar colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Batch uploads. Give each row its own progressbar role and keep an aggregate summary — a single combined bar hides which file is stuck.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .q { width: 300px; display: grid; gap: 10px; }\n    .q .row { background: #151b2a; border: 1px solid #263149; border-radius: 12px; padding: .7rem .9rem; }\n    .q .top { display: flex; justify-content: space-between; font-size: .85rem; color: #cbd5e1; margin-bottom: .5rem; }\n    .q .pct { color: #8b93a7; font-size: .78rem; }\n    .q .bar { height: 5px; border-radius: 99px; background: #22304a; overflow: hidden; }\n    .q .bar i { display: block; height: 100%; background: #7c5cff; width: calc(var(--p) * 1%); }\n    .q .done .bar i { background: #34d399; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"q\">\n    <div class=\"row done\" style=\"--p:100\"><div class=\"top\"><span>brief.pdf</span><span class=\"pct\">Done</span></div><div class=\"bar\"><i></i></div></div>\n    <div class=\"row\" style=\"--p:64\"><div class=\"top\"><span>hero.mp4</span><span class=\"pct\">64%</span></div><div class=\"bar\"><i></i></div></div>\n    <div class=\"row\" style=\"--p:18\"><div class=\"top\"><span>assets.zip</span><span class=\"pct\">18%</span></div><div class=\"bar\"><i></i></div></div>\n  </div>\n</body>\n</html>\n"
}
