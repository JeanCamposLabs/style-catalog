  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Art Deco Fans</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"art-deco-fan\",\n    \"title\": \"Art Deco Fans\",\n    \"summary\": \"Repeating fan arcs in gold.\",\n    \"description\": \"Repeating fan arcs in gold. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"art-deco\", \"fan\", \"gatsby\", \"luxury\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Arc colour\", \"default\": \"rgba(251,191,36,.4)\" },\n      { \"name\": \"--s\", \"description\": \"Fan size\", \"default\": \"60px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"1920s and luxury themes. Anchor the radial gradient at a tile corner so each tile shows a quarter fan.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(251,191,36,.4); --s: 60px; }\n    .bg { background-color: #12101c;\n      background-image: repeating-radial-gradient(circle at 0 100%, transparent 0 14px, var(--c) 14px 16px, transparent 16px 30px);\n      background-size: var(--s) var(--s); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
