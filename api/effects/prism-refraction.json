#fff; }\n    .fx .prism { position: absolute; top: 26px; left: 104px; width: 0; height: 0;\n      border-left: 26px solid transparent; border-right: 26px solid transparent; border-bottom: 48px solid rgba(255,255,255,.18); }\n    .fx .spec { position: absolute; top: 56px; left: 150px; width: 110px; height: 44px;\n      background: linear-gradient(180deg, #ef4444, #f59e0b, #eab308, #22c55e, #3b82f6, #a855f7);\n      clip-path: polygon(0 40%, 100% 0, 100% 100%, 0 60%); filter: blur(1px); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"beam\"></span><span class=\"prism\"></span><span class=\"spec\"></span></div>\n</body>\n</html>\n"
