  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Mini Progress Badge</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"badge-progress-ring-mini\",\n    \"title\": \"Mini Progress Badge\",\n    \"summary\": \"A tiny ring showing completion next to a label.\",\n    \"description\": \"A tiny ring showing completion next to a label. Small self-contained component ready to drop into a list or card.\",\n    \"theme\": \"badges-tags\",\n    \"categories\": [\"badge\", \"label\"],\n    \"tags\": [\"badge\", \"label\", \"progress\", \"ring\", \"conic\", \"compact\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Status must never be colour-only: pair every badge colour with a label, icon, or shape.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Percent complete\", \"default\": \"70\" }\n    ],\n    \"variations\": [\"Add a size variant\", \"Map colours to semantic tokens\"],\n    \"ai_usage\": \"Compact completion indicators in lists. One conic-gradient plus an inner disc is the smallest possible progress ring — no SVG needed.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .b { display: inline-flex; align-items: center; gap: .5rem; padding: .3rem .8rem .3rem .35rem; border-radius: 999px;\n      background: #1c2437; color: #cbd5e1; font-size: .8rem; font-weight: 600; }\n    .b .ring { width: 22px; height: 22px; border-radius: 50%;\n      background: conic-gradient(#34d399 calc(var(--p) * 1%), #2b3450 0); display: grid; place-items: center; }\n    .b .ring::after { content: \"\"; width: 14px; height: 14px; border-radius: 50%; background: #1c2437; }\n  </style>\n</head>\n<body>\n  <span class=\"b\"><span class=\"ring\" style=\"--p:70\" aria-hidden=\"true\"></span>70% complete</span>\n</body>\n</html>\n"
