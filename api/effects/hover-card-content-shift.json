  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Content Shift Card</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hover-card-content-shift\",\n    \"title\": \"Content Shift Card\",\n    \"summary\": \"Body copy sliding up to make room for actions.\",\n    \"description\": \"Body copy sliding up to make room for actions.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"interaction\"],\n    \"tags\": [\"hover\", \"pointer\", \"shift\", \"actions\", \"reveal\", \"card\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover state here is mirrored on :focus-visible so keyboard users get the same information.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Shift duration\", \"default\": \"0.35s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Card grids with secondary actions. Move existing content up rather than growing the card so the grid never reflows on hover.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .card { position: relative; width: 240px; height: 150px; border-radius: 16px; overflow: hidden; padding: 1.2rem;\n      background: #151b2a; border: 1px solid #263149; }\n    .card .body { transition: transform .35s cubic-bezier(.7,0,.2,1); }\n    .card h3 { margin: 0 0 .3rem; font-size: 1rem; }\n    .card p { margin: 0; color: #8b93a7; font-size: .85rem; }\n    .card .acts { position: absolute; inset: auto 1.2rem 1.2rem; display: flex; gap: .5rem; opacity: 0;\n      transform: translateY(12px); transition: opacity .3s, transform .3s; }\n    .card button { padding: .4rem .9rem; border: 0; border-radius: 8px; background: #7c5cff; color: #fff; font: inherit; font-size: .8rem; cursor: pointer; }\n    .card:hover .body, .card:focus-within .body { transform: translateY(-16px); }\n    .card:hover .acts, .card:focus-within .acts { opacity: 1; transform: none; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <article class=\"card\" tabindex=\"0\"><div class=\"body\"><h3>Aurora</h3><p>Animated gradient backdrop.</p></div>\n  <div class=\"acts\"><button type=\"button\">Open</button><button type=\"button\">Copy</button></div></article>\n</body>\n</html>\n"
