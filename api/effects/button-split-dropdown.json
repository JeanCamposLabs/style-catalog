  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Split Button</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"button-split-dropdown\",\n    \"title\": \"Split Button\",\n    \"summary\": \"A primary action with an attached menu trigger.\",\n    \"description\": \"A primary action with an attached menu trigger.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"action\"],\n    \"tags\": [\"button\", \"action\", \"split\", \"dropdown\", \"primary\", \"menu\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>, keep a visible :focus-visible ring, and never signal state with colour alone.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Button colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Actions with variants (Save / Save as). Both halves must be separate buttons with their own labels; a single button with a click-position check is unusable by keyboard.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: inline-flex; border-radius: 11px; overflow: hidden; }\n    .fx button { border: 0; background: #7c5cff; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }\n    .fx .main { padding: .7rem 1.2rem; }\n    .fx .arrow { padding: .7rem .8rem; border-left: 1px solid rgba(255,255,255,.25); }\n    .fx button:hover { background: #6544e0; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><button class=\"main\" type=\"button\">Publish</button>\n  <button class=\"arrow\" type=\"button\" aria-haspopup=\"menu\" aria-expanded=\"false\" aria-label=\"More publish options\">▾</button></div>\n</body>\n</html>\n"
