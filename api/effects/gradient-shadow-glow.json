  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Gradient Drop Shadow</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"gradient-shadow-glow\",\n    \"title\": \"Gradient Drop Shadow\",\n    \"summary\": \"A blurred copy of the element's gradient acts as its shadow.\",\n    \"description\": \"A duplicate layer behind the card, blurred and slightly scaled, tints the shadow with the surface's own colours.\",\n    \"theme\": \"borders-shadows\",\n    \"categories\": [\"shadow\"],\n    \"tags\": [\"gradient\", \"glow\", \"shadow\", \"color\", \"hero\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative edge treatment — never encode meaning in the border colour alone. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--blur\", \"description\": \"Shadow blur\", \"default\": \"28px\" },\n      { \"name\": \"--drop\", \"description\": \"Shadow offset\", \"default\": \"18px\" }\n    ],\n    \"variations\": [\"Stronger drop for a floating feel\", \"Match the shadow to the dominant colour only\", \"Animate on hover\"],\n    \"ai_usage\": \"Colourful cards and CTAs. Reuse the same gradient on a blurred pseudo-element rather than guessing a shadow colour — the tint always matches, even when the gradient changes.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; padding: 1.6rem; color: #e7ebf3; }\n    .demo h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .demo p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    :root { --blur: 28px; --drop: 18px; }\n    .wrap { position: relative; }\n    .wrap::before { content: \"\"; position: absolute; inset: 0; border-radius: 18px; transform: translateY(var(--drop)) scale(.92);\n      background: linear-gradient(135deg, #7c5cff, #2dd4bf); filter: blur(var(--blur)); opacity: .8; }\n    .demo { position: relative; border-radius: 18px; background: linear-gradient(135deg, #7c5cff, #2dd4bf); color: #0b0d12; }\n    .demo p { color: rgba(11,13,18,.7); }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\"><div class=\"demo\"><h3>Gradient shadow</h3><p>The shadow borrows the surface colours.</p></div></div>\n</body>\n</html>\n"
