content: \"\"; position: absolute; inset: 0;\n      background: repeating-linear-gradient(180deg, rgba(34,211,238,.09) 0 1px, transparent 1px 3px); }\n    .fx::after { content: \"\"; position: absolute; left: 0; right: 0; height: 40px;\n      background: linear-gradient(180deg, transparent, rgba(34,211,238,.16), transparent); animation: roll 4s linear infinite; }\n    @keyframes roll { from { top: -40px; } to { top: 100%; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"></div>\n</body>\n</html>\n"
