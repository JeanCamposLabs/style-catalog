  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Side Drawer</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"modal-side-drawer\",\n    \"title\": \"Side Drawer\",\n    \"summary\": \"A panel that slides in from the right over a dimmed page.\",\n    \"description\": \"A panel that slides in from the right over a dimmed page.\",\n    \"theme\": \"modals-overlays\",\n    \"categories\": [\"modal\", \"overlay\"],\n    \"tags\": [\"modal\", \"dialog\", \"drawer\", \"side\", \"panel\", \"navigation\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"A modal must trap focus, close on Escape, return focus to its trigger, and mark the page behind it inert. The <dialog> element gives most of this for free.\",\n    \"customization\": [\n      { \"name\": \"--w\", \"description\": \"Drawer width\", \"default\": \"210px\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Filters, settings, and mobile navigation. Animate transform, not width or right — layout-driven drawers stutter on low-end devices.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .stage { position: relative; width: 330px; height: 250px; border-radius: 18px; overflow: hidden; background: #10141f; border: 1px solid #263149; }\n    .stage .content { padding: 1.2rem; color: #8b93a7; font-size: .9rem; }\n    .scrim { position: absolute; inset: 0; background: rgba(4,7,14,.6); opacity: 0; transition: opacity .3s; }\n    .drawer { position: absolute; top: 0; bottom: 0; right: 0; width: 210px; padding: 1.1rem; background: #1a2130;\n      transform: translateX(100%); transition: transform .32s cubic-bezier(.7,0,.2,1); }\n    .stage.is-open .drawer { transform: none; }\n    .stage.is-open .scrim { opacity: 1; }\n    .drawer h3 { margin: 0 0 .6rem; font-size: 1rem; }\n    .drawer a { display: block; padding: .45rem 0; color: #cbd5e1; text-decoration: none; font-size: .9rem; }\n    button { padding: .5rem 1rem; border-radius: 9px; border: 0; background: #7c5cff; color: #fff; font: inherit; cursor: pointer; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stage is-open\" id=\"dr\"><div class=\"content\">Slide-in panel.<br><br><button type=\"button\" id=\"tgd\">Toggle</button></div>\n  <div class=\"scrim\"></div><nav class=\"drawer\" aria-label=\"Filters\"><h3>Filters</h3><a href=\"#\">Recent</a><a href=\"#\">Starred</a><a href=\"#\">Shared</a><a href=\"#\">Archived</a></nav></div>\n  <script>\n    (function () {\n      var d = document.getElementById(\"dr\");\n      document.getElementById(\"tgd\").addEventListener(\"click\", function () { d.classList.toggle(\"is-open\"); });\n    })();\n  </script>\n</body>\n</html>\n"
}
