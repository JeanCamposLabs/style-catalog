  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Health Bar</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"health-bar-segmented\",\n    \"title\": \"Health Bar\",\n    \"summary\": \"A segmented health bar that shifts colour as it drains.\",\n    \"description\": \"A segmented health bar that shifts colour as it drains.\",\n    \"theme\": \"game-ui\",\n    \"categories\": [\"game\", \"ui\"],\n    \"tags\": [\"game\", \"hud\", \"health\", \"hp\", \"bar\", \"rpg\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Game HUDs still need real semantics: use progressbar roles for meters and buttons for slots so the interface is operable without sight.\",\n    \"customization\": [\n      { \"name\": \"--hp\", \"description\": \"Health percent\", \"default\": \"72\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"RPG and action HUDs. Change hue at thresholds and add a pulse only in the critical band — constant animation stops the warning from meaning anything.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 260px; }\n    .fx .bar { height: 18px; border: 2px solid #0b0d12; border-radius: 4px; background: #1f2937; overflow: hidden; position: relative; }\n    .fx .fill { height: 100%; width: calc(var(--hp) * 1%); background: linear-gradient(180deg, #4ade80, #16a34a); transition: width .3s; }\n    .fx.low .fill { background: linear-gradient(180deg, #fbbf24, #d97706); }\n    .fx.crit .fill { background: linear-gradient(180deg, #f87171, #dc2626); animation: pulse .6s ease-in-out infinite alternate; }\n    .fx .ticks { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, transparent 0 25px, rgba(0,0,0,.5) 25px 27px); }\n    .fx .lbl { margin-top: .4rem; font-family: ui-monospace, monospace; font-size: .78rem; color: #8b93a7; }\n    @keyframes pulse { to { filter: brightness(1.35); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" style=\"--hp:72\"><div class=\"bar\" role=\"progressbar\" aria-valuenow=\"72\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"Health\">\n    <div class=\"fill\"></div><div class=\"ticks\"></div></div><div class=\"lbl\">HP 72 / 100</div></div>\n</body>\n</html>\n"
}
