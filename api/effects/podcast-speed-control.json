  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Playback Speed</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"podcast-speed-control\",\n    \"title\": \"Playback Speed\",\n    \"summary\": \"A speed selector with the current rate highlighted.\",\n    \"description\": \"A speed selector with the current rate highlighted.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"speed\", \"playback\", \"rate\", \"podcast\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Active colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Podcast players. Offer a small fixed set of rates rather than a slider — precise values are what listeners actually want to return to.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: inline-flex; padding: 4px; border-radius: 999px; background: #151b2a; border: 1px solid #263149; }\n    .fx button { padding: .35rem .8rem; border: 0; border-radius: 999px; background: transparent; color: #8b93a7;\n      font: inherit; font-size: .8rem; font-weight: 700; cursor: pointer; }\n    .fx button[aria-pressed=\"true\"] { background: #7c5cff; color: #fff; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"group\" aria-label=\"Playback speed\">\n    <button type=\"button\" aria-pressed=\"false\">0.75×</button><button type=\"button\" aria-pressed=\"true\">1×</button>\n    <button type=\"button\" aria-pressed=\"false\">1.5×</button><button type=\"button\" aria-pressed=\"false\">2×</button></div>\n</body>\n</html>\n"
