  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Checkout Steps</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"checkout-steps-bar\",\n    \"title\": \"Checkout Steps\",\n    \"summary\": \"A three-step checkout indicator with a completed state.\",\n    \"description\": \"A three-step checkout indicator with a completed state.\",\n    \"theme\": \"ecommerce-ui\",\n    \"categories\": [\"ecommerce\", \"commerce\"],\n    \"tags\": [\"ecommerce\", \"shop\", \"checkout\", \"steps\", \"progress\", \"flow\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Price, stock, and discount information must be in text, never only a colour or a badge shape.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Active colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Multi-step checkout. Mark the active step with aria-current=step and never let users lose entered data by navigating back.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; width: 300px; }\n    .st { display: grid; justify-items: center; gap: .35rem; font-size: .74rem; color: #8b93a7; }\n    .st .d { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 800;\n      background: #1c2437; border: 2px solid #2b3450; }\n    .st.done .d { background: #34d399; border-color: #34d399; color: #052e2b; }\n    .st.now .d { border-color: #7c5cff; color: #b9a5ff; }\n    .st.now { color: #e7ebf3; }\n    .ln { flex: 1; height: 2px; background: #2b3450; margin: 0 .3rem 1.1rem; }\n    .ln.done { background: #34d399; }\n  </style>\n</head>\n<body>\n  <ol class=\"fx\" style=\"list-style:none;margin:0;padding:0\"><li class=\"st done\"><span class=\"d\">✓</span>Cart</li>\n  <li class=\"ln done\" aria-hidden=\"true\"></li><li class=\"st now\" aria-current=\"step\"><span class=\"d\">2</span>Delivery</li>\n  <li class=\"ln\" aria-hidden=\"true\"></li><li class=\"st\"><span class=\"d\">3</span>Payment</li></ol>\n</body>\n</html>\n"
