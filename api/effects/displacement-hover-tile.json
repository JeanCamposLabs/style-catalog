  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Distort on Hover</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"displacement-hover-tile\",\n    \"title\": \"Distort on Hover\",\n    \"summary\": \"A tile that warps while the pointer is over it.\",\n    \"description\": \"A tile that warps while the pointer is over it.\",\n    \"theme\": \"glitch-distortion\",\n    \"categories\": [\"glitch\", \"distortion\"],\n    \"tags\": [\"glitch\", \"distortion\", \"hover\", \"displacement\", \"warp\", \"interactive\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Rapid flicker and high-contrast tearing can trigger discomfort — keep glitches brief and honour prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--scale\", \"description\": \"Warp strength\", \"default\": \"24\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Adjust the loop duration\"],\n    \"ai_usage\": \"Interactive gallery tiles. Apply the SVG filter only on hover — leaving a displacement filter permanently active forces a repaint of the layer on every frame.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 200px; height: 140px; border-radius: 12px; transition: filter .3s;\n      background: conic-gradient(from 90deg at 40% 40%, #f472b6, #fbbf24, #22d3ee, #f472b6); }\n    .fx:hover { filter: url(#dist); }\n    svg.defs { position: absolute; width: 0; height: 0; }\n  </style>\n</head>\n<body>\n  <svg class=\"defs\" aria-hidden=\"true\"><filter id=\"dist\">\n    <feTurbulence type=\"turbulence\" baseFrequency=\"0.04\" numOctaves=\"2\" result=\"n\"/>\n    <feDisplacementMap in=\"SourceGraphic\" in2=\"n\" scale=\"24\"/>\n  </filter></svg>\n  <div class=\"fx\"></div>\n</body>\n</html>\n"
