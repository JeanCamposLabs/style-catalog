  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Numeric Features</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"type-numeric-features\",\n    \"title\": \"Numeric Features\",\n    \"summary\": \"Tabular, lining, and old-style figures compared.\",\n    \"description\": \"Tabular, lining, and old-style figures compared.\",\n    \"theme\": \"typography-systems\",\n    \"categories\": [\"typography\", \"reference\"],\n    \"tags\": [\"typography\", \"type\", \"numerals\", \"tabular-nums\", \"opentype\", \"figures\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Type systems must survive user font-size settings: size in rem, never lock line-height in px, and keep the measure under 75 characters.\",\n    \"customization\": [\n      { \"name\": \"--feat\", \"description\": \"Numeric feature\", \"default\": \"tabular-nums\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Tables, timers, and prices. tabular-nums gives every digit the same advance width so columns align and counters stop jittering; use proportional figures in running prose.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; display: grid; gap: .7rem; font-size: .95rem; }\n    .fx .r { display: flex; justify-content: space-between; padding: .4rem .6rem; border-radius: 8px; background: #151b2a; }\n    .fx .lbl { color: #64748b; font-size: .72rem; font-family: ui-monospace, monospace; }\n    .tab { font-variant-numeric: tabular-nums; }\n    .prop { font-variant-numeric: proportional-nums; }\n    .slash { font-variant-numeric: slashed-zero; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"r\"><span class=\"lbl\">tabular</span><span class=\"tab\">1,181.00</span></div>\n  <div class=\"r\"><span class=\"lbl\">tabular</span><span class=\"tab\">99,411.24</span></div>\n  <div class=\"r\"><span class=\"lbl\">proportional</span><span class=\"prop\">1,181.00</span></div>\n  <div class=\"r\"><span class=\"lbl\">slashed zero</span><span class=\"slash\">0O0O</span></div></div>\n</body>\n</html>\n"
