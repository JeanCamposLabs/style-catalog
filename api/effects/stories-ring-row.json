  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Stories Row</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"stories-ring-row\",\n    \"title\": \"Stories Row\",\n    \"summary\": \"Avatar rings marking unseen stories.\",\n    \"description\": \"Avatar rings marking unseen stories.\",\n    \"theme\": \"social-ui\",\n    \"categories\": [\"social\", \"feed\"],\n    \"tags\": [\"social\", \"community\", \"stories\", \"ring\", \"avatar\", \"unseen\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Reaction counts and follow state need accessible names that change with state, and threads need real heading or list structure.\",\n    \"customization\": [\n      { \"name\": \"--ring\", \"description\": \"Unseen ring\", \"default\": \"conic-gradient(#f472b6,#fbbf24,#7c5cff)\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Story rails. The gradient ring means unseen; make that state textual too ('New story from Ada') for non-visual users.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 12px; }\n    .s { display: grid; justify-items: center; gap: .35rem; font-size: .7rem; color: #8b93a7; }\n    .s .ring { width: 62px; height: 62px; border-radius: 50%; padding: 3px;\n      background: conic-gradient(#f472b6, #fbbf24, #7c5cff, #f472b6); }\n    .s.seen .ring { background: #2b3450; }\n    .s .av { width: 100%; height: 100%; border-radius: 50%; border: 2px solid #0b0d12; display: grid; place-items: center;\n      font-weight: 800; color: #0b0d12; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"s\"><div class=\"ring\"><div class=\"av\" style=\"background:#7c5cff\">A</div></div>ada</div>\n  <div class=\"s\"><div class=\"ring\"><div class=\"av\" style=\"background:#2dd4bf\">J</div></div>jean</div>\n  <div class=\"s seen\"><div class=\"ring\"><div class=\"av\" style=\"background:#fbbf24\">M</div></div>max</div></div>\n</body>\n</html>\n"
