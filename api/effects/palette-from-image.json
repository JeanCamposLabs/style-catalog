#d1478c, #7c5cff); }\n    .fx .row { display: flex; gap: 6px; margin-top: 8px; }\n    .fx .row i { flex: 1; height: 40px; border-radius: 8px; }\n    .fx p { margin: .5rem 0 0; font-size: .76rem; color: #8b93a7; line-height: 1.5; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"img\"></div><div class=\"row\"><i style=\"background:#7c5cff\"></i><i style=\"background:#2dd4bf\"></i>\n  <i style=\"background:#c2891a\"></i><i style=\"background:#d1478c\"></i><i style=\"background:#1a1140\"></i></div>\n  <p>Extracted swatches snapped to the nearest passing ramp step.</p></div>\n</body>\n</html>\n"
