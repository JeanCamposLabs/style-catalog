  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Avatar Shapes</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"avatar-squircle-shapes\",\n    \"title\": \"Avatar Shapes\",\n    \"summary\": \"Circle, squircle, and rounded-square variants.\",\n    \"description\": \"Circle, squircle, and rounded-square variants.\",\n    \"theme\": \"avatars-identity\",\n    \"categories\": [\"avatar\", \"identity\"],\n    \"tags\": [\"avatar\", \"identity\", \"shapes\", \"squircle\", \"circle\", \"variants\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"An avatar is decorative when the name is beside it (use empty alt); when it stands alone it must carry the person's name as its accessible label.\",\n    \"customization\": [\n      { \"name\": \"--r\", \"description\": \"Rounded radius\", \"default\": \"16px\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Brand-level choice. Pick one shape and use it everywhere; mixed avatar shapes in one product read as an unfinished design system.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 12px; }\n    .a { width: 60px; height: 60px; background: linear-gradient(150deg, #7c5cff, #2dd4bf); display: grid;\n      place-items: center; font-weight: 800; color: #0b0d12; }\n    .circle { border-radius: 50%; }\n    .squircle { clip-path: path(\"M30 0 C48 0 60 12 60 30 C60 48 48 60 30 60 C12 60 0 48 0 30 C0 12 12 0 30 0 Z\"); }\n    .rounded { border-radius: 16px; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"a circle\" role=\"img\" aria-label=\"Circle avatar\">JC</span>\n  <span class=\"a squircle\" role=\"img\" aria-label=\"Squircle avatar\">JC</span>\n  <span class=\"a rounded\" role=\"img\" aria-label=\"Rounded square avatar\">JC</span></div>\n</body>\n</html>\n"
