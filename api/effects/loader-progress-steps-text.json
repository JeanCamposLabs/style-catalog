  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Step Status Loader</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"loader-progress-steps-text\",\n    \"title\": \"Step Status Loader\",\n    \"summary\": \"A spinner with a changing status line.\",\n    \"description\": \"A spinner with a changing status line.\",\n    \"theme\": \"loaders-spinners\",\n    \"categories\": [\"loader\", \"spinner\"],\n    \"tags\": [\"loader\", \"waiting\", \"status\", \"steps\", \"text\", \"progress\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Pair every indicator with a visually-hidden aria-live status; motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Spinner colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Multi-stage operations. Naming the current stage turns an opaque wait into a legible one — update the text through an aria-live region so the change is announced.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: .8rem; width: 280px; padding: .9rem 1rem; border-radius: 12px;\n      background: #151b2a; border: 1px solid #263149; }\n    .fx .sp { width: 20px; height: 20px; border: 3px solid #22304a; border-top-color: #7c5cff; border-radius: 50%;\n      animation: spin .9s linear infinite; flex: none; }\n    .fx .txt { font-size: .85rem; color: #cbd5e1; }\n    .fx .sub { display: block; font-size: .74rem; color: #64748b; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\"><span class=\"sp\" aria-hidden=\"true\"></span>\n  <span class=\"txt\">Building catalogue<span class=\"sub\">Step 2 of 4 · validating specimens</span></span></div>\n</body>\n</html>\n"
