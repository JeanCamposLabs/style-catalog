  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Brick Wall</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"brick-wall-bg\",\n    \"title\": \"Brick Wall\",\n    \"summary\": \"Staggered brick courses with mortar gaps.\",\n    \"description\": \"Two identical brick layers offset by half a brick and half a course produce the running bond a single layer cannot.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"texture\"],\n    \"tags\": [\"brick\", \"wall\", \"masonry\", \"texture\", \"offset\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--brick\", \"description\": \"Brick colour\", \"default\": \"#3a2320\" },\n      { \"name\": \"--mortar\", \"description\": \"Mortar colour\", \"default\": \"#1a1614\" },\n      { \"name\": \"--w\", \"description\": \"Brick width\", \"default\": \"64px\" },\n      { \"name\": \"--h\", \"description\": \"Course height\", \"default\": \"30px\" }\n    ],\n    \"variations\": [\"Whitewashed brick\", \"Vary brick tones per row\", \"Add grain for texture\"],\n    \"ai_usage\": \"Industrial, cafe, and loft aesthetics. The running bond comes from a second gradient pair offset by half the brick width and half the course height — without that offset the wall reads as a plain grid.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --brick: #3a2320; --mortar: #1a1614; --w: 64px; --h: 30px; }\n    .bg { background-color: var(--mortar);\n      background-image: linear-gradient(var(--brick) 0 calc(var(--h) - 3px), transparent calc(var(--h) - 3px)),\n        linear-gradient(90deg, transparent 0 3px, var(--brick) 3px);\n      background-size: var(--w) var(--h), var(--w) var(--h);\n      background-blend-mode: multiply; }\n    .bg::after { content: \"\"; position: absolute; inset: 0;\n      background-image: linear-gradient(var(--brick) 0 calc(var(--h) - 3px), transparent calc(var(--h) - 3px)),\n        linear-gradient(90deg, transparent 0 3px, var(--brick) 3px);\n      background-size: var(--w) var(--h), var(--w) var(--h);\n      background-position: calc(var(--w) / 2) var(--h), calc(var(--w) / 2) var(--h);\n      background-blend-mode: multiply; }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
