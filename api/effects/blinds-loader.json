  "ai_usage": "Use as a panel-level loading cover rather than an inline spinner — it fills a rectangle nicely. Give the container perspective so the slats have depth; without it, rotateY just squashes their width.",
  "path": "effects/loaders-spinners/blinds-loader.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Venetian Blinds</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"blinds-loader\",\n    \"title\": \"Venetian Blinds\",\n    \"summary\": \"Vertical slats flip closed and open like window blinds.\",\n    \"description\": \"Each slat animates rotateY through 180° with a staggered delay, so light appears to sweep across the panel.\",\n    \"theme\": \"loaders-spinners\",\n    \"categories\": [\"loader\", \"3d\"],\n    \"tags\": [\"blinds\", \"slats\", \"rotateY\", \"stagger\", \"panel\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative status indicator — pair it with a visually-hidden aria-live message so screen readers announce the wait. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Slat color\", \"default\": \"#60a5fa\" },\n      { \"name\": \"--dur\", \"description\": \"Sweep\", \"default\": \"1.8s\" }\n    ],\n    \"variations\": [\"Horizontal slats via rotateX\", \"Alternate slat colors\", \"Freeze mid-sweep as a hover state\"],\n    \"ai_usage\": \"Use as a panel-level loading cover rather than an inline spinner — it fills a rectangle nicely. Give the container perspective so the slats have depth; without it, rotateY just squashes their width.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --c: #60a5fa; --dur: 1.8s; }\n    .blinds { display: flex; gap: 4px; perspective: 400px; }\n    .blinds i { width: 14px; height: 64px; border-radius: 3px; background: linear-gradient(180deg, var(--c), color-mix(in srgb, var(--c) 55%, #000));\n      animation: slat var(--dur) ease-in-out infinite; animation-delay: calc(var(--i) * .1s); }\n    @keyframes slat { 0%, 100% { transform: rotateY(0deg); } 50% { transform: rotateY(180deg); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"blinds\" role=\"status\" aria-label=\"Loading\">\n    <i style=\"--i:0\"></i><i style=\"--i:1\"></i><i style=\"--i:2\"></i><i style=\"--i:3\"></i><i style=\"--i:4\"></i><i style=\"--i:5\"></i>\n  </div>\n</body>\n</html>\n"
}
