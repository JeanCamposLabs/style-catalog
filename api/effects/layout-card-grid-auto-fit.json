  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Auto-Fit Card Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"layout-card-grid-auto-fit\",\n    \"title\": \"Auto-Fit Card Grid\",\n    \"summary\": \"Cards that reflow without media queries.\",\n    \"description\": \"Cards that reflow without media queries.\",\n    \"theme\": \"layout-archetypes\",\n    \"categories\": [\"layout\", \"structure\"],\n    \"tags\": [\"layout\", \"grid\", \"auto-fit\", \"minmax\", \"responsive\", \"grid\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Layouts must reflow rather than scroll horizontally, and the DOM order must match the visual reading order.\",\n    \"customization\": [\n      { \"name\": \"--min\", \"description\": \"Minimum track\", \"default\": \"88px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Responsive card grids. repeat(auto-fit, minmax(X, 1fr)) reflows at every width with no breakpoints; use auto-fill instead when empty tracks should be preserved.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; grid-template-columns: repeat(auto-fit, minmax(88px, 1fr)); gap: 8px; width: 300px; }\n    .fx div { height: 70px; border-radius: 12px; background: #151b2a; border: 1px solid #263149; display: grid;\n      place-items: center; color: #8b93a7; font-size: .76rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div>1</div><div>2</div><div>3</div><div>4</div><div>5</div><div>6</div></div>\n</body>\n</html>\n"
