  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Relative Time</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"relative-time-list\",\n    \"title\": \"Relative Time\",\n    \"summary\": \"Timestamps shown as human-relative strings.\",\n    \"description\": \"Timestamps shown as human-relative strings.\",\n    \"theme\": \"calendar-time\",\n    \"categories\": [\"calendar\", \"time\"],\n    \"tags\": [\"calendar\", \"date\", \"relative-time\", \"timestamps\", \"human\", \"list\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dates need machine-readable markup (<time datetime>) and selected days must be announced, not just highlighted.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Time colour\", \"default\": \"#8b93a7\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Feeds and activity logs. Put the absolute timestamp in the datetime attribute and a title so hovering reveals the exact time — relative-only stamps are useless in support threads.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 270px; font-size: .86rem; }\n    .r { display: flex; justify-content: space-between; padding: .5rem .7rem; border-radius: 9px; color: #cbd5e1; }\n    .r:hover { background: #151b2a; }\n    .r time { color: #8b93a7; font-size: .78rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"r\"><span>Deployed to production</span><time datetime=\"2026-09-10T12:04\" title=\"10 Sept 2026, 12:04\">4m ago</time></div>\n  <div class=\"r\"><span>Merged pull request</span><time datetime=\"2026-09-10T09:12\" title=\"10 Sept 2026, 09:12\">3h ago</time></div>\n  <div class=\"r\"><span>Opened issue</span><time datetime=\"2026-09-08T16:40\" title=\"8 Sept 2026, 16:40\">2d ago</time></div></div>\n</body>\n</html>\n"
