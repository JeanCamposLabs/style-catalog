  "path": "effects/hover-interactions/press-depth-hover.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Pressable Depth Card</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"press-depth-hover\",\n    \"title\": \"Pressable Depth Card\",\n    \"summary\": \"A card lifts on hover and sinks under the press.\",\n    \"description\": \"Shadow spread and translateY move together in both directions, which is what makes the surface feel physical rather than animated.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"press\"],\n    \"tags\": [\"lift\", \"press\", \"shadow\", \"depth\", \"tactile\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--lift\", \"description\": \"Hover lift\", \"default\": \"6px\" },\n      { \"name\": \"--dur\", \"description\": \"Transition\", \"default\": \"0.2s\" }\n    ],\n    \"variations\": [\"Colour shift on lift\", \"Deeper press for primary actions\", \"Tilt slightly toward the pointer\"],\n    \"ai_usage\": \"Any clickable surface. Scale the shadow with the lift (larger blur and offset when raised, tighter when pressed) — a static shadow makes the movement look like sliding.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --lift: 6px; --dur: .2s; }\n    .pd { width: 250px; padding: 1.4rem; border-radius: 16px; background: #151b2a; border: 1px solid #263149;\n      cursor: pointer; box-shadow: 0 4px 12px rgba(0,0,0,.35);\n      transition: transform var(--dur) ease, box-shadow var(--dur) ease; }\n    .pd:hover, .pd:focus-visible { transform: translateY(calc(var(--lift) * -1)); box-shadow: 0 18px 34px rgba(0,0,0,.5); }\n    .pd:active { transform: translateY(2px); box-shadow: 0 2px 8px rgba(0,0,0,.4); }\n    .pd h3 { margin: 0 0 .3rem; }\n    .pd p { margin: 0; color: #8b93a7; font-size: .9rem; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"pd\" tabindex=\"0\"><h3>Press me</h3><p>Lift on hover, sink on press.</p></div>\n</body>\n</html>\n"
}
