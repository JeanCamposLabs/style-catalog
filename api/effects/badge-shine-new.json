  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Shining New Badge</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"badge-shine-new\",\n    \"title\": \"Shining New Badge\",\n    \"summary\": \"A badge with a highlight that sweeps across it.\",\n    \"description\": \"A badge with a highlight that sweeps across it. Small self-contained component ready to drop into a list or card.\",\n    \"theme\": \"badges-tags\",\n    \"categories\": [\"badge\", \"label\"],\n    \"tags\": [\"badge\", \"label\", \"shine\", \"new\", \"attention\", \"sweep\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Status must never be colour-only: pair every badge colour with a label, icon, or shape.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Sweep period\", \"default\": \"2.6s\" }\n    ],\n    \"variations\": [\"Add a size variant\", \"Map colours to semantic tokens\"],\n    \"ai_usage\": \"Drawing the eye to a genuinely new feature. Remove the animation once the feature is no longer new — permanent motion becomes noise.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .b { position: relative; overflow: hidden; display: inline-block; padding: .35rem .9rem; border-radius: 8px;\n      background: #7c5cff; color: #fff; font-size: .76rem; font-weight: 800; letter-spacing: .05em; }\n    .b::after { content: \"\"; position: absolute; top: 0; bottom: 0; width: 40%; left: -60%;\n      background: linear-gradient(90deg, transparent, rgba(255,255,255,.5), transparent); transform: skewX(-20deg);\n      animation: sweep 2.6s ease-in-out infinite; }\n    @keyframes sweep { 0%, 60% { left: -60%; } 100% { left: 140%; } }\n  </style>\n</head>\n<body>\n  <span class=\"b\">NEW</span>\n</body>\n</html>\n"
