  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Fluttering Wings</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"butterfly-flutter\",\n    \"title\": \"Fluttering Wings\",\n    \"summary\": \"Wings beat with a slight body bob.\",\n    \"description\": \"Wings beat with a slight body bob.\",\n    \"theme\": \"nature-organic\",\n    \"categories\": [\"nature\", \"organic\"],\n    \"tags\": [\"organic\", \"nature\", \"butterfly\", \"wings\", \"flutter\", \"3d\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Ambient nature motion should be slow and optional — disable it entirely under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Wing colour\", \"default\": \"#7c3aed\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Slow it down for an ambient version\"],\n    \"ai_usage\": \"Delight moments and success states. rotateY around the inner edge (not scaleX) is what makes the wings look like they have depth.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 120px; height: 90px; display: grid; place-items: center; perspective: 300px; }\n    .fx .w { position: absolute; width: 46px; height: 60px; background: linear-gradient(160deg, #c084fc, #7c3aed);\n      border-radius: 60% 40% 50% 50% / 60% 60% 40% 40%; animation: flap .5s ease-in-out infinite alternate; }\n    .fx .l { right: 50%; transform-origin: right center; }\n    .fx .r { left: 50%; transform-origin: left center; animation-name: flapr; }\n    .fx .body { width: 6px; height: 46px; border-radius: 99px; background: #3b0764; z-index: 1; }\n    @keyframes flap { to { transform: rotateY(64deg); } }\n    @keyframes flapr { to { transform: rotateY(-64deg); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"w l\"></span><span class=\"w r\"></span><span class=\"body\"></span></div>\n</body>\n</html>\n"
