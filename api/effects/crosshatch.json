  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Crosshatch</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"crosshatch\",\n    \"title\": \"Crosshatch\",\n    \"summary\": \"Fine crossing diagonals like pen shading.\",\n    \"description\": \"Fine crossing diagonals like pen shading. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"crosshatch\", \"hatching\", \"illustration\", \"texture\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Hatch colour\", \"default\": \"rgba(231,235,243,.1)\" },\n      { \"name\": \"--s\", \"description\": \"Hatch spacing\", \"default\": \"8px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Illustration and editorial textures. Vary the two layers' spacing slightly for a hand-drawn feel instead of a mechanical mesh.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(231,235,243,.1); --s: 8px; }\n    .bg { background-color: #0b0d12;\n      background-image: repeating-linear-gradient(45deg, var(--c) 0 1px, transparent 1px var(--s)),\n        repeating-linear-gradient(-45deg, var(--c) 0 1px, transparent 1px var(--s)); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
