  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Nested Task Progress</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"progress-tree-loading\",\n    \"title\": \"Nested Task Progress\",\n    \"summary\": \"A parent task whose bar aggregates its children.\",\n    \"description\": \"A parent task whose bar aggregates its children.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"nested\", \"aggregate\", \"tasks\", \"build\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Aggregate percent\", \"default\": \"55\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Build pipelines and multi-stage jobs. Derive the parent value from the children rather than tracking it separately, or the two will disagree.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .tp { width: 300px; font-size: .88rem; }\n    .tp .p { display: flex; justify-content: space-between; color: #e7ebf3; font-weight: 700; margin-bottom: .4rem; }\n    .tp .bar { height: 7px; border-radius: 99px; background: #22304a; overflow: hidden; margin-bottom: .8rem; }\n    .tp .bar i { display: block; height: 100%; width: calc(var(--p) * 1%); background: #7c5cff; }\n    .tp .kid { display: flex; align-items: center; gap: .6rem; padding: .25rem 0 .25rem 1rem; color: #8b93a7; }\n    .tp .kid .mini { flex: 1; height: 4px; border-radius: 99px; background: #22304a; overflow: hidden; }\n    .tp .kid .mini i { display: block; height: 100%; background: #2dd4bf; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"tp\" style=\"--p:55\"><div class=\"p\"><span>Build pipeline</span><span>55%</span></div>\n  <div class=\"bar\" role=\"progressbar\" aria-valuenow=\"55\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i></i></div>\n  <div class=\"kid\">Install<span class=\"mini\"><i style=\"width:100%\"></i></span></div>\n  <div class=\"kid\">Compile<span class=\"mini\"><i style=\"width:65%\"></i></span></div>\n  <div class=\"kid\">Test<span class=\"mini\"><i style=\"width:0%\"></i></span></div></div>\n</body>\n</html>\n"
