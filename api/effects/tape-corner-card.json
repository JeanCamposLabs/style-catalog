  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Taped Corners</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"tape-corner-card\",\n    \"title\": \"Taped Corners\",\n    \"summary\": \"Translucent tape strips hold the card at two corners.\",\n    \"description\": \"Two rotated, semi-transparent strips overlap the card edge, which is what makes the tape read as on top of it.\",\n    \"theme\": \"borders-shadows\",\n    \"categories\": [\"border\", \"craft\"],\n    \"tags\": [\"tape\", \"scrapbook\", \"craft\", \"rotate\", \"photo\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative edge treatment — never encode meaning in the border colour alone. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--tape\", \"description\": \"Tape color\", \"default\": \"rgba(251,191,36,.5)\" }\n    ],\n    \"variations\": [\"Washi tape pattern\", \"Tape all four corners\", \"Slight card rotation for a pinned-up look\"],\n    \"ai_usage\": \"Scrapbook, moodboard, and photo-wall layouts. The strips must extend past the card edge and sit above it in z-order; tape drawn inside the card looks like a printed graphic.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; padding: 1.6rem; color: #e7ebf3; }\n    .demo h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .demo p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    :root { --tape: rgba(251,191,36,.5); }\n    .tape { position: relative; }\n    .tape::before, .tape::after { content: \"\"; position: absolute; width: 76px; height: 24px; background: var(--tape);\n      box-shadow: 0 1px 3px rgba(0,0,0,.4); }\n    .tape::before { top: -10px; left: -14px; transform: rotate(-24deg); }\n    .tape::after { bottom: -10px; right: -14px; transform: rotate(-24deg); }\n    .demo { background: #151b2a; border-radius: 4px; box-shadow: 0 10px 26px rgba(0,0,0,.45); }\n  </style>\n</head>\n<body>\n  <div class=\"tape\"><div class=\"demo\"><h3>Taped up</h3><p>Two strips, rotated.</p></div></div>\n</body>\n</html>\n"
}
