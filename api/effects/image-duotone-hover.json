  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Duotone Hover</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"image-duotone-hover\",\n    \"title\": \"Duotone Hover\",\n    \"summary\": \"A duotone image returning to full colour on hover.\",\n    \"description\": \"A duotone image returning to full colour on hover.\",\n    \"theme\": \"images-media\",\n    \"categories\": [\"image\", \"media\"],\n    \"tags\": [\"image\", \"media\", \"duotone\", \"hover\", \"grayscale\", \"reveal\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative images need empty alt; meaningful ones need real descriptions. Never convey information through a hover-only image treatment.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Duotone shadow\", \"default\": \"#2f7cc9\" },\n      { \"name\": \"--b\", \"description\": \"Duotone highlight\", \"default\": \"#d1478c\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Editorial and portfolio grids. Grayscale first, then a colour-blended tint — tinting a colour image directly produces muddy midtones.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 260px; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; }\n    .fx .img { position: absolute; inset: 0; background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #c2891a, #7c5cff);\n      filter: grayscale(1) contrast(1.15); transition: filter .4s; }\n    .fx::after { content: \"\"; position: absolute; inset: 0; mix-blend-mode: color; opacity: 1; transition: opacity .4s;\n      background: linear-gradient(135deg, #2f7cc9, #d1478c); }\n    .fx:hover .img { filter: none; }\n    .fx:hover::after { opacity: 0; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"img\"></div></div>\n</body>\n</html>\n"
