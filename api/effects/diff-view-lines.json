  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Diff View</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"diff-view-lines\",\n    \"title\": \"Diff View\",\n    \"summary\": \"Added and removed lines in a unified diff.\",\n    \"description\": \"Added and removed lines in a unified diff.\",\n    \"theme\": \"terminal-cli\",\n    \"categories\": [\"terminal\", \"code\"],\n    \"tags\": [\"terminal\", \"monospace\", \"diff\", \"git\", \"added\", \"removed\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Terminal output should live in a real text element (not an image) so it can be selected, searched, and read aloud.\",\n    \"customization\": [\n      { \"name\": \"--add\", \"description\": \"Addition colour\", \"default\": \"#7ee787\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Code review UIs. Prefix lines with + and - as well as colouring them — that prefix is what makes a diff readable when copied as plain text.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; border-radius: 10px; overflow: hidden; border: 1px solid #21262d; background: #0d1117;\n      font-family: ui-monospace, monospace; font-size: .76rem; line-height: 1.8; }\n    .fx div { padding: 0 .8rem; color: #c9d1d9; }\n    .fx .add { background: rgba(63,185,80,.15); color: #7ee787; }\n    .fx .del { background: rgba(248,81,73,.15); color: #ffa198; }\n    .fx .hd { background: #161b22; color: #8b949e; padding: .4rem .8rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"hd\">@@ -12,3 +12,4 @@ scripts/build.mjs</div>\n  <div>  const { catalog } = scanCatalog();</div>\n  <div class=\"del\">- console.log(catalog.counts);</div>\n  <div class=\"add\">+ console.log(`${catalog.counts.effects} effects`);</div>\n  <div class=\"add\">+ console.log(\"done\");</div></div>\n</body>\n</html>\n"
