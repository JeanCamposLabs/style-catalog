  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Sliced Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"text-slice-split\",\n    \"title\": \"Sliced Text\",\n    \"summary\": \"A headline cut in two with offset halves.\",\n    \"description\": \"A headline cut in two with offset halves.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"typography\"],\n    \"tags\": [\"text\", \"type\", \"slice\", \"split\", \"offset\", \"kinetic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative duplicates are aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Top colour\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--b\", \"description\": \"Bottom colour\", \"default\": \"#2dd4bf\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Editorial and music-poster headlines. Two clipped duplicates offset in opposite directions give the slice; keep the base text underneath for selection and screen readers.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; font-size: 2.4rem; font-weight: 900; color: #e7ebf3; }\n    .fx::before, .fx::after { content: attr(data-t); position: absolute; inset: 0; }\n    .fx::before { clip-path: inset(0 0 50% 0); transform: translateX(-4px); color: #7c5cff; }\n    .fx::after { clip-path: inset(50% 0 0 0); transform: translateX(4px); color: #2dd4bf; }\n  </style>\n</head>\n<body>\n  <h2 class=\"fx\" data-t=\"SLICED\">SLICED</h2>\n</body>\n</html>\n"
