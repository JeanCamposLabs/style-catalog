position: absolute; inset: -50%; mix-blend-mode: color-dodge; filter: blur(26px); opacity: .55;\n      background: conic-gradient(from 0deg, #ff2d95, #fbbf24, #22d3ee, #a855f7, #ff2d95); animation: spin 8s linear infinite; }\n    .fx b { position: absolute; inset: auto 0 0 0; padding: 1rem; font-weight: 800; color: #fff; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><b>Holo Rare</b></div>\n</body>\n</html>\n"
