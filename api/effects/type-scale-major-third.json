  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Major Third Scale</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"type-scale-major-third\",\n    \"title\": \"Major Third Scale\",\n    \"summary\": \"A 1.25 ratio type scale from caption to display.\",\n    \"description\": \"A 1.25 ratio type scale from caption to display.\",\n    \"theme\": \"typography-systems\",\n    \"categories\": [\"typography\", \"reference\"],\n    \"tags\": [\"typography\", \"type\", \"scale\", \"ratio\", \"modular\", \"hierarchy\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Type systems must survive user font-size settings: size in rem, never lock line-height in px, and keep the measure under 75 characters.\",\n    \"customization\": [\n      { \"name\": \"--ratio\", \"description\": \"Scale ratio\", \"default\": \"1.25\" },\n      { \"name\": \"--base\", \"description\": \"Base size\", \"default\": \"1rem\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Pick one ratio and generate every step from it. 1.25 (major third) suits dense product UI; 1.333 or 1.5 suit editorial. Tighten line-height as size grows — display text at 1.6 looks unglued.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; display: grid; gap: .6rem; }\n    .fx .r { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #1e2740; padding-bottom: .4rem; }\n    .fx .s { color: #64748b; font-size: .7rem; font-family: ui-monospace, monospace; }\n    .d { font-size: 2.44rem; font-weight: 800; line-height: 1.1; }\n    .h1 { font-size: 1.95rem; font-weight: 800; line-height: 1.15; }\n    .h2 { font-size: 1.56rem; font-weight: 700; line-height: 1.2; }\n    .h3 { font-size: 1.25rem; font-weight: 700; line-height: 1.3; }\n    .b { font-size: 1rem; line-height: 1.6; }\n    .c { font-size: .8rem; color: #8b93a7; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"r\"><span class=\"d\">Display</span><span class=\"s\">2.44rem</span></div>\n  <div class=\"r\"><span class=\"h1\">Heading 1</span><span class=\"s\">1.95rem</span></div>\n  <div class=\"r\"><span class=\"h2\">Heading 2</span><span class=\"s\">1.56rem</span></div>\n  <div class=\"r\"><span class=\"h3\">Heading 3</span><span class=\"s\">1.25rem</span></div>\n  <div class=\"r\"><span class=\"b\">Body text</span><span class=\"s\">1rem</span></div>\n  <div class=\"r\"><span class=\"c\">Caption</span><span class=\"s\">0.8rem</span></div></div>\n</body>\n</html>\n"
