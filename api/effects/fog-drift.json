  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Drifting Fog</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"fog-drift\",\n    \"title\": \"Drifting Fog\",\n    \"summary\": \"Soft fog banks sliding across a scene.\",\n    \"description\": \"Soft fog banks sliding across a scene.\",\n    \"theme\": \"weather-ambient\",\n    \"categories\": [\"weather\", \"ambient\"],\n    \"tags\": [\"weather\", \"ambient\", \"fog\", \"mist\", \"drift\", \"atmosphere\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Flashing weather effects (lightning) can be a seizure risk — keep flashes infrequent, low-contrast, and disabled under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Fog colour\", \"default\": \"rgba(226,232,240,.16)\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Slow it down for an ambient version\"],\n    \"ai_usage\": \"Atmospheric depth. Use several wide blurred bands at different speeds and vertical positions; one band reads as a smudge.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 260px; height: 170px; border-radius: 14px; overflow: hidden;\n      background: linear-gradient(180deg, #334155, #0f172a); }\n    .fx i { position: absolute; height: 60px; width: 200%; left: -50%; border-radius: 50%; filter: blur(22px);\n      background: rgba(226,232,240,.16); animation: drift var(--d) linear infinite; }\n    @keyframes drift { from { transform: translateX(-25%); } to { transform: translateX(25%); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><i style=\"top:30%;--d:14s\"></i><i style=\"top:52%;--d:20s\"></i><i style=\"top:70%;--d:17s\"></i></div>\n</body>\n</html>\n"
