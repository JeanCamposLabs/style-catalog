  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Stretched Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"stretch-glitch-text\",\n    \"title\": \"Stretched Text\",\n    \"summary\": \"Text that periodically stretches horizontally.\",\n    \"description\": \"Text that periodically stretches horizontally.\",\n    \"theme\": \"glitch-distortion\",\n    \"categories\": [\"glitch\", \"distortion\"],\n    \"tags\": [\"glitch\", \"distortion\", \"stretch\", \"text\", \"glitch\", \"kinetic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Rapid flicker and high-contrast tearing can trigger discomfort — keep glitches brief and honour prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Cycle\", \"default\": \"5s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Adjust the loop duration\"],\n    \"ai_usage\": \"Glitch titles. Stepped scaleX keeps the distortion instantaneous; easing between the states looks like a rubber-band animation instead.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { font-size: 2.2rem; font-weight: 900; color: #e7ebf3; letter-spacing: .04em;\n      animation: stretch 5s steps(1) infinite; }\n    @keyframes stretch {\n      0%, 82%, 100% { transform: none; }\n      84% { transform: scaleX(1.5) skewX(-6deg); }\n      86% { transform: scaleX(.7); }\n      88% { transform: scaleX(1.2) skewX(4deg); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\">CORRUPTED</div>\n</body>\n</html>\n"
