  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Waveform Scrubber</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"waveform-scrubber\",\n    \"title\": \"Waveform Scrubber\",\n    \"summary\": \"A waveform where the played portion is highlighted.\",\n    \"description\": \"A waveform where the played portion is highlighted.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"waveform\", \"scrubber\", \"seek\", \"player\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Played colour\", \"default\": \"#2dd4bf\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Podcast and audio editors. Render the peaks once into fixed heights; recomputing the waveform on every seek is the usual cause of jank.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: 2px; height: 60px; width: 290px; cursor: pointer; }\n    .fx i { flex: 1; border-radius: 2px; background: #2b3450; height: var(--h); }\n    .fx i.on { background: #2dd4bf; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"slider\" aria-label=\"Seek\" aria-valuenow=\"42\" aria-valuemin=\"0\" aria-valuemax=\"100\">\n    <i class=\"on\" style=\"--h:30%\"></i><i class=\"on\" style=\"--h:62%\"></i><i class=\"on\" style=\"--h:44%\"></i><i class=\"on\" style=\"--h:88%\"></i>\n    <i class=\"on\" style=\"--h:52%\"></i><i class=\"on\" style=\"--h:70%\"></i><i style=\"--h:36%\"></i><i style=\"--h:92%\"></i>\n    <i style=\"--h:48%\"></i><i style=\"--h:64%\"></i><i style=\"--h:28%\"></i><i style=\"--h:76%\"></i><i style=\"--h:40%\"></i>\n    <i style=\"--h:58%\"></i><i style=\"--h:34%\"></i></div>\n</body>\n</html>\n"
