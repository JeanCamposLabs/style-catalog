  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Ornamental Rule</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"divider-ornament\",\n    \"title\": \"Ornamental Rule\",\n    \"summary\": \"A rule with a centred diamond ornament.\",\n    \"description\": \"A rule with a centred diamond ornament. Purely decorative and self-contained, so it drops between any two sections.\",\n    \"theme\": \"dividers-shapes\",\n    \"categories\": [\"divider\", \"shape\"],\n    \"tags\": [\"divider\", \"separator\", \"ornament\", \"editorial\", \"diamond\", \"classic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dividers are decorative: mark them aria-hidden so they are not announced as content.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Ornament colour\", \"default\": \"#fbbf24\" }\n    ],\n    \"variations\": [\"Flip vertically for the opposite section\", \"Recolour to match the next section\"],\n    \"ai_usage\": \"Editorial and long-form articles. Fade the rules toward the page edges so the ornament reads as the focal point.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .top { background: #151b2a; padding: 1.6rem; text-align: center; color: #8b93a7; font-size: .85rem; }\n    .bottom { background: #7c5cff; padding: 1.6rem; text-align: center; color: #1a1030; font-size: .85rem; font-weight: 700; }\n    .stage { width: min(92vw, 340px); }\n    .divider { height: 40px; display: flex; align-items: center; gap: .8rem; padding: 0 1.4rem; background: #151b2a; }\n    .divider::before, .divider::after { content: \"\"; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, #3b465e, transparent); }\n    .divider i { width: 9px; height: 9px; background: #fbbf24; transform: rotate(45deg); }\n  </style>\n</head>\n<body>\n  <div class=\"stage\"><div class=\"top\">Section one</div><div class=\"divider\" aria-hidden=\"true\"><i></i></div><div class=\"top\">Section two</div></div>\n</body>\n</html>\n"
