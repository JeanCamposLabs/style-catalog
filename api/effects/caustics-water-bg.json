  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Pool Caustics</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"caustics-water-bg\",\n    \"title\": \"Pool Caustics\",\n    \"summary\": \"Rippling light patterns like sunlight through water.\",\n    \"description\": \"Two blurred, differently scaled repeating-radial layers drift over each other, producing the wandering bright veins of caustics.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"water\"],\n    \"tags\": [\"caustics\", \"water\", \"pool\", \"light\", \"organic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Light color\", \"default\": \"rgba(125,211,252,.3)\" },\n      { \"name\": \"--dur\", \"description\": \"Drift period\", \"default\": \"12s\" }\n    ],\n    \"variations\": [\"Warmer light for sunset\", \"Sharper veins with less blur\", \"Overlay on a photo with screen blending\"],\n    \"ai_usage\": \"Pool, spa, aquarium, and summer themes. Two layers at different scales moving in different directions is the minimum for a convincing caustic; one layer looks like a moving pattern.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(125,211,252,.3); --dur: 12s; }\n    .bg { background: linear-gradient(#062b3d, #04161f); overflow: hidden; }\n    .bg i { position: absolute; inset: -20%; filter: blur(14px); mix-blend-mode: screen;\n      background-image: repeating-radial-gradient(circle at 30% 40%, transparent 0 18px, var(--c) 18px 22px, transparent 22px 46px);\n      animation: swim var(--d) ease-in-out infinite alternate; }\n    .bg i:nth-child(2) { background-image: repeating-radial-gradient(circle at 70% 60%, transparent 0 26px, var(--c) 26px 30px, transparent 30px 64px); }\n    @keyframes swim {\n      from { transform: translate(-4%, -3%) scale(1); }\n      to { transform: translate(5%, 4%) scale(1.12); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"><i style=\"--d:12s\"></i><i style=\"--d:17s\"></i></div>\n</body>\n</html>\n"
}
