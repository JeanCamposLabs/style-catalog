  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Turbulent Ripple</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"svg-turbulence-water\",\n    \"title\": \"Turbulent Ripple\",\n    \"summary\": \"Vector art rippling through a turbulence filter.\",\n    \"description\": \"Vector art rippling through a turbulence filter.\",\n    \"theme\": \"svg-effects\",\n    \"categories\": [\"svg\", \"vector\"],\n    \"tags\": [\"svg\", \"vector\", \"turbulence\", \"displacement\", \"ripple\", \"filter\"],\n    \"tech\": [\"svg\", \"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Inline SVG needs role=img and a title or aria-label when it carries meaning, and aria-hidden when it is decoration.\",\n    \"customization\": [\n      { \"name\": \"--scale\", \"description\": \"Displacement\", \"default\": \"12\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Water and heat distortion. Animate baseFrequency with SMIL rather than the displacement scale — scale jumps read as a glitch, frequency shifts read as flowing.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 220px; }\n    .fx svg { width: 100%; display: block; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><svg viewBox=\"0 0 220 140\" aria-hidden=\"true\">\n    <defs><filter id=\"wv\"><feTurbulence type=\"fractalNoise\" baseFrequency=\"0.01 0.04\" numOctaves=\"2\" result=\"n\">\n      <animate attributeName=\"baseFrequency\" dur=\"10s\" values=\"0.01 0.04;0.02 0.06;0.01 0.04\" repeatCount=\"indefinite\"/></feTurbulence>\n      <feDisplacementMap in=\"SourceGraphic\" in2=\"n\" scale=\"12\" xChannelSelector=\"R\" yChannelSelector=\"G\"/></filter>\n    <linearGradient id=\"wg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"#2dd4bf\"/>\n    <stop offset=\"1\" stop-color=\"#0c4a6e\"/></linearGradient></defs>\n    <rect width=\"220\" height=\"140\" rx=\"14\" fill=\"url(#wg)\" filter=\"url(#wv)\"/></svg></div>\n</body>\n</html>\n"
