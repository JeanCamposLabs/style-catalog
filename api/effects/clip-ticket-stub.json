ff); }\n    .label { margin-top: .9rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .shape { -webkit-mask-image: radial-gradient(circle 14px at 0 50%, transparent 14px, #000 15px), radial-gradient(circle 14px at 100% 50%, transparent 14px, #000 15px);\n      mask-image: radial-gradient(circle 14px at 0 50%, transparent 14px, #000 15px), radial-gradient(circle 14px at 100% 50%, transparent 14px, #000 15px);\n      -webkit-mask-composite: source-in; mask-composite: intersect; border-radius: 14px; }\n  </style>\n</head>\n<body>\n  <div><div class=\"art shape\"></div><p class=\"label\">Ticket Stub</p></div>\n</body>\n</html>\n"
