  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Cart Summary</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cart-summary-panel\",\n    \"title\": \"Cart Summary\",\n    \"summary\": \"An order summary with subtotal, shipping, and total.\",\n    \"description\": \"An order summary with subtotal, shipping, and total.\",\n    \"theme\": \"ecommerce-ui\",\n    \"categories\": [\"ecommerce\", \"commerce\"],\n    \"tags\": [\"ecommerce\", \"shop\", \"cart\", \"summary\", \"checkout\", \"totals\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Price, stock, and discount information must be in text, never only a colour or a badge shape.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Action colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Checkout. Show every line item including tax and shipping before the total — surprise fees at the final step are the top cause of cart abandonment.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 260px; padding: 1.2rem; border-radius: 16px; background: #151b2a; border: 1px solid #263149; }\n    .fx h4 { margin: 0 0 .9rem; font-size: 1rem; }\n    .fx .r { display: flex; justify-content: space-between; padding: .3rem 0; color: #8b93a7; font-size: .88rem; }\n    .fx .r.free { color: #34d399; }\n    .fx .tot { display: flex; justify-content: space-between; margin-top: .7rem; padding-top: .7rem;\n      border-top: 1px solid #263149; font-weight: 900; font-size: 1.1rem; color: #e7ebf3; }\n    .fx button { width: 100%; margin-top: 1rem; padding: .75rem; border: 0; border-radius: 11px; background: #7c5cff;\n      color: #fff; font: inherit; font-weight: 700; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><h4>Order summary</h4><div class=\"r\"><span>Subtotal</span><span>$118.00</span></div>\n  <div class=\"r free\"><span>Shipping</span><span>Free</span></div><div class=\"r\"><span>Tax</span><span>$9.44</span></div>\n  <div class=\"tot\"><span>Total</span><span>$127.44</span></div><button type=\"button\">Checkout</button></div>\n</body>\n</html>\n"
