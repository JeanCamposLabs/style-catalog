  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>CLI Spinner</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cli-spinner-line\",\n    \"title\": \"CLI Spinner\",\n    \"summary\": \"A braille spinner beside a status line.\",\n    \"description\": \"A braille spinner beside a status line.\",\n    \"theme\": \"terminal-cli\",\n    \"categories\": [\"terminal\", \"code\"],\n    \"tags\": [\"terminal\", \"monospace\", \"spinner\", \"braille\", \"cli\", \"status\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Terminal output should live in a real text element (not an image) so it can be selected, searched, and read aloud.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Spinner colour\", \"default\": \"#58a6ff\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"CLI-flavoured web loaders. Rotate through braille frames with JS (CSS cannot animate content reliably across browsers) and keep a text status beside it.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: .6rem; padding: .8rem 1rem; border-radius: 8px; background: #0d1117;\n      border: 1px solid #21262d; font-family: ui-monospace, monospace; font-size: .85rem; color: #c9d1d9; }\n    .fx .sp { width: 1ch; color: #58a6ff; animation: frames .8s steps(8) infinite; }\n    @keyframes frames {\n      0% { content: \"⠋\"; } 12.5% { content: \"⠙\"; } 25% { content: \"⠹\"; } 37.5% { content: \"⠸\"; }\n      50% { content: \"⠼\"; } 62.5% { content: \"⠴\"; } 75% { content: \"⠦\"; } 87.5% { content: \"⠧\"; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"sp\" id=\"sp\">⠋</span> Installing dependencies…</div>\n  <script>\n    (function () {\n      var f = \"⠋⠙⠹⠸⠼⠴⠦⠧\", i = 0, el = document.getElementById(\"sp\");\n      setInterval(function () { el.textContent = f[i = (i + 1) % f.length]; }, 90);\n    })();\n  </script>\n</body>\n</html>\n"
}
