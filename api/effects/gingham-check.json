  "path": "effects/patterns-textures/gingham-check.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Gingham</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"gingham-check\",\n    \"title\": \"Gingham\",\n    \"summary\": \"Semi-transparent crossing bands, picnic style.\",\n    \"description\": \"Semi-transparent crossing bands, picnic style. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"gingham\", \"check\", \"picnic\", \"fabric\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Check colour\", \"default\": \"rgba(248,113,113,.45)\" },\n      { \"name\": \"--s\", \"description\": \"Check size\", \"default\": \"30px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Food, market, and rustic themes. Both layers must use partial alpha so the crossings darken — that is the whole gingham effect.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(248,113,113,.45); --s: 30px; }\n    .bg { background-color: #0b0d12;\n      background-image: repeating-linear-gradient(90deg, var(--c) 0 var(--s), transparent var(--s) calc(var(--s) * 2)),\n        repeating-linear-gradient(0deg, var(--c) 0 var(--s), transparent var(--s) calc(var(--s) * 2)); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
