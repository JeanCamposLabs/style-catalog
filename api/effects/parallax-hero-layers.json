  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Parallax Hero</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"parallax-hero-layers\",\n    \"title\": \"Parallax Hero\",\n    \"summary\": \"Background layers moving at different rates.\",\n    \"description\": \"Background layers moving at different rates.\",\n    \"theme\": \"scroll-effects\",\n    \"categories\": [\"scroll\", \"motion\"],\n    \"tags\": [\"scroll\", \"parallax\", \"hero\", \"layers\", \"sticky\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Scroll-linked motion must be disabled under prefers-reduced-motion, and content must never depend on scrolling to become readable.\",\n    \"customization\": [\n      { \"name\": \"--rate\", \"description\": \"Parallax rate\", \"default\": \"0.4\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Landing heroes. Drive layer offsets from a single scroll value and apply them with transform — animating background-position forces a repaint of the whole layer each frame.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n    body { min-height: 250vh; margin: 0; }\n    .hero { position: sticky; top: 0; height: 100vh; overflow: hidden; }\n    .l { position: absolute; inset: 0; }\n    .sky { background: linear-gradient(180deg, #1e1b4b, #7c5cff); }\n    .hills { background: radial-gradient(ellipse 120% 60% at 50% 100%, #10a894 0 60%, transparent 61%); }\n    .front { background: radial-gradient(ellipse 90% 40% at 50% 100%, #042f2a 0 60%, transparent 61%); }\n    .title { position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-size: 2rem; font-weight: 900; }\n    .after { height: 120vh; background: #0b0d12; }\n  </style>\n</head>\n<body>\n  <div class=\"hero\"><div class=\"l sky\"></div><div class=\"l hills\" id=\"h1\"></div><div class=\"l front\" id=\"h2\"></div>\n  <div class=\"title\">PARALLAX</div></div><div class=\"after\"></div>\n  <script>\n    (function () {\n      var h1 = document.getElementById(\"h1\"), h2 = document.getElementById(\"h2\");\n      if (matchMedia(\"(prefers-reduced-motion: reduce)\").matches) return;\n      addEventListener(\"scroll\", function () {\n        var y = scrollY;\n        h1.style.transform = \"translateY(\" + y * .18 + \"px)\";\n        h2.style.transform = \"translateY(\" + y * .34 + \"px)\";\n      }, { passive: true });\n    })();\n  </script>\n</body>\n</html>\n"
}
