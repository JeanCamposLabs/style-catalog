  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Chrome Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"chrome-text\",\n    \"title\": \"Chrome Text\",\n    \"summary\": \"A polished metal headline made from a multi-stop gradient clipped to the glyphs.\",\n    \"description\": \"The illusion is in the stop placement: light, dark, light, dark in quick succession reads as a reflective curve rather than a flat ramp.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"material\"],\n    \"tags\": [\"chrome\", \"metal\", \"gradient\", \"background-clip\", \"reflective\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--tilt\", \"description\": \"Gradient angle\", \"default\": \"178deg\" }\n    ],\n    \"variations\": [\"Animate background-position for a moving reflection\", \"Warmer stops for gold\", \"Add a thin dark outline via text-stroke\"],\n    \"ai_usage\": \"Y2K, automotive, or heavy-metal aesthetics. Use background-clip:text with color:transparent; the metal read depends on abrupt light/dark stops, so avoid smooth two-color ramps.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --tilt: 178deg; }\n    .chrome { font-size: clamp(2.4rem, 10vw, 5rem); font-weight: 900; letter-spacing: -.01em;\n      background: linear-gradient(var(--tilt), #ffffff 0 10%, #98a2b8 24%, #ffffff 40%, #5b6478 54%, #eef2f9 70%, #7b8698 100%);\n      -webkit-background-clip: text; background-clip: text; color: transparent;\n      filter: drop-shadow(0 3px 6px rgba(0,0,0,.55)); }\n  </style>\n</head>\n<body>\n  <h1 class=\"chrome\">CHROME</h1>\n</body>\n</html>\n"
}
