  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Anonymous Avatar</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"avatar-anonymous-ghost\",\n    \"title\": \"Anonymous Avatar\",\n    \"summary\": \"A neutral placeholder for unknown users.\",\n    \"description\": \"A neutral placeholder for unknown users.\",\n    \"theme\": \"avatars-identity\",\n    \"categories\": [\"avatar\", \"identity\"],\n    \"tags\": [\"avatar\", \"identity\", \"anonymous\", \"placeholder\", \"unknown\", \"guest\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"An avatar is decorative when the name is beside it (use empty alt); when it stands alone it must carry the person's name as its accessible label.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Placeholder colour\", \"default\": \"#1e2740\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Guests, deleted accounts, and unassigned items. Keep it visually quiet — a bright placeholder draws attention to the absence of a person.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 12px; align-items: center; }\n    .a { width: 48px; height: 48px; border-radius: 50%; background: #1e2740; color: #64748b; display: grid;\n      place-items: center; font-size: 1.3rem; }\n    .a.dash { border: 2px dashed #2b3450; background: transparent; }\n    .lbl { color: #8b93a7; font-size: .84rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"a\" role=\"img\" aria-label=\"Anonymous user\">👤</span>\n  <span class=\"a dash\" role=\"img\" aria-label=\"Unassigned\">＋</span><span class=\"lbl\">Unassigned</span></div>\n</body>\n</html>\n"
