  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Comic Halftone</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"comic-halftone\",\n    \"title\": \"Comic Halftone\",\n    \"summary\": \"Big printed dots in the pop-art tradition.\",\n    \"description\": \"Big printed dots in the pop-art tradition. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"halftone\", \"comic\", \"pop-art\", \"print\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Dot colour\", \"default\": \"#ff2d95\" },\n      { \"name\": \"--s\", \"description\": \"Dot pitch\", \"default\": \"18px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Comic panels and pop-art sections. Larger dots (30%+ of the tile) read as deliberate print; small dots read as a texture.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: #ff2d95; --s: 18px; }\n    .bg { background-color: #ffd166;\n      background-image: radial-gradient(var(--c) 32%, transparent 33%); background-size: var(--s) var(--s);\n      background-position: 0 0, calc(var(--s) / 2) calc(var(--s) / 2); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
