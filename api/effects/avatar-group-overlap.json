  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Avatar Group</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"avatar-group-overlap\",\n    \"title\": \"Avatar Group\",\n    \"summary\": \"Overlapping avatars with an overflow count.\",\n    \"description\": \"Overlapping avatars with an overflow count.\",\n    \"theme\": \"avatars-identity\",\n    \"categories\": [\"avatar\", \"identity\"],\n    \"tags\": [\"avatar\", \"identity\", \"group\", \"overlap\", \"team\", \"stack\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"An avatar is decorative when the name is beside it (use empty alt); when it stands alone it must carry the person's name as its accessible label.\",\n    \"customization\": [\n      { \"name\": \"--overlap\", \"description\": \"Overlap\", \"default\": \"12px\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Collaborator rows. Give the whole group one accessible label ('5 collaborators') instead of announcing each initial; cap at four plus a count.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; }\n    .fx span { width: 40px; height: 40px; border-radius: 50%; border: 2px solid #0b0d12; margin-left: -12px;\n      display: grid; place-items: center; font-weight: 800; font-size: .8rem; color: #0b0d12; }\n    .fx span:first-child { margin-left: 0; }\n    .fx .more { background: #2b3450; color: #cbd5e1; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"img\" aria-label=\"5 collaborators: Jean, Ada, Max and 2 more\">\n    <span style=\"background:#7c5cff\">JC</span><span style=\"background:#10a894\">AL</span>\n    <span style=\"background:#c2891a\">MR</span><span class=\"more\">+2</span></div>\n</body>\n</html>\n"
