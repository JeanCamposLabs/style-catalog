191,219,254,.16) 1px, transparent 1px);\n      background-size: 18px 18px; border: 2px solid #bfdbfe; }\n    .fx .block { position: absolute; right: 0; bottom: 0; padding: .4rem .6rem; border-top: 2px solid #bfdbfe;\n      border-left: 2px solid #bfdbfe; font-size: .65rem; line-height: 1.5; }\n    .fx .shape { position: absolute; top: 30px; left: 34px; width: 90px; height: 60px; border: 2px solid #bfdbfe; }\n    .fx .shape::after { content: \"\"; position: absolute; inset: 12px; border: 1px dashed rgba(191,219,254,.6); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"shape\"></div><div class=\"block\">DWG-0042<br>SCALE 1:20<br>REV C</div></div>\n</body>\n</html>\n"
