  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Status Pill</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"badge-status-dot\",\n    \"title\": \"Status Pill\",\n    \"summary\": \"A pill with a coloured dot and a text status.\",\n    \"description\": \"A pill with a coloured dot and a text status. Small self-contained component ready to drop into a list or card.\",\n    \"theme\": \"badges-tags\",\n    \"categories\": [\"badge\", \"label\"],\n    \"tags\": [\"badge\", \"label\", \"status\", \"dot\", \"pill\", \"semantic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Status must never be colour-only: pair every badge colour with a label, icon, or shape.\",\n    \"customization\": [\n      { \"name\": \"--ok\", \"description\": \"Healthy colour\", \"default\": \"#34d399\" }\n    ],\n    \"variations\": [\"Add a size variant\", \"Map colours to semantic tokens\"],\n    \"ai_usage\": \"System status and record states. Always include the word as well as the dot; a colour-only indicator fails for colour-blind users and in greyscale printing.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .b { display: inline-flex; align-items: center; gap: .45rem; padding: .3rem .7rem; border-radius: 999px;\n      font-size: .8rem; font-weight: 700; background: rgba(52,211,153,.13); color: #34d399; }\n    .b i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }\n    .row { display: flex; gap: .5rem; }\n    .b.warn { background: rgba(251,191,36,.13); color: #fbbf24; }\n    .b.bad { background: rgba(248,113,113,.13); color: #f87171; }\n  </style>\n</head>\n<body>\n  <div class=\"row\"><span class=\"b\"><i></i>Operational</span><span class=\"b warn\"><i></i>Degraded</span><span class=\"b bad\"><i></i>Down</span></div>\n</body>\n</html>\n"
