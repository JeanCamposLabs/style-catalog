  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Cyber Loading Bar</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"neon-loading-bar-cyber\",\n    \"title\": \"Cyber Loading Bar\",\n    \"summary\": \"An angular loading bar with a chevron fill.\",\n    \"description\": \"An angular loading bar with a chevron fill.\",\n    \"theme\": \"neon-cyberpunk\",\n    \"categories\": [\"neon\", \"cyberpunk\"],\n    \"tags\": [\"neon\", \"glow\", \"dark\", \"loading\", \"angular\", \"cyber\", \"bar\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Saturated glow on black is hard to read: keep body copy near-white and unglowing, and reserve neon for accents.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Bar colour\", \"default\": \"#22d3ee\" }\n    ],\n    \"variations\": [\"Retune the palette via the custom properties\", \"Slow the motion for an ambient version\"],\n    \"ai_usage\": \"Sci-fi loading states. Skewed clip-path plus marching chevrons gives the genre look without any extra assets.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; height: 22px; background: #0a1520; border: 1px solid #22d3ee;\n      clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 100%, 10px 100%); overflow: hidden; }\n    .fx i { display: block; height: 100%; width: 62%;\n      background: repeating-linear-gradient(115deg, #22d3ee 0 10px, #0e7490 10px 20px); animation: march .8s linear infinite; }\n    @keyframes march { to { background-position: 22px 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"progressbar\" aria-valuenow=\"62\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i></i></div>\n</body>\n</html>\n"
