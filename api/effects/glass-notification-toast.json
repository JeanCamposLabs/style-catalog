  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Glass Toast</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"glass-notification-toast\",\n    \"title\": \"Glass Toast\",\n    \"summary\": \"A translucent notification over content.\",\n    \"description\": \"A translucent notification over content.\",\n    \"theme\": \"glass-neumorphism\",\n    \"categories\": [\"glass\", \"surface\"],\n    \"tags\": [\"glass\", \"surface\", \"glass\", \"toast\", \"notification\", \"overlay\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Translucent surfaces easily fall below contrast minimums — check text and borders against the busiest part of the backdrop.\",\n    \"customization\": [\n      { \"name\": \"--blur\", \"description\": \"Backdrop blur\", \"default\": \"16px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Notifications over media. On glass, white text needs a text-shadow or a slightly more opaque panel — a bright backdrop can push contrast below 3:1 at any moment.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { background: conic-gradient(from 40deg at 60% 40%, #7c5cff, #2dd4bf, #d1478c, #7c5cff); }\n    .fx { display: flex; align-items: center; gap: .8rem; width: 280px; padding: .8rem 1rem; border-radius: 14px;\n      background: rgba(255,255,255,.18); backdrop-filter: blur(16px) saturate(1.7);\n      -webkit-backdrop-filter: blur(16px) saturate(1.7); border: 1px solid rgba(255,255,255,.35); color: #fff;\n      box-shadow: 0 16px 40px rgba(0,0,0,.3); }\n    .fx .ic { width: 26px; height: 26px; border-radius: 50%; background: rgba(255,255,255,.9); color: #0b0d12;\n      display: grid; place-items: center; font-weight: 900; flex: none; }\n    .fx p { margin: 0; font-size: .86rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\"><span class=\"ic\" aria-hidden=\"true\">✓</span><p>Specimen added to your bundle</p></div>\n</body>\n</html>\n"
