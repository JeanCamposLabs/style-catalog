  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Paint Trail</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-brush-paint-trail\",\n    \"title\": \"Paint Trail\",\n    \"summary\": \"A stroke painted along the pointer path.\",\n    \"description\": \"A stroke painted along the pointer path.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"pointer\"],\n    \"tags\": [\"cursor\", \"pointer\", \"paint\", \"brush\", \"canvas\", \"trail\"],\n    \"tech\": [\"css\", \"js\", \"canvas\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Custom cursors are gated to fine pointers; touch and reduced-motion users keep the native cursor and full functionality.\",\n    \"customization\": [\n      { \"name\": \"--w\", \"description\": \"Stroke width\", \"default\": \"6\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Drawing and signature surfaces. Track pointer events (not mouse) so pens and touch work, and use setPointerCapture so a stroke continues when the pointer leaves the canvas.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; height: 170px; border-radius: 14px; background: #151b2a; border: 1px solid #263149; cursor: crosshair; }\n    canvas { display: block; width: 100%; height: 100%; border-radius: 14px; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><canvas id=\"pt2\"></canvas></div>\n  <script>\n    (function () {\n      var c = document.getElementById(\"pt2\"), x = c.getContext(\"2d\"), down = false;\n      c.width = 290; c.height = 170;\n      x.strokeStyle = \"#7c5cff\"; x.lineWidth = 6; x.lineCap = \"round\"; x.lineJoin = \"round\";\n      function pos(e) { var r = c.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; }\n      c.addEventListener(\"pointerdown\", function (e) { down = true; c.setPointerCapture(e.pointerId); var p = pos(e); x.beginPath(); x.moveTo(p[0], p[1]); });\n      c.addEventListener(\"pointermove\", function (e) { if (!down) return; var p = pos(e); x.lineTo(p[0], p[1]); x.stroke(); });\n      [\"pointerup\", \"pointercancel\"].forEach(function (ev) { c.addEventListener(ev, function () { down = false; }); });\n    })();\n  </script>\n</body>\n</html>\n"
}
