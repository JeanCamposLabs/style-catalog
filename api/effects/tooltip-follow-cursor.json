  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Cursor-Following Tooltip</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"tooltip-follow-cursor\",\n    \"title\": \"Cursor-Following Tooltip\",\n    \"summary\": \"A hint that trails the pointer across a region.\",\n    \"description\": \"A hint that trails the pointer across a region.\",\n    \"theme\": \"tooltips-popovers\",\n    \"categories\": [\"tooltip\", \"overlay\"],\n    \"tags\": [\"tooltip\", \"popover\", \"cursor\", \"follow\", \"chart\", \"hint\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Hover-only content is unreachable by keyboard and touch: show on focus too, link with aria-describedby, and never put interactive content in a hover tooltip.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Tip colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Charts and maps where the hint must track a value under the pointer. Offset it from the cursor so it never sits under the pointer itself.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .zone { width: 300px; height: 170px; border-radius: 14px; border: 1px dashed #2b3450; display: grid; place-items: center;\n      color: #8b93a7; background: #10141f; }\n    .tip { position: fixed; padding: .3rem .6rem; border-radius: 7px; background: #7c5cff; color: #fff; font-size: .78rem;\n      font-weight: 600; pointer-events: none; opacity: 0; transition: opacity .15s; translate: 12px 12px; }\n    .zone:hover ~ .tip { opacity: 1; }\n  </style>\n</head>\n<body>\n  <div class=\"zone\">Move across this area</div><div class=\"tip\" id=\"tip\" role=\"status\">x: 0</div>\n  <script>\n    (function () {\n      var z = document.querySelector(\".zone\"), t = document.getElementById(\"tip\");\n      z.addEventListener(\"pointermove\", function (e) {\n        var r = z.getBoundingClientRect();\n        t.style.left = e.clientX + \"px\"; t.style.top = e.clientY + \"px\";\n        t.textContent = \"x: \" + Math.round(e.clientX - r.left);\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
