  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Revealed Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"bg-dot-grid-spotlight-reveal\",\n    \"title\": \"Revealed Grid\",\n    \"summary\": \"A dot grid visible only near the pointer.\",\n    \"description\": \"A dot grid visible only near the pointer.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"surface\"],\n    \"tags\": [\"background\", \"grid\", \"mask\", \"pointer\", \"reveal\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep text contrast above 4.5:1 and stop drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--r\", \"description\": \"Reveal radius\", \"default\": \"260px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Interactive dark heroes. Masking the pattern rather than fading a full-strength grid keeps the resting page completely clean.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    .bg { background: #0b0d12; }\n    .bg::after { content: \"\"; position: absolute; inset: 0;\n      background-image: radial-gradient(rgba(124,92,255,.7) 1.4px, transparent 1.5px); background-size: 22px 22px;\n      -webkit-mask-image: radial-gradient(260px circle at var(--x, 50%) var(--y, 50%), #000 10%, transparent 70%);\n      mask-image: radial-gradient(260px circle at var(--x, 50%) var(--y, 50%), #000 10%, transparent 70%); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\" id=\"dg\"></div>\n  <script>\n    (function () {\n      var el = document.getElementById(\"dg\");\n      addEventListener(\"pointermove\", function (e) {\n        el.style.setProperty(\"--x\", e.clientX + \"px\");\n        el.style.setProperty(\"--y\", e.clientY + \"px\");\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
