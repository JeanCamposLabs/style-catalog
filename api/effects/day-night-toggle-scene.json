  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Day / Night Scene</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"day-night-toggle-scene\",\n    \"title\": \"Day / Night Scene\",\n    \"summary\": \"A scene that crossfades between day and night.\",\n    \"description\": \"A scene that crossfades between day and night.\",\n    \"theme\": \"weather-ambient\",\n    \"categories\": [\"weather\", \"ambient\"],\n    \"tags\": [\"weather\", \"ambient\", \"day-night\", \"cycle\", \"crossfade\", \"theme\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Flashing weather effects (lightning) can be a seizure risk — keep flashes infrequent, low-contrast, and disabled under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Cycle length\", \"default\": \"10s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Slow it down for an ambient version\"],\n    \"ai_usage\": \"Theme switchers and time-of-day states. Crossfade two stacked skies rather than animating one gradient's stops, which browsers cannot interpolate smoothly.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 260px; height: 150px; border-radius: 14px; overflow: hidden; }\n    .fx .sky { position: absolute; inset: 0; animation: cycle 10s ease-in-out infinite alternate; }\n    .fx .day { background: linear-gradient(180deg, #38bdf8, #bae6fd); }\n    .fx .night { background: linear-gradient(180deg, #0f172a, #1e293b); opacity: 0; animation-name: cyclen; }\n    .fx .orb { position: absolute; top: 22%; left: 50%; translate: -50% 0; width: 46px; height: 46px; border-radius: 50%;\n      background: #fde68a; box-shadow: 0 0 34px #fbbf24; animation: arc 10s ease-in-out infinite alternate; }\n    @keyframes cycle { to { opacity: 1; } }\n    @keyframes cyclen { from { opacity: 0; } to { opacity: 1; } }\n    @keyframes arc { from { transform: translate(-90px, 30px); } to { transform: translate(90px, 30px); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"sky day\"></span><span class=\"sky night\"></span><span class=\"orb\"></span></div>\n</body>\n</html>\n"
