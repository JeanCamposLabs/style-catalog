  "ai_usage": "Hacker and cyberpunk pages. Do not clear the canvas each frame — paint rgba(0,0,0,.06) over it so old glyphs decay into the trail. Respect reduced motion by rendering one static frame.",
  "path": "effects/backgrounds/matrix-rain-bg.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Matrix Rain</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"matrix-rain-bg\",\n    \"title\": \"Matrix Rain\",\n    \"summary\": \"Columns of falling glyphs rendered on a canvas.\",\n    \"description\": \"A translucent black fill each frame leaves the trailing streak, which is what makes the rain read as light rather than characters.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"retro\"],\n    \"tags\": [\"matrix\", \"canvas\", \"rain\", \"glyphs\", \"cyberpunk\"],\n    \"tech\": [\"js\", \"canvas\"],\n    \"era\": \"1990s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"One canvas, one rAF loop, ~40 columns — cheap, but pause it when off-screen.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Glyph color\", \"default\": \"#34d399\" }\n    ],\n    \"variations\": [\"Katakana glyph set\", \"Slower fall for an ambient version\", \"Fade the top for a vignette\"],\n    \"ai_usage\": \"Hacker and cyberpunk pages. Do not clear the canvas each frame — paint rgba(0,0,0,.06) over it so old glyphs decay into the trail. Respect reduced motion by rendering one static frame.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    canvas { display: block; width: 100%; height: 100%; }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"><canvas id=\"c\"></canvas></div>\n  <script>\n    (function () {\n      var c = document.getElementById(\"c\"), x = c.getContext(\"2d\");\n      var chars = \"01アイウエオカキクケコサシスセソ\", size = 16, cols, drops;\n      function fit() {\n        c.width = c.offsetWidth; c.height = c.offsetHeight;\n        cols = Math.floor(c.width / size); drops = [];\n        for (var i = 0; i < cols; i++) drops[i] = Math.random() * -50;\n      }\n      fit(); addEventListener(\"resize\", fit);\n      var reduce = matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n      function frame() {\n        x.fillStyle = \"rgba(6,10,8,.08)\"; x.fillRect(0, 0, c.width, c.height);\n        x.fillStyle = \"#34d399\"; x.font = size + \"px monospace\";\n        for (var i = 0; i < cols; i++) {\n          x.fillText(chars[Math.floor(Math.random() * chars.length)], i * size, drops[i] * size);\n          if (drops[i] * size > c.height && Math.random() > 0.975) drops[i] = 0;\n          drops[i]++;\n        }\n        if (!reduce) requestAnimationFrame(frame);\n      }\n      frame();\n    })();\n  </script>\n</body>\n</html>\n"
}
