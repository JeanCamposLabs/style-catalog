ransparent 5px, #000 6px), radial-gradient(circle 5px at 50% 0, transparent 5px, #000 6px);\n      -webkit-mask-size: 14px 14px; mask-size: 14px 14px; -webkit-mask-composite: source-in; mask-composite: intersect; }\n    .fx .inner { height: 100%; border: 1px solid #92400e; display: grid; place-items: center; gap: .3rem;\n      color: #92400e; font-family: Georgia, serif; text-align: center; }\n    .fx .val { font-size: 1.6rem; font-weight: 700; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"inner\"><div class=\"val\">42¢</div><div>AIRMAIL</div></div></div>\n</body>\n</html>\n"
