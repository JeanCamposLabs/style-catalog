  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Field Add-ons</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"input-prefix-suffix-addons\",\n    \"title\": \"Field Add-ons\",\n    \"summary\": \"A field with attached prefix and suffix.\",\n    \"description\": \"A field with attached prefix and suffix.\",\n    \"theme\": \"forms-inputs\",\n    \"categories\": [\"form\", \"input\"],\n    \"tags\": [\"form\", \"input\", \"prefix\", \"suffix\", \"addon\", \"units\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every control keeps a real label, a visible focus ring, and error state conveyed by text as well as colour.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Focus colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"URLs, currencies, and units. Add-ons must not be the only place the unit appears — repeat it in the label or hint so it is announced with the field.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; width: 280px; border-radius: 12px; overflow: hidden; border: 1px solid #2b3450; background: #151b2a; }\n    .fx span { display: grid; place-items: center; padding: 0 .8rem; background: #1c2437; color: #8b93a7; font-size: .85rem; }\n    .fx input { flex: 1; min-width: 0; padding: .8rem .7rem; border: 0; background: transparent; color: #e7ebf3; font: inherit; }\n    .fx input:focus { outline: none; }\n    .fx:focus-within { border-color: #7c5cff; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span>https://</span><label class=\"sr\" for=\"dm\" style=\"position:absolute;left:-9999px\">Domain</label>\n  <input id=\"dm\" type=\"text\" value=\"catalog\" /><span>.dev</span></div>\n</body>\n</html>\n"
