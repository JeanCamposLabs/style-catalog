  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Breathing Glow</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"text-glow-breathe\",\n    \"title\": \"Breathing Glow\",\n    \"summary\": \"Text with a glow that swells and fades.\",\n    \"description\": \"Text with a glow that swells and fades.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"typography\"],\n    \"tags\": [\"text\", \"type\", \"glow\", \"breathe\", \"pulse\", \"ambient\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative duplicates are aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Glow colour\", \"default\": \"#38bdf8\" },\n      { \"name\": \"--dur\", \"description\": \"Breath period\", \"default\": \"3s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Ambient headings in dark UIs. Animate only the shadow, never the text colour, so contrast never drops below the readable threshold.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { font-size: 2rem; font-weight: 800; color: #e0f2fe; animation: glow 3s ease-in-out infinite alternate; }\n    @keyframes glow {\n      from { text-shadow: 0 0 6px rgba(56,189,248,.5), 0 0 16px rgba(56,189,248,.3); }\n      to { text-shadow: 0 0 12px rgba(56,189,248,.9), 0 0 34px rgba(56,189,248,.6); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <h2 class=\"fx\">Ambient</h2>\n</body>\n</html>\n"
