  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Cylinder Carousel</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"carousel-cylinder-3d\",\n    \"title\": \"Cylinder Carousel\",\n    \"summary\": \"Panels arranged around a rotating cylinder.\",\n    \"description\": \"Panels arranged around a rotating cylinder.\",\n    \"theme\": \"3d-transforms\",\n    \"categories\": [\"3d\", \"transform\"],\n    \"tags\": [\"3d\", \"transform\", \"carousel\", \"cylinder\", \"rotate\", \"panels\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"3D motion is a common trigger for vestibular discomfort — keep rotations small and stop them under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--r\", \"description\": \"Cylinder radius\", \"default\": \"180px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Rotating showcases. The translateZ radius must be about (panelWidth / 2) / tan(180° / count) or the panels overlap or leave gaps.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .scene { perspective: 900px; width: 220px; height: 140px; }\n    .cyl { position: relative; width: 100%; height: 100%; transform-style: preserve-3d;\n      animation: spin 16s linear infinite; }\n    .p { position: absolute; inset: 0; border-radius: 12px; display: grid; place-items: center; font-weight: 800;\n      color: #0b0d12; transform: rotateY(var(--a)) translateZ(180px); backface-visibility: hidden; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"scene\"><div class=\"cyl\">\n    <span class=\"p\" style=\"--a:0deg;background:#7c5cff\">1</span><span class=\"p\" style=\"--a:60deg;background:#10a894\">2</span>\n    <span class=\"p\" style=\"--a:120deg;background:#c2891a\">3</span><span class=\"p\" style=\"--a:180deg;background:#d1478c\">4</span>\n    <span class=\"p\" style=\"--a:240deg;background:#2f7cc9\">5</span><span class=\"p\" style=\"--a:300deg;background:#a855f7\">6</span></div></div>\n</body>\n</html>\n"
