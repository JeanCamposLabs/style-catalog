  "path": "effects/hover-interactions/letter-hover-scatter.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Letters Scatter on Hover</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"letter-hover-scatter\",\n    \"title\": \"Letters Scatter on Hover\",\n    \"summary\": \"Passing the pointer over a word nudges each letter away from it.\",\n    \"description\": \"Per-letter displacement falls off with distance from the pointer, so the word parts like water rather than shifting as a block.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"text\"],\n    \"tags\": [\"letters\", \"scatter\", \"pointer\", \"falloff\", \"kinetic\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--push\", \"description\": \"Maximum displacement\", \"default\": \"22px\" }\n    ],\n    \"variations\": [\"Push toward the pointer instead\", \"Scale letters by proximity\", \"Colour shift on the nearest letter\"],\n    \"ai_usage\": \"Playful headings. Compute each letter's centre once (not per frame), then displace by (1 - dist/radius) — recalculating layout every pointermove is what makes naive versions janky.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .scat { font-size: clamp(2rem, 8vw, 3.4rem); font-weight: 900; display: flex; cursor: default; }\n    .scat span { display: inline-block; transition: transform .25s cubic-bezier(.2,.8,.3,1); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <h1 class=\"scat\" id=\"sc\" aria-label=\"MAGNETIC\"></h1>\n  <script>\n    (function () {\n      var host = document.getElementById(\"sc\"), word = \"MAGNETIC\";\n      word.split(\"\").forEach(function (ch) {\n        var s = document.createElement(\"span\"); s.textContent = ch; s.setAttribute(\"aria-hidden\", \"true\"); host.appendChild(s);\n      });\n      var spans = [].slice.call(host.children);\n      host.addEventListener(\"pointermove\", function (e) {\n        spans.forEach(function (s) {\n          var r = s.getBoundingClientRect(), cx = r.left + r.width / 2, cy = r.top + r.height / 2;\n          var dx = cx - e.clientX, dy = cy - e.clientY, d = Math.hypot(dx, dy);\n          var f = Math.max(0, 1 - d / 140);\n          s.style.transform = \"translate(\" + (dx * f * .5) + \"px,\" + (dy * f * .5) + \"px)\";\n        });\n      });\n      host.addEventListener(\"pointerleave\", function () {\n        spans.forEach(function (s) { s.style.transform = \"\"; });\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
