  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Inventory Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"inventory-slots\",\n    \"title\": \"Inventory Grid\",\n    \"summary\": \"A grid of item slots with rarity borders.\",\n    \"description\": \"A grid of item slots with rarity borders.\",\n    \"theme\": \"game-ui\",\n    \"categories\": [\"game\", \"ui\"],\n    \"tags\": [\"game\", \"hud\", \"inventory\", \"slots\", \"grid\", \"rarity\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Game HUDs still need real semantics: use progressbar roles for meters and buttons for slots so the interface is operable without sight.\",\n    \"customization\": [\n      { \"name\": \"--slot\", \"description\": \"Slot colour\", \"default\": \"#1c2333\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Inventory and loadout screens. Rarity must be encoded by border colour plus glow plus a label — colour alone fails for a large share of players.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; grid-template-columns: repeat(4, 54px); gap: 6px; padding: 8px; border-radius: 10px;\n      background: #14161f; border: 2px solid #2b3450; }\n    .fx .slot { width: 54px; height: 54px; border-radius: 7px; background: #1c2333; border: 2px solid #2b3450;\n      display: grid; place-items: center; font-size: 1.3rem; cursor: pointer; }\n    .fx .slot:hover { border-color: #7c5cff; }\n    .fx .rare { border-color: #38bdf8; box-shadow: inset 0 0 12px rgba(56,189,248,.35); }\n    .fx .epic { border-color: #a855f7; box-shadow: inset 0 0 12px rgba(168,85,247,.35); }\n    .fx .count { position: relative; }\n    .fx .count::after { content: attr(data-n); position: absolute; right: 2px; bottom: 0; font-size: .65rem; color: #cbd5e1; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"group\" aria-label=\"Inventory\">\n    <button class=\"slot rare\" aria-label=\"Frost blade, rare\">🗡</button>\n    <button class=\"slot\" aria-label=\"Empty slot\"></button>\n    <button class=\"slot epic\" aria-label=\"Void orb, epic\">🔮</button>\n    <button class=\"slot count\" data-n=\"12\" aria-label=\"Potion, 12\">🧪</button>\n    <button class=\"slot\" aria-label=\"Empty slot\"></button><button class=\"slot\" aria-label=\"Shield\">🛡</button>\n    <button class=\"slot\" aria-label=\"Empty slot\"></button><button class=\"slot\" aria-label=\"Empty slot\"></button>\n  </div>\n</body>\n</html>\n"
}
