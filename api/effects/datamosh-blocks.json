inset: 0; background: inherit; animation: mosh 4s steps(1) infinite; }\n    .fx i:nth-child(2) { animation-delay: .6s; }\n    @keyframes mosh {\n      0%, 70%, 100% { clip-path: inset(0 0 100% 0); transform: none; }\n      74% { clip-path: inset(22% 0 60% 0); transform: translateX(14px); }\n      78% { clip-path: inset(58% 0 24% 0); transform: translateX(-18px); }\n      82% { clip-path: inset(40% 0 46% 0); transform: translateX(9px); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><i></i><i></i></div>\n</body>\n</html>\n"
