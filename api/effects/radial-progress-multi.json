  "path": "effects/charts-dataviz/radial-progress-multi.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Radial Comparison</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"radial-progress-multi\",\n    \"title\": \"Radial Comparison\",\n    \"summary\": \"Three metrics as concentric arcs with a legend.\",\n    \"description\": \"Three metrics as concentric arcs with a legend.\",\n    \"theme\": \"charts-dataviz\",\n    \"categories\": [\"chart\", \"dataviz\"],\n    \"tags\": [\"chart\", \"data\", \"radial\", \"rings\", \"activity\", \"comparison\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Identity is never colour-alone: every multi-series chart ships a legend, direct labels where they fit, and an equivalent table or accessible summary. Grid lines and axes stay recessive; values wear text colours, not series colours.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Outer percent\", \"default\": \"78\" },\n      { \"name\": \"--b\", \"description\": \"Middle percent\", \"default\": \"54\" },\n      { \"name\": \"--c\", \"description\": \"Inner percent\", \"default\": \"32\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"Three bounded percentages at a glance. Concentric arcs of different radii are not length-comparable, so always print the numbers beside them — the rings are an index, not the measurement.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { --c1: #7c5cff; --c2: #10a894; --c3: #c2891a; --c4: #d1478c; --c5: #2f7cc9;\n      --ink: #e7ebf3; --ink-2: #8b93a7; --grid: rgba(139,147,167,.22); --surface: #0b0d12; display: flex; align-items: center; gap: 1.2rem; }\n    .fx .rings { position: relative; width: 140px; aspect-ratio: 1; }\n    .fx .r { position: absolute; border-radius: 50%; }\n    .fx .r1 { inset: 0; background: conic-gradient(var(--c1) calc(var(--a) * 1%), #1b2231 0);\n      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 13px), #000 0); mask: radial-gradient(farthest-side, transparent calc(100% - 13px), #000 0); }\n    .fx .r2 { inset: 19px; background: conic-gradient(var(--c2) calc(var(--b) * 1%), #1b2231 0);\n      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 13px), #000 0); mask: radial-gradient(farthest-side, transparent calc(100% - 13px), #000 0); }\n    .fx .r3 { inset: 38px; background: conic-gradient(var(--c3) calc(var(--c) * 1%), #1b2231 0);\n      -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 13px), #000 0); mask: radial-gradient(farthest-side, transparent calc(100% - 13px), #000 0); }\n    .fx .legend { display: grid; gap: .5rem; font-size: .78rem; color: var(--ink-2); }\n    .fx .legend span { display: flex; align-items: center; gap: .45rem; }\n    .fx .legend i { width: 10px; height: 10px; border-radius: 3px; }\n    .fx .legend b { color: var(--ink); font-variant-numeric: tabular-nums; }\n  </style>\n</head>\n<body>\n  <figure class=\"fx\" style=\"margin:0\"><div class=\"rings\" style=\"--a:78;--b:54;--c:32\" role=\"img\" aria-label=\"Coverage 78 percent, posters 54 percent, docs 32 percent\">\n    <div class=\"r r1\"></div><div class=\"r r2\"></div><div class=\"r r3\"></div></div>\n  <div class=\"legend\"><span><i style=\"background:var(--c1)\"></i>Coverage <b>78%</b></span>\n  <span><i style=\"background:var(--c2)\"></i>Posters <b>54%</b></span><span><i style=\"background:var(--c3)\"></i>Docs <b>32%</b></span></div></figure>\n</body>\n</html>\n"
}
