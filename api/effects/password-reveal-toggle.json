  "path": "effects/micro-interactions/password-reveal-toggle.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Password Reveal</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"password-reveal-toggle\",\n    \"title\": \"Password Reveal\",\n    \"summary\": \"A field with a show/hide control.\",\n    \"description\": \"A field with a show/hide control.\",\n    \"theme\": \"micro-interactions\",\n    \"categories\": [\"micro-interaction\", \"feedback\"],\n    \"tags\": [\"micro-interaction\", \"feedback\", \"password\", \"reveal\", \"toggle\", \"form\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every micro-interaction must have a non-animated equivalent: state changes are announced through ARIA, not through motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Icon colour\", \"default\": \"#8b93a7\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Password fields. Toggle the input type and update the button's accessible name to 'Show'/'Hide'; never render the password in a tooltip or title.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 280px; }\n    .fx input { width: 100%; padding: .8rem 3rem .8rem 1rem; border-radius: 12px; border: 1px solid #2b3450;\n      background: #151b2a; color: #e7ebf3; font: inherit; letter-spacing: .1em; }\n    .fx button { position: absolute; right: .5rem; top: 50%; translate: 0 -50%; width: 34px; height: 34px; border: 0;\n      border-radius: 9px; background: transparent; color: #8b93a7; cursor: pointer; }\n    .fx button:hover { background: #1e2740; color: #e7ebf3; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><input type=\"password\" value=\"correcthorsebattery\" aria-label=\"Password\" id=\"pw\" />\n  <button type=\"button\" aria-label=\"Show password\" id=\"pt\">👁</button></div>\n  <script>\n    (function () {\n      var i = document.getElementById(\"pw\"), b = document.getElementById(\"pt\");\n      b.addEventListener(\"click\", function () {\n        var show = i.type === \"password\";\n        i.type = show ? \"text\" : \"password\";\n        b.setAttribute(\"aria-label\", show ? \"Hide password\" : \"Show password\");\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
