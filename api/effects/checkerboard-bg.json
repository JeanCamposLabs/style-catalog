  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Checkerboard</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"checkerboard-bg\",\n    \"title\": \"Checkerboard\",\n    \"summary\": \"A classic two-tone checker built from two offset conic gradients.\",\n    \"description\": \"One conic-gradient tile with four quadrants tiles into a perfect checker at any size.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"pattern\"],\n    \"tags\": [\"checker\", \"conic-gradient\", \"tile\", \"retro\", \"pattern\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Square A\", \"default\": \"#11161f\" },\n      { \"name\": \"--b\", \"description\": \"Square B\", \"default\": \"#0b0d12\" },\n      { \"name\": \"--s\", \"description\": \"Square size\", \"default\": \"40px\" }\n    ],\n    \"variations\": [\"Rotate 45° for a diamond check\", \"Animate the tile size\", \"High-contrast racing flag\"],\n    \"ai_usage\": \"Transparency indicators, retro sections, and image placeholders. conic-gradient(#a 0 25%, #b 0 50%, #a 0 75%, #b 0) with background-size: 2×square is the shortest correct checker in CSS.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --a: #11161f; --b: #0b0d12; --s: 40px; }\n    .bg { background: conic-gradient(var(--a) 0 25%, var(--b) 0 50%, var(--a) 0 75%, var(--b) 0);\n      background-size: var(--s) var(--s); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
