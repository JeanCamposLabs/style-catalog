  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Milestone Bar</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"progress-timeline-bar\",\n    \"title\": \"Milestone Bar\",\n    \"summary\": \"A progress bar with milestone markers along it.\",\n    \"description\": \"A progress bar with milestone markers along it.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"milestones\", \"markers\", \"roadmap\", \"stages\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Percent complete\", \"default\": \"58\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Roadmaps and delivery tracking. Position markers by percentage so they stay aligned when the bar is fluid width.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .mb { width: 320px; padding-top: 1.6rem; }\n    .mb .bar { position: relative; height: 6px; border-radius: 999px; background: #22304a; }\n    .mb .bar i { display: block; height: 100%; width: calc(var(--p) * 1%); border-radius: 999px; background: #7c5cff; }\n    .mb .m { position: absolute; top: 50%; translate: -50% -50%; width: 14px; height: 14px; border-radius: 50%;\n      background: #0b0d12; border: 2px solid #3b465e; }\n    .mb .m.done { border-color: #7c5cff; background: #7c5cff; }\n    .mb .m span { position: absolute; bottom: 18px; left: 50%; translate: -50% 0; white-space: nowrap; font-size: .72rem; color: #8b93a7; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"mb\" style=\"--p:58\"><div class=\"bar\" role=\"progressbar\" aria-valuenow=\"58\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i></i>\n    <span class=\"m done\" style=\"left:0\"><span>Kickoff</span></span>\n    <span class=\"m done\" style=\"left:35%\"><span>Alpha</span></span>\n    <span class=\"m\" style=\"left:70%\"><span>Beta</span></span>\n    <span class=\"m\" style=\"left:100%\"><span>GA</span></span>\n  </div></div>\n</body>\n</html>\n"
}
