  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Rolling Count Badge</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"badge-animated-counter\",\n    \"title\": \"Rolling Count Badge\",\n    \"summary\": \"A count that rolls when it changes.\",\n    \"description\": \"A count that rolls when it changes. Small self-contained component ready to drop into a list or card.\",\n    \"theme\": \"badges-tags\",\n    \"categories\": [\"badge\", \"label\"],\n    \"tags\": [\"badge\", \"label\", \"counter\", \"roll\", \"animated\", \"live\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Status must never be colour-only: pair every badge colour with a label, icon, or shape.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Roll interval\", \"default\": \"5s\" }\n    ],\n    \"variations\": [\"Add a size variant\", \"Map colours to semantic tokens\"],\n    \"ai_usage\": \"Live counters (viewers, likes). Roll in whole line-height steps so digits always land aligned; announce updates sparingly with aria-live=polite.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .b { display: inline-flex; align-items: center; gap: .4rem; padding: .3rem .8rem; border-radius: 999px;\n      background: #1c2437; color: #cbd5e1; font-size: .85rem; font-weight: 700; }\n    .b .win { height: 1.2em; overflow: hidden; }\n    .b .win span { display: block; height: 1.2em; line-height: 1.2em; color: #34d399;\n      animation: roll 5s steps(5) infinite; }\n    @keyframes roll { to { transform: translateY(-600%); } }\n  </style>\n</head>\n<body>\n  <span class=\"b\">Online <span class=\"win\" aria-hidden=\"true\"><span>128</span><span>129</span><span>131</span><span>134</span><span>136</span><span>128</span></span></span>\n</body>\n</html>\n"
