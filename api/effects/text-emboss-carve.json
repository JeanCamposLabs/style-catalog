  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Carved Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"text-emboss-carve\",\n    \"title\": \"Carved Text\",\n    \"summary\": \"Type carved into a stone-like surface.\",\n    \"description\": \"Type carved into a stone-like surface.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"typography\"],\n    \"tags\": [\"text\", \"type\", \"carve\", \"emboss\", \"deboss\", \"stone\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative duplicates are aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--surface\", \"description\": \"Surface colour\", \"default\": \"#23262c\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Physical-material headings. Carving needs a mid-tone surface and a text colour identical to it — the effect lives entirely in the two one-pixel shadows.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { background: #23262c; }\n    .fx { font-size: 2.2rem; font-weight: 900; color: #23262c;\n      text-shadow: 0 -1px 1px rgba(0,0,0,.9), 0 1px 1px rgba(255,255,255,.14); letter-spacing: .02em; }\n  </style>\n</head>\n<body>\n  <h2 class=\"fx\">CARVED</h2>\n</body>\n</html>\n"
