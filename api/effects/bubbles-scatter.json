  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Bubble Field</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"bubbles-scatter\",\n    \"title\": \"Bubble Field\",\n    \"summary\": \"Outlined bubbles of assorted sizes.\",\n    \"description\": \"Outlined bubbles of assorted sizes. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"bubbles\", \"circles\", \"water\", \"scatter\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Bubble colour\", \"default\": \"rgba(125,211,252,.3)\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Aquatic and playful surfaces. Ring-shaped radial gradients (transparent, colour, transparent) give outlines without extra elements.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(125,211,252,.3); }\n    .bg { background-color: #06121c;\n      background-image: radial-gradient(circle at 20% 30%, transparent 0 10px, var(--c) 10px 11px, transparent 12px),\n        radial-gradient(circle at 70% 60%, transparent 0 16px, var(--c) 16px 17px, transparent 18px),\n        radial-gradient(circle at 45% 85%, transparent 0 7px, var(--c) 7px 8px, transparent 9px);\n      background-size: 120px 120px, 170px 170px, 90px 90px; }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
