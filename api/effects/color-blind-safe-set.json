{ font-size: .68rem; color: #64748b; margin-bottom: .3rem; font-family: ui-monospace, monospace; }\n    .fx .sim { filter: url(#deut); }\n    svg.defs { position: absolute; width: 0; height: 0; }\n  </style>\n</head>\n<body>\n  <svg class=\"defs\" aria-hidden=\"true\"><filter id=\"deut\"><feColorMatrix type=\"matrix\"\n    values=\"0.625 0.375 0 0 0  0.7 0.3 0 0 0  0 0.3 0.7 0 0  0 0 0 1 0\"/></filter></svg>\n  <div class=\"fx\"><div class=\"lbl\">normal vision</div>\n  <div class=\"row\"><i style=\"background:#7c5cff\"></i><i style=\"background:#10a894\"></i><i style=\"background:#c2891a\"></i>\n  <i style=\"background:#d1478c\"></i><i style=\"background:#2f7cc9\"></i></div>\n  <div class=\"lbl\">deuteranopia simulation</div>\n  <div class=\"row sim\"><i style=\"background:#7c5cff\"></i><i style=\"background:#10a894\"></i><i style=\"background:#c2891a\"></i>\n  <i style=\"background:#d1478c\"></i><i style=\"background:#2f7cc9\"></i></div></div>\n</body>\n</html>\n"
