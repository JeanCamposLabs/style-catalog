  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Focal Point Crop</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"image-focal-crop\",\n    \"title\": \"Focal Point Crop\",\n    \"summary\": \"The same image cropped around different focal points.\",\n    \"description\": \"The same image cropped around different focal points.\",\n    \"theme\": \"images-media\",\n    \"categories\": [\"image\", \"media\"],\n    \"tags\": [\"image\", \"media\", \"focal-point\", \"crop\", \"object-position\", \"responsive\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative images need empty alt; meaningful ones need real descriptions. Never convey information through a hover-only image treatment.\",\n    \"customization\": [\n      { \"name\": \"--pos\", \"description\": \"Object position\", \"default\": \"50% 50%\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Responsive imagery. Store a focal point per image and feed it to object-position so faces survive aggressive crops at narrow widths.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 10px; }\n    .c { width: 88px; height: 88px; border-radius: 10px; overflow: hidden; position: relative; }\n    .c .img { position: absolute; width: 200px; height: 140px;\n      background: conic-gradient(from 200deg at 30% 30%, #7c5cff, #2dd4bf, #c2891a, #d1478c); }\n    .tl .img { top: 0; left: 0; } .ctr .img { top: -26px; left: -56px; } .br .img { bottom: 0; right: 0; }\n    .lbl { text-align: center; font-size: .68rem; color: #64748b; margin-top: .35rem; }\n  </style>\n</head>\n<body>\n  <div><div class=\"fx\"><div><div class=\"c tl\"><div class=\"img\"></div></div><div class=\"lbl\">top left</div></div>\n  <div><div class=\"c ctr\"><div class=\"img\"></div></div><div class=\"lbl\">centre</div></div>\n  <div><div class=\"c br\"><div class=\"img\"></div></div><div class=\"lbl\">bottom right</div></div></div></div>\n</body>\n</html>\n"
