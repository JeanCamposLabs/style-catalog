  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Distance and Duration</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"motion-distance-duration\",\n    \"title\": \"Distance and Duration\",\n    \"summary\": \"Travel distance scaled to duration.\",\n    \"description\": \"Travel distance scaled to duration.\",\n    \"theme\": \"motion-principles\",\n    \"categories\": [\"motion\", \"reference\"],\n    \"tags\": [\"motion\", \"easing\", \"distance\", \"duration\", \"proportional\", \"physics\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every motion token here has a reduced-motion equivalent: durations collapse to zero rather than the animation being left half-played.\",\n    \"customization\": [\n      { \"name\": \"--rate\", \"description\": \"Pixels per ms\", \"default\": \"1.6\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Consistent motion. Duration should scale roughly with the square root of distance — a short slide at the same duration as a long one looks sluggish, and vice versa.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; display: grid; gap: .7rem; }\n    .r { font-size: .68rem; color: #64748b; font-family: ui-monospace, monospace; }\n    .t { height: 20px; border-radius: 99px; background: #151b2a; position: relative; margin-top: .25rem; }\n    .t i { position: absolute; top: 3px; left: 3px; width: 14px; height: 14px; border-radius: 50%; background: #2dd4bf;\n      animation: go var(--d) cubic-bezier(.7,0,.2,1) infinite alternate; }\n    .short .t { width: 40%; }\n    @keyframes go { to { left: calc(100% - 17px); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"short\"><div class=\"r\">short travel · 180ms</div><div class=\"t\"><i style=\"--d:180ms\"></i></div></div>\n  <div><div class=\"r\">long travel · 380ms</div><div class=\"t\"><i style=\"--d:380ms\"></i></div></div></div>\n</body>\n</html>\n"
