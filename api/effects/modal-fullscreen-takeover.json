  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Fullscreen Takeover</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"modal-fullscreen-takeover\",\n    \"title\": \"Fullscreen Takeover\",\n    \"summary\": \"A panel that expands from a card to fill the frame.\",\n    \"description\": \"A panel that expands from a card to fill the frame.\",\n    \"theme\": \"modals-overlays\",\n    \"categories\": [\"modal\", \"overlay\"],\n    \"tags\": [\"modal\", \"dialog\", \"expand\", \"takeover\", \"shared-element\", \"transition\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"A modal must trap focus, close on Escape, return focus to its trigger, and mark the page behind it inert. The <dialog> element gives most of this for free.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Expand duration\", \"default\": \"0.45s\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Shared-element transitions. Animating one element from card to fullscreen preserves context far better than cross-fading two separate views.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .stage { position: relative; width: 320px; height: 220px; border-radius: 18px; overflow: hidden; background: #10141f; border: 1px solid #263149; }\n    .card { position: absolute; top: 20px; left: 20px; width: 130px; height: 90px; border-radius: 14px;\n      background: linear-gradient(135deg, #7c5cff, #2dd4bf); cursor: pointer; border: 0;\n      transition: all .45s cubic-bezier(.7,0,.2,1); }\n    .stage.is-open .card { top: 0; left: 0; width: 100%; height: 100%; border-radius: 0; }\n    .body { position: absolute; inset: 0; padding: 1.4rem; color: #0b0d12; opacity: 0; transition: opacity .3s .15s; pointer-events: none; }\n    .stage.is-open .body { opacity: 1; pointer-events: auto; }\n    .body h3 { margin: 0 0 .4rem; }\n    .body p { margin: 0 0 1rem; font-size: .88rem; }\n    .body button { padding: .45rem 1rem; border-radius: 8px; border: 0; background: #0b0d12; color: #fff; font: inherit; cursor: pointer; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stage\" id=\"tk\"><button class=\"card\" type=\"button\" id=\"opn\" aria-expanded=\"false\" aria-label=\"Expand card\"></button>\n  <div class=\"body\"><h3>Expanded</h3><p>The same element grew to fill the frame.</p><button type=\"button\" id=\"cls\">Close</button></div></div>\n  <script>\n    (function () {\n      var s = document.getElementById(\"tk\");\n      document.getElementById(\"opn\").addEventListener(\"click\", function () { s.classList.add(\"is-open\"); });\n      document.getElementById(\"cls\").addEventListener(\"click\", function () { s.classList.remove(\"is-open\"); });\n    })();\n  </script>\n</body>\n</html>\n"
}
