  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Dolphin Grid Scene</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"vapor-dolphin-scene\",\n    \"title\": \"Dolphin Grid Scene\",\n    \"summary\": \"A composed scene with grid, sun, and silhouette.\",\n    \"description\": \"A composed scene with grid, sun, and silhouette.\",\n    \"theme\": \"vaporwave-synthwave\",\n    \"categories\": [\"retro\", \"vaporwave\"],\n    \"tags\": [\"vaporwave\", \"retro\", \"80s\", \"scene\", \"composition\", \"grid\", \"sun\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2000s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"High-saturation magenta on cyan is a contrast trap — keep body copy on a neutral surface.\",\n    \"customization\": [\n      { \"name\": \"--sun\", \"description\": \"Sun colour\", \"default\": \"#ff2d95\" }\n    ],\n    \"variations\": [\"Retune the palette via the custom properties\", \"Slow the motion for an ambient version\"],\n    \"ai_usage\": \"A complete synthwave backdrop in one element tree — sky gradient, banded sun, perspective grid, and a silhouette on top.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 300px; height: 200px; border-radius: 14px; overflow: hidden;\n      background: linear-gradient(180deg, #2b1055 0 58%, #0a0316 58%); }\n    .fx .sun { position: absolute; top: 16%; left: 50%; translate: -50% 0; width: 96px; height: 96px; border-radius: 50%;\n      background: linear-gradient(180deg, #fde68a, #ff2d95); }\n    .fx .grid { position: absolute; left: -60%; right: -60%; bottom: 0; height: 42%;\n      background-image: repeating-linear-gradient(90deg, rgba(34,211,238,.55) 0 2px, transparent 2px 40px),\n        repeating-linear-gradient(0deg, rgba(34,211,238,.55) 0 2px, transparent 2px 40px);\n      transform: perspective(150px) rotateX(70deg); transform-origin: bottom; }\n    .fx .icon { position: absolute; top: 26%; left: 50%; translate: -50% 0; font-size: 2.6rem; filter: drop-shadow(0 0 12px #22d3ee); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"sun\"></span><span class=\"icon\" aria-hidden=\"true\">🐬</span><span class=\"grid\"></span></div>\n</body>\n</html>\n"
