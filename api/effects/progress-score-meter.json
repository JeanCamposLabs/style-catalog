  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Score Meter</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"progress-score-meter\",\n    \"title\": \"Score Meter\",\n    \"summary\": \"A horizontal meter with threshold zones.\",\n    \"description\": \"A horizontal meter with threshold zones.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"score\", \"threshold\", \"zones\", \"rating\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Score position\", \"default\": \"78\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Credit scores, performance grades, and audits. Zone colours must be backed by labels — the bands are meaningless to a colour-blind user otherwise.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .sm { width: 300px; }\n    .sm .track { position: relative; height: 12px; border-radius: 999px;\n      background: linear-gradient(90deg, #f87171 0 33%, #fbbf24 33% 66%, #34d399 66%); }\n    .sm .pin { position: absolute; top: -6px; left: calc(var(--p) * 1%); translate: -50% 0; width: 4px; height: 24px;\n      border-radius: 2px; background: #e7ebf3; box-shadow: 0 0 0 3px #0b0d12; }\n    .sm .lbl { display: flex; justify-content: space-between; margin-top: .6rem; font-size: .75rem; color: #8b93a7; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"sm\" style=\"--p:78\"><div class=\"track\" role=\"meter\" aria-valuenow=\"78\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"Performance score\"><span class=\"pin\"></span></div>\n  <div class=\"lbl\"><span>Poor</span><span>Fair</span><span>Good</span></div></div>\n</body>\n</html>\n"
