  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Price Comparison</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"price-tier-compare\",\n    \"title\": \"Price Comparison\",\n    \"summary\": \"Three price points with the middle recommended.\",\n    \"description\": \"Three price points with the middle recommended.\",\n    \"theme\": \"ecommerce-ui\",\n    \"categories\": [\"ecommerce\", \"commerce\"],\n    \"tags\": [\"ecommerce\", \"shop\", \"pricing\", \"tiers\", \"compare\", \"bundle\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Price, stock, and discount information must be in text, never only a colour or a badge shape.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Highlight\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Bundle and quantity pickers. Show the unit price alongside the total — that is the number shoppers actually compare.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 10px; }\n    .p { width: 96px; padding: 1rem .7rem; border-radius: 14px; background: #151b2a; border: 1px solid #263149; text-align: center; }\n    .p.on { border-color: #7c5cff; background: #191331; }\n    .p .n { font-size: .78rem; color: #8b93a7; }\n    .p .v { font-size: 1.4rem; font-weight: 900; margin: .3rem 0; }\n    .p .u { font-size: .7rem; color: #8b93a7; }\n    .p .tag { display: inline-block; margin-top: .5rem; padding: .1rem .45rem; border-radius: 99px; background: #7c5cff;\n      color: #fff; font-size: .62rem; font-weight: 800; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"p\"><div class=\"n\">1 pack</div><div class=\"v\">$24</div><div class=\"u\">$24 each</div></div>\n  <div class=\"p on\"><div class=\"n\">3 pack</div><div class=\"v\">$59</div><div class=\"u\">$19.67 each</div><span class=\"tag\">BEST</span></div>\n  <div class=\"p\"><div class=\"n\">5 pack</div><div class=\"v\">$99</div><div class=\"u\">$19.80 each</div></div></div>\n</body>\n</html>\n"
