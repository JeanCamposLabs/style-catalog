  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Notched Outline Field</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"input-floating-label-outline\",\n    \"title\": \"Notched Outline Field\",\n    \"summary\": \"A label that notches into the field's border.\",\n    \"description\": \"A label that notches into the field's border.\",\n    \"theme\": \"forms-inputs\",\n    \"categories\": [\"form\", \"input\"],\n    \"tags\": [\"form\", \"input\", \"floating-label\", \"notch\", \"outline\", \"material\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every control keeps a real label, a visible focus ring, and error state conveyed by text as well as colour.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Focus colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Dense forms. The :not(:placeholder-shown) selector is what keeps the label raised after typing — it requires a placeholder attribute, even an empty one.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 280px; }\n    .fx input { width: 100%; padding: .95rem .9rem; border-radius: 12px; border: 1px solid #2b3450; background: transparent;\n      color: #e7ebf3; font: inherit; }\n    .fx label { position: absolute; left: .7rem; top: .95rem; padding: 0 .3rem; color: #64748b; pointer-events: none;\n      transition: transform .18s, font-size .18s, color .18s; background: #0b0d12; }\n    .fx input:focus { outline: none; border-color: #7c5cff; }\n    .fx input:focus + label, .fx input:not(:placeholder-shown) + label {\n      transform: translateY(-1.55rem); font-size: .74rem; color: #b9a5ff; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><input id=\"fl\" type=\"text\" placeholder=\" \" /><label for=\"fl\">Workspace name</label></div>\n</body>\n</html>\n"
