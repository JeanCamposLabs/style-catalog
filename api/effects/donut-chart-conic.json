  "ai_usage": "Part-to-whole with four or fewer slices. Insert a 0.6% surface-coloured gap between segments so the boundaries read without strokes. Beyond four slices a bar chart is easier to compare — angle is the hardest channel to judge.",
  "path": "effects/charts-dataviz/donut-chart-conic.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Donut Chart</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"donut-chart-conic\",\n    \"title\": \"Donut Chart\",\n    \"summary\": \"A part-to-whole donut with a centred total.\",\n    \"description\": \"A part-to-whole donut with a centred total.\",\n    \"theme\": \"charts-dataviz\",\n    \"categories\": [\"chart\", \"dataviz\"],\n    \"tags\": [\"chart\", \"data\", \"donut\", \"pie\", \"composition\", \"conic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Identity is never colour-alone: every multi-series chart ships a legend, direct labels where they fit, and an equivalent table or accessible summary. Grid lines and axes stay recessive; values wear text colours, not series colours.\",\n    \"customization\": [\n      { \"name\": \"--c1\", \"description\": \"Slice one\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--c2\", \"description\": \"Slice two\", \"default\": \"#10a894\" },\n      { \"name\": \"--c3\", \"description\": \"Slice three\", \"default\": \"#c2891a\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"Part-to-whole with four or fewer slices. Insert a 0.6% surface-coloured gap between segments so the boundaries read without strokes. Beyond four slices a bar chart is easier to compare — angle is the hardest channel to judge.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { --c1: #7c5cff; --c2: #10a894; --c3: #c2891a; --c4: #d1478c; --c5: #2f7cc9;\n      --ink: #e7ebf3; --ink-2: #8b93a7; --grid: rgba(139,147,167,.22); --surface: #0b0d12; display: flex; align-items: center; gap: 1.2rem; }\n    .fx .ring { position: relative; width: 130px; aspect-ratio: 1; border-radius: 50%;\n      background: conic-gradient(var(--c1) 0 48%, var(--surface) 0 48.6%, var(--c2) 0 74%, var(--surface) 0 74.6%, var(--c3) 0 90%, var(--surface) 0 90.6%, var(--c5) 0);\n      -webkit-mask: radial-gradient(farthest-side, transparent 62%, #000 63%); mask: radial-gradient(farthest-side, transparent 62%, #000 63%); }\n    .fx .wrap { position: relative; display: grid; place-items: center; }\n    .fx .tot { position: absolute; text-align: center; }\n    .fx .tot b { display: block; font-size: 1.3rem; font-weight: 900; color: var(--ink); }\n    .fx .tot span { font-size: .68rem; color: var(--ink-2); }\n    .fx .legend { display: grid; gap: .4rem; font-size: .78rem; color: var(--ink-2); }\n    .fx .legend span { display: flex; align-items: center; gap: .45rem; }\n    .fx .legend i { width: 10px; height: 10px; border-radius: 3px; }\n    .fx .legend b { color: var(--ink); font-variant-numeric: tabular-nums; }\n  </style>\n</head>\n<body>\n  <figure class=\"fx\" style=\"margin:0\"><div class=\"wrap\"><div class=\"ring\" role=\"img\" aria-label=\"Donut chart: CSS 48 percent, SVG 26 percent, JS 16 percent, other 10 percent\"></div>\n  <div class=\"tot\"><b>1,181</b><span>specimens</span></div></div>\n  <div class=\"legend\"><span><i style=\"background:var(--c1)\"></i>CSS <b>48%</b></span><span><i style=\"background:var(--c2)\"></i>SVG <b>26%</b></span>\n  <span><i style=\"background:var(--c3)\"></i>JS <b>16%</b></span><span><i style=\"background:var(--c5)\"></i>Other <b>10%</b></span></div></figure>\n</body>\n</html>\n"
}
