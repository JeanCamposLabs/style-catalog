  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Isometric Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"isometric-grid-bg\",\n    \"title\": \"Isometric Grid\",\n    \"summary\": \"A three-axis isometric lattice drawn with three gradient layers.\",\n    \"description\": \"Two 30°-offset line sets plus a vertical set create the isometric illusion without a single image.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"grid\"],\n    \"tags\": [\"isometric\", \"grid\", \"30-degrees\", \"lines\", \"technical\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Line color\", \"default\": \"rgba(124,92,255,.22)\" },\n      { \"name\": \"--s\", \"description\": \"Cell size\", \"default\": \"48px\" }\n    ],\n    \"variations\": [\"Fade the grid with a radial mask\", \"Animate the grid position for a scrolling floor\", \"Thicker lines for a blueprint\"],\n    \"ai_usage\": \"Technical, 3D, and game backgrounds. Use 30deg and 150deg for the two diagonal sets — 45° angles read as a plain diamond grid rather than isometric.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(124,92,255,.22); --s: 48px; }\n    .bg { background-color: #0b0d12;\n      background-image: repeating-linear-gradient(30deg, var(--c) 0 1px, transparent 1px var(--s)),\n        repeating-linear-gradient(150deg, var(--c) 0 1px, transparent 1px var(--s)),\n        repeating-linear-gradient(90deg, var(--c) 0 1px, transparent 1px var(--s)); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
