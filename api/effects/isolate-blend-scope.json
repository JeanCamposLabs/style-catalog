  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Blend Isolation</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"isolate-blend-scope\",\n    \"title\": \"Blend Isolation\",\n    \"summary\": \"Two identical overlays, one escaping its parent and one contained.\",\n    \"description\": \"Two identical overlays, one escaping its parent and one contained. Applied with CSS filters or blend modes, so the underlying content stays live and selectable.\",\n    \"theme\": \"blend-filters\",\n    \"categories\": [\"filter\", \"color\"],\n    \"tags\": [\"filter\", \"css\", \"isolation\", \"blend-mode\", \"stacking-context\", \"debug\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Filters change colour relationships — re-check text contrast after applying one, and never encode meaning in a filtered colour alone.\",\n    \"customization\": [\n      { \"name\": \"--iso\", \"description\": \"Isolation\", \"default\": \"isolate\" }\n    ],\n    \"variations\": [\"Animate the filter value on hover\", \"Apply to a whole section with backdrop-filter\"],\n    \"ai_usage\": \"The fix for a blend mode that affects the whole page: isolation:isolate creates a stacking context so the blend only sees its own parent.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; height: 170px; border-radius: 16px; overflow: hidden; position: relative;\n      background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .8rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .row { display: flex; gap: 14px; }\n    .box { width: 122px; height: 150px; border-radius: 14px; background: linear-gradient(135deg, #7c5cff, #2dd4bf); position: relative; }\n    .box.iso { isolation: isolate; }\n    .box::after { content: \"\"; position: absolute; inset: 20px; background: #fbbf24; mix-blend-mode: difference; border-radius: 8px; }\n  </style>\n</head>\n<body>\n  <div><div class=\"row\"><div class=\"box\"></div><div class=\"box iso\"></div></div><p class=\"label\">Right box is isolated</p></div>\n</body>\n</html>\n"
