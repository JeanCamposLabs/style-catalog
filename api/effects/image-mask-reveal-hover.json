  "ai_usage": "Portfolio and editorial images. Mask the top layer with radial-gradient(circle var(--r) at var(--x) var(--y), #000 60%, transparent) and animate --r on enter/leave so the reveal opens rather than snapping.",
  "path": "effects/hover-interactions/image-mask-reveal-hover.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Masked Image Reveal</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"image-mask-reveal-hover\",\n    \"title\": \"Masked Image Reveal\",\n    \"summary\": \"A colour image appears only inside a circle that follows the pointer.\",\n    \"description\": \"Two stacked copies — grayscale below, colour above — with a pointer-driven radial mask on the top layer.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"image\"],\n    \"tags\": [\"mask\", \"reveal\", \"pointer\", \"grayscale\", \"image\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--r\", \"description\": \"Reveal radius\", \"default\": \"90px\" }\n    ],\n    \"variations\": [\"Reveal a different image instead of colour\", \"Square or blob mask\", \"Sticky reveal that eases behind the pointer\"],\n    \"ai_usage\": \"Portfolio and editorial images. Mask the top layer with radial-gradient(circle var(--r) at var(--x) var(--y), #000 60%, transparent) and animate --r on enter/leave so the reveal opens rather than snapping.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .rev { position: relative; width: 300px; height: 200px; border-radius: 14px; overflow: hidden; }\n    .rev .base, .rev .top { position: absolute; inset: 0;\n      background: conic-gradient(from 210deg at 40% 30%, #7c5cff, #2dd4bf, #f472b6, #7c5cff); }\n    .rev .base { filter: grayscale(1) brightness(.6); }\n    .rev .top { -webkit-mask-image: radial-gradient(circle var(--r, 0px) at var(--x, 50%) var(--y, 50%), #000 60%, transparent 100%);\n      mask-image: radial-gradient(circle var(--r, 0px) at var(--x, 50%) var(--y, 50%), #000 60%, transparent 100%);\n      transition: none; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"rev\" id=\"rv\"><div class=\"base\"></div><div class=\"top\"></div></div>\n  <script>\n    (function () {\n      var el = document.getElementById(\"rv\");\n      el.addEventListener(\"pointermove\", function (e) {\n        var r = el.getBoundingClientRect();\n        el.style.setProperty(\"--x\", (e.clientX - r.left) + \"px\");\n        el.style.setProperty(\"--y\", (e.clientY - r.top) + \"px\");\n        el.style.setProperty(\"--r\", \"90px\");\n      });\n      el.addEventListener(\"pointerleave\", function () { el.style.setProperty(\"--r\", \"0px\"); });\n    })();\n  </script>\n</body>\n</html>\n"
}
