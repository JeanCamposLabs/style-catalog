  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Tiger Stripes</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"tiger-stripes\",\n    \"title\": \"Tiger Stripes\",\n    \"summary\": \"Irregular animal-print bands.\",\n    \"description\": \"Irregular animal-print bands. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"animal-print\", \"tiger\", \"stripes\", \"fashion\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--ground\", \"description\": \"Ground colour\", \"default\": \"#1a1208\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Fashion and bold branding. Three stripe layers at slightly different angles break the mechanical regularity of a single set.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    .bg { background-color: #1a1208;\n      background-image: repeating-linear-gradient(80deg, #0b0d12 0 6px, transparent 6px 26px),\n        repeating-linear-gradient(96deg, #0b0d12 0 4px, transparent 4px 34px),\n        repeating-linear-gradient(70deg, #0b0d12 0 8px, transparent 8px 46px); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
