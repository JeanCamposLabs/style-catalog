  "path": "effects/text-effects/split-flap-text.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Split-Flap Board</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"split-flap-text\",\n    \"title\": \"Split-Flap Board\",\n    \"summary\": \"An airport-style board where each character flips through glyphs before settling.\",\n    \"description\": \"Each cell cycles random characters on a timer and stops at its target, staggered so the word resolves left to right.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"retro\"],\n    \"tags\": [\"split-flap\", \"departure-board\", \"retro\", \"javascript\", \"reveal\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2000s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--cell\", \"description\": \"Cell background\", \"default\": \"#15192a\" },\n      { \"name\": \"--ink\", \"description\": \"Character color\", \"default\": \"#e7ebf3\" }\n    ],\n    \"variations\": [\"Real 3D flap with two half-cells\", \"Sound-free tick with a scale pulse\", \"Cycle through numbers only for counters\"],\n    \"ai_usage\": \"Announcements, stat reveals, and retro dashboards. Randomize each cell independently and stagger the settle time by index; keep the character set small (A–Z plus space) or the resolve takes too long to read.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --cell: #15192a; --ink: #e7ebf3; }\n    .flap { display: flex; gap: 4px; font-family: ui-monospace, Menlo, Consolas, monospace; }\n    .flap b { width: 34px; height: 48px; display: grid; place-items: center; border-radius: 5px;\n      background: var(--cell); color: var(--ink); font-size: 1.5rem; font-weight: 700;\n      box-shadow: inset 0 -1px 0 #2b3350, inset 0 1px 0 #0a0d18; position: relative; }\n    .flap b::after { content: \"\"; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: #0a0d18; }\n  </style>\n</head>\n<body>\n  <div class=\"flap\" id=\"board\" aria-label=\"ARRIVED\"></div>\n  <script>\n    (function () {\n      var word = \"ARRIVED\", chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\", board = document.getElementById(\"board\"), cells = [];\n      for (var i = 0; i < word.length; i++) {\n        var b = document.createElement(\"b\"); b.textContent = \"A\"; b.setAttribute(\"aria-hidden\", \"true\");\n        board.appendChild(b); cells.push(b);\n      }\n      function run() {\n        cells.forEach(function (b, i) {\n          var ticks = 0, max = 12 + i * 4;\n          var t = setInterval(function () {\n            b.textContent = chars[Math.floor(Math.random() * chars.length)];\n            if (++ticks >= max) { clearInterval(t); b.textContent = word[i]; }\n          }, 55);\n        });\n      }\n      run(); setInterval(run, 5000);\n    })();\n  </script>\n</body>\n</html>\n"
}
