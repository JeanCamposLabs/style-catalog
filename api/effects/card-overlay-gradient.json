  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Image Overlay Card</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"card-overlay-gradient\",\n    \"title\": \"Image Overlay Card\",\n    \"summary\": \"Text sits over media behind a legibility gradient.\",\n    \"description\": \"Text sits over media behind a legibility gradient. Self-contained card markup you can drop into a grid.\",\n    \"theme\": \"cards-surfaces\",\n    \"categories\": [\"card\", \"surface\"],\n    \"tags\": [\"card\", \"surface\", \"overlay\", \"image\", \"gradient\", \"legibility\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"A clickable card needs one real link or button inside it; never attach a click handler to a bare div.\",\n    \"customization\": [\n      { \"name\": \"--veil\", \"description\": \"Scrim strength\", \"default\": \"0.88\" }\n    ],\n    \"variations\": [\"Adapt for a light theme\", \"Add a media area at the top\"],\n    \"ai_usage\": \"Editorial and gallery cards. A gradient scrim (not a flat tint) keeps the image visible at the top while guaranteeing text contrast at the bottom.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .card { width: 260px; border-radius: 18px; padding: 1.4rem; }\n    .card h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .card p { margin: 0; color: #8b93a7; font-size: .88rem; line-height: 1.5; }\n    .card { position: relative; height: 200px; padding: 0; overflow: hidden;\n      background: conic-gradient(from 160deg at 40% 30%, #7c5cff, #2dd4bf, #f472b6); }\n    .card .veil { position: absolute; inset: 0; background: linear-gradient(transparent 30%, rgba(6,8,14,.88)); }\n    .card .body { position: absolute; inset: auto 0 0 0; padding: 1.2rem; }\n    .card h3 { color: #fff; }\n    .card p { color: rgba(255,255,255,.8); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <article class=\"card\"><div class=\"veil\"></div><div class=\"body\"><h3>Overlay Card</h3><p>Scrim guarantees contrast.</p></div></article>\n</body>\n</html>\n"
