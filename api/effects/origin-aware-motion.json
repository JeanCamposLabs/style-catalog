  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Origin-Aware Motion</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"origin-aware-motion\",\n    \"title\": \"Origin-Aware Motion\",\n    \"summary\": \"Panels entering from where they were triggered.\",\n    \"description\": \"Panels entering from where they were triggered.\",\n    \"theme\": \"motion-principles\",\n    \"categories\": [\"motion\", \"reference\"],\n    \"tags\": [\"motion\", \"easing\", \"origin\", \"transform-origin\", \"context\", \"menu\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every motion token here has a reduced-motion equivalent: durations collapse to zero rather than the animation being left half-played.\",\n    \"customization\": [\n      { \"name\": \"--origin\", \"description\": \"Transform origin\", \"default\": \"bottom right\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Menus and popovers. Set transform-origin to the trigger's corner so the panel appears to grow out of the control that opened it — a centred scale loses that connection.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 290px; height: 170px; border-radius: 14px; background: #10141f; border: 1px solid #263149; overflow: hidden; }\n    .fx .btn { position: absolute; bottom: 12px; right: 12px; width: 40px; height: 40px; border-radius: 50%;\n      background: #7c5cff; color: #fff; display: grid; place-items: center; }\n    .fx .panel { position: absolute; bottom: 12px; right: 12px; width: 150px; height: 100px; border-radius: 14px;\n      background: #1c2437; border: 1px solid #2b3450; transform-origin: bottom right;\n      animation: open 3s cubic-bezier(.7,0,.2,1) infinite; }\n    @keyframes open { 0%, 10% { transform: scale(.15); opacity: 0; } 35%, 80% { transform: scale(1); opacity: 1; } 100% { transform: scale(.15); opacity: 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"panel\"></div><div class=\"btn\" aria-hidden=\"true\">＋</div></div>\n</body>\n</html>\n"
