  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Zigzag Divider</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"divider-zigzag\",\n    \"title\": \"Zigzag Divider\",\n    \"summary\": \"A sawtooth edge between sections.\",\n    \"description\": \"A sawtooth edge between sections. Purely decorative and self-contained, so it drops between any two sections.\",\n    \"theme\": \"dividers-shapes\",\n    \"categories\": [\"divider\", \"shape\"],\n    \"tags\": [\"divider\", \"separator\", \"zigzag\", \"sawtooth\", \"mask\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dividers are decorative: mark them aria-hidden so they are not announced as content.\",\n    \"customization\": [\n      { \"name\": \"--w\", \"description\": \"Tooth width\", \"default\": \"30px\" }\n    ],\n    \"variations\": [\"Flip vertically for the opposite section\", \"Recolour to match the next section\"],\n    \"ai_usage\": \"Playful and craft-themed sections. A conic-gradient mask tiles the sawtooth without any SVG path.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .top { background: #151b2a; padding: 1.6rem; text-align: center; color: #8b93a7; font-size: .85rem; }\n    .bottom { background: #7c5cff; padding: 1.6rem; text-align: center; color: #1a1030; font-size: .85rem; font-weight: 700; }\n    .stage { width: min(92vw, 340px); }\n    .divider { height: 22px; background: #7c5cff;\n      -webkit-mask-image: conic-gradient(from -45deg at 50% 0, #000 0 90deg, transparent 0);\n      mask-image: conic-gradient(from -45deg at 50% 0, #000 0 90deg, transparent 0);\n      -webkit-mask-size: 30px 100%; mask-size: 30px 100%; }\n  </style>\n</head>\n<body>\n  <div class=\"stage\"><div class=\"top\">Section one</div><div class=\"divider\" aria-hidden=\"true\"></div><div class=\"bottom\">Section two</div></div>\n</body>\n</html>\n"
