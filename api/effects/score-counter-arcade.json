  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Arcade Scoreboard</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"score-counter-arcade\",\n    \"title\": \"Arcade Scoreboard\",\n    \"summary\": \"A high-score panel with padded digits.\",\n    \"description\": \"A high-score panel with padded digits.\",\n    \"theme\": \"game-ui\",\n    \"categories\": [\"game\", \"ui\"],\n    \"tags\": [\"game\", \"hud\", \"score\", \"arcade\", \"counter\", \"leaderboard\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Game HUDs still need real semantics: use progressbar roles for meters and buttons for slots so the interface is operable without sight.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Display colour\", \"default\": \"#22d3ee\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Arcade and casual games. Zero-pad the score and use tabular-nums so the digits never shift width as the number changes.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { padding: 1rem 1.2rem; border-radius: 8px; background: #05070d; border: 2px solid #22d3ee;\n      font-family: ui-monospace, monospace; color: #22d3ee; text-align: center; }\n    .fx .lbl { font-size: .72rem; letter-spacing: .2em; opacity: .75; }\n    .fx .n { font-size: 2rem; font-weight: 900; letter-spacing: .1em; text-shadow: 0 0 10px rgba(34,211,238,.7);\n      font-variant-numeric: tabular-nums; }\n    .fx .row { display: flex; gap: 1.6rem; justify-content: center; margin-top: .6rem; font-size: .75rem; opacity: .8; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"lbl\">HIGH SCORE</div><div class=\"n\">0042180</div>\n  <div class=\"row\"><span>1UP 012400</span><span>2UP 008920</span></div></div>\n</body>\n</html>\n"
}
