und-image: linear-gradient(90deg, #7c5cff, #2dd4bf); background-size: 100% 6px;\n      background-repeat: no-repeat; background-position: 0 100%; }\n  </style>\n</head>\n<body>\n  <h2 class=\"fx\">Underlined</h2>\n</body>\n</html>\n"
