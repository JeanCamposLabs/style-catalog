  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Highlighted Code Block</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"code-block-highlight\",\n    \"title\": \"Highlighted Code Block\",\n    \"summary\": \"A code sample with a highlighted line and copy affordance.\",\n    \"description\": \"A code sample with a highlighted line and copy affordance.\",\n    \"theme\": \"terminal-cli\",\n    \"categories\": [\"terminal\", \"code\"],\n    \"tags\": [\"terminal\", \"monospace\", \"code\", \"syntax\", \"highlight\", \"docs\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Terminal output should live in a real text element (not an image) so it can be selected, searched, and read aloud.\",\n    \"customization\": [\n      { \"name\": \"--hl\", \"description\": \"Highlight colour\", \"default\": \"rgba(88,166,255,.12)\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Documentation. Highlight the changed line with a background and a left rule so the emphasis survives greyscale printing.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 300px; border-radius: 10px; overflow: hidden; background: #0d1117; border: 1px solid #21262d;\n      font-family: ui-monospace, monospace; font-size: .78rem; }\n    .fx pre { margin: 0; padding: .9rem 0; line-height: 1.8; }\n    .fx .ln { display: block; padding: 0 .9rem; color: #c9d1d9; }\n    .fx .ln.on { background: rgba(88,166,255,.12); border-left: 2px solid #58a6ff; padding-left: calc(.9rem - 2px); }\n    .fx .k { color: #ff7b72; } .fx .s { color: #a5d6ff; } .fx .c { color: #8b949e; }\n    .fx button { position: absolute; top: 8px; right: 8px; padding: .2rem .5rem; border-radius: 6px; border: 1px solid #30363d;\n      background: #161b22; color: #8b949e; font: inherit; font-size: .7rem; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><button type=\"button\">Copy</button><pre><code><span class=\"ln\"><span class=\"c\">// scan the library</span></span>\n  <span class=\"ln\"><span class=\"k\">const</span> { catalog } = <span class=\"k\">await</span> scan();</span>\n  <span class=\"ln on\">catalog.effects.length; <span class=\"c\">// 1181</span></span></code></pre></div>\n</body>\n</html>\n"
