  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Scroll-Linked Rotation</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"scroll-timeline-rotate\",\n    \"title\": \"Scroll-Linked Rotation\",\n    \"summary\": \"An element rotating with scroll via CSS only.\",\n    \"description\": \"An element rotating with scroll via CSS only.\",\n    \"theme\": \"scroll-effects\",\n    \"categories\": [\"scroll\", \"motion\"],\n    \"tags\": [\"scroll\", \"scroll-timeline\", \"rotate\", \"css-only\", \"native\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Scroll-linked motion must be disabled under prefers-reduced-motion, and content must never depend on scrolling to become readable.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Full rotation\", \"default\": \"one scroll\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Decorative scroll links. Native scroll-driven animation needs no JS and never desynchronises from the scroller; feature-detect with @supports (animation-timeline: scroll()) for a fallback.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n    body { min-height: 250vh; }\n    .stage { position: sticky; top: 0; height: 100vh; display: grid; place-items: center; }\n    .sq { width: 130px; height: 130px; border-radius: 22px; background: linear-gradient(150deg, #7c5cff, #2dd4bf);\n      animation: turn linear; animation-timeline: scroll(root); }\n    .hint { position: absolute; bottom: 14vh; color: #8b93a7; font-size: .85rem; }\n    @keyframes turn { to { rotate: 360deg; scale: .6; } }\n    @media (prefers-reduced-motion: reduce) {\n      .sq { animation: none; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"stage\"><div class=\"sq\"></div><p class=\"hint\">Scroll to rotate — pure CSS scroll-timeline</p></div>\n</body>\n</html>\n"
