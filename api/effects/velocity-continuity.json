  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Velocity Continuity</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"velocity-continuity\",\n    \"title\": \"Velocity Continuity\",\n    \"summary\": \"Motion that keeps momentum between phases.\",\n    \"description\": \"Motion that keeps momentum between phases.\",\n    \"theme\": \"motion-principles\",\n    \"categories\": [\"motion\", \"reference\"],\n    \"tags\": [\"motion\", \"easing\", \"velocity\", \"continuity\", \"momentum\", \"chaining\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every motion token here has a reduced-motion equivalent: durations collapse to zero rather than the animation being left half-played.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Sequence duration\", \"default\": \"2.6s\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Chained animations. When one motion hands off to another, match the exit velocity of the first to the entry velocity of the second — a hard stop between phases reads as two unrelated events.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; }\n    .t { height: 30px; border-radius: 99px; background: #151b2a; position: relative; margin-bottom: .8rem; }\n    .t i { position: absolute; top: 5px; left: 5px; width: 20px; height: 20px; border-radius: 50%; background: #c2891a; }\n    .bad i { animation: two 2.6s steps(1) infinite; }\n    .good i { animation: smooth 2.6s cubic-bezier(.4,0,.2,1) infinite; }\n    .lbl { font-size: .68rem; color: #64748b; font-family: ui-monospace, monospace; margin-bottom: .25rem; }\n    @keyframes two { 0%, 45% { left: 5px; } 50%, 100% { left: calc(100% - 25px); } }\n    @keyframes smooth { 0% { left: 5px; } 55%, 100% { left: calc(100% - 25px); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"lbl\">discontinuous — teleports</div><div class=\"t bad\"><i></i></div>\n  <div class=\"lbl\">continuous — keeps momentum</div><div class=\"t good\"><i></i></div></div>\n</body>\n</html>\n"
