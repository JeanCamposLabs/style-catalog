    "particles",
    "heatmap",
    "click-wave",
    "typed-arrays"
  ],
  "tech": [
    "canvas",
    "js",
    "css"
  ],
  "era": "2020s",
  "difficulty": "advanced",
  "dependencies": [],
  "browser_support": "Any browser with Canvas 2D and Pointer Events (Chrome/Edge/Firefox/Safari). Gracefully renders a single static frame when reduced motion is requested or no fine pointer is present.",
  "performance_notes": "State lives in Float32Array/Uint8Array grids indexed by cell, never per-cell objects. Only lit cells are visited (a compacted active list), draws are bucketed by font size x color band so fillStyle/font change at most SIZES*BANDS times per frame, and clearRect covers only the dirty rectangle rather than the full canvas. Device pixel ratio is capped at 1.5, the loop halves its rate while idle and stops entirely once the field is dark. Cost scales with the lit area, not the viewport.",
  "accessibility_notes": "Purely decorative: the canvas is aria-hidden, has pointer-events: none, and never replaces the system cursor. Under prefers-reduced-motion: reduce (or on coarse/no-hover pointers) the animation loop and pointer listeners are skipped entirely and one still frame is painted instead. Nothing is conveyed by the glyphs alone, and page content sits in a positioned layer above with normal contrast.",
  "customization": [
    {
      "name": "--glyph-field-cold",
      "description": "Glyph color at rest / low speed",
      "default": "var(--ink)"
    },
    {
      "name": "--glyph-field-hot",
      "description": "Glyph color at full speed and at the click wave crest",
      "default": "var(--accent)"
    },
    {
      "name": "FONT",
      "description": "Base glyph size in px; also sets cell width/height with LEADING",
      "default": "13"
    },
    {
      "name": "R_BASE / R_FAST",
      "description": "Trail radius at rest and the extra radius added at full speed",
      "default": "58 / 34"
    },
    {
      "name": "SPEED_DIV / SPEED_REF",
      "description": "How much pointer velocity counts as \"full heat\"; normalized against viewport size so a small hero box behaves like a large one",
      "default": "2.2 / 900"
    },
    {
      "name": "DECAY / COOL",
      "description": "Per-frame multipliers for intensity and heat — lower fades faster",
      "default": "0.972 / 0.955"
    },
    {
      "name": "SETS",
      "description": "Eight arrays of glyphs, one per 45 degree direction bucket",
      "default": "ASCII arrows"
    },
    {
      "name": "WAVE_SPEED / WAVE_WIDTH / WAVE_MAX",
      "description": "Click ring expansion px/s, band thickness, and travel before it dies",
      "default": "780 / 46 / 820"
    }
  ],
  "variations": [
    "Swap SETS for katakana, braille (⠁⠂⠄⡀), or box-drawing characters for a different alphabet",
    "Drop the direction buckets and always use one glyph set for a plain heat trail",
    "Drive the field from scroll velocity instead of the pointer",
    "Constrain the canvas to a hero section (position: absolute inside a relative parent) instead of the viewport",
    "Emit a wave on route change or form submit rather than on click"
  ],
  "related": [
    "blob-trail-cursor",
    "follow-dot-cursor",
    "spotlight-cursor"
  ],
  "ai_usage": "Use for a decorative, tech-flavoured pointer trail behind a hero or landing page — terminal, developer-tool, AI, or cyber aesthetics. Do NOT use it as a cursor replacement (keep the native cursor) or on content-dense/text-heavy pages, where it competes with reading.\n\nIntegrate: put <canvas data-glyph-field aria-hidden=\"true\"></canvas> first in <body>, style it position: fixed; inset: 0; z-index: 0; pointer-events: none, and give your content wrapper position: relative; z-index: 1 — without that the content sits at the same layer and the glyphs draw over it. The script self-initializes on DOM ready; window.GlyphField.init(canvas), .destroy(), and .refreshColors() are also exposed. In React/Vue/Next call init(ref.current) from an effect after mount and destroy() on unmount, and never call it during server rendering (it needs window). Only one instance is active at a time; init on a new canvas replaces the previous one.\n\nTune: set --glyph-field-cold and --glyph-field-hot on :root (they fall back to --ink/--accent, then built-in values) — cold should be close to your body text color and hot to your accent, or the trail turns into confetti. Root data-theme/class/style changes refresh automatically; call refreshColors() when theme state lives elsewhere. Raise R_BASE for a broader wash, lower DECAY for a snappier fade, and edit SETS to change the alphabet.\n\nAvoid: giving the canvas pointer events or a positive z-index above content; removing the reduced-motion and fine-pointer gate; running one instance per component render; replacing the typed arrays with per-cell objects, clearing the whole canvas each frame, or removing the idle throttle and the 1.5 DPR cap — those four are what keep it cheap. Because it paints the full viewport behind everything, verify text contrast with the hot color at full intensity.",
  "path": "effects/cursors-pointers/glyph-field.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Glyph Field</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"glyph-field\",\n    \"title\": \"Glyph Field\",\n    \"summary\": \"A canvas grid of ASCII glyphs ignites under the pointer, pointing the way you moved and heating up as you go faster.\",\n    \"description\": \"A full-bleed monospace grid sits behind the page. Pointer movement stamps a capsule of intensity along the segment travelled, so fast flicks paint continuous ribbons instead of dotted samples. Each lit cell renders a glyph chosen from one of eight direction sets (>, \\\\, v, /, <, ^ …), so the field reads as an arrow map of your gesture. Cursor speed drives a separate heat channel that ramps the glyph color from a cold ink tone to a hot accent, and a click launches an expanding ring whose glyphs face outward from the impact. Cells decay and cool on their own, so the trail dissolves a moment after you stop.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"pointer\", \"ambient\", \"background\"],\n    \"tags\": [\"cursor\", \"trail\", \"canvas\", \"ascii\", \"glyph\", \"matrix\", \"monospace\", \"particles\", \"heatmap\", \"click-wave\", \"typed-arrays\"],\n    \"tech\": [\"canvas\", \"js\", \"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"Any browser with Canvas 2D and Pointer Events (Chrome/Edge/Firefox/Safari). Gracefully renders a single static frame when reduced motion is requested or no fine pointer is present.\",\n    \"performance_notes\": \"State lives in Float32Array/Uint8Array grids indexed by cell, never per-cell objects. Only lit cells are visited (a compacted active list), draws are bucketed by font size x color band so fillStyle/font change at most SIZES*BANDS times per frame, and clearRect covers only the dirty rectangle rather than the full canvas. Device pixel ratio is capped at 1.5, the loop halves its rate while idle and stops entirely once the field is dark. Cost scales with the lit area, not the viewport.\",\n    \"accessibility_notes\": \"Purely decorative: the canvas is aria-hidden, has pointer-events: none, and never replaces the system cursor. Under prefers-reduced-motion: reduce (or on coarse/no-hover pointers) the animation loop and pointer listeners are skipped entirely and one still frame is painted instead. Nothing is conveyed by the glyphs alone, and page content sits in a positioned layer above with normal contrast.\",\n    \"customization\": [\n      { \"name\": \"--glyph-field-cold\", \"description\": \"Glyph color at rest / low speed\", \"default\": \"var(--ink)\" },\n      { \"name\": \"--glyph-field-hot\", \"description\": \"Glyph color at full speed and at the click wave crest\", \"default\": \"var(--accent)\" },\n      { \"name\": \"FONT\", \"description\": \"Base glyph size in px; also sets cell width/height with LEADING\", \"default\": \"13\" },\n      { \"name\": \"R_BASE / R_FAST\", \"description\": \"Trail radius at rest and the extra radius added at full speed\", \"default\": \"58 / 34\" },\n      { \"name\": \"SPEED_DIV / SPEED_REF\", \"description\": \"How much pointer velocity counts as \\\"full heat\\\"; normalized against viewport size so a small hero box behaves like a large one\", \"default\": \"2.2 / 900\" },\n      { \"name\": \"DECAY / COOL\", \"description\": \"Per-frame multipliers for intensity and heat — lower fades faster\", \"default\": \"0.972 / 0.955\" },\n      { \"name\": \"SETS\", \"description\": \"Eight arrays of glyphs, one per 45 degree direction bucket\", \"default\": \"ASCII arrows\" },\n      { \"name\": \"WAVE_SPEED / WAVE_WIDTH / WAVE_MAX\", \"description\": \"Click ring expansion px/s, band thickness, and travel before it dies\", \"default\": \"780 / 46 / 820\" }\n    ],\n    \"variations\": [\n      \"Swap SETS for katakana, braille (⠁⠂⠄⡀), or box-drawing characters for a different alphabet\",\n      \"Drop the direction buckets and always use one glyph set for a plain heat trail\",\n      \"Drive the field from scroll velocity instead of the pointer\",\n      \"Constrain the canvas to a hero section (position: absolute inside a relative parent) instead of the viewport\",\n      \"Emit a wave on route change or form submit rather than on click\"\n    ],\n    \"related\": [\"blob-trail-cursor\", \"follow-dot-cursor\", \"spotlight-cursor\"],\n    \"ai_usage\": \"Use for a decorative, tech-flavoured pointer trail behind a hero or landing page — terminal, developer-tool, AI, or cyber aesthetics. Do NOT use it as a cursor replacement (keep the native cursor) or on content-dense/text-heavy pages, where it competes with reading.\\n\\nIntegrate: put <canvas data-glyph-field aria-hidden=\\\"true\\\"></canvas> first in <body>, style it position: fixed; inset: 0; z-index: 0; pointer-events: none, and give your content wrapper position: relative; z-index: 1 — without that the content sits at the same layer and the glyphs draw over it. The script self-initializes on DOM ready; window.GlyphField.init(canvas), .destroy(), and .refreshColors() are also exposed. In React/Vue/Next call init(ref.current) from an effect after mount and destroy() on unmount, and never call it during server rendering (it needs window). Only one instance is active at a time; init on a new canvas replaces the previous one.\\n\\nTune: set --glyph-field-cold and --glyph-field-hot on :root (they fall back to --ink/--accent, then built-in values) — cold should be close to your body text color and hot to your accent, or the trail turns into confetti. Root data-theme/class/style changes refresh automatically; call refreshColors() when theme state lives elsewhere. Raise R_BASE for a broader wash, lower DECAY for a snappier fade, and edit SETS to change the alphabet.\\n\\nAvoid: giving the canvas pointer events or a positive z-index above content; removing the reduced-motion and fine-pointer gate; running one instance per component render; replacing the typed arrays with per-cell objects, clearing the whole canvas each frame, or removing the idle throttle and the 1.5 DPR cap — those four are what keep it cheap. Because it paints the full viewport behind everything, verify text contrast with the hot color at full intensity.\"\n  }\n  </script>\n  <style>\n    :root {\n      --bg: #0d0d15;\n      --ink: #ececf3;\n      --accent: #c79bff;\n      --muted: #6a6a85;\n      --mono: ui-monospace, \"SF Mono\", Menlo, Consolas, monospace;\n      /* The two knobs the effect actually reads; they alias your theme tokens. */\n      --glyph-field-cold: var(--ink);\n      --glyph-field-hot: var(--accent);\n    }\n    html, body { height: 100%; margin: 0; overflow: hidden; }\n    body { background: var(--bg); color: var(--muted); font-family: var(--mono); }\n\n    /* Decorative, viewport-sized, never interactive. Content goes above it. */\n    canvas[data-glyph-field] {\n      position: fixed; inset: 0; display: block;\n      width: 100%; height: 100%;\n      z-index: 0; pointer-events: none;\n    }\n\n    /* Content layer — must be positioned with z-index >= 1. */\n    .stage {\n      position: relative; z-index: 1;\n      height: 100%; display: grid; place-content: center;\n      text-align: center; padding: 1rem; pointer-events: none;\n    }\n    .stage h1 {\n      margin: 0; font-size: clamp(1.4rem, 5.6vw, 2.8rem); line-height: 1;\n      letter-spacing: -0.03em; color: var(--ink); font-weight: 600;\n    }\n    .stage p { margin: 0.9rem 0 0; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; }\n  </style>\n</head>\n<body>\n  <canvas data-glyph-field aria-hidden=\"true\"></canvas>\n\n  <div class=\"stage\">\n    <h1>Glyph field</h1>\n    <p>move · click</p>\n  </div>\n\n  <script>\n  (function (window, document) {\n    \"use strict\";\n\n    var instance = null, readyHandler = null, API = window.GlyphField || {};\n\n    function create(canvas) {\n      canvas = canvas || document.querySelector(\"[data-glyph-field]\") || document.getElementById(\"glyphfield\");\n      if (!canvas || !canvas.getContext) return null;\n      var ctx = canvas.getContext(\"2d\", { alpha: true });\n      if (!ctx) return null;\n\n      // Gate: reduced motion or a device without a fine hover pointer gets one\n      // still frame instead of a live loop (and instead of a blank box).\n      var reduced = window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n      var fine = window.matchMedia && window.matchMedia(\"(hover: hover) and (pointer: fine)\");\n      var still = (reduced && reduced.matches) || (fine && !fine.matches);\n\n      var FONT = 13, LEADING = 1.26, R_BASE = 58, R_FAST = 34, PEAK = 0.85;\n      var SIZES = 4, DECAY = 0.972, COOL = 0.955, SCRAMBLE = 90, BANDS = 6;\n      var WAVE_SPEED = 780, WAVE_WIDTH = 46, WAVE_MAX = 820;\n      var SPEED_DIV = 2.2, SPEED_REF = 900;\n      var IDLE_MS = 2600, DEMO_WAVE_MS = 6500, DEMO_WAVE_0 = 3400;\n      var STROKE_MS = 2400, STROKE_LEAD = 1000, STROKE_RUN = 800;\n      // One glyph set per 45-degree direction bucket, starting at \"east\".\n      var SETS = [\n        [\">\", \">\", \">\", \"›\", \"»\", \"-\"], [\"\\\\\", \"\\\\\", \"\\\\\", \">\", \"·\"],\n        [\"v\", \"v\", \"|\", \"·\", \"↓\"], [\"/\", \"/\", \"/\", \"<\", \"·\"],\n        [\"<\", \"<\", \"<\", \"‹\", \"«\", \"-\"], [\"\\\\\", \"\\\\\", \"\\\\\", \"<\", \"·\"],\n        [\"^\", \"^\", \"|\", \"·\", \"↑\"], [\"/\", \"/\", \"/\", \">\", \"·\"]\n      ];\n\n      var cw = 7.2, ch = 15, cols = 0, rows = 0, n = 0, dpr = 1, cssW = 0, cssH = 0, vDiv = SPEED_DIV;\n      var inten, heat, dirOf, seedOf, activeArr, inActive, activeCount = 0;\n      var waves = [], raf = 0, resizeTimer = null, dead = false;\n      var lastX = null, lastY = null, lastT = 0, prevX = null, prevY = null, dir = 0, speed = 0;\n      var movedAt = -1e9, drawnAt = -1e9, userAt = -1e9, demo = !still;\n      var demoWave = DEMO_WAVE_0 - DEMO_WAVE_MS;\n      var dx0 = 0, dy0 = 0, dx1 = 0, dy1 = 0, dirty = false;\n      var ramp = [], fontAt = [];\n      var SLOTS = SIZES * BANDS, bucket = [], bucketLen = new Int32Array(SLOTS);\n      var SIN = new Float32Array(256), q, k;\n      for (q = 0; q < 256; q++) SIN[q] = Math.sin(q / 256 * Math.PI * 2);\n      for (k = 0; k < SLOTS; k++) bucket.push([]);\n\n      /* ---------- helpers ---------- */\n\n      function hash(v) {\n        v = (v ^ 61) ^ (v >>> 16); v += v << 3; v ^= v >>> 4;\n        v = Math.imul(v, 0x27d4eb2d); return (v ^ (v >>> 15)) >>> 0;\n      }\n      function rgbOf(value, fallback) {\n        var str = (value || fallback).trim();\n        if (str.charAt(0) === \"#\") {\n          if (str.length === 4) str = \"#\" + str[1] + str[1] + str[2] + str[2] + str[3] + str[3];\n          var num = parseInt(str.slice(1), 16);\n          if (!isNaN(num)) return [(num >> 16) & 255, (num >> 8) & 255, num & 255];\n        }\n        var m = str.match(/(\\d+(?:\\.\\d+)?)/g);\n        return m && m.length >= 3 ? [+m[0], +m[1], +m[2]] : rgbOf(fallback, \"#888888\");\n      }\n      // Precompute the cold -> hot ramp once per theme change, not per glyph.\n      function refreshColors() {\n        if (dead) return;\n        var st = window.getComputedStyle(document.documentElement);\n        var cold = rgbOf(st.getPropertyValue(\"--glyph-field-cold\") || st.getPropertyValue(\"--glyph\") || st.getPropertyValue(\"--ink\"), \"#ececf3\");\n        var hot = rgbOf(st.getPropertyValue(\"--glyph-field-hot\") || st.getPropertyValue(\"--glow\") || st.getPropertyValue(\"--accent\"), \"#c79bff\");\n        ramp.length = 0;\n        for (var b = 0; b < BANDS; b++) {\n          var t = b / (BANDS - 1);\n          ramp.push(\"rgb(\" + Math.round(cold[0] + (hot[0] - cold[0]) * t) + \",\" +\n            Math.round(cold[1] + (hot[1] - cold[1]) * t) + \",\" +\n            Math.round(cold[2] + (hot[2] - cold[2]) * t) + \")\");\n        }\n        if (still) requestFrame();\n      }\n      function resize() {\n        if (dead) return;\n        dpr = Math.min(window.devicePixelRatio || 1, 1.5); // cap: 2x costs 1.8x fill for no visible gain\n        var w = window.innerWidth, h = window.innerHeight;\n        cssW = w; cssH = h;\n        // Normalize \"fast\" against the viewport, not raw px/ms: the same gesture\n        // should read equally hot in a 600px hero box and on a 1600px display.\n        vDiv = SPEED_DIV * Math.max(0.5, Math.min(Math.min(w, h) / SPEED_REF, 1.35));\n        canvas.width = Math.round(w * dpr); canvas.height = Math.round(h * dpr);\n        canvas.style.width = w + \"px\"; canvas.style.height = h + \"px\";\n        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n        var family = window.getComputedStyle(document.body).getPropertyValue(\"--mono\") || \"monospace\";\n        ctx.font = FONT + \"px \" + family;\n        cw = ctx.measureText(\"M\").width || FONT * 0.6;\n        fontAt.length = 0;\n        for (var z = 0; z < SIZES; z++) fontAt.push((FONT * (0.55 + 0.45 * z / (SIZES - 1))).toFixed(2) + \"px \" + family);\n        ch = Math.round(FONT * LEADING);\n        ctx.textAlign = \"center\"; ctx.textBaseline = \"middle\";\n        cols = Math.ceil(w / cw) + 1; rows = Math.ceil(h / ch) + 1; n = cols * rows;\n        inten = new Float32Array(n); heat = new Float32Array(n); dirOf = new Uint8Array(n);\n        seedOf = new Uint8Array(n); activeArr = new Int32Array(n); inActive = new Uint8Array(n);\n        activeCount = 0; dirty = false; waves.length = 0;\n        for (var i = 0; i < n; i++) seedOf[i] = hash(i) & 255;\n        if (still) paintStill(); else requestFrame();\n      }\n\n      /* ---------- field ---------- */\n\n      function light(i, value, direction, warmth) {\n        if (value > inten[i]) {\n          inten[i] = value; dirOf[i] = direction;\n          if (!inActive[i]) { inActive[i] = 1; activeArr[activeCount++] = i; }\n        }\n        if (warmth > heat[i]) heat[i] = warmth;\n      }\n      // Stamp a capsule along the segment travelled since the last sample, so a\n      // fast flick paints a ribbon instead of disconnected blobs.\n      function stamp(ax, ay, bx, by, radius) {\n        var rsq = radius * radius, abx = bx - ax, aby = by - ay, abLen = abx * abx + aby * aby;\n        var c0 = Math.max(0, Math.floor((Math.min(ax, bx) - radius) / cw));\n        var c1 = Math.min(cols, Math.ceil((Math.max(ax, bx) + radius) / cw));\n        var r0 = Math.max(0, Math.floor((Math.min(ay, by) - radius) / ch));\n        var r1 = Math.min(rows, Math.ceil((Math.max(ay, by) + radius) / ch));\n        for (var r = r0; r < r1; r++) for (var c = c0; c < c1; c++) {\n          var px = c * cw + cw * 0.5, py = r * ch + ch * 0.5, along = 0;\n          if (abLen > 0) { along = ((px - ax) * abx + (py - ay) * aby) / abLen; along = Math.max(0, Math.min(1, along)); }\n          var x = px - (ax + abx * along), y = py - (ay + aby * along), dsq = x * x + y * y;\n          if (dsq > rsq) continue;\n          var i = r * cols + c, t = 1 - Math.sqrt(dsq) / radius;\n          var value = t * (0.55 + t * 0.45) * (0.90 + (seedOf[i] % 100) / 1000) * (0.78 + speed * 0.35);\n          if (value > 0.02) light(i, value, dir, Math.min(t * (0.30 + speed * 1.15), 1));\n        }\n      }\n      // One pointer sample — real or synthesized by the idle demo.\n      function feed(mx, my, now) {\n        if (lastX !== null) {\n          var vx = mx - lastX, vy = my - lastY, dist = Math.sqrt(vx * vx + vy * vy);\n          if (dist > 2.5) {\n            dir = ((Math.round(Math.atan2(vy, vx) / (Math.PI / 4)) % 8) + 8) % 8;\n            speed = Math.min(dist / Math.max(now - lastT, 8) / vDiv, 1);\n          } else speed *= 0.9;\n        }\n        lastX = mx; lastY = my; lastT = now; movedAt = now;\n        if (prevX === null) { prevX = mx; prevY = my; }\n        if (Math.abs(mx - prevX) + Math.abs(my - prevY) > 400) { prevX = mx; prevY = my; }\n        stamp(prevX, prevY, mx, my, R_BASE + R_FAST * speed);\n        prevX = mx; prevY = my;\n      }\n      function splash(x, y, ts) {\n        if (waves.length > 3) waves.shift();\n        waves.push({ x: x, y: y, t0: ts });\n      }\n      function stepWaves(ts) {\n        for (var w = waves.length - 1; w >= 0; w--) {\n          var wave = waves[w], rad = (ts - wave.t0) / 1000 * WAVE_SPEED;\n          if (rad > WAVE_MAX) { waves.splice(w, 1); continue; }\n          var outer = rad + WAVE_WIDTH, inner = Math.max(rad - WAVE_WIDTH, 0);\n          var outerSq = outer * outer, innerSq = inner * inner, fade = 1 - rad / WAVE_MAX;\n          var c0 = Math.max(0, Math.floor((wave.x - outer) / cw)), c1 = Math.min(cols, Math.ceil((wave.x + outer) / cw));\n          var r0 = Math.max(0, Math.floor((wave.y - outer) / ch)), r1 = Math.min(rows, Math.ceil((wave.y + outer) / ch));\n          for (var r = r0; r < r1; r++) for (var c = c0; c < c1; c++) {\n            var x = c * cw + cw * 0.5 - wave.x, y = r * ch + ch * 0.5 - wave.y, dsq = x * x + y * y;\n            if (dsq < innerSq || dsq > outerSq) continue;\n            var edge = 1 - Math.abs(Math.sqrt(dsq) - rad) / WAVE_WIDTH;\n            if (edge > 0) light(r * cols + c, edge * fade * 0.95, ((Math.round(Math.atan2(y, x) / (Math.PI / 4)) % 8) + 8) % 8, edge * fade);\n          }\n        }\n      }\n\n      /* ---------- draw ---------- */\n\n      // Bucket lit cells by (size, color band) so font/fillStyle are set at most\n      // SIZES*BANDS times per frame instead of once per glyph.\n      function paint(ts, animate) {\n        if (dirty) ctx.clearRect(dx0, dy0, dx1 - dx0, dy1 - dy0);\n        var nx0 = 1e9, ny0 = 1e9, nx1 = -1e9, ny1 = -1e9;\n        var tick = (ts / SCRAMBLE) | 0, phase = (ts * 0.17) | 0, b;\n        for (b = 0; b < SLOTS; b++) bucketLen[b] = 0;\n        var write = 0;\n        for (var a = 0; a < activeCount; a++) {\n          var 