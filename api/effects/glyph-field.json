{
  "id": "glyph-field",
  "title": "Glyph Field",
  "summary": "A canvas grid of ASCII glyphs ignites under the pointer, pointing the way you moved and heating up as you go faster.",
  "description": "A full-bleed monospace grid sits behind the page. Pointer movement stamps a capsule of intensity along the segment travelled, so fast flicks paint continuous ribbons instead of dotted samples. Each lit cell renders a glyph chosen from one of eight direction sets (>, \\, v, /, <, ^ …), so the field reads as an arrow map of your gesture. Cursor speed drives a separate heat channel that ramps the glyph color from a cold ink tone to a hot accent, and a click launches an expanding ring whose glyphs face outward from the impact. Cells decay and cool on their own, so the trail dissolves a moment after you stop.",
  "theme": "cursors-pointers",
  "themeTitle": "Cursors & Pointers",
  "categories": [
    "cursor",
    "pointer",
    "ambient",
    "background"
  ],
  "tags": [
    "cursor",
    "trail",
    "canvas",
    "ascii",
    "glyph",
