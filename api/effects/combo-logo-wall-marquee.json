ent(90deg, transparent, #000 12%, #000 88%, transparent);\n      mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }\n    .rail div { display: flex; gap: 1.6rem; width: max-content; animation: slide 14s linear infinite; }\n    .rail b { color: #8b93a7; font-weight: 800; font-size: .95rem; letter-spacing: .04em; white-space: nowrap; }\n    @keyframes slide { to { transform: translateX(-50%); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <section class=\"wrap\"><p>Trusted by teams at</p><div class=\"rail\"><div>\n  <b>ANALYTICAL</b><b>BABBAGE</b><b>TURING CO</b><b>HOPPER</b><b>ANALYTICAL</b><b>BABBAGE</b><b>TURING CO</b><b>HOPPER</b></div></div></section>\n</body>\n</html>\n"
