  "path": "effects/backgrounds/spotlight-radial-bg.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Radial Spotlight</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"spotlight-radial-bg\",\n    \"title\": \"Radial Spotlight\",\n    \"summary\": \"A single warm light pool centred behind the content.\",\n    \"description\": \"One large radial gradient over a near-black ground; the falloff distance is the only knob that matters.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"gradient\"],\n    \"tags\": [\"spotlight\", \"radial\", \"glow\", \"hero\", \"minimal\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Light color\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--size\", \"description\": \"Pool size\", \"default\": \"70%\" },\n      { \"name\": \"--str\", \"description\": \"Light strength\", \"default\": \"0.35\" }\n    ],\n    \"variations\": [\"Two overlapping pools\", \"Move the light to a corner\", \"Pulse the strength slowly\"],\n    \"ai_usage\": \"The cheapest way to give a dark hero focus. One radial-gradient with a colour at low alpha, sized 60–80% — anything smaller reads as a bright dot behind the headline.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: #7c5cff; --size: 70%; --str: .35; }\n    .bg { background: radial-gradient(circle var(--size) at 50% 30%, color-mix(in srgb, var(--c) calc(var(--str) * 100%), transparent), transparent 70%), #0b0d12; }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
