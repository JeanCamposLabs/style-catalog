  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Liquid Metal</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"liquid-metal-blob\",\n    \"title\": \"Liquid Metal\",\n    \"summary\": \"A mercury blob that morphs and reflects.\",\n    \"description\": \"A mercury blob that morphs and reflects.\",\n    \"theme\": \"holographic-metallic\",\n    \"categories\": [\"material\", \"holographic\"],\n    \"tags\": [\"holographic\", \"metallic\", \"liquid-metal\", \"mercury\", \"morph\", \"blob\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Iridescent surfaces have unpredictable local contrast — never place body text directly on one.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Morph cycle\", \"default\": \"7s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Futuristic and AI branding. A tight specular highlight near one edge is what makes the blob read as metal rather than as a grey shape.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 170px; height: 170px; border-radius: 44% 56% 62% 38% / 48% 42% 58% 52%;\n      background: radial-gradient(circle at 32% 28%, #fff 0 8%, #cbd5e1 22%, #64748b 48%, #1e293b 78%, #94a3b8);\n      animation: morph 7s ease-in-out infinite; box-shadow: 0 20px 40px rgba(0,0,0,.5); }\n    @keyframes morph {\n      0%, 100% { border-radius: 44% 56% 62% 38% / 48% 42% 58% 52%; }\n      33% { border-radius: 62% 38% 44% 56% / 58% 52% 48% 42%; }\n      66% { border-radius: 38% 62% 56% 44% / 42% 58% 52% 48%; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"></div>\n</body>\n</html>\n"
