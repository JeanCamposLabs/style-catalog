  "path": "effects/hover-interactions/3d-flip-tile-grid.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Flip Tile Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"3d-flip-tile-grid\",\n    \"title\": \"Flip Tile Grid\",\n    \"summary\": \"Tiles flip individually to reveal their back face on hover.\",\n    \"description\": \"Each tile is its own 3D scene, so hovering one never disturbs the layout of the others.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"3d\"],\n    \"tags\": [\"flip\", \"grid\", \"tiles\", \"3d\", \"reveal\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Flip duration\", \"default\": \"0.5s\" }\n    ],\n    \"variations\": [\"Flip on the Y axis instead\", \"Auto-flip in sequence\", \"Different back colour per tile\"],\n    \"ai_usage\": \"Feature grids and stat tiles. Put perspective on each tile (not the grid) and backface-visibility:hidden on both faces; forgetting the latter shows mirrored text through the card.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: .5s; }\n    .tiles { display: grid; grid-template-columns: repeat(3, 92px); gap: 10px; }\n    .tile { perspective: 600px; height: 92px; }\n    .tile .in { position: relative; width: 100%; height: 100%; transform-style: preserve-3d;\n      transition: transform var(--dur) cubic-bezier(.7,0,.2,1); }\n    .tile:hover .in, .tile:focus-within .in { transform: rotateX(180deg); }\n    .tile .f, .tile .b { position: absolute; inset: 0; display: grid; place-items: center; border-radius: 12px;\n      backface-visibility: hidden; font-weight: 800; }\n    .tile .f { background: #1b2338; color: #e7ebf3; }\n    .tile .b { background: #7c5cff; color: #fff; transform: rotateX(180deg); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"tiles\">\n    <div class=\"tile\" tabindex=\"0\"><div class=\"in\"><div class=\"f\">01</div><div class=\"b\">↑ 12%</div></div></div>\n    <div class=\"tile\" tabindex=\"0\"><div class=\"in\"><div class=\"f\">02</div><div class=\"b\">↓ 3%</div></div></div>\n    <div class=\"tile\" tabindex=\"0\"><div class=\"in\"><div class=\"f\">03</div><div class=\"b\">↑ 41%</div></div></div>\n    <div class=\"tile\" tabindex=\"0\"><div class=\"in\"><div class=\"f\">04</div><div class=\"b\">↑ 8%</div></div></div>\n    <div class=\"tile\" tabindex=\"0\"><div class=\"in\"><div class=\"f\">05</div><div class=\"b\">— 0%</div></div></div>\n    <div class=\"tile\" tabindex=\"0\"><div class=\"in\"><div class=\"f\">06</div><div class=\"b\">↑ 27%</div></div></div>\n  </div>\n</body>\n</html>\n"
}
