  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Touch Target Size</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"touch-target-size\",\n    \"title\": \"Touch Target Size\",\n    \"summary\": \"Hit areas below and above the 44px minimum.\",\n    \"description\": \"Hit areas below and above the 44px minimum.\",\n    \"theme\": \"accessibility-patterns\",\n    \"categories\": [\"accessibility\", \"reference\"],\n    \"tags\": [\"accessibility\", \"a11y\", \"touch-target\", \"hit-area\", \"mobile\", \"wcag\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"These specimens are the accessibility reference — each demonstrates the correct semantics, not just the visual result.\",\n    \"customization\": [\n      { \"name\": \"--min\", \"description\": \"Minimum target\", \"default\": \"44px\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"WCAG 2.2 asks for 24×24 CSS pixels minimum; 44×44 is the practical target. When the visual control must stay small, expand the hit area with padding or a pseudo-element rather than scaling the icon.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 20px; align-items: center; }\n    .t { display: grid; justify-items: center; gap: .4rem; font-size: .72rem; color: #8b93a7; }\n    .small { width: 24px; height: 24px; }\n    .good { width: 44px; height: 44px; }\n    .t button { border-radius: 10px; border: 1px solid #263149; background: #151b2a; color: #cbd5e1; cursor: pointer;\n      display: grid; place-items: center; }\n    .pad { position: relative; width: 24px; height: 24px; }\n    .pad button { position: absolute; inset: -10px; width: auto; height: auto; }\n    .note { margin-top: .9rem; max-width: 280px; color: #8b93a7; font-size: .8rem; line-height: 1.5; }\n  </style>\n</head>\n<body>\n  <div><div class=\"fx\"><div class=\"t\"><button class=\"small\" type=\"button\" aria-label=\"Too small\">×</button>24px</div>\n  <div class=\"t\"><button class=\"good\" type=\"button\" aria-label=\"Comfortable\">×</button>44px</div>\n  <div class=\"t\"><span class=\"pad\"><button type=\"button\" aria-label=\"Small icon, large hit area\">×</button></span>24px + padding</div></div>\n  <p class=\"note\">The third control looks 24px but its hit area is 44px — the recommended compromise for dense toolbars.</p></div>\n</body>\n</html>\n"
