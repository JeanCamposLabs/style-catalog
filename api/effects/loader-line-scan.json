linear-gradient(180deg, transparent, #2dd4bf, transparent);\n      box-shadow: 0 0 14px #2dd4bf; animation: scan 1.8s ease-in-out infinite alternate; }\n    @keyframes scan { from { left: 4%; } to { left: 94%; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\" aria-label=\"Analysing\"><i></i></div>\n</body>\n</html>\n"
