  "path": "effects/tooltips-popovers/popover-color-picker.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Popover Colour Picker</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"popover-color-picker\",\n    \"title\": \"Popover Colour Picker\",\n    \"summary\": \"A swatch grid that opens from a trigger.\",\n    \"description\": \"A swatch grid that opens from a trigger.\",\n    \"theme\": \"tooltips-popovers\",\n    \"categories\": [\"tooltip\", \"overlay\"],\n    \"tags\": [\"tooltip\", \"popover\", \"color\", \"picker\", \"swatches\", \"popover\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Hover-only content is unreachable by keyboard and touch: show on focus too, link with aria-describedby, and never put interactive content in a hover tooltip.\",\n    \"customization\": [\n      { \"name\": \"--cols\", \"description\": \"Swatch columns\", \"default\": \"5\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Theme and label pickers. Name every swatch in its accessible label; a grid of unlabelled colour buttons is unusable without sight.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .cp { position: relative; display: inline-block; }\n    .cp > button { display: flex; align-items: center; gap: .5rem; padding: .5rem .8rem; border-radius: 10px;\n      border: 1px solid #2b3450; background: #151b2a; color: #e7ebf3; font: inherit; cursor: pointer; }\n    .cp .dot { width: 18px; height: 18px; border-radius: 5px; background: #7c5cff; }\n    .panel { position: absolute; top: calc(100% + 8px); left: 0; padding: .6rem; border-radius: 12px; background: #141a28;\n      border: 1px solid #2b3450; display: none; grid-template-columns: repeat(5, 26px); gap: 6px; box-shadow: 0 16px 40px rgba(0,0,0,.5); }\n    .cp.is-open .panel { display: grid; }\n    .panel button { width: 26px; height: 26px; border-radius: 7px; border: 0; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <span class=\"cp\" id=\"cp\"><button type=\"button\" aria-expanded=\"false\"><span class=\"dot\" id=\"dot\"></span>Accent</button>\n  <div class=\"panel\" role=\"group\" aria-label=\"Accent colour\">\n    <button type=\"button\" aria-label=\"Violet\" style=\"background:#7c5cff\"></button>\n    <button type=\"button\" aria-label=\"Teal\" style=\"background:#2dd4bf\"></button>\n    <button type=\"button\" aria-label=\"Pink\" style=\"background:#f472b6\"></button>\n    <button type=\"button\" aria-label=\"Amber\" style=\"background:#fbbf24\"></button>\n    <button type=\"button\" aria-label=\"Sky\" style=\"background:#38bdf8\"></button>\n  </div></span>\n  <script>\n    (function () {\n      var cp = document.getElementById(\"cp\"), b = cp.querySelector(\"button\"), dot = document.getElementById(\"dot\");\n      b.addEventListener(\"click\", function () { b.setAttribute(\"aria-expanded\", String(cp.classList.toggle(\"is-open\"))); });\n      cp.querySelector(\".panel\").addEventListener(\"click\", function (e) {\n        var s = e.target.closest(\"button\"); if (!s) return;\n        dot.style.background = getComputedStyle(s).backgroundColor;\n        cp.classList.remove(\"is-open\"); b.setAttribute(\"aria-expanded\", \"false\");\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
