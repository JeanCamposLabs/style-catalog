  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Mushroom Cluster</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"mushroom-cluster\",\n    \"title\": \"Mushroom Cluster\",\n    \"summary\": \"Toadstools that pop up in sequence.\",\n    \"description\": \"Toadstools that pop up in sequence.\",\n    \"theme\": \"nature-organic\",\n    \"categories\": [\"nature\", \"organic\"],\n    \"tags\": [\"organic\", \"nature\", \"mushroom\", \"forest\", \"pop\", \"cluster\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Ambient nature motion should be slow and optional — disable it entirely under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Cap colour\", \"default\": \"#ef4444\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Slow it down for an ambient version\"],\n    \"ai_usage\": \"Playful nature illustration. Scale from the base (transform-origin: bottom) so they appear to grow out of the ground.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: flex-end; gap: 12px; }\n    .fx .m { display: grid; justify-items: center; transform-origin: bottom; animation: pop 3.6s ease-in-out infinite; animation-delay: var(--dl); }\n    .fx .cap { width: var(--w); height: calc(var(--w) * .58); border-radius: 99px 99px 8px 8px; background: #ef4444;\n      box-shadow: inset -4px -3px 0 rgba(0,0,0,.15); }\n    .fx .stem { width: calc(var(--w) * .34); height: calc(var(--w) * .6); background: #fef3c7; border-radius: 0 0 6px 6px; }\n    @keyframes pop { 0%, 8% { transform: scaleY(0); } 22%, 90% { transform: scaleY(1); } 100% { transform: scaleY(0); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"m\" style=\"--w:44px;--dl:0s\"><span class=\"cap\"></span><span class=\"stem\"></span></span>\n  <span class=\"m\" style=\"--w:60px;--dl:.3s\"><span class=\"cap\"></span><span class=\"stem\"></span></span>\n  <span class=\"m\" style=\"--w:34px;--dl:.6s\"><span class=\"cap\"></span><span class=\"stem\"></span></span></div>\n</body>\n</html>\n"
