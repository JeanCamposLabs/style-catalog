pointer;\n      box-shadow: 0 5px 0 #94a3b8, 0 8px 12px rgba(0,0,0,.45), inset 0 2px 0 #fff;\n      transition: transform .06s, box-shadow .06s; }\n    .fx button:active { transform: translateY(5px); box-shadow: 0 0 0 #94a3b8, 0 3px 8px rgba(0,0,0,.4), inset 0 2px 0 #fff; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><button type=\"button\">⌘</button><button type=\"button\">⇧</button><button type=\"button\">K</button></div>\n</body>\n</html>\n"
