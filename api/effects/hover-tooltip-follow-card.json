  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Preview on Hover</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hover-tooltip-follow-card\",\n    \"title\": \"Preview on Hover\",\n    \"summary\": \"A thumbnail preview appearing beside a link.\",\n    \"description\": \"A thumbnail preview appearing beside a link.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"interaction\"],\n    \"tags\": [\"hover\", \"pointer\", \"preview\", \"hover\", \"link\", \"thumbnail\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover state here is mirrored on :focus-visible so keyboard users get the same information.\",\n    \"customization\": [\n      { \"name\": \"--w\", \"description\": \"Preview width\", \"default\": \"160px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Wiki and documentation links. Delay the preview by ~300ms so it does not flash while the pointer crosses a paragraph of links.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; display: inline-block; }\n    .fx a { color: #b9a5ff; text-decoration: underline; font-size: .95rem; }\n    .fx .pv { position: absolute; bottom: calc(100% + 8px); left: 0; width: 160px; padding: 6px; border-radius: 12px;\n      background: #141a28; border: 1px solid #2b3450; opacity: 0; visibility: hidden; transform: translateY(6px);\n      transition: opacity .2s, transform .2s, visibility .2s; }\n    .fx .pv .img { aspect-ratio: 16 / 10; border-radius: 8px; background: conic-gradient(from 160deg, #7c5cff, #2dd4bf, #d1478c); }\n    .fx .pv b { display: block; margin-top: .35rem; font-size: .74rem; color: #cbd5e1; }\n    .fx:hover .pv, .fx:focus-within .pv { opacity: 1; visibility: visible; transform: none; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <span class=\"fx\"><a href=\"#\">aurora-background</a><span class=\"pv\" role=\"tooltip\"><span class=\"img\"></span><b>Backgrounds · CSS</b></span></span>\n</body>\n</html>\n"
