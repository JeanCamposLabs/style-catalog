  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Skeleton Rows</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"skeleton-list-rows\",\n    \"title\": \"Skeleton Rows\",\n    \"summary\": \"Placeholder list rows with avatars.\",\n    \"description\": \"Placeholder list rows with avatars.\",\n    \"theme\": \"empty-skeleton-states\",\n    \"categories\": [\"state\", \"empty\"],\n    \"tags\": [\"state\", \"placeholder\", \"skeleton\", \"list\", \"rows\", \"loading\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Loading placeholders must be hidden from assistive tech (aria-hidden) with a single aria-live status instead; empty states need real headings and a focusable action.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Shimmer period\", \"default\": \"1.6s\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"List views. Show three to five skeleton rows, never a screen full — a long placeholder list overstates how much content is coming.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; display: grid; gap: 10px; }\n    .r { display: flex; align-items: center; gap: .8rem; padding: .6rem .8rem; border-radius: 12px;\n      background: #151b2a; border: 1px solid #263149; }\n    .r .av { width: 34px; height: 34px; border-radius: 50%; flex: none; }\n    .r .col { flex: 1; display: grid; gap: 6px; }\n    .r .l { height: 8px; border-radius: 4px; }\n    .r .l.s { width: 55%; }\n    .sk { background: linear-gradient(90deg, #1b2231 25%, #2b3550 37%, #1b2231 63%); background-size: 400% 100%;\n      animation: sheen 1.6s ease-in-out infinite; }\n    @keyframes sheen { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" aria-hidden=\"true\"><div class=\"r\"><span class=\"av sk\"></span><span class=\"col\"><span class=\"l sk\"></span><span class=\"l s sk\"></span></span></div>\n  <div class=\"r\"><span class=\"av sk\"></span><span class=\"col\"><span class=\"l sk\"></span><span class=\"l s sk\"></span></span></div>\n  <div class=\"r\"><span class=\"av sk\"></span><span class=\"col\"><span class=\"l sk\"></span><span class=\"l s sk\"></span></span></div></div>\n</body>\n</html>\n"
