  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Live Recording</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"recording-waveform-live\",\n    \"title\": \"Live Recording\",\n    \"summary\": \"A live input meter with a recording indicator.\",\n    \"description\": \"A live input meter with a recording indicator.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"recording\", \"meter\", \"live\", \"input\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Level colour\", \"default\": \"#ef4444\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Voice recorders and meetings. The blinking dot plus a running timer is the minimum honest recording indicator — never hide it.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: .9rem; width: 290px; padding: .9rem 1rem; border-radius: 14px;\n      background: #151b2a; border: 1px solid #3a2530; }\n    .fx .rec { width: 12px; height: 12px; border-radius: 50%; background: #ef4444; animation: blink 1.4s ease-in-out infinite; }\n    .fx .bars { flex: 1; display: flex; align-items: center; gap: 3px; height: 34px; }\n    .fx .bars i { flex: 1; border-radius: 2px; background: #ef4444; animation: live var(--d) ease-in-out infinite alternate; }\n    .fx .time { font-family: ui-monospace, monospace; font-size: .82rem; color: #cbd5e1; font-variant-numeric: tabular-nums; }\n    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }\n    @keyframes live { from { height: 15%; } to { height: 100%; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\" aria-label=\"Recording, 1 minute 24 seconds\"><span class=\"rec\"></span>\n  <span class=\"bars\" aria-hidden=\"true\"><i style=\"--d:.4s\"></i><i style=\"--d:.6s\"></i><i style=\"--d:.5s\"></i><i style=\"--d:.75s\"></i>\n  <i style=\"--d:.45s\"></i><i style=\"--d:.65s\"></i><i style=\"--d:.55s\"></i><i style=\"--d:.7s\"></i></span>\n  <span class=\"time\">01:24</span></div>\n</body>\n</html>\n"
}
