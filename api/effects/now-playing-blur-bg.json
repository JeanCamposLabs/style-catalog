  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Now Playing</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"now-playing-blur-bg\",\n    \"title\": \"Now Playing\",\n    \"summary\": \"A full card with artwork-derived blurred backdrop.\",\n    \"description\": \"A full card with artwork-derived blurred backdrop.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"now-playing\", \"blur\", \"artwork\", \"ambient\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--blur\", \"description\": \"Backdrop blur\", \"default\": \"34px\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Player screens. Deriving the backdrop from the artwork gives every track its own palette without shipping any extra assets.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 250px; padding: 1.4rem; border-radius: 20px; overflow: hidden; color: #fff; text-align: center; }\n    .fx::before { content: \"\"; position: absolute; inset: -30%; filter: blur(34px); opacity: .7;\n      background: conic-gradient(from 40deg, #7c5cff, #2dd4bf, #f472b6, #7c5cff); }\n    .fx .art { position: relative; width: 130px; height: 130px; border-radius: 16px; margin: 0 auto 1rem;\n      background: conic-gradient(from 40deg, #7c5cff, #2dd4bf, #f472b6); box-shadow: 0 16px 34px rgba(0,0,0,.5); }\n    .fx b { position: relative; display: block; font-size: 1rem; }\n    .fx span { position: relative; font-size: .82rem; opacity: .75; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"art\"></div><b>Midnight City</b><span>M83 · Hurry Up, We're Dreaming</span></div>\n</body>\n</html>\n"
