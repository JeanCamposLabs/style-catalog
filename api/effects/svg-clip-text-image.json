  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>SVG Text Clip</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"svg-clip-text-image\",\n    \"title\": \"SVG Text Clip\",\n    \"summary\": \"An image visible only inside SVG letterforms.\",\n    \"description\": \"An image visible only inside SVG letterforms.\",\n    \"theme\": \"svg-effects\",\n    \"categories\": [\"svg\", \"vector\"],\n    \"tags\": [\"svg\", \"vector\", \"clip-path\", \"text\", \"image\", \"knockout\"],\n    \"tech\": [\"svg\", \"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Inline SVG needs role=img and a title or aria-label when it carries meaning, and aria-hidden when it is decoration.\",\n    \"customization\": [\n      { \"name\": \"--size\", \"description\": \"Font size\", \"default\": \"62\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Headline treatments that must clip a photo or gradient. clipPath with SVG text works where background-clip cannot — for instance clipping a video element.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; }\n    .fx svg { width: 100%; display: block; }\n    .fx text { font-family: system-ui, sans-serif; font-weight: 900; font-size: 62px; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><svg viewBox=\"0 0 280 90\" role=\"img\" aria-label=\"VECTOR\">\n    <defs><clipPath id=\"tc\"><text x=\"140\" y=\"68\" text-anchor=\"middle\">VECTOR</text></clipPath>\n    <linearGradient id=\"tg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#7c5cff\"/>\n    <stop offset=\"0.5\" stop-color=\"#2dd4bf\"/><stop offset=\"1\" stop-color=\"#c2891a\"/></linearGradient></defs>\n    <rect width=\"280\" height=\"90\" fill=\"url(#tg)\" clip-path=\"url(#tc)\"/></svg></div>\n</body>\n</html>\n"
}
