  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Offset Polka Dots</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"polka-dots-offset\",\n    \"title\": \"Offset Polka Dots\",\n    \"summary\": \"Staggered dots in a diamond layout.\",\n    \"description\": \"Staggered dots in a diamond layout. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"dots\", \"polka\", \"offset\", \"diamond\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Dot colour\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--s\", \"description\": \"Grid pitch\", \"default\": \"40px\" },\n      { \"name\": \"--r\", \"description\": \"Dot radius\", \"default\": \"5px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Playful and retro surfaces. Two dot layers offset by half a tile give the diamond arrangement a single layer cannot.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: #7c5cff; --s: 40px; --r: 5px; }\n    .bg { background-color: #0b0d12;\n      background-image: radial-gradient(var(--c) var(--r), transparent calc(var(--r) + 1px)),\n        radial-gradient(var(--c) var(--r), transparent calc(var(--r) + 1px));\n      background-size: var(--s) var(--s);\n      background-position: 0 0, calc(var(--s) / 2) calc(var(--s) / 2); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
