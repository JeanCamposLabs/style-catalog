  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Frosted Ice Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"frost-text\",\n    \"title\": \"Frosted Ice Text\",\n    \"summary\": \"A cold headline with crystalline highlights and a pale drop shadow.\",\n    \"description\": \"A blue-white gradient fill plus a light outer glow and a soft inner-dark shadow give the glassy depth of frozen type.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"elemental\"],\n    \"tags\": [\"ice\", \"frost\", \"cold\", \"gradient\", \"winter\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--ice\", \"description\": \"Highlight color\", \"default\": \"#e0f2fe\" },\n      { \"name\": \"--deep\", \"description\": \"Shadow tone\", \"default\": \"#0369a1\" }\n    ],\n    \"variations\": [\"Add drips with a mask\", \"Animate a slow shimmer\", \"Pair with a falling-snow background\"],\n    \"ai_usage\": \"Winter promos, cold-storage or gaming themes. The chill comes from the pairing of a near-white gradient with a saturated blue glow; drop the glow and it just reads as light gray text.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .ice { font-size: clamp(2.2rem, 9vw, 4.4rem); font-weight: 900;\n      background: linear-gradient(180deg, #ffffff, var(--ice, #e0f2fe) 40%, #7dd3fc);\n      -webkit-background-clip: text; background-clip: text; color: transparent;\n      filter: drop-shadow(0 0 14px rgba(56,189,248,.55)) drop-shadow(0 4px 2px rgba(3,105,161,.6)); }\n  </style>\n</head>\n<body>\n  <h1 class=\"ice\">SUBZERO</h1>\n</body>\n</html>\n"
}
