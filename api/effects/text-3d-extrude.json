  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>3D Extruded Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"text-3d-extrude\",\n    \"title\": \"3D Extruded Text\",\n    \"summary\": \"Stacked text-shadows extrude the headline into a solid slab.\",\n    \"description\": \"A dozen 1px-offset shadows in darkening steps build the side of the letterform, with a final soft shadow grounding it.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"3d\"],\n    \"tags\": [\"3d\", \"extrude\", \"text-shadow\", \"depth\", \"headline\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--face\", \"description\": \"Front face color\", \"default\": \"#ffd166\" },\n      { \"name\": \"--side\", \"description\": \"Extrusion color\", \"default\": \"#b06a12\" },\n      { \"name\": \"--depth\", \"description\": \"Extrusion length\", \"default\": \"10\" }\n    ],\n    \"variations\": [\"Animate the depth on hover\", \"Angle the extrusion by adding x-offset\", \"Gradient face with background-clip\"],\n    \"ai_usage\": \"Poster and hero headlines. The slab is a run of text-shadows at increasing offsets — generate them rather than hand-typing, and keep the offsets 1px apart or the side shows banding. Pair with a tight, heavy font.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --face: #ffd166; --side: #b06a12; }\n    .ex { font-size: clamp(2.4rem, 9vw, 4.6rem); font-weight: 900; letter-spacing: -.02em; color: var(--face);\n      text-shadow: 1px 1px var(--side), 2px 2px var(--side), 3px 3px var(--side), 4px 4px var(--side),\n        5px 5px var(--side), 6px 6px var(--side), 7px 7px var(--side), 8px 8px var(--side),\n        9px 9px var(--side), 10px 10px var(--side), 12px 14px 18px rgba(0,0,0,.55); }\n  </style>\n</head>\n<body>\n  <h1 class=\"ex\">EXTRUDE</h1>\n</body>\n</html>\n"
