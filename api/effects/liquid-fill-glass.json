animation: fill 5s ease-in-out infinite; }\n    .fx .liq::before { content: \"\"; position: absolute; top: -10px; left: -20%; right: -20%; height: 20px; border-radius: 45%;\n      background: #38bdf8; animation: spin 3s linear infinite; }\n    @keyframes fill { 0%, 10% { height: 0; } 55%, 85% { height: 78%; } 100% { height: 0; } }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"liq\"></span></div>\n</body>\n</html>\n"
