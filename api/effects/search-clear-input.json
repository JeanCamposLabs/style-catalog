  "path": "effects/forms-inputs/search-clear-input.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Search Field with Clear</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"search-clear-input\",\n    \"title\": \"Search Field with Clear\",\n    \"summary\": \"A search box whose clear button appears only when there is text.\",\n    \"description\": \"The clear affordance is hidden while empty, so the field stays visually quiet until it has content.\",\n    \"theme\": \"forms-inputs\",\n    \"categories\": [\"form\", \"input\"],\n    \"tags\": [\"search\", \"clear\", \"input\", \"affordance\", \"utility\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every control keeps a real <label>, a visible focus ring, and state that is never signalled by colour alone.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Accent\", \"default\": \"#2dd4bf\" }\n    ],\n    \"variations\": [\"Loading spinner while querying\", \"Keyboard shortcut hint on the right\"],\n    \"ai_usage\": \"Any search UI. Use type=search plus an explicit clear button — the native clear button is inconsistent across browsers and invisible in Firefox.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .sf { position: relative; width: 300px; }\n    .sf input { width: 100%; padding: .8rem 2.6rem .8rem 2.4rem; border-radius: 12px; border: 1px solid #2b3450;\n      background: #151b2a; color: #e7ebf3; font: inherit; }\n    .sf input:focus { outline: none; border-color: var(--c, #2dd4bf); }\n    .sf .ico { position: absolute; left: .8rem; top: 50%; translate: 0 -50%; color: #8b93a7; }\n    .sf .clr { position: absolute; right: .5rem; top: 50%; translate: 0 -50%; border: 0; background: #2b3450; color: #e7ebf3;\n      width: 24px; height: 24px; border-radius: 50%; cursor: pointer; display: none; }\n    .sf.has-value .clr { display: block; }\n  </style>\n</head>\n<body>\n  <div class=\"sf\" id=\"sf\"><span class=\"ico\" aria-hidden=\"true\">⌕</span>\n  <input type=\"search\" aria-label=\"Search\" placeholder=\"Search effects\" />\n  <button class=\"clr\" type=\"button\" aria-label=\"Clear search\">×</button></div>\n  <script>\n    (function () {\n      var w = document.getElementById(\"sf\"), i = w.querySelector(\"input\"), c = w.querySelector(\".clr\");\n      i.addEventListener(\"input\", function () { w.classList.toggle(\"has-value\", !!i.value); });\n      c.addEventListener(\"click\", function () { i.value = \"\"; w.classList.remove(\"has-value\"); i.focus(); });\n    })();\n  </script>\n</body>\n</html>\n"
}
