  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Inner Stroke</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"inner-stroke-inset\",\n    \"title\": \"Inner Stroke\",\n    \"summary\": \"A hairline drawn inside the box that never affects layout.\",\n    \"description\": \"An inset box-shadow of 1px gives a crisp inner rule that, unlike a border, adds nothing to the element's size.\",\n    \"theme\": \"borders-shadows\",\n    \"categories\": [\"border\"],\n    \"tags\": [\"inset\", \"hairline\", \"box-shadow\", \"precision\", \"ui\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative edge treatment — never encode meaning in the border colour alone. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Stroke color\", \"default\": \"rgba(255,255,255,.14)\" }\n    ],\n    \"variations\": [\"Two-tone inner stroke for a bevel\", \"Only on the top edge\", \"Combine with an outer border\"],\n    \"ai_usage\": \"Design-system surfaces where 1px of layout shift matters. inset box-shadow keeps the border-box identical, which is why component libraries prefer it over a real border on hover states.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; padding: 1.6rem; color: #e7ebf3; }\n    .demo h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .demo p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    :root { --c: rgba(255,255,255,.14); }\n    .demo { background: #151b2a; border-radius: 14px; box-shadow: inset 0 0 0 1px var(--c), 0 10px 30px rgba(0,0,0,.4); }\n  </style>\n</head>\n<body>\n  <div class=\"demo\"><h3>Inner stroke</h3><p>Hairline with zero layout cost.</p></div>\n</body>\n</html>\n"
