.85rem; }\n    .chip button { width: 20px; height: 20px; border: 0; border-radius: 50%; background: #2b3450; color: #cbd5e1;\n      cursor: pointer; font: inherit; line-height: 1; }\n    .chip button:hover { background: #f87171; color: #2a0a0a; }\n  </style>\n</head>\n<body>\n  <div class=\"chips\">\n    <span class=\"chip\">CSS<button type=\"button\" aria-label=\"Remove CSS\">×</button></span>\n    <span class=\"chip\">Animation<button type=\"button\" aria-label=\"Remove Animation\">×</button></span>\n  </div>\n</body>\n</html>\n"
