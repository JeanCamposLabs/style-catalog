ems: center; font-size: .7rem; font-weight: 900; }\n  </style>\n</head>\n<body>\n  <span class=\"fx\">Jean Campos <span class=\"v\" role=\"img\" aria-label=\"Verified account\">✓</span></span>\n</body>\n</html>\n"
