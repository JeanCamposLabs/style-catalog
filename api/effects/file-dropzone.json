  "era": "2020s",
  "difficulty": "intermediate",
  "dependencies": [],
  "browser_support": "All modern browsers. Drag-and-drop needs a pointer; the wrapped file input is the fallback everywhere else, including touch and keyboard.",
  "performance_notes": "Listeners are bound once on the zone plus a window-level guard that stops the browser navigating away when a file is dropped outside it. Rendering is one row per file. Progress here is simulated on a timer — swap it for real XHR/fetch upload events.",
  "accessibility_notes": "The zone is a <label> wrapping a visually-hidden (not display:none) file input, so it stays in the tab order, announces as a file control, and opens the picker on Enter or Space with no key handling of our own. Drag state is decorative only — every action is reachable without dragging. The queue is an aria-live=\"polite\" region so added files are announced once. Focus is shown with a real outline, and the dashed border is not the only cue for the drag state.",
  "customization": [
    {
      "name": "--accent",
      "description": "Active/dragover tint and progress fill",
      "default": "#7c5cff"
    },
    {
      "name": "--line",
      "description": "Resting dashed border colour",
      "default": "#2b3145"
    },
    {
      "name": "accept",
      "description": "Restrict pickable types on the input; validate again on drop, since dropping bypasses accept",
      "default": "unset"
    },
    {
      "name": "MAX_MB",
      "description": "Client-side size guard — always re-check server side",
      "default": "10"
    }
  ],
  "variations": [
    "Paste-to-upload by listening for paste and reading event.clipboardData.files",
