{
  "id": "file-dropzone",
  "title": "File Drop Zone",
  "summary": "Drag-and-drop upload area with a dashed target, live drag state, and a queued file list with progress bars.",
  "description": "A drop target that is also a real file input, which is the part most implementations get wrong. The dashed frame lifts and tints on dragover, driven by a drag counter so that dragging across a child element does not flicker the state off and on. Dropped or picked files land in a queue with a type icon, a human-readable size, and a progress bar; the label wraps a visually-hidden <input type=\"file\"> so the whole zone is clickable, focusable, and operable from the keyboard without a single extra listener.",
  "theme": "forms-inputs",
  "themeTitle": "Forms & Inputs",
