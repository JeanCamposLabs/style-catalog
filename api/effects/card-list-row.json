n    .card { display: flex; align-items: center; gap: .9rem; padding: .9rem 1rem; background: #151b2a;\n      border: 1px solid #263149; border-radius: 14px; }\n    .card .ic { flex: none; width: 40px; height: 40px; border-radius: 11px; background: #22304a; display: grid; place-items: center; }\n    .card .txt { flex: 1; min-width: 0; }\n    .card h3 { font-size: .95rem; margin: 0; }\n    .card p { font-size: .8rem; margin: 0; }\n    .card .go { color: #8b93a7; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <article class=\"card\"><span class=\"ic\" aria-hidden=\"true\">📁</span><div class=\"txt\"><h3>Design assets</h3><p>24 files · 82 MB</p></div><span class=\"go\" aria-hidden=\"true\">›</span></article>\n</body>\n</html>\n"
