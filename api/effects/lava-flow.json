  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Lava Flow</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"lava-flow\",\n    \"title\": \"Lava Flow\",\n    \"summary\": \"Glowing molten flow with a crusted surface.\",\n    \"description\": \"Glowing molten flow with a crusted surface.\",\n    \"theme\": \"fire-water\",\n    \"categories\": [\"elemental\", \"animation\"],\n    \"tags\": [\"elemental\", \"animated\", \"lava\", \"molten\", \"volcano\", \"heat\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Elemental loops are decorative and must stop entirely under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Lava colour\", \"default\": \"#f97316\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Adjust the loop duration\"],\n    \"ai_usage\": \"Volcanic and heat themes. A dark crust multiplied over a moving hot gradient produces the cracked-surface read cheaply.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 260px; height: 120px; border-radius: 14px; overflow: hidden; background: #1c0a05; }\n    .fx .flow { position: absolute; inset: 0; background: linear-gradient(100deg, #dc2626, #f97316, #fbbf24, #dc2626);\n      background-size: 300% 100%; animation: shift 6s linear infinite; }\n    .fx .crust { position: absolute; inset: 0; mix-blend-mode: multiply; opacity: .8;\n      background-image: radial-gradient(circle at 20% 30%, #0b0d12 0 12%, transparent 13%),\n        radial-gradient(circle at 62% 70%, #0b0d12 0 16%, transparent 17%),\n        radial-gradient(circle at 84% 24%, #0b0d12 0 10%, transparent 11%); background-size: 120px 120px; }\n    @keyframes shift { to { background-position: 300% 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"></div>\n</body>\n</html>\n"
