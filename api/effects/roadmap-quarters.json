  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Quarter Roadmap</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"roadmap-quarters\",\n    \"title\": \"Quarter Roadmap\",\n    \"summary\": \"Initiatives laid out across quarters.\",\n    \"description\": \"Initiatives laid out across quarters.\",\n    \"theme\": \"timelines-steppers\",\n    \"categories\": [\"timeline\", \"stepper\"],\n    \"tags\": [\"timeline\", \"sequence\", \"roadmap\", \"quarters\", \"planning\", \"gantt\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Sequences need list markup and an explicit current marker (aria-current) — position and colour alone are not enough.\",\n    \"customization\": [\n      { \"name\": \"--c1\", \"description\": \"Track colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Public roadmaps. Label the bars directly and avoid precise dates — a quarter-level roadmap that implies day precision creates commitments you cannot keep.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; font-size: .78rem; }\n    .hd { display: grid; grid-template-columns: repeat(4, 1fr); color: #8b93a7; margin-bottom: .5rem; text-align: center; }\n    .row { position: relative; height: 26px; margin-bottom: 6px;\n      background: repeating-linear-gradient(90deg, rgba(139,147,167,.18) 0 1px, transparent 1px 25%); }\n    .row i { position: absolute; top: 3px; height: 20px; border-radius: 6px; left: calc(var(--s) * 1%);\n      width: calc(var(--w) * 1%); display: grid; place-items: center; color: #0b0d12; font-weight: 700; font-size: .7rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"hd\"><span>Q1</span><span>Q2</span><span>Q3</span><span>Q4</span></div>\n  <div class=\"row\"><i style=\"--s:0;--w:46;background:#7c5cff\">Catalogue v1</i></div>\n  <div class=\"row\"><i style=\"--s:26;--w:48;background:#10a894\">MCP tooling</i></div>\n  <div class=\"row\"><i style=\"--s:54;--w:44;background:#c2891a\">Poster pipeline</i></div></div>\n</body>\n</html>\n"
