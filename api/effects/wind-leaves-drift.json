  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Drifting Leaves</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"wind-leaves-drift\",\n    \"title\": \"Drifting Leaves\",\n    \"summary\": \"Leaves tumbling across on a breeze.\",\n    \"description\": \"Leaves tumbling across on a breeze.\",\n    \"theme\": \"particles-physics\",\n    \"categories\": [\"particles\", \"physics\"],\n    \"tags\": [\"particles\", \"motion\", \"leaves\", \"wind\", \"tumble\", \"drift\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Particle fields are decorative and expensive — cap counts, pause when off-screen, and stop entirely under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Crossing period\", \"default\": \"6s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Seasonal decoration. Combine horizontal travel, a vertical drift, and rotation on one keyframe so each leaf follows its own arc.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 280px; height: 160px; border-radius: 14px; overflow: hidden;\n      background: linear-gradient(160deg, #10141f, #0b0d12); }\n    .fx i { position: absolute; width: 16px; height: 22px; border-radius: 50% 0 50% 0; background: #c2891a;\n      animation: blow var(--d) linear infinite; animation-delay: var(--dl); }\n    @keyframes blow {\n      0% { transform: translate(-30px, 0) rotate(0); opacity: 0; }\n      10%, 90% { opacity: 1; }\n      100% { transform: translate(310px, var(--y)) rotate(540deg); opacity: 0; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><i style=\"top:20%;--d:6s;--dl:0s;--y:40px\"></i><i style=\"top:52%;--d:8s;--dl:-2s;--y:-30px\"></i>\n  <i style=\"top:74%;--d:7s;--dl:-4s;--y:20px\"></i></div>\n</body>\n</html>\n"
