  "ai_usage": "Dark card grids. Track the pointer on the container, not each card, and write --x/--y as pixel values; the border-only look comes from a mask that keeps just the padding ring visible.",
  "path": "effects/hover-interactions/border-glow-follow.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Pointer-Following Border Glow</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"border-glow-follow\",\n    \"title\": \"Pointer-Following Border Glow\",\n    \"summary\": \"A soft glow tracks the pointer along the card's border.\",\n    \"description\": \"Pointer coordinates feed a radial gradient on a masked border layer, so the light appears to live in the edge itself.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"border\"],\n    \"tags\": [\"glow\", \"pointer\", \"border\", \"mask\", \"card\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Glow color\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--r\", \"description\": \"Glow radius\", \"default\": \"140px\" }\n    ],\n    \"variations\": [\"Multiple cards sharing one pointer listener\", \"Colour by card category\", \"Fade the glow out on leave\"],\n    \"ai_usage\": \"Dark card grids. Track the pointer on the container, not each card, and write --x/--y as pixel values; the border-only look comes from a mask that keeps just the padding ring visible.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .gcard { position: relative; width: 300px; padding: 1px; border-radius: 16px; background: #263149; }\n    .gcard::before { content: \"\"; position: absolute; inset: 0; border-radius: inherit; opacity: 0; transition: opacity .3s;\n      background: radial-gradient(var(--r, 140px) circle at var(--x) var(--y), var(--c, #7c5cff), transparent 60%); }\n    .gcard:hover::before { opacity: 1; }\n    .gcard .inner { position: relative; border-radius: 15px; background: #10141f; padding: 1.6rem; }\n    .gcard h3 { margin: 0 0 .4rem; }\n    .gcard p { margin: 0; color: #8b93a7; font-size: .92rem; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"gcard\" id=\"gc\"><div class=\"inner\"><h3>Edge lighting</h3><p>Move the pointer around the card border.</p></div></div>\n  <script>\n    (function () {\n      var c = document.getElementById(\"gc\");\n      c.addEventListener(\"pointermove\", function (e) {\n        var r = c.getBoundingClientRect();\n        c.style.setProperty(\"--x\", (e.clientX - r.left) + \"px\");\n        c.style.setProperty(\"--y\", (e.clientY - r.top) + \"px\");\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
