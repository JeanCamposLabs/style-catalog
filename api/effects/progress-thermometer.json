  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Thermometer Meter</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"progress-thermometer\",\n    \"title\": \"Thermometer Meter\",\n    \"summary\": \"A vertical bulb thermometer.\",\n    \"description\": \"A vertical bulb thermometer.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"thermometer\", \"vertical\", \"temperature\", \"fundraising\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Percent filled\", \"default\": \"64\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Fundraising totals and temperature. Anchor the fill to the bulb so a low percentage still shows colour at the base.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .th { position: relative; width: 44px; height: 190px; display: grid; place-items: end center; }\n    .th .tube { position: absolute; top: 0; width: 18px; height: 160px; border-radius: 999px 999px 0 0; background: #22304a; overflow: hidden; }\n    .th .fill { position: absolute; bottom: 0; width: 100%; height: calc(var(--p) * 1%); background: linear-gradient(#f87171, #fbbf24); }\n    .th .bulb { width: 42px; height: 42px; border-radius: 50%; background: #f87171; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"th\" style=\"--p:64\" role=\"img\" aria-label=\"64 percent of goal\"><div class=\"tube\"><div class=\"fill\"></div></div><div class=\"bulb\"></div></div>\n</body>\n</html>\n"
}
