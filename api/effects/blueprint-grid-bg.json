  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Blueprint Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"blueprint-grid-bg\",\n    \"title\": \"Blueprint Grid\",\n    \"summary\": \"Cyan draughting paper with fine and heavy rules.\",\n    \"description\": \"Two grid layers at different scales — a fine 20px cell and a heavy 100px major line — read exactly like technical paper.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"grid\"],\n    \"tags\": [\"blueprint\", \"grid\", \"technical\", \"draughting\", \"cyan\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--ink\", \"description\": \"Line color\", \"default\": \"rgba(125,211,252,.28)\" },\n      { \"name\": \"--paper\", \"description\": \"Paper color\", \"default\": \"#0a1626\" },\n      { \"name\": \"--s\", \"description\": \"Minor cell\", \"default\": \"20px\" }\n    ],\n    \"variations\": [\"White-on-blue classic blueprint\", \"Add a title block in the corner\", \"Animate a drawing reveal over it\"],\n    \"ai_usage\": \"Engineering, planning, and 'work in progress' pages. Layer a 1px fine grid under a 2px major grid at 5× the size — a single grid always reads as graph paper rather than a blueprint.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --ink: rgba(125,211,252,.28); --paper: #0a1626; --s: 20px; }\n    .bg { background-color: var(--paper);\n      background-image: linear-gradient(var(--ink) 1px, transparent 1px), linear-gradient(90deg, var(--ink) 1px, transparent 1px),\n        linear-gradient(rgba(125,211,252,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(125,211,252,.5) 1px, transparent 1px);\n      background-size: var(--s) var(--s), var(--s) var(--s), calc(var(--s) * 5) calc(var(--s) * 5), calc(var(--s) * 5) calc(var(--s) * 5); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
