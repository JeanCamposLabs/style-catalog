  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Pomodoro Timer</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"pomodoro-timer-ring\",\n    \"title\": \"Pomodoro Timer\",\n    \"summary\": \"A work timer with a draining ring and session dots.\",\n    \"description\": \"A work timer with a draining ring and session dots.\",\n    \"theme\": \"calendar-time\",\n    \"categories\": [\"calendar\", \"time\"],\n    \"tags\": [\"calendar\", \"date\", \"pomodoro\", \"timer\", \"focus\", \"sessions\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dates need machine-readable markup (<time datetime>) and selected days must be announced, not just highlighted.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Time remaining\", \"default\": \"68\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Focus tools. Show completed sessions as dots so the cycle position is visible at a glance without reading the timer.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; justify-items: center; gap: .8rem; }\n    .ring { position: relative; width: 140px; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center;\n      background: conic-gradient(#f87171 calc(var(--p) * 1%), #22304a 0);\n      -webkit-mask: radial-gradient(farthest-side, transparent 70%, #000 71%); mask: radial-gradient(farthest-side, transparent 70%, #000 71%); }\n    .wrap { position: relative; display: grid; place-items: center; }\n    .wrap b { position: absolute; font-size: 1.6rem; font-weight: 900; font-variant-numeric: tabular-nums; }\n    .dots { display: flex; gap: 6px; }\n    .dots i { width: 9px; height: 9px; border-radius: 50%; background: #22304a; }\n    .dots i.on { background: #f87171; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"wrap\"><div class=\"ring\" style=\"--p:68\" role=\"timer\" aria-label=\"17 minutes remaining\"></div><b>17:04</b></div>\n  <div class=\"dots\" aria-label=\"2 of 4 sessions complete\"><i class=\"on\"></i><i class=\"on\"></i><i></i><i></i></div></div>\n</body>\n</html>\n"
