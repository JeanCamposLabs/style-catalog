  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Loop vs One-Shot</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"loop-vs-oneshot\",\n    \"title\": \"Loop vs One-Shot\",\n    \"summary\": \"When motion should repeat and when it should not.\",\n    \"description\": \"When motion should repeat and when it should not.\",\n    \"theme\": \"motion-principles\",\n    \"categories\": [\"motion\", \"reference\"],\n    \"tags\": [\"motion\", \"easing\", \"loop\", \"one-shot\", \"repetition\", \"intent\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every motion token here has a reduced-motion equivalent: durations collapse to zero rather than the animation being left half-played.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Loop period\", \"default\": \"0.9s\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Loop only while something is genuinely ongoing. A looping success tick implies the operation has not finished; a one-shot spinner implies it has stalled.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 12px; }\n    .p { width: 130px; padding: .9rem; border-radius: 12px; background: #151b2a; border: 1px solid #263149; font-size: .76rem; color: #8b93a7; }\n    .p b { display: block; color: #e7ebf3; font-size: .82rem; margin-bottom: .5rem; }\n    .sp { width: 28px; height: 28px; border: 3px solid #22304a; border-top-color: #7c5cff; border-radius: 50%;\n      animation: spin .9s linear infinite; margin-bottom: .5rem; }\n    .ok { width: 28px; height: 28px; border-radius: 50%; background: #10a894; color: #04241f; display: grid; place-items: center;\n      margin-bottom: .5rem; animation: pop 3s cubic-bezier(.34,1.56,.64,1) infinite; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @keyframes pop { 0%, 70% { transform: scale(1); } 80% { transform: scale(1.25); } 90%, 100% { transform: scale(1); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"p\"><b>Loop</b><div class=\"sp\"></div>Ongoing work with unknown duration.</div>\n  <div class=\"p\"><b>One-shot</b><div class=\"ok\">✓</div>A completed, discrete event.</div></div>\n</body>\n</html>\n"
