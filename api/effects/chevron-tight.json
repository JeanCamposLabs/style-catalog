  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Tight Chevrons</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"chevron-tight\",\n    \"title\": \"Tight Chevrons\",\n    \"summary\": \"Dense arrow-like chevrons.\",\n    \"description\": \"Dense arrow-like chevrons. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"chevron\", \"zigzag\", \"arrows\", \"dense\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Chevron colour\", \"default\": \"#1f2a44\" },\n      { \"name\": \"--b\", \"description\": \"Ground\", \"default\": \"#0b0d12\" },\n      { \"name\": \"--s\", \"description\": \"Tile size\", \"default\": \"22px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Sport, packaging, and directional emphasis. Four gradients are the minimum for a true chevron; two only give diagonal stripes.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --a: #1f2a44; --b: #0b0d12; --s: 22px; }\n    .bg { background-color: var(--b);\n      background-image: linear-gradient(135deg, var(--a) 25%, transparent 25%), linear-gradient(225deg, var(--a) 25%, transparent 25%),\n        linear-gradient(45deg, var(--a) 25%, transparent 25%), linear-gradient(315deg, var(--a) 25%, transparent 25%);\n      background-position: calc(var(--s) / 2) 0, calc(var(--s) / 2) 0, 0 0, 0 0;\n      background-size: var(--s) var(--s); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
