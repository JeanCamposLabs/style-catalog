inherit; }\n    .fx input { width: 100%; padding: .8rem .9rem; border-radius: 12px; border: 1px solid #2b3450; background: #151b2a;\n      color: #e7ebf3; font: inherit; position: relative; background-clip: padding-box; }\n    .fx input:focus { outline: none; border-color: #7c5cff; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"ghost\" aria-hidden=\"true\">grad<span style=\"color:transparent\">ient-border</span></span>\n  <label class=\"sr\" for=\"ig\" style=\"position:absolute;left:-9999px\">Search</label><input id=\"ig\" type=\"text\" value=\"grad\" /></div>\n</body>\n</html>\n"
