  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Icon Toggle Group</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"button-toggle-group-icons\",\n    \"title\": \"Icon Toggle Group\",\n    \"summary\": \"Mutually exclusive icon options.\",\n    \"description\": \"Mutually exclusive icon options.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"action\"],\n    \"tags\": [\"button\", \"action\", \"toggle\", \"radio\", \"icons\", \"alignment\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>, keep a visible :focus-visible ring, and never signal state with colour alone.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Selected colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"View and alignment switchers. Build on radio inputs so arrow-key navigation and form submission work without any JavaScript.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: inline-flex; padding: 3px; border-radius: 11px; background: #151b2a; border: 1px solid #263149; }\n    .fx label { width: 40px; height: 34px; display: grid; place-items: center; border-radius: 8px; color: #8b93a7; cursor: pointer; font-size: .95rem; }\n    .fx input { position: absolute; opacity: 0; }\n    .fx input:checked + label { background: #7c5cff; color: #fff; }\n    .fx input:focus-visible + label { outline: 2px solid #fff; outline-offset: 2px; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"group\" aria-label=\"Alignment\">\n    <input type=\"radio\" name=\"al\" id=\"a1\" checked /><label for=\"a1\" title=\"Left\">⬅</label>\n    <input type=\"radio\" name=\"al\" id=\"a2\" /><label for=\"a2\" title=\"Centre\">⬌</label>\n    <input type=\"radio\" name=\"al\" id=\"a3\" /><label for=\"a3\" title=\"Right\">➡</label></div>\n</body>\n</html>\n"
