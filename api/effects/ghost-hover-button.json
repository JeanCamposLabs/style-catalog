  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Ghost to Solid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"ghost-hover-button\",\n    \"title\": \"Ghost to Solid\",\n    \"summary\": \"A ghost button gains a solid fill that grows from the centre.\",\n    \"description\": \"A centred pseudo-element scales from zero, so the fill blooms outward instead of wiping across.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"hover\"],\n    \"tags\": [\"ghost\", \"fill\", \"scale\", \"secondary\", \"hover\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>; keep a visible :focus-visible ring and never rely on hover alone to convey state. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Fill color\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--dur\", \"description\": \"Bloom duration\", \"default\": \"0.35s\" }\n    ],\n    \"variations\": [\"Scale from a corner\", \"Radial gradient fill\", \"Fill from the pointer position with JS\"],\n    \"ai_usage\": \"Secondary actions that need to feel equal to the primary on hover. Keep the border color constant through the transition so the button's footprint never appears to change.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    button { font: inherit; cursor: pointer; border: 0; }\n    button:focus-visible { outline: 2px solid #7c5cff; outline-offset: 3px; }\n    :root { --c: #7c5cff; --dur: .35s; }\n    .ghost { position: relative; overflow: hidden; padding: .95rem 2.2rem; border-radius: 12px; background: transparent;\n      border: 2px solid var(--c); color: var(--c); font-weight: 700; transition: color var(--dur); }\n    .ghost span { position: relative; z-index: 2; }\n    .ghost::before { content: \"\"; position: absolute; inset: 0; background: var(--c); transform: scale(0);\n      border-radius: 50%; transition: transform var(--dur) cubic-bezier(.7,0,.2,1); }\n    .ghost:hover { color: #fff; }\n    .ghost:hover::before { transform: scale(2.2); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <button class=\"ghost\" type=\"button\"><span>Learn more</span></button>\n</body>\n</html>\n"
}
