  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Embossed Panel</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"embossed-panel\",\n    \"title\": \"Embossed Panel\",\n    \"summary\": \"A panel that appears pressed out of the surface.\",\n    \"description\": \"Opposing inset shadows on two corners give the raised read; the same pair reversed makes it sunken.\",\n    \"theme\": \"borders-shadows\",\n    \"categories\": [\"shadow\", \"skeuomorphic\"],\n    \"tags\": [\"emboss\", \"inset\", \"soft-ui\", \"surface\", \"light\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative edge treatment — never encode meaning in the border colour alone. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--light\", \"description\": \"Highlight\", \"default\": \"rgba(255,255,255,.06)\" },\n      { \"name\": \"--dark\", \"description\": \"Shade\", \"default\": \"rgba(0,0,0,.5)\" }\n    ],\n    \"variations\": [\"Deboss variant\", \"Stronger light for plastic\", \"Coloured highlight for tinted surfaces\"],\n    \"ai_usage\": \"Soft-UI surfaces. Keep both shadows subtle and equal in magnitude; asymmetric strengths make the panel look tilted rather than raised.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; padding: 1.6rem; color: #e7ebf3; }\n    .demo h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .demo p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    :root { --light: rgba(255,255,255,.06); --dark: rgba(0,0,0,.5); }\n    .demo { background: #171d2b; border-radius: 18px;\n      box-shadow: inset 2px 2px 6px var(--light), inset -3px -3px 8px var(--dark), 0 12px 28px rgba(0,0,0,.35); }\n  </style>\n</head>\n<body>\n  <div class=\"demo\"><h3>Embossed</h3><p>Raised out of the surface.</p></div>\n</body>\n</html>\n"
}
