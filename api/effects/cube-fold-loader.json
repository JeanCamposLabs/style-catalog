  "ai_usage": "A classic loader worth keeping for its silhouette. Each child needs its own rotateZ (0/90/180/270) on the wrapper and a scale on the ::before, with delays a quarter of the cycle apart. Keep perspective on the container or the fold looks flat.",
  "path": "effects/loaders-spinners/cube-fold-loader.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Folding Cube</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cube-fold-loader\",\n    \"title\": \"Folding Cube\",\n    \"summary\": \"Four quadrants fold in and out around a shared center in sequence.\",\n    \"description\": \"Each quadrant is rotated into place with a perspective transform and scales along its outer edge, so the square appears to fold in on itself.\",\n    \"theme\": \"loaders-spinners\",\n    \"categories\": [\"loader\", \"3d\"],\n    \"tags\": [\"3d\", \"fold\", \"cube\", \"perspective\", \"quadrant\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative status indicator — pair it with a visually-hidden aria-live message so screen readers announce the wait. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Face color\", \"default\": \"#22d3ee\" },\n      { \"name\": \"--dur\", \"description\": \"Fold cycle\", \"default\": \"2.4s\" }\n    ],\n    \"variations\": [\"Gradient faces for depth\", \"Reverse the fold order\", \"Add a soft shadow under the cube\"],\n    \"ai_usage\": \"A classic loader worth keeping for its silhouette. Each child needs its own rotateZ (0/90/180/270) on the wrapper and a scale on the ::before, with delays a quarter of the cycle apart. Keep perspective on the container or the fold looks flat.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --c: #22d3ee; --dur: 2.4s; }\n    .fold { width: 64px; height: 64px; position: relative; transform: rotateZ(45deg); }\n    .fold i { position: absolute; inset: 0; width: 50%; height: 50%; float: left; transform: scale(1.1); }\n    .fold i::before { content: \"\"; position: absolute; inset: 0; background: var(--c); transform-origin: 100% 100%;\n      animation: fold var(--dur) linear infinite both; }\n    .fold i:nth-child(1) { transform: scale(1.1) rotateZ(0deg); }\n    .fold i:nth-child(2) { transform: scale(1.1) rotateZ(90deg); left: 50%; }\n    .fold i:nth-child(3) { transform: scale(1.1) rotateZ(180deg); top: 50%; left: 50%; }\n    .fold i:nth-child(4) { transform: scale(1.1) rotateZ(270deg); top: 50%; }\n    .fold i:nth-child(2)::before { animation-delay: calc(var(--dur) * .12); }\n    .fold i:nth-child(3)::before { animation-delay: calc(var(--dur) * .25); }\n    .fold i:nth-child(4)::before { animation-delay: calc(var(--dur) * .37); }\n    @keyframes fold {\n      0%, 10% { transform: perspective(140px) rotateX(-180deg); opacity: 0; }\n      25%, 75% { transform: perspective(140px) rotateX(0deg); opacity: 1; }\n      90%, 100% { transform: perspective(140px) rotateY(180deg); opacity: 0; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fold\" role=\"status\" aria-label=\"Loading\"><i></i><i></i><i></i><i></i></div>\n</body>\n</html>\n"
}
