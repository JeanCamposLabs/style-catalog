  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Hue Cycle Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"color-cycle-text\",\n    \"title\": \"Hue Cycle Text\",\n    \"summary\": \"The headline walks the entire hue wheel on a slow loop.\",\n    \"description\": \"A single filter: hue-rotate animation recolors the type continuously without touching any color values.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"color\"],\n    \"tags\": [\"hue-rotate\", \"color-cycle\", \"filter\", \"rainbow\", \"loop\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Full hue rotation\", \"default\": \"6s\" }\n    ],\n    \"variations\": [\"Limit the range for a subtle shift\", \"Apply to an icon set instead\", \"Pause on hover\"],\n    \"ai_usage\": \"Party, pride, or playful branding. hue-rotate is one cheap filter, but it re-rasterizes the element each frame — keep it on small text, never a full page. Respect reduced motion; cycling color is a common trigger.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: 6s; }\n    .hue { font-size: clamp(2rem, 8vw, 3.8rem); font-weight: 900; color: #ff5f6d;\n      animation: hue var(--dur) linear infinite; }\n    @keyframes hue { to { filter: hue-rotate(360deg); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <h1 class=\"hue\">SPECTRUM</h1>\n</body>\n</html>\n"
}
