  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Progressive Load</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"image-loading-progressive\",\n    \"title\": \"Progressive Load\",\n    \"summary\": \"A low-quality preview sharpening into the full image.\",\n    \"description\": \"A low-quality preview sharpening into the full image.\",\n    \"theme\": \"images-media\",\n    \"categories\": [\"image\", \"media\"],\n    \"tags\": [\"image\", \"media\", \"progressive\", \"blur-up\", \"loading\", \"lqip\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative images need empty alt; meaningful ones need real descriptions. Never convey information through a hover-only image treatment.\",\n    \"customization\": [\n      { \"name\": \"--blur\", \"description\": \"Preview blur\", \"default\": \"20px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Image-heavy pages. Inline a tiny base64 preview so the blurred placeholder needs no extra request, and reserve the aspect ratio to prevent layout shift.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 270px; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; }\n    .fx .lo { position: absolute; inset: 0; filter: blur(20px); transform: scale(1.15);\n      background: linear-gradient(135deg, #7c5cff, #c2891a); }\n    .fx .hi { position: absolute; inset: 0; opacity: 0; animation: load 3.4s ease-in-out infinite;\n      background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #c2891a, #d1478c, #7c5cff); }\n    @keyframes load { 0%, 25% { opacity: 0; } 55%, 100% { opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"lo\"></div><div class=\"hi\"></div></div>\n</body>\n</html>\n"
