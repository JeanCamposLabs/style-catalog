  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Icon Spin on Hover</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hover-icon-rotate\",\n    \"title\": \"Icon Spin on Hover\",\n    \"summary\": \"A settings icon that turns when hovered.\",\n    \"description\": \"A settings icon that turns when hovered.\",\n    \"theme\": \"micro-interactions\",\n    \"categories\": [\"micro-interaction\", \"feedback\"],\n    \"tags\": [\"micro-interaction\", \"feedback\", \"icon\", \"rotate\", \"hover\", \"settings\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every micro-interaction must have a non-animated equivalent: state changes are announced through ARIA, not through motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Rotation duration\", \"default\": \"0.5s\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Icon buttons. A 90° turn is enough to feel responsive; a full rotation on hover reads as a loading state and confuses meaning.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 52px; height: 52px; border-radius: 14px; border: 1px solid #263149; background: #151b2a; color: #cbd5e1;\n      font-size: 1.3rem; cursor: pointer; }\n    .fx span { display: inline-block; transition: transform .5s cubic-bezier(.34,1.56,.64,1); }\n    .fx:hover span, .fx:focus-visible span { transform: rotate(90deg); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <button class=\"fx\" type=\"button\" aria-label=\"Settings\"><span aria-hidden=\"true\">⚙</span></button>\n</body>\n</html>\n"
