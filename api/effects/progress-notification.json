  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Progress Notification</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"progress-notification\",\n    \"title\": \"Progress Notification\",\n    \"summary\": \"A toast that reports ongoing work.\",\n    \"description\": \"A toast that reports ongoing work.\",\n    \"theme\": \"notifications-toasts\",\n    \"categories\": [\"notification\", \"feedback\"],\n    \"tags\": [\"notification\", \"feedback\", \"progress\", \"toast\", \"background-task\", \"status\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Announce transient messages through an aria-live region; never convey severity by colour alone, and never auto-dismiss anything the user must act on.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Percent complete\", \"default\": \"62\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Long background jobs. Keep the toast until the job resolves, then swap it to a success or error state in place rather than stacking a second toast.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; padding: .8rem 1rem; border-radius: 12px; background: #1a2130; border: 1px solid #2b3450; }\n    .fx .top { display: flex; justify-content: space-between; align-items: center; font-size: .85rem; color: #e7ebf3; margin-bottom: .5rem; }\n    .fx .pct { color: #8b93a7; font-size: .78rem; font-variant-numeric: tabular-nums; }\n    .fx .bar { height: 5px; border-radius: 99px; background: #22304a; overflow: hidden; }\n    .fx .bar i { display: block; height: 100%; width: calc(var(--p) * 1%); background: #7c5cff; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" style=\"--p:62\" role=\"status\"><div class=\"top\"><span>Generating posters…</span><span class=\"pct\">62%</span></div>\n  <div class=\"bar\" role=\"progressbar\" aria-valuenow=\"62\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i></i></div></div>\n</body>\n</html>\n"
