  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Two-Image Blend Mask</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"mask-gradient-blend-two\",\n    \"title\": \"Two-Image Blend Mask\",\n    \"summary\": \"Two surfaces blended along a soft gradient edge.\",\n    \"description\": \"Two surfaces blended along a soft gradient edge. Uses clip-path or mask-image, so the element's box and layout are unaffected by the shape.\",\n    \"theme\": \"masks-clipping\",\n    \"categories\": [\"mask\", \"shape\"],\n    \"tags\": [\"clip-path\", \"mask\", \"blend\", \"gradient\", \"mask\", \"composite\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Clipping hides content visually but not from assistive tech — anything fully clipped away should also be removed or aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--angle\", \"description\": \"Seam angle\", \"default\": \"110deg\" }\n    ],\n    \"variations\": [\"Animate the shape on hover\", \"Combine with a gradient fill\"],\n    \"ai_usage\": \"Compositing two images without an editor. A gradient mask on the top layer gives a soft seam that a hard clip-path cannot.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .art { width: 210px; height: 210px; background: conic-gradient(from 210deg at 40% 35%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .9rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .pair { position: relative; width: 250px; height: 170px; border-radius: 14px; overflow: hidden; }\n    .pair div { position: absolute; inset: 0; }\n    .pair .a { background: linear-gradient(135deg, #7c5cff, #1e1b4b); }\n    .pair .b { background: linear-gradient(135deg, #2dd4bf, #052e2b);\n      -webkit-mask-image: linear-gradient(110deg, #000 30%, transparent 62%); mask-image: linear-gradient(110deg, #000 30%, transparent 62%); }\n  </style>\n</head>\n<body>\n  <div><div class=\"pair\"><div class=\"a\"></div><div class=\"b\"></div></div><p class=\"label\">Gradient Seam</p></div>\n</body>\n</html>\n"
