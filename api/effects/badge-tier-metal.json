  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Metallic Tier Badge</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"badge-tier-metal\",\n    \"title\": \"Metallic Tier Badge\",\n    \"summary\": \"Gold, silver, and bronze rank badges.\",\n    \"description\": \"Gold, silver, and bronze rank badges. Small self-contained component ready to drop into a list or card.\",\n    \"theme\": \"badges-tags\",\n    \"categories\": [\"badge\", \"label\"],\n    \"tags\": [\"badge\", \"label\", \"metal\", \"rank\", \"gold\", \"gamification\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Status must never be colour-only: pair every badge colour with a label, icon, or shape.\",\n    \"customization\": [\n      { \"name\": \"--gold\", \"description\": \"Gold colour\", \"default\": \"#fde68a\" }\n    ],\n    \"variations\": [\"Add a size variant\", \"Map colours to semantic tokens\"],\n    \"ai_usage\": \"Leaderboards and achievements. The metal read comes from a light-to-dark gradient plus an inset highlight — flat gold looks like plain yellow.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .row { display: flex; gap: .6rem; }\n    .b { width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; font-weight: 900; color: #2a1a02;\n      font-size: .9rem; box-shadow: inset 0 2px 4px rgba(255,255,255,.6), inset 0 -3px 6px rgba(0,0,0,.35); }\n    .g { background: linear-gradient(160deg, #fde68a, #d97706); }\n    .s { background: linear-gradient(160deg, #f1f5f9, #94a3b8); }\n    .br { background: linear-gradient(160deg, #fcd7b6, #b45309); }\n  </style>\n</head>\n<body>\n  <div class=\"row\"><span class=\"b g\">1st</span><span class=\"b s\">2nd</span><span class=\"b br\">3rd</span></div>\n</body>\n</html>\n"
