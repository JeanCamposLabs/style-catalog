  "ai_usage": "Playful and game-adjacent sites. Throttle spawning and always clean up on animationend; a naive implementation adds a node per pointermove and grinds to a halt within seconds.",
  "path": "effects/cursors-pointers/cursor-particle-trail.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Particle Trail Cursor</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-particle-trail\",\n    \"title\": \"Particle Trail Cursor\",\n    \"summary\": \"Small sparks spill from the pointer and fade out.\",\n    \"description\": \"Each particle is spawned with a random velocity and removed on animationend, so the DOM never accumulates nodes.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"particles\"],\n    \"tags\": [\"particles\", \"trail\", \"sparks\", \"cursor\", \"spawn\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Cap the spawn rate (one particle every other move event) and remove nodes on animationend, or fast movement floods the DOM.\",\n    \"accessibility_notes\": \"Custom cursors are gated to fine pointers; touch and reduced-motion users keep the native cursor and full functionality.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Spark color\", \"default\": \"#fbbf24\" },\n      { \"name\": \"--life\", \"description\": \"Particle lifetime\", \"default\": \"0.7s\" }\n    ],\n    \"variations\": [\"Colour cycle per particle\", \"Gravity on the particles\", \"Only emit while a button is held\"],\n    \"ai_usage\": \"Playful and game-adjacent sites. Throttle spawning and always clean up on animationend; a naive implementation adds a node per pointermove and grinds to a halt within seconds.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { cursor: crosshair; }\n    :root { --c: #fbbf24; --life: .7s; }\n    .hint { color: #8b93a7; }\n    .p { position: fixed; width: 7px; height: 7px; border-radius: 50%; background: var(--c); pointer-events: none;\n      margin: -3.5px 0 0 -3.5px; animation: fly var(--life) ease-out forwards; }\n    @keyframes fly {\n      to { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; }\n    }\n  </style>\n</head>\n<body>\n  <p class=\"hint\">Move the pointer to emit sparks</p>\n  <script>\n    (function () {\n      var n = 0;\n      addEventListener(\"pointermove\", function (e) {\n        if (++n % 2) return;\n        var p = document.createElement(\"div\");\n        p.className = \"p\";\n        p.style.left = e.clientX + \"px\"; p.style.top = e.clientY + \"px\";\n        p.style.setProperty(\"--dx\", (Math.random() * 60 - 30).toFixed(0) + \"px\");\n        p.style.setProperty(\"--dy\", (Math.random() * 60 - 10).toFixed(0) + \"px\");\n        document.body.appendChild(p);\n        p.addEventListener(\"animationend\", function () { p.remove(); });\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
