  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Constellation</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"constellation-lines\",\n    \"title\": \"Constellation\",\n    \"summary\": \"Stars joined by faint lines.\",\n    \"description\": \"Stars joined by faint lines.\",\n    \"theme\": \"space-cosmic\",\n    \"categories\": [\"space\", \"cosmic\"],\n    \"tags\": [\"space\", \"cosmic\", \"constellation\", \"stars\", \"network\", \"lines\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Deep-space palettes are very low contrast — keep any text on a solid panel above the scene.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Line colour\", \"default\": \"rgba(148,163,184,.5)\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Slow it down for an ambient version\"],\n    \"ai_usage\": \"Network and community metaphors. Twinkle the nodes at different phases so the diagram feels alive without any layout change.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 260px; height: 170px; border-radius: 14px; background: #05070d; overflow: hidden; }\n    .fx svg { position: absolute; inset: 0; width: 100%; height: 100%; }\n    .fx line { stroke: rgba(148,163,184,.5); stroke-width: 1; }\n    .fx circle { fill: #fff; animation: tw 3s ease-in-out infinite; }\n    .fx circle:nth-of-type(2n) { animation-delay: 1s; }\n    @keyframes tw { 0%, 100% { opacity: .5; } 50% { opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><svg viewBox=\"0 0 260 170\">\n  <line x1=\"40\" y1=\"120\" x2=\"90\" y2=\"60\"/><line x1=\"90\" y1=\"60\" x2=\"150\" y2=\"80\"/><line x1=\"150\" y1=\"80\" x2=\"200\" y2=\"40\"/><line x1=\"150\" y1=\"80\" x2=\"180\" y2=\"135\"/>\n  <circle cx=\"40\" cy=\"120\" r=\"3\"/><circle cx=\"90\" cy=\"60\" r=\"4\"/><circle cx=\"150\" cy=\"80\" r=\"3\"/><circle cx=\"200\" cy=\"40\" r=\"4\"/><circle cx=\"180\" cy=\"135\" r=\"3\"/>\n  </svg></div>\n</body>\n</html>\n"
