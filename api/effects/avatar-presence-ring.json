  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Presence Ring</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"avatar-presence-ring\",\n    \"title\": \"Presence Ring\",\n    \"summary\": \"An avatar with an online status ring.\",\n    \"description\": \"An avatar with an online status ring.\",\n    \"theme\": \"avatars-identity\",\n    \"categories\": [\"avatar\", \"identity\"],\n    \"tags\": [\"avatar\", \"identity\", \"presence\", \"online\", \"status\", \"ring\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"An avatar is decorative when the name is beside it (use empty alt); when it stands alone it must carry the person's name as its accessible label.\",\n    \"customization\": [\n      { \"name\": \"--on\", \"description\": \"Online colour\", \"default\": \"#10a894\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Contact lists. The status dot needs a border in the page background colour so it reads as sitting on top; pair it with text in the accessible name.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 56px; height: 56px; }\n    .fx .a { width: 100%; height: 100%; border-radius: 50%; background: linear-gradient(150deg, #7c5cff, #2dd4bf);\n      display: grid; place-items: center; font-weight: 800; color: #0b0d12; }\n    .fx .s { position: absolute; right: 0; bottom: 0; width: 15px; height: 15px; border-radius: 50%;\n      background: #10a894; border: 3px solid #0b0d12; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"a\" role=\"img\" aria-label=\"Jean Campos, online\">JC</span><span class=\"s\"></span></div>\n</body>\n</html>\n"
