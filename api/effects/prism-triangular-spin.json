  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Spinning Prism</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"prism-triangular-spin\",\n    \"title\": \"Spinning Prism\",\n    \"summary\": \"A triangular prism rotating on its axis.\",\n    \"description\": \"A triangular prism rotating on its axis.\",\n    \"theme\": \"3d-transforms\",\n    \"categories\": [\"3d\", \"transform\"],\n    \"tags\": [\"3d\", \"transform\", \"prism\", \"triangular\", \"3d\", \"rotate\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"3D motion is a common trigger for vestibular discomfort — keep rotations small and stop them under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Spin period\", \"default\": \"8s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Geometric branding. Three faces at 0/120/240° with translateZ of (width / 2) / tan(60°) form a closed prism; get the radius wrong and the edges gap.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .scene { perspective: 800px; width: 120px; height: 150px; }\n    .pr { position: relative; width: 100%; height: 100%; transform-style: preserve-3d; animation: spin 8s linear infinite; }\n    .pr .f { position: absolute; inset: 0; border: 2px solid #2dd4bf; background: rgba(45,212,191,.14);\n      transform: rotateY(var(--a)) translateZ(35px); }\n    @keyframes spin { to { transform: rotateY(360deg); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"scene\"><div class=\"pr\"><span class=\"f\" style=\"--a:0deg\"></span><span class=\"f\" style=\"--a:120deg\"></span>\n  <span class=\"f\" style=\"--a:240deg\"></span></div></div>\n</body>\n</html>\n"
}
