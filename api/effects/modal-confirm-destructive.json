  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Destructive Confirm</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"modal-confirm-destructive\",\n    \"title\": \"Destructive Confirm\",\n    \"summary\": \"A confirmation that requires typing the resource name.\",\n    \"description\": \"A confirmation that requires typing the resource name.\",\n    \"theme\": \"modals-overlays\",\n    \"categories\": [\"modal\", \"overlay\"],\n    \"tags\": [\"modal\", \"dialog\", \"confirm\", \"destructive\", \"type-to-confirm\", \"safety\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"A modal must trap focus, close on Escape, return focus to its trigger, and mark the page behind it inert. The <dialog> element gives most of this for free.\",\n    \"customization\": [\n      { \"name\": \"--danger\", \"description\": \"Danger colour\", \"default\": \"#ef4444\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Irreversible actions. Typed confirmation defeats muscle memory in a way a second click never does — reserve it for genuinely unrecoverable operations.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .stage { width: 300px; padding: 1.5rem; border-radius: 18px; background: #141a28; border: 1px solid #3a2530; }\n    .stage h3 { margin: 0 0 .5rem; color: #f87171; }\n    .stage p { margin: 0 0 1rem; color: #8b93a7; font-size: .88rem; line-height: 1.5; }\n    .stage code { background: #22161c; padding: .1rem .35rem; border-radius: 4px; color: #f87171; }\n    .stage input { width: 100%; padding: .6rem .8rem; border-radius: 10px; border: 1px solid #3a2530; background: #10141f; color: #e7ebf3; font: inherit; margin-bottom: 1rem; }\n    .stage button { width: 100%; padding: .65rem; border-radius: 10px; border: 0; background: #7f1d1d; color: #fca5a5; font: inherit; font-weight: 700; cursor: not-allowed; }\n    .stage button.on { background: #ef4444; color: #fff; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <div class=\"stage\" role=\"dialog\" aria-label=\"Delete project\"><h3>Delete project</h3>\n  <p>This permanently removes <code>aurora-api</code> and all deployments. Type the name to confirm.</p>\n  <input id=\"cf\" type=\"text\" aria-label=\"Type aurora-api to confirm\" placeholder=\"aurora-api\" />\n  <button id=\"del\" type=\"button\" disabled>Delete forever</button></div>\n  <script>\n    (function () {\n      var i = document.getElementById(\"cf\"), b = document.getElementById(\"del\");\n      i.addEventListener(\"input\", function () {\n        var ok = i.value === \"aurora-api\";\n        b.disabled = !ok; b.classList.toggle(\"on\", ok);\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
