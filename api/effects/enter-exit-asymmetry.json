n-bottom: .25rem; }\n    .card { padding: .7rem .9rem; border-radius: 10px; background: #151b2a; border: 1px solid #263149; color: #cbd5e1; font-size: .8rem; }\n    .in { animation: cycle 3s ease-in-out infinite; }\n    @keyframes cycle {\n      0% { opacity: 0; transform: translateY(10px); }\n      20%, 70% { opacity: 1; transform: none; }\n      80%, 100% { opacity: 0; transform: translateY(-6px); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div><div class=\"lbl\">enter 250ms · exit 150ms</div><div class=\"card in\">Toast message</div></div></div>\n</body>\n</html>\n"
