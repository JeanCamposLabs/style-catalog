  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Input Mode Badge</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"input-mode-indicator\",\n    \"title\": \"Input Mode Badge\",\n    \"summary\": \"A badge showing the active editing mode.\",\n    \"description\": \"A badge showing the active editing mode.\",\n    \"theme\": \"keyboard-input\",\n    \"categories\": [\"keyboard\", \"input\"],\n    \"tags\": [\"keyboard\", \"shortcut\", \"mode\", \"vim\", \"editor\", \"indicator\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Shortcut hints must reflect the user's platform, and no action should be reachable only by a shortcut.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Mode colour\", \"default\": \"#10a894\" }\n    ],\n    \"variations\": [\"Reskin through the custom properties\", \"Swap the copy for your own\"],\n    \"ai_usage\": \"Modal editors. Put the mode badge where the eye already rests (near the caret or in a fixed status line) and announce mode changes through a live region.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: .6rem; align-items: center; }\n    .b { padding: .25rem .7rem; border-radius: 6px; font-family: ui-monospace, monospace; font-size: .76rem; font-weight: 800; }\n    .normal { background: rgba(16,168,148,.16); color: #7fd8cb; }\n    .insert { background: rgba(124,92,255,.2); color: #b9a5ff; }\n    .visual { background: rgba(194,137,26,.18); color: #ecc57c; }\n    .note { color: #64748b; font-size: .76rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"b normal\">NORMAL</span><span class=\"b insert\">INSERT</span><span class=\"b visual\">VISUAL</span></div>\n  <p class=\"note\">Modes announced via aria-live so changes are not silent.</p>\n</body>\n</html>\n"
