  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Shaped Frames</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"image-shape-mask-frames\",\n    \"title\": \"Shaped Frames\",\n    \"summary\": \"The same image in four mask shapes.\",\n    \"description\": \"The same image in four mask shapes.\",\n    \"theme\": \"images-media\",\n    \"categories\": [\"image\", \"media\"],\n    \"tags\": [\"image\", \"media\", \"shapes\", \"mask\", \"frames\", \"gallery\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative images need empty alt; meaningful ones need real descriptions. Never convey information through a hover-only image treatment.\",\n    \"customization\": [\n      { \"name\": \"--size\", \"description\": \"Frame size\", \"default\": \"68px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Editorial image sets. Pick one shape language per layout; mixed frame shapes in a single grid read as unfinished rather than playful.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 12px; }\n    .i { width: 68px; height: 68px; background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #c2891a); }\n    .hex { clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); }\n    .blob { border-radius: 58% 42% 37% 63% / 45% 39% 61% 55%; }\n    .circle { border-radius: 50%; }\n    .arch { border-radius: 50% 50% 8px 8px / 60% 60% 8px 8px; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"i circle\"></span><span class=\"i hex\"></span><span class=\"i blob\"></span><span class=\"i arch\"></span></div>\n</body>\n</html>\n"
