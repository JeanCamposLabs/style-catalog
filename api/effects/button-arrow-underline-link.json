 content: \"\"; position: absolute; left: 0; right: 1.2rem; bottom: -3px; height: 2px; background: currentColor;\n      transform: scaleX(0); transform-origin: left; transition: transform .25s; }\n    .fx:hover .ar, .fx:focus-visible .ar { transform: translateX(4px); }\n    .fx:hover::after, .fx:focus-visible::after { transform: scaleX(1); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <a class=\"fx\" href=\"#\">Browse the catalogue <span class=\"ar\" aria-hidden=\"true\">→</span></a>\n</body>\n</html>\n"
