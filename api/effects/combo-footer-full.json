{ font-size: .95rem; }\n    .fx .brand p { margin: .3rem 0 0; color: #64748b; font-size: .74rem; line-height: 1.5; }\n    .fx h4 { margin: 0 0 .4rem; font-size: .66rem; text-transform: uppercase; letter-spacing: .08em; color: #64748b; }\n    .fx a { display: block; padding: .15rem 0; color: #cbd5e1; text-decoration: none; font-size: .78rem; }\n    .fx .legal { display: flex; justify-content: space-between; margin-top: 1.1rem; padding-top: .8rem;\n      border-top: 1px solid #1e2740; color: #64748b; font-size: .72rem; }\n  </style>\n</head>\n<body>\n  <footer class=\"fx\"><div class=\"top\"><div class=\"brand\"><b>Style Catalog</b><p>A museum of web effects.</p></div>\n  <nav aria-label=\"Product\"><h4>Product</h4><a href=\"#\">Gallery</a><a href=\"#\">API</a></nav>\n  <nav aria-label=\"Resources\"><h4>Resources</h4><a href=\"#\">Docs</a><a href=\"#\">Changelog</a></nav></div>\n  <div class=\"legal\"><span>© 2026 Style Catalog</span><span>MIT licence</span></div></footer>\n</body>\n</html>\n"
