  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>WordArt Headline</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"wordart-gradient-text\",\n    \"title\": \"WordArt Headline\",\n    \"summary\": \"The arched, outlined gradient headline.\",\n    \"description\": \"The arched, outlined gradient headline.\",\n    \"theme\": \"retro-web\",\n    \"categories\": [\"retro\", \"nostalgia\"],\n    \"tags\": [\"retro\", \"nostalgia\", \"wordart\", \"office\", \"gradient\", \"kitsch\"],\n    \"tech\": [\"css\"],\n    \"era\": \"1990s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"These recreate deprecated tags accessibly: motion respects prefers-reduced-motion and nothing depends on blinking to be readable.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Gradient top\", \"default\": \"#ffe600\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Deliberate retro kitsch. paint-order: stroke fill draws the outline behind the fill, which is what stops the stroke eating into the letterforms.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { font-family: \"Impact\", \"Arial Black\", sans-serif; font-size: 2.4rem; letter-spacing: .02em;\n      background: linear-gradient(180deg, #ffe600 0 45%, #ff8000 55%, #c00000);\n      -webkit-background-clip: text; background-clip: text; color: transparent;\n      -webkit-text-stroke: 2px #000; paint-order: stroke fill;\n      filter: drop-shadow(3px 3px 0 rgba(0,0,0,.6)); transform: skewY(-4deg); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\">AWESOME</div>\n</body>\n</html>\n"
