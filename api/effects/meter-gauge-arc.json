  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Arc Gauge</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"meter-gauge-arc\",\n    \"title\": \"Arc Gauge\",\n    \"summary\": \"A half-circle gauge with a needle and a numeric readout.\",\n    \"description\": \"A half-circle gauge with a needle and a numeric readout.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"gauge\", \"arc\", \"svg\", \"dial\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Percent filled\", \"default\": \"72\" },\n      { \"name\": \"--c\", \"description\": \"Arc colour\", \"default\": \"#34d399\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Speed, capacity, and score dials. The arc length is π×r (here 251 for r=80); set stroke-dasharray to that and drive dashoffset from the percentage.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .g { width: 220px; }\n    .g svg { width: 100%; display: block; }\n    .g .track { fill: none; stroke: #22304a; stroke-width: 14; stroke-linecap: round; }\n    .g .bar { fill: none; stroke: #34d399; stroke-width: 14; stroke-linecap: round; stroke-dasharray: 251; stroke-dashoffset: calc(251 - 251 * var(--p) / 100); transition: stroke-dashoffset .6s; }\n    .g .val { text-align: center; margin-top: -2.2rem; font-size: 1.9rem; font-weight: 900; }\n    .g .unit { text-align: center; color: #8b93a7; font-size: .8rem; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"g\" style=\"--p:72\"><svg viewBox=\"0 0 200 110\" role=\"img\" aria-label=\"72 percent\">\n    <path class=\"track\" d=\"M20 100 A80 80 0 0 1 180 100\"/><path class=\"bar\" d=\"M20 100 A80 80 0 0 1 180 100\"/>\n  </svg><div class=\"val\">72</div><div class=\"unit\">of 100 credits</div></div>\n</body>\n</html>\n"
