  "path": "effects/buttons/cta-arrow-circle.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Circle Arrow CTA</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cta-arrow-circle\",\n    \"title\": \"Circle Arrow CTA\",\n    \"summary\": \"A pill label with a circular arrow that expands to swallow it on hover.\",\n    \"description\": \"The circle grows to the full pill width while the arrow slides to the far edge, merging two elements into one gesture.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"hover\"],\n    \"tags\": [\"cta\", \"circle\", \"arrow\", \"expand\", \"agency\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>; keep a visible :focus-visible ring and never rely on hover alone to convey state. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Circle color\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--dur\", \"description\": \"Expand duration\", \"default\": \"0.45s\" }\n    ],\n    \"variations\": [\"Reverse: circle on the right\", \"Text color inversion at the end\", \"Use as a card-wide link\"],\n    \"ai_usage\": \"Agency and portfolio sites. Animate the circle's width (not scale) so the arrow's position stays predictable, and pair with a color transition on the label that completes slightly after the expansion.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    button { font: inherit; cursor: pointer; border: 0; }\n    button:focus-visible { outline: 2px solid #7c5cff; outline-offset: 3px; }\n    :root { --c: #7c5cff; --dur: .45s; }\n    .cta { position: relative; display: inline-flex; align-items: center; gap: .9rem; padding: .5rem 1.6rem .5rem .5rem;\n      border-radius: 999px; background: transparent; border: 1px solid #2b3450; color: #e7ebf3; font-weight: 700; overflow: hidden; }\n    .cta .circ { position: relative; z-index: 2; display: grid; place-items: center; width: 42px; height: 42px;\n      border-radius: 999px; background: var(--c); color: #fff; transition: transform var(--dur) cubic-bezier(.7,0,.2,1); }\n    .cta .lbl { position: relative; z-index: 2; transition: color var(--dur), transform var(--dur); }\n    .cta::before { content: \"\"; position: absolute; left: 5px; top: 5px; bottom: 5px; width: 42px; border-radius: 999px;\n      background: var(--c); transition: width var(--dur) cubic-bezier(.7,0,.2,1); }\n    .cta:hover::before { width: calc(100% - 10px); }\n    .cta:hover .lbl { color: #fff; }\n    .cta:hover .circ { transform: translateX(6px); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <button class=\"cta\" type=\"button\"><span class=\"circ\" aria-hidden=\"true\">→</span><span class=\"lbl\">Start a project</span></button>\n</body>\n</html>\n"
}
