  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Scallops</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"scallop-pattern\",\n    \"title\": \"Scallops\",\n    \"summary\": \"Overlapping arcs like fish scales or roof tiles.\",\n    \"description\": \"Overlapping arcs like fish scales or roof tiles. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"scallop\", \"scales\", \"arcs\", \"tiles\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Arc colour\", \"default\": \"#1c2333\" },\n      { \"name\": \"--s\", \"description\": \"Tile width\", \"default\": \"44px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Packaging, roofing, and decorative headers. Tile height must be half the width or the arcs will not nest.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: #1c2333; --bg: #0b0d12; --s: 44px; }\n    .bg { background-color: var(--bg);\n      background-image: radial-gradient(circle at 50% 0, transparent 0 20px, var(--c) 20px 22px, transparent 22px);\n      background-size: var(--s) calc(var(--s) / 2); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
