  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Multi-Line Highlight</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"text-highlight-marker-multi\",\n    \"title\": \"Multi-Line Highlight\",\n    \"summary\": \"A marker highlight that wraps correctly.\",\n    \"description\": \"A marker highlight that wraps correctly.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"typography\"],\n    \"tags\": [\"text\", \"type\", \"highlight\", \"marker\", \"wrap\", \"emphasis\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative duplicates are aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Marker colour\", \"default\": \"rgba(251,191,36,.45)\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Emphasis in body copy. A gradient background that starts partway down the line height gives a marker look that survives line breaks — a pseudo-element only covers the last line.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { max-width: 26ch; font-size: 1.1rem; line-height: 2; }\n    .fx mark { background: linear-gradient(180deg, transparent 55%, rgba(251,191,36,.45) 55%);\n      color: inherit; padding: 0 .1em; }\n  </style>\n</head>\n<body>\n  <p class=\"fx\">The important thing is that <mark>the highlight wraps across every line of the phrase</mark> without breaking.</p>\n</body>\n</html>\n"
