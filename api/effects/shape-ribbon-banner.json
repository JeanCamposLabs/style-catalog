e { width: min(92vw, 340px); }\n    .stage { display: grid; place-items: center; padding: 2rem 0; }\n    .rib { position: relative; padding: .7rem 1.6rem; background: #7c5cff; color: #fff; font-weight: 800; }\n    .rib::before, .rib::after { content: \"\"; position: absolute; top: 100%; border: 10px solid #4c1d95; }\n    .rib::before { left: 0; border-left-color: transparent; border-bottom-color: transparent; }\n    .rib::after { right: 0; border-right-color: transparent; border-bottom-color: transparent; }\n  </style>\n</head>\n<body>\n  <div class=\"stage\"><span class=\"rib\">Featured</span></div>\n</body>\n</html>\n"
