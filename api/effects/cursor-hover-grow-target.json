  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Growing Cursor</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-hover-grow-target\",\n    \"title\": \"Growing Cursor\",\n    \"summary\": \"The follower expands over interactive targets.\",\n    \"description\": \"The follower expands over interactive targets.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"pointer\"],\n    \"tags\": [\"cursor\", \"pointer\", \"follower\", \"grow\", \"target\", \"hover\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Custom cursors are gated to fine pointers; touch and reduced-motion users keep the native cursor and full functionality.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Cursor colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Portfolio sites. Grow the follower over interactive elements to reinforce affordance, and always keep a native cursor fallback for pointer:coarse.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { cursor: none; }\n    .fx { display: flex; gap: 12px; }\n    .fx div { width: 84px; height: 84px; border-radius: 14px; background: #151b2a; border: 1px solid #263149;\n      display: grid; place-items: center; color: #8b93a7; font-size: .78rem; }\n    .cur { position: fixed; top: 0; left: 0; width: 14px; height: 14px; border-radius: 50%; background: #7c5cff;\n      margin: -7px 0 0 -7px; pointer-events: none; z-index: 9;\n      transition: width .2s, height .2s, margin .2s, background .2s; }\n    .cur.big { width: 54px; height: 54px; margin: -27px 0 0 -27px; background: rgba(124,92,255,.35); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div data-t>Project</div><div data-t>About</div><div>Static</div></div>\n  <div class=\"cur\" aria-hidden=\"true\"></div>\n  <script>\n    (function () {\n      var c = document.querySelector(\".cur\");\n      addEventListener(\"pointermove\", function (e) { c.style.transform = \"translate(\" + e.clientX + \"px,\" + e.clientY + \"px)\"; });\n      document.querySelectorAll(\"[data-t]\").forEach(function (el) {\n        el.addEventListener(\"pointerenter\", function () { c.classList.add(\"big\"); });\n        el.addEventListener(\"pointerleave\", function () { c.classList.remove(\"big\"); });\n      });\n    })();\n  </script>\n</body>\n</html>\n"
