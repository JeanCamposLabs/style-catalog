  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Shortcut Sheet</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"keyboard-shortcut-sheet\",\n    \"title\": \"Shortcut Sheet\",\n    \"summary\": \"A cheat sheet of keyboard shortcuts.\",\n    \"description\": \"A cheat sheet of keyboard shortcuts.\",\n    \"theme\": \"terminal-cli\",\n    \"categories\": [\"terminal\", \"code\"],\n    \"tags\": [\"terminal\", \"monospace\", \"shortcuts\", \"cheat-sheet\", \"kbd\", \"help\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Terminal output should live in a real text element (not an image) so it can be selected, searched, and read aloud.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Sheet background\", \"default\": \"#151b2a\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Help overlays. Detect the platform and swap ⌘ for Ctrl — showing Mac keys to Windows users is the most common shortcut-sheet bug.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; padding: 1rem; border-radius: 12px; background: #151b2a; border: 1px solid #263149; }\n    .fx h4 { margin: 0 0 .7rem; font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: #8b93a7; }\n    .fx dl { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: .5rem 1rem; align-items: center; }\n    .fx dt { color: #cbd5e1; font-size: .85rem; }\n    .fx dd { margin: 0; display: flex; gap: .2rem; }\n    .fx kbd { padding: .12rem .4rem; border-radius: 5px; background: #1c2437; border: 1px solid #2b3450; border-bottom-width: 2px;\n      font-family: ui-monospace, monospace; font-size: .72rem; color: #e7ebf3; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><h4>Shortcuts</h4><dl>\n    <dt>Command palette</dt><dd><kbd>⌘</kbd><kbd>K</kbd></dd>\n    <dt>Search</dt><dd><kbd>/</kbd></dd>\n    <dt>Toggle theme</dt><dd><kbd>⇧</kbd><kbd>D</kbd></dd>\n  </dl></div>\n</body>\n</html>\n"
