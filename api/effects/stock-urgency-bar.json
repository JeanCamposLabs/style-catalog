  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Low Stock Meter</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"stock-urgency-bar\",\n    \"title\": \"Low Stock Meter\",\n    \"summary\": \"A bar showing how little stock remains.\",\n    \"description\": \"A bar showing how little stock remains.\",\n    \"theme\": \"ecommerce-ui\",\n    \"categories\": [\"ecommerce\", \"commerce\"],\n    \"tags\": [\"ecommerce\", \"shop\", \"stock\", \"urgency\", \"scarcity\", \"inventory\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Price, stock, and discount information must be in text, never only a colour or a badge shape.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Stock remaining\", \"default\": \"18\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Product pages. Only show scarcity when it is true — fabricated urgency is a dark pattern and increasingly a legal risk.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 250px; }\n    .fx .bar { height: 7px; border-radius: 99px; background: #22304a; overflow: hidden; }\n    .fx .bar i { display: block; height: 100%; width: calc(var(--p) * 1%); background: #f97316; }\n    .fx p { margin: .5rem 0 0; font-size: .82rem; color: #fdba74; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" style=\"--p:18\"><div class=\"bar\" role=\"progressbar\" aria-valuenow=\"18\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i></i></div>\n  <p>Only 4 left in stock</p></div>\n</body>\n</html>\n"
