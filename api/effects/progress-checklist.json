  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Checklist Progress</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"progress-checklist\",\n    \"title\": \"Checklist Progress\",\n    \"summary\": \"A list where completion drives a summary bar.\",\n    \"description\": \"A list where completion drives a summary bar.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"checklist\", \"tasks\", \"onboarding\", \"completion\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Complete colour\", \"default\": \"#34d399\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Onboarding and setup guides. Show the count as text as well as the bar — 3 of 5 is more motivating than an unlabelled 60%.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .cl { width: 280px; }\n    .cl .bar { height: 6px; border-radius: 99px; background: #22304a; overflow: hidden; margin-bottom: .9rem; }\n    .cl .bar i { display: block; height: 100%; width: 60%; background: #34d399; }\n    .cl ul { list-style: none; margin: 0; padding: 0; }\n    .cl li { display: flex; gap: .6rem; align-items: center; padding: .35rem 0; color: #cbd5e1; font-size: .9rem; }\n    .cl li.done { color: #8b93a7; text-decoration: line-through; }\n    .cl .box { width: 18px; height: 18px; border-radius: 6px; border: 1.5px solid #3b465e; display: grid; place-items: center; font-size: .7rem; }\n    .cl li.done .box { background: #34d399; border-color: #34d399; color: #052e2b; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"cl\"><div class=\"bar\" role=\"progressbar\" aria-valuenow=\"60\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i></i></div>\n  <ul><li class=\"done\"><span class=\"box\">✓</span>Create account</li><li class=\"done\"><span class=\"box\">✓</span>Verify email</li>\n  <li class=\"done\"><span class=\"box\">✓</span>Invite team</li><li><span class=\"box\"></span>Connect repo</li><li><span class=\"box\"></span>First deploy</li></ul></div>\n</body>\n</html>\n"
