  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Guestbook</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"guestbook-form\",\n    \"title\": \"Guestbook\",\n    \"summary\": \"A 90s guestbook entry form.\",\n    \"description\": \"A 90s guestbook entry form.\",\n    \"theme\": \"retro-web\",\n    \"categories\": [\"retro\", \"nostalgia\"],\n    \"tags\": [\"retro\", \"nostalgia\", \"guestbook\", \"form\", \"90s\", \"windows\"],\n    \"tech\": [\"css\"],\n    \"era\": \"1990s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"These recreate deprecated tags accessibly: motion respects prefers-reduced-motion and nothing depends on blinking to be readable.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Panel colour\", \"default\": \"#c0c0c0\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Retro-web pastiche. Recreate the era with border-style outset/inset and the system font stack rather than images; the result stays selectable and accessible.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; padding: 1rem; background: #c0c0c0; border: 3px outset #fff; color: #000;\n      font-family: \"MS Sans Serif\", Tahoma, sans-serif; font-size: .8rem; }\n    .fx h3 { margin: 0 0 .7rem; font-size: .95rem; text-align: center; text-decoration: underline; }\n    .fx label { display: block; margin-bottom: .2rem; }\n    .fx input, .fx textarea { width: 100%; margin-bottom: .6rem; padding: .3rem; border: 2px inset #fff; font: inherit; }\n    .fx button { padding: .3rem 1rem; border: 2px outset #fff; background: #c0c0c0; font: inherit; cursor: pointer; }\n    .fx button:active { border-style: inset; }\n  </style>\n</head>\n<body>\n  <form class=\"fx\"><h3>Sign my guestbook!</h3><label for=\"gn\">Your name:</label><input id=\"gn\" type=\"text\" />\n  <label for=\"gm\">Message:</label><textarea id=\"gm\" rows=\"2\"></textarea><button type=\"button\">Submit</button></form>\n</body>\n</html>\n"
