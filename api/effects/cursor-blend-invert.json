  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Inverting Blend Cursor</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-blend-invert\",\n    \"title\": \"Inverting Blend Cursor\",\n    \"summary\": \"A circle that inverts whatever it passes over.\",\n    \"description\": \"mix-blend-mode: difference on a white circle flips the colours beneath it, so one cursor works on any background.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"blend\"],\n    \"tags\": [\"blend-mode\", \"invert\", \"difference\", \"cursor\", \"contrast\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Custom cursors are gated to fine pointers; touch and reduced-motion users keep the native cursor and full functionality.\",\n    \"customization\": [\n      { \"name\": \"--size\", \"description\": \"Cursor size\", \"default\": \"44px\" }\n    ],\n    \"variations\": [\"Grow over links\", \"Exclusion blend for a softer flip\", \"Square or blob shape\"],\n    \"ai_usage\": \"Editorial and high-contrast designs. Difference blending means you never have to pick a cursor colour; but the page needs isolation:isolate on a wrapping element or the blend escapes to the root background.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { cursor: none; isolation: isolate; }\n    :root { --size: 44px; }\n    .panel { display: flex; }\n    .panel div { width: 150px; height: 150px; display: grid; place-items: center; font-weight: 800; }\n    .panel div:nth-child(1) { background: #e7ebf3; color: #0b0d12; }\n    .panel div:nth-child(2) { background: #7c5cff; color: #fff; }\n    .cur { position: fixed; top: 0; left: 0; width: var(--size); height: var(--size); border-radius: 50%; background: #fff;\n      margin: calc(var(--size) / -2) 0 0 calc(var(--size) / -2); mix-blend-mode: difference; pointer-events: none; z-index: 9; }\n  </style>\n</head>\n<body>\n  <div class=\"panel\"><div>LIGHT</div><div>DARK</div></div>\n  <div class=\"cur\" aria-hidden=\"true\"></div>\n  <script>\n    (function () {\n      var c = document.querySelector(\".cur\");\n      addEventListener(\"pointermove\", function (e) {\n        c.style.transform = \"translate(\" + e.clientX + \"px,\" + e.clientY + \"px)\";\n      });\n    })();\n  </script>\n</body>\n</html>\n"
