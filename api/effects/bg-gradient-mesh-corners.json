  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Corner Mesh</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"bg-gradient-mesh-corners\",\n    \"title\": \"Corner Mesh\",\n    \"summary\": \"Four corner colour sources blending across the viewport.\",\n    \"description\": \"Four corner colour sources blending across the viewport.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"surface\"],\n    \"tags\": [\"background\", \"mesh\", \"corners\", \"radial\", \"blend\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep text contrast above 4.5:1 and stop drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"First colour\", \"default\": \"rgba(124,92,255,.55)\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"The standard mesh-gradient hero. Anchor one radial per corner and keep each under 55% reach so the centre stays dark enough for text.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    .bg { background: #0b0d12;\n      background-image: radial-gradient(at 12% 18%, rgba(124,92,255,.55) 0, transparent 55%),\n        radial-gradient(at 85% 14%, rgba(45,212,191,.45) 0, transparent 55%),\n        radial-gradient(at 18% 84%, rgba(209,71,140,.45) 0, transparent 55%),\n        radial-gradient(at 88% 82%, rgba(194,137,26,.4) 0, transparent 55%); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
