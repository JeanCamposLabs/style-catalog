  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Bouncing Box</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"collision-bounce-box\",\n    \"title\": \"Bouncing Box\",\n    \"summary\": \"A ball ricocheting inside a container.\",\n    \"description\": \"A ball ricocheting inside a container.\",\n    \"theme\": \"particles-physics\",\n    \"categories\": [\"particles\", \"physics\"],\n    \"tags\": [\"particles\", \"motion\", \"collision\", \"bounce\", \"ricochet\", \"screensaver\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Particle fields are decorative and expensive — cap counts, pause when off-screen, and stop entirely under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--dx\", \"description\": \"Horizontal period\", \"default\": \"3.1s\" },\n      { \"name\": \"--dy\", \"description\": \"Vertical period\", \"default\": \"2.3s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"The DVD-logo screensaver in two lines: independent linear alternate animations on x and y with coprime durations produce a path that never repeats quickly.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 240px; height: 160px; border-radius: 14px; background: #10141f; border: 1px solid #263149; overflow: hidden; }\n    .fx i { position: absolute; width: 20px; height: 20px; border-radius: 50%; background: #10a894;\n      animation: bx 3.1s linear infinite alternate, by 2.3s linear infinite alternate; }\n    @keyframes bx { from { left: 4px; } to { left: 216px; } }\n    @keyframes by { from { top: 4px; } to { top: 136px; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><i></i></div>\n</body>\n</html>\n"
