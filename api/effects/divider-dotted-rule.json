  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Dotted Rule</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"divider-dotted-rule\",\n    \"title\": \"Dotted Rule\",\n    \"summary\": \"A centred rule made of evenly spaced dots.\",\n    \"description\": \"A centred rule made of evenly spaced dots. Purely decorative and self-contained, so it drops between any two sections.\",\n    \"theme\": \"dividers-shapes\",\n    \"categories\": [\"divider\", \"shape\"],\n    \"tags\": [\"divider\", \"separator\", \"dots\", \"rule\", \"minimal\", \"typography\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dividers are decorative: mark them aria-hidden so they are not announced as content.\",\n    \"customization\": [\n      { \"name\": \"--gap\", \"description\": \"Dot spacing\", \"default\": \"12px\" }\n    ],\n    \"variations\": [\"Flip vertically for the opposite section\", \"Recolour to match the next section\"],\n    \"ai_usage\": \"In-article breaks. A dot-tiled gradient scales cleanly and avoids the hairline rendering issues of a 1px border at fractional zoom.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .top { background: #151b2a; padding: 1.6rem; text-align: center; color: #8b93a7; font-size: .85rem; }\n    .bottom { background: #7c5cff; padding: 1.6rem; text-align: center; color: #1a1030; font-size: .85rem; font-weight: 700; }\n    .stage { width: min(92vw, 340px); }\n    .divider { height: 30px; background: transparent; display: grid; place-items: center; }\n    .divider::before { content: \"\"; width: 70%; height: 4px;\n      background-image: radial-gradient(circle, #8b93a7 1.6px, transparent 2px); background-size: 12px 4px; }\n  </style>\n</head>\n<body>\n  <div class=\"stage\"><div class=\"top\">Section one</div><div class=\"divider\" aria-hidden=\"true\"></div><div class=\"bottom\">Section two</div></div>\n</body>\n</html>\n"
