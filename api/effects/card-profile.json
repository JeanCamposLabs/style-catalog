  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Profile Card</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"card-profile\",\n    \"title\": \"Profile Card\",\n    \"summary\": \"An avatar, name, role, and action in one block.\",\n    \"description\": \"An avatar, name, role, and action in one block. Self-contained card markup you can drop into a grid.\",\n    \"theme\": \"cards-surfaces\",\n    \"categories\": [\"card\", \"surface\"],\n    \"tags\": [\"card\", \"surface\", \"profile\", \"avatar\", \"team\", \"person\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"A clickable card needs one real link or button inside it; never attach a click handler to a bare div.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Accent\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt for a light theme\", \"Add a media area at the top\"],\n    \"ai_usage\": \"Team and directory pages. Put the person's name in a heading element so the page has a usable outline.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .card { width: 260px; border-radius: 18px; padding: 1.4rem; }\n    .card h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .card p { margin: 0; color: #8b93a7; font-size: .88rem; line-height: 1.5; }\n    .card { background: #151b2a; border: 1px solid #263149; text-align: center; }\n    .card .av { width: 68px; height: 68px; border-radius: 50%; margin: 0 auto .8rem;\n      background: conic-gradient(from 30deg, #7c5cff, #2dd4bf, #7c5cff); display: grid; place-items: center;\n      font-weight: 800; color: #0b0d12; font-size: 1.3rem; }\n    .card .role { color: #8b93a7; font-size: .85rem; margin: .2rem 0 1rem; }\n    .card button { padding: .55rem 1.3rem; border: 0; border-radius: 999px; background: #7c5cff; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <article class=\"card\"><div class=\"av\">JC</div><h3>Jean Campos</h3><p class=\"role\">Design Engineer</p><button type=\"button\">Message</button></article>\n</body>\n</html>\n"
