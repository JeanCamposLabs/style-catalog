  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Poll Results</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"poll-results-bars\",\n    \"title\": \"Poll Results\",\n    \"summary\": \"Vote bars with percentages and a chosen option.\",\n    \"description\": \"Vote bars with percentages and a chosen option.\",\n    \"theme\": \"social-ui\",\n    \"categories\": [\"social\", \"feed\"],\n    \"tags\": [\"social\", \"community\", \"poll\", \"votes\", \"results\", \"bars\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Reaction counts and follow state need accessible names that change with state, and threads need real heading or list structure.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Bar colour\", \"default\": \"rgba(124,92,255,.28)\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Polls and surveys. Show both the percentage and the raw count; percentages alone hide a sample of twelve people.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; }\n    .fx .q { font-weight: 700; margin-bottom: .8rem; font-size: .92rem; }\n    .fx .o { position: relative; padding: .55rem .8rem; border-radius: 10px; background: #151b2a; border: 1px solid #263149;\n      margin-bottom: .5rem; overflow: hidden; font-size: .86rem; display: flex; justify-content: space-between; }\n    .fx .o i { position: absolute; inset: 0 auto 0 0; width: calc(var(--p) * 1%); background: rgba(124,92,255,.28); }\n    .fx .o.mine { border-color: #7c5cff; }\n    .fx .o span { position: relative; }\n    .fx .tot { color: #8b93a7; font-size: .76rem; margin-top: .3rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"q\">Which theme should we expand next?</div>\n  <div class=\"o mine\" style=\"--p:52\"><i></i><span>Motion principles ✓</span><span>52%</span></div>\n  <div class=\"o\" style=\"--p:31\"><i></i><span>Data visualisation</span><span>31%</span></div>\n  <div class=\"o\" style=\"--p:17\"><i></i><span>Retro web</span><span>17%</span></div>\n  <div class=\"tot\">1,284 votes · 2 days left</div></div>\n</body>\n</html>\n"
