  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Timezone Rows</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"timezone-row-list\",\n    \"title\": \"Timezone Rows\",\n    \"summary\": \"Cities with local times and a day/night marker.\",\n    \"description\": \"Cities with local times and a day/night marker.\",\n    \"theme\": \"calendar-time\",\n    \"categories\": [\"calendar\", \"time\"],\n    \"tags\": [\"calendar\", \"date\", \"timezone\", \"clock\", \"cities\", \"remote\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Dates need machine-readable markup (<time datetime>) and selected days must be announced, not just highlighted.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Row background\", \"default\": \"#151b2a\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Distributed-team tools. Show the UTC offset as well as the local time; the offset is what people need to schedule across DST changes.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; }\n    .r { display: flex; align-items: center; justify-content: space-between; padding: .6rem .8rem; border-radius: 10px;\n      background: #151b2a; border: 1px solid #263149; margin-bottom: 6px; font-size: .88rem; }\n    .r .c { display: flex; align-items: center; gap: .5rem; }\n    .r .t { font-variant-numeric: tabular-nums; font-weight: 700; }\n    .r small { display: block; color: #8b93a7; font-size: .72rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"r\"><span class=\"c\">🌞 <span>Lisbon<small>UTC+1</small></span></span><span class=\"t\">14:32</span></div>\n  <div class=\"r\"><span class=\"c\">🌞 <span>New York<small>UTC-4</small></span></span><span class=\"t\">09:32</span></div>\n  <div class=\"r\"><span class=\"c\">🌙 <span>Tokyo<small>UTC+9</small></span></span><span class=\"t\">22:32</span></div></div>\n</body>\n</html>\n"
