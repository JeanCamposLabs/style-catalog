  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Neumorphic Slider</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"neumorphic-slider-track\",\n    \"title\": \"Neumorphic Slider\",\n    \"summary\": \"A soft-UI range control.\",\n    \"description\": \"A soft-UI range control.\",\n    \"theme\": \"glass-neumorphism\",\n    \"categories\": [\"glass\", \"surface\"],\n    \"tags\": [\"glass\", \"surface\", \"neumorphism\", \"slider\", \"soft-ui\", \"inset\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Translucent surfaces easily fall below contrast minimums — check text and borders against the busiest part of the backdrop.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Fill colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Soft-UI settings. The track is inset and the knob is outset — that contrast is the entire neumorphic language; matching them makes the control disappear.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { background: #232a3a; }\n    .fx { width: 270px; }\n    .fx label { display: block; font-size: .8rem; color: #8b93a7; margin-bottom: .6rem; }\n    .fx .track { position: relative; height: 14px; border-radius: 99px; background: #232a3a;\n      box-shadow: inset 3px 3px 6px rgba(0,0,0,.5), inset -3px -3px 6px rgba(255,255,255,.05); }\n    .fx .fill { position: absolute; inset: 0 auto 0 0; width: 58%; border-radius: 99px; background: #7c5cff; }\n    .fx .knob { position: absolute; top: 50%; left: 58%; translate: -50% -50%; width: 28px; height: 28px; border-radius: 50%;\n      background: #232a3a; box-shadow: 3px 3px 7px rgba(0,0,0,.5), -3px -3px 7px rgba(255,255,255,.06); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><label for=\"ns\">Intensity</label><div class=\"track\" role=\"slider\" aria-label=\"Intensity\"\n    aria-valuenow=\"58\" aria-valuemin=\"0\" aria-valuemax=\"100\"><div class=\"fill\"></div><div class=\"knob\"></div></div></div>\n</body>\n</html>\n"
}
