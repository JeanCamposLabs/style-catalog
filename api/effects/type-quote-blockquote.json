  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Blockquote Styling</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"type-quote-blockquote\",\n    \"title\": \"Blockquote Styling\",\n    \"summary\": \"A pull quote with attribution.\",\n    \"description\": \"A pull quote with attribution.\",\n    \"theme\": \"typography-systems\",\n    \"categories\": [\"typography\", \"reference\"],\n    \"tags\": [\"typography\", \"type\", \"blockquote\", \"quote\", \"attribution\", \"editorial\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Type systems must survive user font-size settings: size in rem, never lock line-height in px, and keep the measure under 75 characters.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Rule colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Editorial quotes. Use <blockquote> with <cite> for the source; a styled <p> loses the semantic relationship between the quote and its attribution.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; padding-left: 1rem; border-left: 3px solid #7c5cff; }\n    .fx blockquote { margin: 0; font-size: 1.05rem; line-height: 1.55; color: #e7ebf3; font-style: italic; }\n    .fx cite { display: block; margin-top: .6rem; font-size: .8rem; font-style: normal; color: #8b93a7; }\n    .fx cite b { color: #cbd5e1; font-style: normal; }\n  </style>\n</head>\n<body>\n  <figure class=\"fx\" style=\"margin:0\"><blockquote>The best interface is the one that disappears once you know what to do.</blockquote>\n  <cite><b>Ada Lovelace</b> · Design notes</cite></figure>\n</body>\n</html>\n"
