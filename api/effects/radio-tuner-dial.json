  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Radio Dial</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"radio-tuner-dial\",\n    \"title\": \"Radio Dial\",\n    \"summary\": \"A tuner scale with a moving needle.\",\n    \"description\": \"A tuner scale with a moving needle.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"radio\", \"tuner\", \"dial\", \"skeuomorphic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Needle position\", \"default\": \"58\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Radio and retro-audio apps. Tick marks at irregular label intervals is what makes a tuner scale look real rather than a ruler.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; padding: 1rem; border-radius: 14px; background: linear-gradient(160deg, #2a2118, #14100b);\n      border: 1px solid #4a3a26; }\n    .fx .scale { position: relative; height: 46px; border-radius: 6px; background: #f5efdf;\n      background-image: repeating-linear-gradient(90deg, #4a3a26 0 1px, transparent 1px 14px); }\n    .fx .needle { position: absolute; top: -4px; bottom: -4px; left: calc(var(--p) * 1%); width: 3px; background: #dc2626;\n      box-shadow: 0 0 8px rgba(220,38,38,.7); }\n    .fx .nums { display: flex; justify-content: space-between; margin-top: .4rem; font-family: ui-monospace, monospace;\n      font-size: .68rem; color: #a8926b; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" style=\"--p:58\"><div class=\"scale\" role=\"slider\" aria-label=\"Frequency\" aria-valuenow=\"98.4\" aria-valuemin=\"87.5\" aria-valuemax=\"108\">\n    <span class=\"needle\"></span></div><div class=\"nums\"><span>87.5</span><span>92</span><span>98</span><span>104</span><span>108</span></div></div>\n</body>\n</html>\n"
