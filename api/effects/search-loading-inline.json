  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Searching State</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"search-loading-inline\",\n    \"title\": \"Searching State\",\n    \"summary\": \"An inline spinner inside the search field.\",\n    \"description\": \"An inline spinner inside the search field.\",\n    \"theme\": \"search-ui\",\n    \"categories\": [\"search\", \"filter\"],\n    \"tags\": [\"search\", \"find\", \"loading\", \"inline\", \"spinner\", \"async\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Result counts belong in an aria-live region; filter groups need fieldset/legend so their scope is announced.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Spinner colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Async search. Keep the spinner inside the field so the results area can hold the previous results — blanking results on every keystroke is disorienting.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 290px; }\n    .fx input { width: 100%; padding: .75rem 2.6rem .75rem .9rem; border-radius: 12px; border: 1px solid #7c5cff;\n      background: #151b2a; color: #e7ebf3; font: inherit; }\n    .fx .sp { position: absolute; right: .9rem; top: 50%; translate: 0 -50%; width: 16px; height: 16px;\n      border: 2px solid rgba(124,92,255,.3); border-top-color: #7c5cff; border-radius: 50%; animation: sp .8s linear infinite; }\n    .fx .hint { margin-top: .5rem; font-size: .78rem; color: #8b93a7; }\n    @keyframes sp { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><input type=\"search\" value=\"gradient\" aria-label=\"Search\" /><span class=\"sp\" aria-hidden=\"true\"></span>\n  <p class=\"hint\" role=\"status\">Searching…</p></div>\n</body>\n</html>\n"
