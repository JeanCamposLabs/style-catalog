  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Legal Document</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"template-privacy-legal\",\n    \"title\": \"Legal Document\",\n    \"summary\": \"A readable privacy policy layout.\",\n    \"description\": \"A readable privacy policy layout.\",\n    \"theme\": \"website-templates\",\n    \"categories\": [\"template\", \"page\"],\n    \"tags\": [\"template\", \"page\", \"legal\", \"privacy\", \"policy\", \"document\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Full pages keep landmark elements (header, nav, main, footer), a single h1, and a visible focus order that matches the layout.\",\n    \"customization\": [\n      { \"name\": \"--measure\", \"description\": \"Text measure\", \"default\": \"66ch\" }\n    ],\n    \"variations\": [\"Reskin through the custom properties\", \"Swap the copy for your own\"],\n    \"ai_usage\": \"Policy pages. A table of contents, short sections, and a stated last-updated date do more for comprehension than any amount of simplified language.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n    body { padding: 1.4rem; max-width: 34rem; margin: 0 auto; }\n    h1 { margin: 0 0 .3rem; font-size: 1.4rem; }\n    .updated { margin: 0 0 1.4rem; color: #64748b; font-size: .78rem; }\n    .toc { padding: .9rem 1rem; border-radius: 12px; background: #151b2a; border: 1px solid #263149; margin-bottom: 1.4rem; }\n    .toc h2 { margin: 0 0 .4rem; font-size: .68rem; text-transform: uppercase; letter-spacing: .08em; color: #64748b; }\n    .toc a { display: block; padding: .15rem 0; color: #b9a5ff; text-decoration: none; font-size: .82rem; }\n    section h2 { margin: 1.3rem 0 .4rem; font-size: 1rem; }\n    section p { margin: 0 0 .7rem; color: #8b93a7; font-size: .86rem; line-height: 1.7; max-width: 66ch; }\n  </style>\n</head>\n<body>\n  <h1>Privacy notice</h1><p class=\"updated\">Last updated 10 September 2026</p>\n  <nav class=\"toc\" aria-label=\"Contents\"><h2>Contents</h2><a href=\"#s1\">What we collect</a><a href=\"#s2\">How we use it</a><a href=\"#s3\">Your rights</a></nav>\n  <main><section id=\"s1\"><h2>What we collect</h2><p>The gallery is static and stores no personal data. Analytics are aggregate page counts with no identifiers.</p></section>\n  <section id=\"s2\"><h2>How we use it</h2><p>Aggregate counts tell us which specimens are used, so we know what to expand. Nothing is shared with third parties.</p></section>\n  <section id=\"s3\"><h2>Your rights</h2><p>Because we hold no personal data there is nothing to export or erase. Contact us with any question about this notice.</p></section></main>\n</body>\n</html>\n"
