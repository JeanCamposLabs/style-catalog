  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Flaming Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"flame-text-gif\",\n    \"title\": \"Flaming Text\",\n    \"summary\": \"The animated fire headline of early web banners.\",\n    \"description\": \"The animated fire headline of early web banners.\",\n    \"theme\": \"retro-web\",\n    \"categories\": [\"retro\", \"nostalgia\"],\n    \"tags\": [\"retro\", \"nostalgia\", \"flames\", \"wordart\", \"90s\", \"banner\"],\n    \"tech\": [\"css\"],\n    \"era\": \"1990s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"These recreate deprecated tags accessibly: motion respects prefers-reduced-motion and nothing depends on blinking to be readable.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Flicker period\", \"default\": \"0.5s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Deliberate kitsch. Layered text-shadows reproduce the animated-GIF flame headline at any size, with selectable text and no image request.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { font-family: \"Impact\", \"Arial Black\", sans-serif; font-size: 2.4rem; letter-spacing: .04em; color: #ffe600;\n      text-shadow: 0 -2px 3px #fff, 0 -6px 10px #ff8000, 0 -12px 20px #ff2000, 0 -20px 30px #800000;\n      animation: flick .5s ease-in-out infinite alternate; }\n    @keyframes flick { to { text-shadow: 0 -3px 4px #fff, 0 -9px 14px #ffb000, 0 -18px 26px #ff4000, 0 -28px 40px #a00000; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\">HOT!</div>\n</body>\n</html>\n"
