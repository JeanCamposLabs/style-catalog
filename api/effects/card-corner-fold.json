  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Folded Corner Card</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"card-corner-fold\",\n    \"title\": \"Folded Corner Card\",\n    \"summary\": \"A page-corner fold in the top right.\",\n    \"description\": \"A page-corner fold in the top right. Self-contained card markup you can drop into a grid.\",\n    \"theme\": \"cards-surfaces\",\n    \"categories\": [\"card\", \"surface\"],\n    \"tags\": [\"card\", \"surface\", \"fold\", \"corner\", \"paper\", \"skeuomorphic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"A clickable card needs one real link or button inside it; never attach a click handler to a bare div.\",\n    \"customization\": [\n      { \"name\": \"--size\", \"description\": \"Fold size\", \"default\": \"34px\" }\n    ],\n    \"variations\": [\"Adapt for a light theme\", \"Add a media area at the top\"],\n    \"ai_usage\": \"Document and note cards. The fold needs a two-stop diagonal gradient plus a shadow — a flat triangle reads as a cut, not a fold.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .card { width: 260px; border-radius: 18px; padding: 1.4rem; }\n    .card h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .card p { margin: 0; color: #8b93a7; font-size: .88rem; line-height: 1.5; }\n    .card { position: relative; background: #151b2a; border: 1px solid #263149; overflow: hidden; }\n    .card::before { content: \"\"; position: absolute; top: 0; right: 0; width: 34px; height: 34px;\n      background: linear-gradient(225deg, #0b0d12 0 50%, #2b3450 50%); box-shadow: -2px 2px 5px rgba(0,0,0,.4); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <article class=\"card\"><h3>Folded Corner Card</h3><p>A page-corner fold in the top right.</p></article>\n</body>\n</html>\n"
