  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Subgrid Alignment</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"layout-subgrid-alignment\",\n    \"title\": \"Subgrid Alignment\",\n    \"summary\": \"Card internals aligned across a row.\",\n    \"description\": \"Card internals aligned across a row.\",\n    \"theme\": \"layout-archetypes\",\n    \"categories\": [\"layout\", \"structure\"],\n    \"tags\": [\"layout\", \"grid\", \"subgrid\", \"alignment\", \"cards\", \"grid\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Layouts must reflow rather than scroll horizontally, and the DOM order must match the visual reading order.\",\n    \"customization\": [\n      { \"name\": \"--cols\", \"description\": \"Column count\", \"default\": \"3\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Card rows where titles and prices must line up. subgrid lets children participate in the parent's tracks, which is the only way to align internals across siblings without fixed heights.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; width: 300px; }\n    .c { display: grid; grid-template-rows: subgrid; grid-row: span 3; gap: 6px; padding: .7rem;\n      border-radius: 12px; background: #151b2a; border: 1px solid #263149; }\n    .fx { grid-template-rows: auto auto auto; }\n    .c h4 { margin: 0; font-size: .8rem; }\n    .c p { margin: 0; color: #8b93a7; font-size: .7rem; line-height: 1.4; }\n    .c b { font-size: .9rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"c\"><h4>Starter</h4><p>For solo work</p><b>$12</b></div>\n  <div class=\"c\"><h4>Studio plan</h4><p>For small teams that ship often</p><b>$24</b></div>\n  <div class=\"c\"><h4>Scale</h4><p>Unlimited</p><b>$99</b></div></div>\n</body>\n</html>\n"
