  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Vignette Overlay</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"vignette-overlay\",\n    \"title\": \"Vignette Overlay\",\n    \"summary\": \"A soft darkening at the edges that focuses attention on the centre.\",\n    \"description\": \"A single radial-gradient with a transparent core and dark rim; the falloff distance matters more than the darkness.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"overlay\"],\n    \"tags\": [\"vignette\", \"focus\", \"radial-gradient\", \"photo\", \"subtle\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--str\", \"description\": \"Vignette strength\", \"default\": \"0.65\" },\n      { \"name\": \"--start\", \"description\": \"Where the fade begins\", \"default\": \"45%\" }\n    ],\n    \"variations\": [\"Colored vignette for mood\", \"Tighter falloff for a spotlight\", \"Animate the strength on hover\"],\n    \"ai_usage\": \"Layer over hero images and video. Keep the transparent core large (start the fade at 40–55%) — an early fade darkens the subject and looks like a mistake.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --str: .65; --start: 45%; }\n    .bg { background: linear-gradient(135deg, #23304a, #0b0d12); }\n    .vig { position: fixed; inset: 0; pointer-events: none;\n      background: radial-gradient(ellipse at center, transparent var(--start), rgba(0,0,0,var(--str)) 100%); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div><div class=\"vig\" aria-hidden=\"true\"></div>\n</body>\n</html>\n"
}
