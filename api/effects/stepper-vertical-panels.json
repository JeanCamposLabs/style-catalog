  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Vertical Stepper</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"stepper-vertical-panels\",\n    \"title\": \"Vertical Stepper\",\n    \"summary\": \"Steps that expand to reveal their content.\",\n    \"description\": \"Steps that expand to reveal their content.\",\n    \"theme\": \"timelines-steppers\",\n    \"categories\": [\"timeline\", \"stepper\"],\n    \"tags\": [\"timeline\", \"sequence\", \"vertical\", \"stepper\", \"expand\", \"guided\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Sequences need list markup and an explicit current marker (aria-current) — position and colour alone are not enough.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Active colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Guided setup flows. Only the active step shows its panel; keep completed panels collapsible rather than removed so users can go back and check what they entered.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; }\n    .s { display: grid; grid-template-columns: 26px 1fr; gap: .8rem; }\n    .s .rail { display: grid; justify-items: center; }\n    .s .d { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: .78rem;\n      font-weight: 800; background: #1c2437; border: 2px solid #2b3450; color: #8b93a7; }\n    .s.done .d { background: #10a894; border-color: #10a894; color: #04241f; }\n    .s.now .d { border-color: #7c5cff; color: #b9a5ff; }\n    .s .line { width: 2px; flex: 1; background: #2b3450; height: 100%; }\n    .s .body { padding-bottom: 1rem; }\n    .s b { font-size: .88rem; color: #cbd5e1; }\n    .s.now b { color: #e7ebf3; }\n    .s .panel { display: none; margin-top: .5rem; padding: .7rem .8rem; border-radius: 10px; background: #151b2a;\n      border: 1px solid #263149; color: #8b93a7; font-size: .8rem; line-height: 1.5; }\n    .s.now .panel { display: block; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"s done\"><span class=\"rail\"><span class=\"d\">✓</span><span class=\"line\"></span></span>\n  <div class=\"body\"><b>Connect repository</b></div></div>\n  <div class=\"s now\"><span class=\"rail\"><span class=\"d\">2</span><span class=\"line\"></span></span>\n  <div class=\"body\"><b>Choose a branch</b><div class=\"panel\">Builds will run on every push to the branch you select.</div></div></div>\n  <div class=\"s\"><span class=\"rail\"><span class=\"d\">3</span></span><div class=\"body\"><b>Deploy</b></div></div></div>\n</body>\n</html>\n"
