  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Drag to Scroll</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-drag-scroll-rail\",\n    \"title\": \"Drag to Scroll\",\n    \"summary\": \"A rail scrolled by dragging with the pointer.\",\n    \"description\": \"A rail scrolled by dragging with the pointer.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"pointer\"],\n    \"tags\": [\"cursor\", \"pointer\", \"drag\", \"scroll\", \"rail\", \"grab\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Custom cursors are gated to fine pointers; touch and reduced-motion users keep the native cursor and full functionality.\",\n    \"customization\": [\n      { \"name\": \"--w\", \"description\": \"Item width\", \"default\": \"110px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Horizontal galleries. Drag-to-scroll must supplement native scrolling, never replace it — keep the container scrollable so wheel, touch, and keyboard still work.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 10px; width: 290px; overflow-x: auto; padding: 4px; cursor: grab; scrollbar-width: none; }\n    .fx::-webkit-scrollbar { display: none; }\n    .fx.dragging { cursor: grabbing; scroll-behavior: auto; }\n    .fx div { flex: none; width: 110px; height: 130px; border-radius: 12px;\n      background: linear-gradient(150deg, #7c5cff, #2dd4bf); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" id=\"ds\"><div></div><div></div><div></div><div></div></div>\n  <script>\n    (function () {\n      var el = document.getElementById(\"ds\"), down = false, x0 = 0, s0 = 0;\n      el.addEventListener(\"pointerdown\", function (e) {\n        down = true; x0 = e.clientX; s0 = el.scrollLeft; el.classList.add(\"dragging\"); el.setPointerCapture(e.pointerId);\n      });\n      el.addEventListener(\"pointermove\", function (e) { if (down) el.scrollLeft = s0 - (e.clientX - x0); });\n      [\"pointerup\", \"pointercancel\"].forEach(function (ev) {\n        el.addEventListener(ev, function () { down = false; el.classList.remove(\"dragging\"); });\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
