  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Log Stream</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"terminal-log-stream\",\n    \"title\": \"Log Stream\",\n    \"summary\": \"Coloured log lines arriving in sequence.\",\n    \"description\": \"Coloured log lines arriving in sequence.\",\n    \"theme\": \"terminal-cli\",\n    \"categories\": [\"terminal\", \"code\"],\n    \"tags\": [\"terminal\", \"monospace\", \"logs\", \"stream\", \"stagger\", \"monitoring\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Terminal output should live in a real text element (not an image) so it can be selected, searched, and read aloud.\",\n    \"customization\": [\n      { \"name\": \"--step\", \"description\": \"Line interval\", \"default\": \"0.5s\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Build and deploy views. Colour the level and also prefix it with a word — colour-only severity is unreadable for many users and in plain-text copies.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; height: 150px; overflow: hidden; padding: .8rem; border-radius: 8px; background: #0d1117;\n      border: 1px solid #21262d; font-family: ui-monospace, monospace; font-size: .74rem; line-height: 1.8; }\n    .fx div { opacity: 0; animation: in .3s ease-out forwards; animation-delay: calc(var(--i) * .5s); }\n    .fx .ok { color: #3fb950; } .fx .warn { color: #d29922; } .fx .err { color: #f85149; } .fx .dim { color: #6e7681; }\n    @keyframes in { to { opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) {\n      .fx div { animation: none; opacity: 1; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"log\">\n    <div style=\"--i:0\" class=\"dim\">12:04:01 [info] starting build</div>\n    <div style=\"--i:1\" class=\"ok\">12:04:02 [ok] scanned 1181 effects</div>\n    <div style=\"--i:2\" class=\"warn\">12:04:03 [warn] 2 posters missing</div>\n    <div style=\"--i:3\" class=\"ok\">12:04:05 [ok] wrote catalog.json</div>\n    <div style=\"--i:4\" class=\"err\">12:04:06 [error] upload retry 1/3</div>\n  </div>\n</body>\n</html>\n"
