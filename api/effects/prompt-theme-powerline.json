  .fx span::after { content: \"\"; position: absolute; left: 100%; top: 0; bottom: 0; width: 12px;\n      background: inherit; clip-path: polygon(0 0, 100% 50%, 0 100%); }\n    .fx .a { background: #7c5cff; } .fx .b { background: #2563eb; } .fx .c { background: #0f766e; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"a\">~/catalog</span><span class=\"b\">main</span><span class=\"c\">✓ 1181</span></div>\n</body>\n</html>\n"
