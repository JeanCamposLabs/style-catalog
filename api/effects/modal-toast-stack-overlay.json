  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Stacked Dialog</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"modal-toast-stack-overlay\",\n    \"title\": \"Stacked Dialog\",\n    \"summary\": \"A second dialog opening over the first, offset behind it.\",\n    \"description\": \"A second dialog opening over the first, offset behind it.\",\n    \"theme\": \"modals-overlays\",\n    \"categories\": [\"modal\", \"overlay\"],\n    \"tags\": [\"modal\", \"dialog\", \"stack\", \"nested\", \"layered\", \"z-index\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"A modal must trap focus, close on Escape, return focus to its trigger, and mark the page behind it inert. The <dialog> element gives most of this for free.\",\n    \"customization\": [\n      { \"name\": \"--offset\", \"description\": \"Stack offset\", \"default\": \"14px\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Nested flows (a picker over a form). Push the previous dialog back and dim it so the active layer is unambiguous, and keep focus in the topmost dialog only.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .stack { position: relative; width: 300px; height: 220px; }\n    .d { position: absolute; left: 0; right: 0; padding: 1.3rem; border-radius: 16px; background: #141a28; border: 1px solid #2b3450;\n      box-shadow: 0 20px 50px rgba(0,0,0,.5); }\n    .d.back { top: 0; transform: scale(.93) translateY(-14px); opacity: .6; }\n    .d.front { top: 34px; }\n    .d h3 { margin: 0 0 .4rem; font-size: 1rem; }\n    .d p { margin: 0; color: #8b93a7; font-size: .85rem; }\n  </style>\n</head>\n<body>\n  <div class=\"stack\"><div class=\"d back\" aria-hidden=\"true\"><h3>Project settings</h3><p>Background layer.</p></div>\n  <div class=\"d front\" role=\"dialog\" aria-label=\"Select region\"><h3>Select region</h3><p>The active dialog sits in front; the one behind is inert.</p></div></div>\n</body>\n</html>\n"
