  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Marquee Ticker</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"marquee-scrolling-news\",\n    \"title\": \"Marquee Ticker\",\n    \"summary\": \"A scrolling news bar, accessibly rebuilt.\",\n    \"description\": \"A scrolling news bar, accessibly rebuilt.\",\n    \"theme\": \"retro-web\",\n    \"categories\": [\"retro\", \"nostalgia\"],\n    \"tags\": [\"retro\", \"nostalgia\", \"marquee\", \"ticker\", \"scroll\", \"90s\"],\n    \"tech\": [\"css\"],\n    \"era\": \"1990s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"These recreate deprecated tags accessibly: motion respects prefers-reduced-motion and nothing depends on blinking to be readable.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Scroll period\", \"default\": \"12s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Retro tickers. Never use the deprecated <marquee> tag: it cannot be paused, ignores reduced motion, and hides text from find-in-page. Pause on hover as this one does.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; overflow: hidden; padding: .5rem 0; background: #000; border: 2px inset #808080; }\n    .fx b { display: inline-block; white-space: nowrap; color: #0f0; font-family: ui-monospace, monospace;\n      animation: slide 12s linear infinite; }\n    .fx:hover b { animation-play-state: paused; }\n    @keyframes slide { from { transform: translateX(100%); } to { transform: translateX(-100%); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><b>*** BREAKING: catalogue passes 1,000 specimens *** all zero-dependency *** ***</b></div>\n</body>\n</html>\n"
