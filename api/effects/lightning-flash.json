ontent: \"\"; position: absolute; inset: 0; background: #dbeafe; opacity: 0;\n      animation: flash 7s steps(1) infinite; }\n    .fx .bolt { position: absolute; top: 20%; left: 46%; width: 4px; height: 70px; background: #fde68a; opacity: 0;\n      clip-path: polygon(40% 0, 100% 42%, 55% 44%, 100% 100%, 0 52%, 45% 50%);\n      animation: flash 7s steps(1) infinite; }\n    @keyframes flash { 0%, 88%, 100% { opacity: 0; } 89% { opacity: .55; } 90% { opacity: 0; } 91% { opacity: .35; } 92% { opacity: 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"bolt\"></span></div>\n</body>\n</html>\n"
