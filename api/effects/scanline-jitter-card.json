color: #8b93a7; font-size: .85rem; }\n    @keyframes jit {\n      0%, 90%, 100% { transform: none; filter: none; }\n      91% { transform: translate(3px, -2px); filter: hue-rotate(40deg); }\n      93% { transform: translate(-4px, 2px); }\n      95% { transform: translate(2px, 1px); filter: hue-rotate(-30deg); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><h3>Connection unstable</h3><p>Retrying in 3s…</p></div>\n</body>\n</html>\n"
