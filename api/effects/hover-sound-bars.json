  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Hover Equalizer Rows</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hover-sound-bars\",\n    \"title\": \"Hover Equalizer Rows\",\n    \"summary\": \"List rows sprout a small animated equalizer when hovered.\",\n    \"description\": \"The bars only animate while hovered, so an idle list stays completely still and cheap.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"list\"],\n    \"tags\": [\"equalizer\", \"list\", \"music\", \"hover\", \"bars\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Bar color\", \"default\": \"#2dd4bf\" }\n    ],\n    \"variations\": [\"Show a play icon instead when paused\", \"Persist bars on the active track\", \"Colour the active row\"],\n    \"ai_usage\": \"Music and podcast lists. Start the bar animation only on hover/active so an idle playlist has zero running animations — a common performance mistake in media UIs.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --c: #2dd4bf; }\n    .tracks { list-style: none; margin: 0; padding: 0; width: 260px; }\n    .tracks li { display: flex; align-items: center; gap: .8rem; padding: .6rem .8rem; border-radius: 10px; color: #cbd5e1; cursor: pointer; }\n    .tracks li:hover { background: #151b2a; }\n    .tracks .eq { display: flex; gap: 3px; align-items: flex-end; height: 16px; width: 18px; }\n    .tracks .eq i { width: 3px; height: 4px; background: #3b465e; border-radius: 2px; }\n    .tracks li:hover .eq i { background: var(--c); animation: bob .7s ease-in-out infinite alternate; }\n    .tracks li:hover .eq i:nth-child(2) { animation-duration: .5s; }\n    .tracks li:hover .eq i:nth-child(3) { animation-duration: .9s; }\n    @keyframes bob { to { height: 16px; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <ul class=\"tracks\">\n    <li><span class=\"eq\" aria-hidden=\"true\"><i></i><i></i><i></i></span> Midnight City</li>\n    <li><span class=\"eq\" aria-hidden=\"true\"><i></i><i></i><i></i></span> Nightcall</li>\n    <li><span class=\"eq\" aria-hidden=\"true\"><i></i><i></i><i></i></span> Sunset Drive</li>\n  </ul>\n</body>\n</html>\n"
}
