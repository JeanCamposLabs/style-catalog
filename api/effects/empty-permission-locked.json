  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Permission Required</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"empty-permission-locked\",\n    \"title\": \"Permission Required\",\n    \"summary\": \"A gated state explaining what is missing.\",\n    \"description\": \"A gated state explaining what is missing.\",\n    \"theme\": \"empty-skeleton-states\",\n    \"categories\": [\"state\", \"empty\"],\n    \"tags\": [\"state\", \"placeholder\", \"permission\", \"locked\", \"access\", \"gate\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Loading placeholders must be hidden from assistive tech (aria-hidden) with a single aria-live status instead; empty states need real headings and a focusable action.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Action colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Access-denied states. Name the missing permission and who can grant it; 'You do not have access' with no path forward is the least useful message in software.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 285px; padding: 1.7rem 1.3rem; border-radius: 16px; background: #151b2a; border: 1px solid #263149; text-align: center; }\n    .fx .ic { width: 46px; height: 46px; border-radius: 50%; background: #1e2740; display: grid; place-items: center;\n      margin: 0 auto; font-size: 1.2rem; }\n    .fx h3 { margin: .8rem 0 .3rem; font-size: .98rem; }\n    .fx p { margin: 0 0 1rem; color: #8b93a7; font-size: .84rem; line-height: 1.5; }\n    .fx button { padding: .5rem 1.2rem; border: 0; border-radius: 9px; background: #7c5cff; color: #fff; font: inherit; font-size: .84rem; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"ic\" aria-hidden=\"true\">🔒</div><h3>Admin access required</h3>\n  <p>Ask a workspace owner to grant you the Publish role to deploy the catalogue.</p><button type=\"button\">Request access</button></div>\n</body>\n</html>\n"
