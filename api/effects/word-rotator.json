  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Rotating Words</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"word-rotator\",\n    \"title\": \"Rotating Words\",\n    \"summary\": \"One noun in the headline swaps for the next on a vertical roll.\",\n    \"description\": \"A fixed-height mask shows one word at a time while the stack slides up, so the surrounding line never reflows.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"animation\"],\n    \"tags\": [\"rotator\", \"headline\", \"marketing\", \"roll\", \"cycle\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Time per word\", \"default\": \"2s\" },\n      { \"name\": \"--c\", \"description\": \"Rotating word color\", \"default\": \"#2dd4bf\" }\n    ],\n    \"variations\": [\"Fade instead of roll\", \"Type each word out instead\", \"Match the container width to the longest word\"],\n    \"ai_usage\": \"Marketing headlines ('build faster / safer / together'). Fix the mask height to the line-height and animate translateY in whole-line steps; if the surrounding text jitters, the container width is not fixed to the longest word.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: 2s; --c: #2dd4bf; }\n    .rot { font-size: clamp(1.4rem, 5vw, 2.4rem); font-weight: 800; display: flex; gap: .5ch; align-items: center; }\n    .rot .win { height: 1.25em; overflow: hidden; }\n    .rot .win .list { display: block; animation: roll calc(var(--dur) * 4) steps(4) infinite; }\n    .rot .win b { display: block; height: 1.25em; line-height: 1.25em; color: var(--c); }\n    @keyframes roll { to { transform: translateY(-500%); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"rot\">Ship it <span class=\"win\"><span class=\"list\"><b>faster</b><b>safer</b><b>together</b><b>today</b><b>faster</b></span></span></div>\n</body>\n</html>\n"
}
