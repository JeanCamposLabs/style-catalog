  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Cell Meter</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"meter-battery-cells\",\n    \"title\": \"Cell Meter\",\n    \"summary\": \"Discrete cells fill to show a level.\",\n    \"description\": \"Discrete cells fill to show a level.\",\n    \"theme\": \"progress-meters\",\n    \"categories\": [\"progress\", \"meter\"],\n    \"tags\": [\"progress\", \"indicator\", \"cells\", \"discrete\", \"level\", \"battery\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Give every indicator role=progressbar (or <progress>/<meter>) with aria-valuenow, and never rely on colour alone to signal a threshold.\",\n    \"customization\": [\n      { \"name\": \"--on\", \"description\": \"Filled colour\", \"default\": \"#34d399\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Signal, battery, and strength meters where an exact number is meaningless. Colour early cells differently to encode danger zones.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .m { display: flex; gap: 4px; }\n    .m i { width: 20px; height: 40px; border-radius: 4px; background: #22304a; }\n    .m i.on { background: #34d399; }\n    .m i.on:nth-child(-n+2) { background: #fbbf24; }\n    .lbl { margin-top: .6rem; color: #8b93a7; font-size: .82rem; text-align: center; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div><div class=\"m\" role=\"meter\" aria-valuenow=\"4\" aria-valuemin=\"0\" aria-valuemax=\"6\" aria-label=\"Signal strength\">\n    <i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i class=\"on\"></i><i></i><i></i>\n  </div><p class=\"lbl\">4 of 6</p></div>\n</body>\n</html>\n"
