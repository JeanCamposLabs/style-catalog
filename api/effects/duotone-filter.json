  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Duotone</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"duotone-filter\",\n    \"title\": \"Duotone\",\n    \"summary\": \"Two-colour grading applied with grayscale plus a blended tint.\",\n    \"description\": \"Two-colour grading applied with grayscale plus a blended tint. Applied with CSS filters or blend modes, so the underlying content stays live and selectable.\",\n    \"theme\": \"blend-filters\",\n    \"categories\": [\"filter\", \"color\"],\n    \"tags\": [\"filter\", \"css\", \"duotone\", \"grading\", \"blend\", \"editorial\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Filters change colour relationships — re-check text contrast after applying one, and never encode meaning in a filtered colour alone.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Shadow tint\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--b\", \"description\": \"Highlight tint\", \"default\": \"#2dd4bf\" }\n    ],\n    \"variations\": [\"Animate the filter value on hover\", \"Apply to a whole section with backdrop-filter\"],\n    \"ai_usage\": \"Editorial imagery on brand. Grayscale first, then a colour-blended gradient — tinting a colour image directly gives muddy results.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; height: 170px; border-radius: 16px; overflow: hidden; position: relative;\n      background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .8rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .fx { filter: grayscale(1) contrast(1.15); }\n    .fx::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(135deg, #7c5cff, #2dd4bf); mix-blend-mode: color; }\n  </style>\n</head>\n<body>\n  <div><div class=\"demo fx\"></div><p class=\"label\">Duotone</p></div>\n</body>\n</html>\n"
