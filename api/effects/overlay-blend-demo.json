height: 170px; border-radius: 16px; overflow: hidden; position: relative;\n      background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .8rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .fx::after { content: \"\"; position: absolute; inset: 0; background: linear-gradient(135deg, #f472b6, #38bdf8); mix-blend-mode: overlay; }\n  </style>\n</head>\n<body>\n  <div><div class=\"demo fx\"></div><p class=\"label\">Overlay Blend</p></div>\n</body>\n</html>\n"
