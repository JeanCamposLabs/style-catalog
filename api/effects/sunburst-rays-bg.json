  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Sunburst Rays</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"sunburst-rays-bg\",\n    \"title\": \"Sunburst Rays\",\n    \"summary\": \"Radiating wedges spread from a corner and rotate slowly.\",\n    \"description\": \"A repeating-conic-gradient produces the rays in one declaration; rotating the whole layer avoids the banding an animated gradient angle would cause.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"retro\"],\n    \"tags\": [\"sunburst\", \"rays\", \"conic-gradient\", \"retro\", \"radial\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2000s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Ray color\", \"default\": \"rgba(251,191,36,.18)\" },\n      { \"name\": \"--dur\", \"description\": \"Rotation\", \"default\": \"40s\" }\n    ],\n    \"variations\": [\"Centre the burst for a mandala\", \"More rays for a finer fan\", \"Static version for a poster\"],\n    \"ai_usage\": \"Retro posters, sales banners, and anime-style emphasis. repeating-conic-gradient(from 0deg, color 0 6deg, transparent 6deg 12deg) is the whole pattern; rotate the element rather than animating the from-angle.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --a: rgba(251,191,36,.18); --dur: 40s; }\n    .bg { background: radial-gradient(circle at 50% 50%, #1a1408, #0b0d12 70%); overflow: hidden; }\n    .bg i { position: absolute; inset: -50%;\n      background: repeating-conic-gradient(from 0deg, var(--a) 0 6deg, transparent 6deg 14deg);\n      animation: spin var(--dur) linear infinite; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"><i></i></div>\n</body>\n</html>\n"
