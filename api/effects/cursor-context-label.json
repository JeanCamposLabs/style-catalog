  "ai_usage": "Portfolio galleries ('View case', 'Drag', 'Play'). Read the label from a data attribute on hover so content authors control it without touching the cursor code; always keep a real title/aria-label on the element too.",
  "path": "effects/cursors-pointers/cursor-context-label.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Contextual Cursor Label</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-context-label\",\n    \"title\": \"Contextual Cursor Label\",\n    \"summary\": \"The cursor grows into a labelled pill over interactive areas.\",\n    \"description\": \"Hovering an element with a data-cursor attribute expands the follower and prints that label inside it.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"pointer\"],\n    \"tags\": [\"cursor\", \"label\", \"context\", \"hover\", \"agency\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Custom cursors are gated to fine pointers; touch and reduced-motion users keep the native cursor and full functionality.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Cursor color\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Different colour per label\", \"Arrow icon for links\", \"Shrink back with a spring\"],\n    \"ai_usage\": \"Portfolio galleries ('View case', 'Drag', 'Play'). Read the label from a data attribute on hover so content authors control it without touching the cursor code; always keep a real title/aria-label on the element too.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { cursor: none; }\n    :root { --c: #7c5cff; }\n    .tiles { display: flex; gap: 12px; }\n    .tiles div { width: 130px; height: 130px; border-radius: 14px; display: grid; place-items: center; color: #cbd5e1;\n      background: #151b2a; border: 1px solid #263149; }\n    .cur { position: fixed; top: 0; left: 0; height: 16px; width: 16px; border-radius: 999px; background: var(--c);\n      display: grid; place-items: center; color: #fff; font-size: .78rem; font-weight: 700; white-space: nowrap;\n      margin: -8px 0 0 -8px; pointer-events: none; z-index: 9; overflow: hidden;\n      transition: width .25s cubic-bezier(.34,1.56,.64,1), height .25s, margin .25s; }\n    .cur.is-big { width: 92px; height: 34px; margin: -17px 0 0 -46px; }\n  </style>\n</head>\n<body>\n  <div class=\"tiles\">\n    <div data-cursor=\"View case\">Project A</div>\n    <div data-cursor=\"Play reel\">Project B</div>\n    <div data-cursor=\"Drag\">Project C</div>\n  </div>\n  <div class=\"cur\" aria-hidden=\"true\"><span></span></div>\n  <script>\n    (function () {\n      var c = document.querySelector(\".cur\"), label = c.querySelector(\"span\");\n      addEventListener(\"pointermove\", function (e) {\n        c.style.transform = \"translate(\" + e.clientX + \"px,\" + e.clientY + \"px)\";\n      });\n      document.querySelectorAll(\"[data-cursor]\").forEach(function (el) {\n        el.addEventListener(\"pointerenter\", function () {\n          label.textContent = el.dataset.cursor; c.classList.add(\"is-big\");\n        });\n        el.addEventListener(\"pointerleave\", function () {\n          label.textContent = \"\"; c.classList.remove(\"is-big\");\n        });\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
