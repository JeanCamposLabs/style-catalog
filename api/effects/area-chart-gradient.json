  "ai_usage": "One series where the volume under the curve is meaningful. Keep the fill low-opacity so the line stays the primary mark, and never stack more than two areas — overlapping translucent fills become unreadable fast.",
  "path": "effects/charts-dataviz/area-chart-gradient.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Area Chart</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"area-chart-gradient\",\n    \"title\": \"Area Chart\",\n    \"summary\": \"A single-series area with a soft fill under the line.\",\n    \"description\": \"A single-series area with a soft fill under the line.\",\n    \"theme\": \"charts-dataviz\",\n    \"categories\": [\"chart\", \"dataviz\"],\n    \"tags\": [\"chart\", \"data\", \"area\", \"fill\", \"trend\", \"single-series\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Identity is never colour-alone: every multi-series chart ships a legend, direct labels where they fit, and an equivalent table or accessible summary. Grid lines and axes stay recessive; values wear text colours, not series colours.\",\n    \"customization\": [\n      { \"name\": \"--c1\", \"description\": \"Series colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"One series where the volume under the curve is meaningful. Keep the fill low-opacity so the line stays the primary mark, and never stack more than two areas — overlapping translucent fills become unreadable fast.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { --c1: #7c5cff; --c2: #10a894; --c3: #c2891a; --c4: #d1478c; --c5: #2f7cc9;\n      --ink: #e7ebf3; --ink-2: #8b93a7; --grid: rgba(139,147,167,.22); --surface: #0b0d12; width: 300px; }\n    .fx h4 { margin: 0 0 .1rem; font-size: .95rem; color: var(--ink); }\n    .fx .sub { margin: 0 0 .8rem; font-size: .78rem; color: var(--ink-2); }\n    .fx svg { width: 100%; display: block; }\n    .fx .line { fill: none; stroke: var(--c1); stroke-width: 2; stroke-linejoin: round; }\n    .fx .fill { fill: url(#ag); }\n    .fx .base { stroke: var(--grid); stroke-width: 1; }\n  </style>\n</head>\n<body>\n  <figure class=\"fx\" style=\"margin:0\"><h4>Catalogue size</h4><p class=\"sub\">Cumulative specimens</p>\n  <svg viewBox=\"0 0 300 120\" role=\"img\" aria-label=\"Area chart of cumulative specimens rising from 180 to 1181\">\n    <defs><linearGradient id=\"ag\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n      <stop offset=\"0\" stop-color=\"#7c5cff\" stop-opacity=\".45\"/><stop offset=\"1\" stop-color=\"#7c5cff\" stop-opacity=\"0\"/></linearGradient></defs>\n    <path class=\"fill\" d=\"M0 100 L60 88 L120 66 L180 44 L240 26 L300 10 L300 120 L0 120 Z\"/>\n    <path class=\"line\" d=\"M0 100 L60 88 L120 66 L180 44 L240 26 L300 10\"/>\n    <line class=\"base\" x1=\"0\" y1=\"119\" x2=\"300\" y2=\"119\"/>\n  </svg></figure>\n</body>\n</html>\n"
}
