  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Orbiting System</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"orbit-system\",\n    \"title\": \"Orbiting System\",\n    \"summary\": \"Planets circling a star at different periods.\",\n    \"description\": \"Planets circling a star at different periods.\",\n    \"theme\": \"space-cosmic\",\n    \"categories\": [\"space\", \"cosmic\"],\n    \"tags\": [\"space\", \"cosmic\", \"orbit\", \"planets\", \"solar-system\", \"rotate\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Deep-space palettes are very low contrast — keep any text on a solid panel above the scene.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Planet colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Slow it down for an ambient version\"],\n    \"ai_usage\": \"Ecosystem and integration diagrams. Give outer orbits longer periods (as real ones have) or the system looks like a rigid pinwheel.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 220px; height: 220px; display: grid; place-items: center; }\n    .fx .o { position: absolute; border: 1px dashed rgba(148,163,184,.25); border-radius: 50%; animation: spin var(--d) linear infinite; }\n    .fx .o i { position: absolute; top: -6px; left: 50%; margin-left: -6px; width: 12px; height: 12px; border-radius: 50%; background: var(--c); }\n    .fx .star { width: 34px; height: 34px; border-radius: 50%; background: radial-gradient(circle, #fff, #fbbf24);\n      box-shadow: 0 0 30px #fbbf24; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"o\" style=\"inset:30px;--d:6s\"><i style=\"--c:#38bdf8\"></i></span>\n  <span class=\"o\" style=\"inset:0;--d:11s\"><i style=\"--c:#f472b6\"></i></span><span class=\"star\"></span></div>\n</body>\n</html>\n"
