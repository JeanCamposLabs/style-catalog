  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Paper Cut Text</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"paper-cut-text\",\n    \"title\": \"Paper Cut Text\",\n    \"summary\": \"Layered paper shapes with soft shadows form a die-cut headline.\",\n    \"description\": \"Two offset text layers in tinted paper colors plus a diffuse shadow give the stacked-cardstock look of paper-cut craft.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"material\"],\n    \"tags\": [\"papercut\", \"layers\", \"craft\", \"shadow\", \"tactile\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--top\", \"description\": \"Top sheet\", \"default\": \"#fef3c7\" },\n      { \"name\": \"--mid\", \"description\": \"Middle sheet\", \"default\": \"#fbbf24\" },\n      { \"name\": \"--bot\", \"description\": \"Bottom sheet\", \"default\": \"#b45309\" }\n    ],\n    \"variations\": [\"More layers for deeper relief\", \"Rotate each layer a degree\", \"Cut-out variant with a background image\"],\n    \"ai_usage\": \"Craft, editorial, or children's-product branding. Offsets should be small (2–4px) and the shadow wide and soft; hard shadows turn it into a 3D extrude instead of stacked paper.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --top: #fef3c7; --mid: #fbbf24; --bot: #b45309; }\n    .pc { position: relative; font-size: clamp(2.2rem, 9vw, 4rem); font-weight: 900; color: var(--top);\n      text-shadow: 3px 3px 0 var(--mid), 6px 6px 0 var(--bot), 10px 12px 20px rgba(0,0,0,.45); }\n  </style>\n</head>\n<body>\n  <h1 class=\"pc\">PAPERCUT</h1>\n</body>\n</html>\n"
