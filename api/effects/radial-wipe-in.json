  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Radial Wipe</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"radial-wipe-in\",\n    \"title\": \"Radial Wipe\",\n    \"summary\": \"A conic wipe sweeps the element into view.\",\n    \"description\": \"A conic wipe sweeps the element into view. Applied once on load with animation-fill-mode: both so the element holds its final state.\",\n    \"theme\": \"transitions-animations\",\n    \"categories\": [\"animation\", \"entrance\"],\n    \"tags\": [\"entrance\", \"reveal\", \"mask\", \"conic\", \"wipe\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Entrance animations must not hide content if they never run — the resting state under prefers-reduced-motion is the finished state.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Animation duration\", \"default\": \"1s\" },\n      { \"name\": \"--ease\", \"description\": \"Timing function\", \"default\": \"linear\" }\n    ],\n    \"variations\": [\"Stagger across a list with animation-delay\", \"Play on scroll with IntersectionObserver\"],\n    \"ai_usage\": \"Progress-flavoured reveals. Browsers cannot interpolate conic-gradient stops without @property, so register the angle as a custom property for smooth playback in production.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: 1s; --ease: linear; }\n    .card { width: 230px; padding: 1.5rem; border-radius: 16px; background: #151b2a; border: 1px solid #263149;\n      animation: radial-wipe-in var(--dur) var(--ease) both infinite alternate; }\n    .card h3 { margin: 0 0 .3rem; font-size: 1.05rem; }\n    .card p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    @keyframes radial-wipe-in {\n      from { -webkit-mask-image: conic-gradient(#000 0deg, transparent 0deg); mask-image: conic-gradient(#000 0deg, transparent 0deg); }\n      to { -webkit-mask-image: conic-gradient(#000 360deg, transparent 360deg); mask-image: conic-gradient(#000 360deg, transparent 360deg); }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      .card { animation: none; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"card\"><h3>Radial Wipe</h3><p>A conic wipe sweeps the element into view.</p></div>\n</body>\n</html>\n"
