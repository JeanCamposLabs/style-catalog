  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Caption Slide Up</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"caption-slide-up\",\n    \"title\": \"Caption Slide Up\",\n    \"summary\": \"A caption panel slides over the image from below on hover.\",\n    \"description\": \"The panel is translated fully out of view and back, so no height animation and no reflow of neighbouring cards.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"image\"],\n    \"tags\": [\"caption\", \"overlay\", \"slide\", \"gallery\", \"image\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Slide duration\", \"default\": \"0.35s\" },\n      { \"name\": \"--bg\", \"description\": \"Panel background\", \"default\": \"rgba(11,13,18,.9)\" }\n    ],\n    \"variations\": [\"Fade plus slide\", \"Panel from the side\", \"Persistent title with extra detail on hover\"],\n    \"ai_usage\": \"Image galleries and portfolio grids. Keep the essential label always visible and reserve the slide-up for secondary detail — hiding the only label behind hover breaks touch devices.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: .35s; --bg: rgba(11,13,18,.9); }\n    .gal { position: relative; width: 280px; height: 190px; border-radius: 14px; overflow: hidden;\n      background: conic-gradient(from 140deg at 30% 40%, #7c5cff, #2dd4bf, #f472b6, #7c5cff); }\n    .gal .cap { position: absolute; inset: auto 0 0 0; padding: .9rem 1rem; background: var(--bg);\n      transform: translateY(100%); transition: transform var(--dur) cubic-bezier(.7,0,.2,1); }\n    .gal:hover .cap, .gal:focus-within .cap { transform: translateY(0); }\n    .gal h4 { margin: 0 0 .2rem; font-size: 1rem; }\n    .gal p { margin: 0; color: #8b93a7; font-size: .85rem; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <figure class=\"gal\" tabindex=\"0\" style=\"margin:0\">\n    <figcaption class=\"cap\"><h4>Chromatic study</h4><p>Gradient, 2026</p></figcaption>\n  </figure>\n</body>\n</html>\n"
