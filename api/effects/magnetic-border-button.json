  "ai_usage": "High-emphasis CTAs. The wrapper carries the rotating conic background and 2px of padding; the inner element repaints the solid surface. Register --angle with @property for a smooth sweep, or rotate the whole pseudo-element as done here.",
  "path": "effects/buttons/magnetic-border-button.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Rotating Border Button</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"magnetic-border-button\",\n    \"title\": \"Rotating Border Button\",\n    \"summary\": \"A conic gradient spins continuously around the button edge.\",\n    \"description\": \"The animated conic gradient lives on a padded wrapper and is masked to the border, so the label stays crisp and unrotated.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"border\"],\n    \"tags\": [\"conic-gradient\", \"animated-border\", \"spin\", \"gradient\", \"cta\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>; keep a visible :focus-visible ring and never rely on hover alone to convey state. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Sweep color A\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--b\", \"description\": \"Sweep color B\", \"default\": \"#2dd4bf\" },\n      { \"name\": \"--dur\", \"description\": \"Rotation\", \"default\": \"3s\" }\n    ],\n    \"variations\": [\"Only spin on hover\", \"Thicker border for a bolder frame\", \"Pause when the button is disabled\"],\n    \"ai_usage\": \"High-emphasis CTAs. The wrapper carries the rotating conic background and 2px of padding; the inner element repaints the solid surface. Register --angle with @property for a smooth sweep, or rotate the whole pseudo-element as done here.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    button { font: inherit; cursor: pointer; border: 0; }\n    button:focus-visible { outline: 2px solid #7c5cff; outline-offset: 3px; }\n    :root { --a: #7c5cff; --b: #2dd4bf; --dur: 3s; }\n    .rb { position: relative; padding: 2px; border-radius: 14px; overflow: hidden; background: #151b2a; }\n    .rb::before { content: \"\"; position: absolute; inset: -60%;\n      background: conic-gradient(var(--a), var(--b), var(--a)); animation: spin var(--dur) linear infinite; }\n    .rb button { position: relative; padding: .9rem 2rem; border-radius: 12px; background: #10141f; color: #e7ebf3;\n      font-weight: 700; width: 100%; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"rb\"><button type=\"button\">Get started</button></div>\n</body>\n</html>\n"
}
