  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Split Colour Border</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"split-color-border\",\n    \"title\": \"Split Colour Border\",\n    \"summary\": \"Each edge of the box carries a different colour.\",\n    \"description\": \"Four border-*-color declarations turn the box's mitred corners into a diagonal colour transition.\",\n    \"theme\": \"borders-shadows\",\n    \"categories\": [\"border\"],\n    \"tags\": [\"multicolor\", \"border\", \"mitre\", \"playful\", \"frame\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative edge treatment — never encode meaning in the border colour alone. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--w\", \"description\": \"Border width\", \"default\": \"6px\" }\n    ],\n    \"variations\": [\"Two colours on opposite edges\", \"Animate a hue rotation\", \"Thicker border to emphasise the mitres\"],\n    \"ai_usage\": \"Playful cards and category coding. The mitred corner join is the point of the effect — use a thick border (5px+) or the diagonal transitions are invisible.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; padding: 1.6rem; color: #e7ebf3; }\n    .demo h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .demo p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    :root { --w: 6px; }\n    .demo { border: var(--w) solid; border-color: #7c5cff #2dd4bf #f472b6 #fbbf24; border-radius: 6px; background: #10141f; }\n  </style>\n</head>\n<body>\n  <div class=\"demo\"><h3>Four edges</h3><p>Colours meet at the mitres.</p></div>\n</body>\n</html>\n"
}
