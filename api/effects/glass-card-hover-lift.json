  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Glass Card Lift</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"glass-card-hover-lift\",\n    \"title\": \"Glass Card Lift\",\n    \"summary\": \"A frosted card that rises and brightens on hover.\",\n    \"description\": \"A frosted card that rises and brightens on hover.\",\n    \"theme\": \"glass-neumorphism\",\n    \"categories\": [\"glass\", \"surface\"],\n    \"tags\": [\"glass\", \"surface\", \"glass\", \"hover\", \"lift\", \"card\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Translucent surfaces easily fall below contrast minimums — check text and borders against the busiest part of the backdrop.\",\n    \"customization\": [\n      { \"name\": \"--lift\", \"description\": \"Hover lift\", \"default\": \"5px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Card grids over imagery. Increase the panel's own opacity on hover rather than its blur — changing blur mid-transition causes a visible re-rasterisation.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { background: conic-gradient(from 100deg at 40% 35%, #4c1d95, #0ea5e9, #db2777); }\n    .fx { width: 250px; padding: 1.4rem; border-radius: 18px; color: #fff; cursor: pointer;\n      background: rgba(255,255,255,.14); backdrop-filter: blur(14px) saturate(1.5);\n      -webkit-backdrop-filter: blur(14px) saturate(1.5); border: 1px solid rgba(255,255,255,.3);\n      transition: transform .3s, background .3s, box-shadow .3s; }\n    .fx:hover, .fx:focus-visible { transform: translateY(-5px); background: rgba(255,255,255,.22);\n      box-shadow: 0 22px 44px rgba(0,0,0,.35); }\n    .fx h3 { margin: 0 0 .3rem; font-size: 1rem; }\n    .fx p { margin: 0; opacity: .82; font-size: .85rem; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <article class=\"fx\" tabindex=\"0\"><h3>Frosted lift</h3><p>Opacity rises, blur stays constant.</p></article>\n</body>\n</html>\n"
