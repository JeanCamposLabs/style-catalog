  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Responsive Heading Set</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"type-responsive-headings\",\n    \"title\": \"Responsive Heading Set\",\n    \"summary\": \"Headings that reflow without losing hierarchy.\",\n    \"description\": \"Headings that reflow without losing hierarchy.\",\n    \"theme\": \"typography-systems\",\n    \"categories\": [\"typography\", \"reference\"],\n    \"tags\": [\"typography\", \"type\", \"container-query\", \"cqi\", \"responsive\", \"headings\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Type systems must survive user font-size settings: size in rem, never lock line-height in px, and keep the measure under 75 characters.\",\n    \"customization\": [\n      { \"name\": \"--unit\", \"description\": \"Query unit\", \"default\": \"cqi\" }\n    ],\n    \"variations\": [\"Swap in your own scale\", \"Export as design tokens\"],\n    \"ai_usage\": \"Components reused at different widths. Container query units (cqi) size type against the component, not the viewport — the fix for a card that is wide on desktop and narrow in a sidebar.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; container-type: inline-size; }\n    .fx h2 { margin: 0 0 .3rem; font-size: clamp(1.3rem, 5cqi, 2rem); line-height: 1.2; }\n    .fx h3 { margin: 0 0 .5rem; font-size: clamp(1rem, 3.4cqi, 1.3rem); color: #cbd5e1; }\n    .fx p { margin: 0; font-size: .85rem; line-height: 1.6; color: #8b93a7; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><h2>Container-relative headings</h2><h3>Sized against the component</h3>\n  <p>Using cqi instead of vw means this card types correctly whether it is full-width or in a narrow rail.</p></div>\n</body>\n</html>\n"
}
