  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Volume Fader</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"volume-slider-vertical\",\n    \"title\": \"Volume Fader\",\n    \"summary\": \"A vertical fader with a level scale.\",\n    \"description\": \"A vertical fader with a level scale.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"volume\", \"fader\", \"vertical\", \"mixer\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--v\", \"description\": \"Level percent\", \"default\": \"68\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Mixers and settings. Back it with a real range input rotated with writing-mode so keyboard and screen-reader support come free.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: .8rem; align-items: flex-end; }\n    .fader { position: relative; width: 40px; height: 160px; border-radius: 10px; background: #151b2a; border: 1px solid #263149; }\n    .fader .fill { position: absolute; inset: auto 0 0 0; height: calc(var(--v) * 1%); border-radius: 0 0 9px 9px;\n      background: linear-gradient(180deg, #2dd4bf, #0f766e); }\n    .fader .knob { position: absolute; left: 50%; translate: -50% 50%; bottom: calc(var(--v) * 1%); width: 34px; height: 12px;\n      border-radius: 4px; background: #e2e8f0; box-shadow: 0 2px 5px rgba(0,0,0,.5); }\n    .scale { display: grid; gap: .35rem; font-size: .68rem; color: #64748b; font-family: ui-monospace, monospace; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"fader\" style=\"--v:68\" role=\"slider\" aria-label=\"Volume\" aria-valuenow=\"68\" aria-valuemin=\"0\" aria-valuemax=\"100\">\n    <div class=\"fill\"></div><div class=\"knob\"></div></div>\n  <div class=\"scale\"><span>+6</span><span>0</span><span>-12</span><span>-∞</span></div></div>\n</body>\n</html>\n"
