  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>ASCII Progress Bar</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"terminal-progress-ascii\",\n    \"title\": \"ASCII Progress Bar\",\n    \"summary\": \"A block-character progress bar with a percentage.\",\n    \"description\": \"A block-character progress bar with a percentage.\",\n    \"theme\": \"terminal-cli\",\n    \"categories\": [\"terminal\", \"code\"],\n    \"tags\": [\"terminal\", \"monospace\", \"progress\", \"ascii\", \"blocks\", \"cli\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Terminal output should live in a real text element (not an image) so it can be selected, searched, and read aloud.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Bar colour\", \"default\": \"#4ade80\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"CLI-styled progress. Use full and light block characters (█ ░) rather than a styled div when the surrounding UI is text — it keeps copy-paste meaningful.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { padding: .9rem 1rem; border-radius: 8px; background: #05070d; border: 1px solid #1f2937;\n      font-family: ui-monospace, monospace; font-size: .85rem; color: #4ade80; }\n    .fx .bar { letter-spacing: -.05em; }\n    .fx .dim { color: #1f4d33; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"progressbar\" aria-valuenow=\"65\" aria-valuemin=\"0\" aria-valuemax=\"100\">\n  building <span class=\"bar\">████████████<span class=\"dim\">░░░░░░</span></span> 65%</div>\n</body>\n</html>\n"
