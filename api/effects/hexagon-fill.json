  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Filled Hex Tiles</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hexagon-fill\",\n    \"title\": \"Filled Hex Tiles\",\n    \"summary\": \"Solid honeycomb cells with visible gaps.\",\n    \"description\": \"Solid honeycomb cells with visible gaps. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"hexagon\", \"honeycomb\", \"tiles\", \"filled\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Cell colour\", \"default\": \"#1b2434\" },\n      { \"name\": \"--s\", \"description\": \"Cell width\", \"default\": \"50px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Gaming and tech dashboards. Solid cells with a visible gap read as tiles; outline hexes read as a mesh.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: #1b2434; --bg: #0b0d12; --s: 50px; }\n    .bg { background-color: var(--bg);\n      background-image: radial-gradient(circle farthest-side at 50% 0, var(--c) 47%, transparent 48%),\n        radial-gradient(circle farthest-side at 50% 100%, var(--c) 47%, transparent 48%);\n      background-size: var(--s) calc(var(--s) * .58); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
