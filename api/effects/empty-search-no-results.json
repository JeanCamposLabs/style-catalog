  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>No Search Results</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"empty-search-no-results\",\n    \"title\": \"No Search Results\",\n    \"summary\": \"A zero-results state that suggests recovery.\",\n    \"description\": \"A zero-results state that suggests recovery.\",\n    \"theme\": \"empty-skeleton-states\",\n    \"categories\": [\"state\", \"empty\"],\n    \"tags\": [\"state\", \"placeholder\", \"no-results\", \"search\", \"suggestions\", \"recovery\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Loading placeholders must be hidden from assistive tech (aria-hidden) with a single aria-live status instead; empty states need real headings and a focusable action.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Suggestion border\", \"default\": \"#2b3450\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Search dead ends. Echo the query, then offer concrete escape routes (clear a filter, try a related term) — 'no results found' alone leaves users stuck.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; padding: 1.6rem 1.2rem; border-radius: 16px; background: #151b2a; border: 1px solid #263149; text-align: center; }\n    .fx .q { display: inline-block; padding: .15rem .5rem; border-radius: 6px; background: #1e2740; color: #cbd5e1;\n      font-family: ui-monospace, monospace; font-size: .8rem; }\n    .fx h3 { margin: .8rem 0 .3rem; font-size: .98rem; }\n    .fx p { margin: 0 0 1rem; color: #8b93a7; font-size: .84rem; }\n    .fx .sug { display: flex; gap: .4rem; justify-content: center; flex-wrap: wrap; }\n    .fx .sug button { padding: .3rem .7rem; border-radius: 99px; border: 1px solid #2b3450; background: transparent;\n      color: #cbd5e1; font: inherit; font-size: .78rem; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\"><span class=\"q\">parallax neon</span><h3>No specimens match</h3>\n  <p>Try removing a filter or searching a related tag.</p>\n  <div class=\"sug\"><button type=\"button\">parallax</button><button type=\"button\">neon</button><button type=\"button\">Clear filters</button></div></div>\n</body>\n</html>\n"
