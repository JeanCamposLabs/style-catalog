  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Electron Cloud</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"orbit-electron-cloud\",\n    \"title\": \"Electron Cloud\",\n    \"summary\": \"Particles orbiting on random elliptical paths.\",\n    \"description\": \"Particles orbiting on random elliptical paths.\",\n    \"theme\": \"particles-physics\",\n    \"categories\": [\"particles\", \"physics\"],\n    \"tags\": [\"particles\", \"motion\", \"orbit\", \"electron\", \"atom\", \"cloud\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Particle fields are decorative and expensive — cap counts, pause when off-screen, and stop entirely under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Electron colour\", \"default\": \"#22d3ee\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Science and AI visuals. Give each orbit a distinct tilt and period so the paths never align into a single visible ring.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 190px; height: 190px; display: grid; place-items: center; }\n    .fx .o { position: absolute; inset: 0; border-radius: 50%; animation: spin var(--d) linear infinite; transform: rotate(var(--a)); }\n    .fx .o i { position: absolute; top: -4px; left: 50%; width: 9px; height: 9px; margin-left: -4.5px; border-radius: 50%;\n      background: #22d3ee; box-shadow: 0 0 10px #22d3ee; }\n    .fx .core { width: 26px; height: 26px; border-radius: 50%; background: #d1478c; box-shadow: 0 0 20px #d1478c; }\n    @keyframes spin { to { transform: rotate(calc(var(--a) + 360deg)); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"o\" style=\"--a:0deg;--d:3s\"><i></i></span><span class=\"o\" style=\"--a:45deg;--d:4.2s\"><i></i></span>\n  <span class=\"o\" style=\"--a:100deg;--d:3.6s\"><i></i></span><span class=\"core\"></span></div>\n</body>\n</html>\n"
