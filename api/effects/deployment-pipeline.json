  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Pipeline Stages</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"deployment-pipeline\",\n    \"title\": \"Pipeline Stages\",\n    \"summary\": \"CI stages with pass, running, and pending states.\",\n    \"description\": \"CI stages with pass, running, and pending states.\",\n    \"theme\": \"timelines-steppers\",\n    \"categories\": [\"timeline\", \"stepper\"],\n    \"tags\": [\"timeline\", \"sequence\", \"pipeline\", \"ci\", \"stages\", \"build\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Sequences need list markup and an explicit current marker (aria-current) — position and colour alone are not enough.\",\n    \"customization\": [\n      { \"name\": \"--ok\", \"description\": \"Passing colour\", \"default\": \"#10a894\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"CI dashboards. Each stage needs an icon plus a word; a row of coloured pills is unreadable the moment the build fails and someone screenshots it in greyscale.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: .3rem; width: 300px; }\n    .p { flex: 1; padding: .55rem .3rem; border-radius: 8px; text-align: center; font-size: .74rem; background: #1c2437; color: #8b93a7; }\n    .p.ok { background: rgba(16,168,148,.16); color: #10a894; }\n    .p.run { background: rgba(124,92,255,.16); color: #b9a5ff; }\n    .ar { color: #3b465e; font-size: .7rem; }\n    .spin { display: inline-block; width: 9px; height: 9px; border: 2px solid rgba(185,165,255,.35); border-top-color: #b9a5ff;\n      border-radius: 50%; animation: sp .8s linear infinite; vertical-align: -1px; margin-right: .2rem; }\n    @keyframes sp { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"p ok\">✓ Lint</span><span class=\"ar\">›</span><span class=\"p ok\">✓ Test</span>\n  <span class=\"ar\">›</span><span class=\"p run\"><span class=\"spin\"></span>Build</span><span class=\"ar\">›</span><span class=\"p\">Deploy</span></div>\n</body>\n</html>\n"
