  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Selectable Cards</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"input-toggle-card-select\",\n    \"title\": \"Selectable Cards\",\n    \"summary\": \"Radio options styled as full cards.\",\n    \"description\": \"Radio options styled as full cards.\",\n    \"theme\": \"forms-inputs\",\n    \"categories\": [\"form\", \"input\"],\n    \"tags\": [\"form\", \"input\", \"cards\", \"radio\", \"select\", \"plans\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every control keeps a real label, a visible focus ring, and error state conveyed by text as well as colour.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Selected colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Plan and option pickers. Keep the radio input in the DOM (visually hidden, not display:none) so keyboard navigation and form submission work unchanged.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; gap: 8px; width: 280px; }\n    .fx input { position: absolute; opacity: 0; }\n    .fx label { display: block; padding: .8rem 1rem; border-radius: 12px; border: 1px solid #2b3450; background: #151b2a;\n      cursor: pointer; transition: border-color .2s, background .2s; }\n    .fx input:checked + label { border-color: #7c5cff; background: #191331; }\n    .fx input:focus-visible + label { outline: 2px solid #7c5cff; outline-offset: 2px; }\n    .fx b { display: block; font-size: .9rem; }\n    .fx small { color: #8b93a7; font-size: .78rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><input type=\"radio\" name=\"pl\" id=\"p1\" checked /><label for=\"p1\"><b>Studio</b><small>10 seats · $24/mo</small></label>\n  <input type=\"radio\" name=\"pl\" id=\"p2\" /><label for=\"p2\"><b>Scale</b><small>Unlimited seats · $99/mo</small></label></div>\n</body>\n</html>\n"
