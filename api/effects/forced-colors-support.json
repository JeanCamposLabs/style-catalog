  "ai_usage": "Forced-colours mode replaces your palette with the user's. Give every meaningful boundary a real border (backgrounds are dropped) and use system colour keywords rather than fixed hex values.",
  "path": "effects/accessibility-patterns/forced-colors-support.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Forced Colours</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"forced-colors-support\",\n    \"title\": \"Forced Colours\",\n    \"summary\": \"A component that survives Windows high-contrast mode.\",\n    \"description\": \"A component that survives Windows high-contrast mode.\",\n    \"theme\": \"accessibility-patterns\",\n    \"categories\": [\"accessibility\", \"reference\"],\n    \"tags\": [\"accessibility\", \"a11y\", \"forced-colors\", \"high-contrast\", \"windows\", \"system-colors\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"These specimens are the accessibility reference — each demonstrates the correct semantics, not just the visual result.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Button colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Forced-colours mode replaces your palette with the user's. Give every meaningful boundary a real border (backgrounds are dropped) and use system colour keywords rather than fixed hex values.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; padding: 1.1rem; border-radius: 14px; background: #151b2a; border: 1px solid #263149; }\n    .fx button { display: flex; align-items: center; gap: .5rem; width: 100%; padding: .6rem .8rem; border-radius: 9px;\n      border: 1px solid transparent; background: #7c5cff; color: #fff; font: inherit; font-size: .85rem; cursor: pointer; }\n    .fx .ic { width: 16px; height: 16px; border-radius: 4px; background: currentColor; }\n    .fx .note { margin: .8rem 0 0; color: #8b93a7; font-size: .78rem; line-height: 1.5; }\n    @media (forced-colors: active) {\n      .fx button { border-color: ButtonText; forced-color-adjust: none; background: ButtonFace; color: ButtonText; }\n      .fx .ic { background: ButtonText; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><button type=\"button\"><span class=\"ic\" aria-hidden=\"true\"></span>Publish catalogue</button>\n  <p class=\"note\">In forced-colours mode the icon inherits currentColor and the border becomes visible, so the button never disappears.</p></div>\n</body>\n</html>\n"
}
