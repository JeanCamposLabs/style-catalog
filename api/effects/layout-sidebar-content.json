  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Sidebar and Content</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"layout-sidebar-content\",\n    \"title\": \"Sidebar and Content\",\n    \"summary\": \"A fixed sidebar beside a fluid main column.\",\n    \"description\": \"A fixed sidebar beside a fluid main column.\",\n    \"theme\": \"layout-archetypes\",\n    \"categories\": [\"layout\", \"structure\"],\n    \"tags\": [\"layout\", \"grid\", \"sidebar\", \"two-column\", \"grid\", \"app-shell\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Layouts must reflow rather than scroll horizontally, and the DOM order must match the visual reading order.\",\n    \"customization\": [\n      { \"name\": \"--w\", \"description\": \"Sidebar width\", \"default\": \"90px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"App shells. grid-template-columns with a fixed and a fr track is the whole layout; collapse to one column at a breakpoint rather than shrinking the sidebar to unusable width.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; grid-template-columns: 90px 1fr; gap: 10px; width: 300px; height: 180px; }\n    .fx aside { background: #151b2a; border: 1px solid #263149; border-radius: 12px; padding: .7rem; color: #8b93a7; font-size: .76rem; }\n    .fx main { background: #10141f; border: 1px solid #263149; border-radius: 12px; padding: .9rem; color: #cbd5e1; font-size: .82rem; }\n    @media (max-width: 420px) { .fx { grid-template-columns: 1fr; } }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><aside>Nav<br>Filters<br>Tags</aside><main>Main content column grows to fill the space.</main></div>\n</body>\n</html>\n"
