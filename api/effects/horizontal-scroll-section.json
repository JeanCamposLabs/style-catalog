  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Horizontal Scroll</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"horizontal-scroll-section\",\n    \"title\": \"Horizontal Scroll\",\n    \"summary\": \"A section that scrolls sideways as the page scrolls down.\",\n    \"description\": \"A section that scrolls sideways as the page scrolls down.\",\n    \"theme\": \"scroll-effects\",\n    \"categories\": [\"scroll\", \"motion\"],\n    \"tags\": [\"scroll\", \"horizontal\", \"pin\", \"sideways\", \"gallery\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Scroll-linked motion must be disabled under prefers-reduced-motion, and content must never depend on scrolling to become readable.\",\n    \"customization\": [\n      { \"name\": \"--rate\", \"description\": \"Travel rate\", \"default\": \"1\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Portfolio and process sections. Pin a tall wrapper and translate the rail by the scroll fraction; the wrapper's extra height is what buys the horizontal travel.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n    body { margin: 0; }\n    .pin { height: 260vh; position: relative; }\n    .stage { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; overflow: hidden; }\n    .rail { display: flex; gap: 20px; padding: 0 20px; will-change: transform; }\n    .card { flex: none; width: 220px; height: 300px; border-radius: 18px; display: grid; place-items: center;\n      color: #0b0d12; font-weight: 900; font-size: 1.2rem; }\n  </style>\n</head>\n<body>\n  <div class=\"pin\"><div class=\"stage\"><div class=\"rail\" id=\"rail\">\n    <div class=\"card\" style=\"background:#7c5cff\">01</div><div class=\"card\" style=\"background:#10a894\">02</div>\n    <div class=\"card\" style=\"background:#c2891a\">03</div><div class=\"card\" style=\"background:#d1478c\">04</div></div></div></div>\n  <script>\n    (function () {\n      var pin = document.querySelector(\".pin\"), rail = document.getElementById(\"rail\");\n      if (matchMedia(\"(prefers-reduced-motion: reduce)\").matches) return;\n      addEventListener(\"scroll\", function () {\n        var r = pin.getBoundingClientRect();\n        var p = Math.min(Math.max(-r.top / (r.height - innerHeight), 0), 1);\n        rail.style.transform = \"translateX(\" + -p * (rail.scrollWidth - innerWidth + 40) + \"px)\";\n      }, { passive: true });\n    })();\n  </script>\n</body>\n</html>\n"
}
