  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Mini Player</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"player-mini-bar\",\n    \"title\": \"Mini Player\",\n    \"summary\": \"A compact player with artwork, title, and transport controls.\",\n    \"description\": \"A compact player with artwork, title, and transport controls.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"player\", \"mini\", \"transport\", \"controls\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Accent\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Persistent playback bars. min-width:0 on the metadata column is required or long track titles will push the controls off screen.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: .8rem; width: 300px; padding: .7rem .9rem; border-radius: 14px;\n      background: #151b2a; border: 1px solid #263149; }\n    .fx .art { width: 44px; height: 44px; border-radius: 9px; background: conic-gradient(from 40deg, #7c5cff, #2dd4bf, #f472b6); flex: none; }\n    .fx .meta { flex: 1; min-width: 0; }\n    .fx .meta b { display: block; font-size: .88rem; }\n    .fx .meta span { font-size: .76rem; color: #8b93a7; }\n    .fx button { width: 34px; height: 34px; border-radius: 50%; border: 0; background: #7c5cff; color: #fff; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"art\"></div><div class=\"meta\"><b>Nightcall</b><span>Kavinsky</span></div>\n  <button type=\"button\" aria-label=\"Pause\">❚❚</button></div>\n</body>\n</html>\n"
