  "ai_usage": "Bento and feature grids. Delegate the pointermove to the grid, then set --x/--y per card relative to each card's own rect inside a single rAF batch.",
  "path": "effects/hover-interactions/cursor-trail-card.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Trail Highlight Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-trail-card\",\n    \"title\": \"Trail Highlight Grid\",\n    \"summary\": \"A shared highlight follows the pointer across a grid of cards.\",\n    \"description\": \"One pointer listener on the grid feeds every card's gradient, so twenty cards cost one event handler.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"grid\"],\n    \"tags\": [\"grid\", \"spotlight\", \"pointer\", \"shared-listener\", \"performance\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"A single pointermove listener on the container updates CSS variables — attaching one per card is the common mistake that makes this pattern janky.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Highlight color\", \"default\": \"rgba(124,92,255,.35)\" }\n    ],\n    \"variations\": [\"Highlight only the hovered card\", \"Colour per card category\", \"Add a border glow as well\"],\n    \"ai_usage\": \"Bento and feature grids. Delegate the pointermove to the grid, then set --x/--y per card relative to each card's own rect inside a single rAF batch.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .grid { display: grid; grid-template-columns: repeat(2, 150px); gap: 10px; }\n    .grid .c { position: relative; height: 110px; border-radius: 14px; background: #141a28; border: 1px solid #232c42;\n      overflow: hidden; display: grid; place-items: center; color: #8b93a7; font-weight: 700; }\n    .grid .c::before { content: \"\"; position: absolute; inset: 0; opacity: 0; transition: opacity .3s;\n      background: radial-gradient(120px circle at var(--x) var(--y), var(--c, rgba(124,92,255,.35)), transparent 70%); }\n    .grid:hover .c::before { opacity: 1; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"grid\" id=\"gr\">\n    <div class=\"c\">API</div><div class=\"c\">Webhooks</div><div class=\"c\">Logs</div><div class=\"c\">Billing</div>\n  </div>\n  <script>\n    (function () {\n      var g = document.getElementById(\"gr\"), cards = [].slice.call(g.querySelectorAll(\".c\"));\n      g.addEventListener(\"pointermove\", function (e) {\n        cards.forEach(function (c) {\n          var r = c.getBoundingClientRect();\n          c.style.setProperty(\"--x\", (e.clientX - r.left) + \"px\");\n          c.style.setProperty(\"--y\", (e.clientY - r.top) + \"px\");\n        });\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
