  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Spinning Vinyl</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"vinyl-record-spin\",\n    \"title\": \"Spinning Vinyl\",\n    \"summary\": \"A record turning under a tonearm.\",\n    \"description\": \"A record turning under a tonearm.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"vinyl\", \"record\", \"spin\", \"turntable\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Rotation period\", \"default\": \"3s\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Music players and DJ tools. Pause the rotation when playback stops — a spinning record over paused audio is a state lie.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 170px; height: 170px; }\n    .fx .disc { width: 100%; height: 100%; border-radius: 50%; animation: spin 3s linear infinite;\n      background: repeating-radial-gradient(circle, #111 0 3px, #1c1c1c 3px 5px); }\n    .fx .disc::after { content: \"\"; position: absolute; inset: 38%; border-radius: 50%;\n      background: linear-gradient(160deg, #f472b6, #7c3aed); }\n    .fx .arm { position: absolute; top: 8px; right: -6px; width: 78px; height: 6px; border-radius: 3px; background: #cbd5e1;\n      transform-origin: right center; rotate: 26deg; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"disc\"></div><div class=\"arm\"></div></div>\n</body>\n</html>\n"
