  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Filter Drop Shadow</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"drop-shadow-filter\",\n    \"title\": \"Filter Drop Shadow\",\n    \"summary\": \"A shadow that follows the element's actual alpha shape.\",\n    \"description\": \"A shadow that follows the element's actual alpha shape. Applied with CSS filters or blend modes, so the underlying content stays live and selectable.\",\n    \"theme\": \"blend-filters\",\n    \"categories\": [\"filter\", \"color\"],\n    \"tags\": [\"filter\", \"css\", \"drop-shadow\", \"alpha\", \"clip-path\", \"shape\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Filters change colour relationships — re-check text contrast after applying one, and never encode meaning in a filtered colour alone.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Shadow colour\", \"default\": \"rgba(124,92,255,.55)\" }\n    ],\n    \"variations\": [\"Animate the filter value on hover\", \"Apply to a whole section with backdrop-filter\"],\n    \"ai_usage\": \"Shadows for clipped or transparent shapes. box-shadow follows the border box; filter: drop-shadow follows the alpha channel, which is what irregular shapes need.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; height: 170px; border-radius: 16px; overflow: hidden; position: relative;\n      background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .8rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .fx { border-radius: 0; background: none;\n      -webkit-mask: none; }\n    .shape { width: 160px; height: 160px; margin: 5px auto; background: conic-gradient(from 45deg, #7c5cff, #2dd4bf, #7c5cff);\n      clip-path: polygon(50% 0, 100% 38%, 82% 100%, 18% 100%, 0 38%);\n      filter: drop-shadow(0 14px 22px rgba(124,92,255,.55)); }\n  </style>\n</head>\n<body>\n  <div><div class=\"demo\"><div class=\"shape\"></div></div><p class=\"label\">Filter Drop Shadow</p></div>\n</body>\n</html>\n"
