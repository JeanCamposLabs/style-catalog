  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Reading Fill</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"text-fill-scroll-progress\",\n    \"title\": \"Reading Fill\",\n    \"summary\": \"Text that fills with colour as you scroll.\",\n    \"description\": \"Text that fills with colour as you scroll.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"typography\"],\n    \"tags\": [\"text\", \"type\", \"scroll\", \"fill\", \"reading\", \"progress\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative duplicates are aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Fill percentage\", \"default\": \"0%\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Long-form intros. Keep the unfilled state readable (a mid-tone, not near-transparent) so the text is legible before the scroll fills it.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n    body { min-height: 200vh; }\n    .wrap { padding: 45vh 1.5rem; }\n    .fx { font-size: 1.6rem; font-weight: 800; max-width: 18ch; line-height: 1.3; color: #2b3450;\n      background: linear-gradient(90deg, #e7ebf3 var(--p, 0%), transparent var(--p, 0%));\n      -webkit-background-clip: text; background-clip: text; }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\"><h2 class=\"fx\" id=\"rf\">Read on, and the words fill in as you go.</h2></div>\n  <script>\n    (function () {\n      var h = document.getElementById(\"rf\");\n      function upd() {\n        var r = h.getBoundingClientRect();\n        var p = Math.min(Math.max((innerHeight - r.top) / (innerHeight * .7), 0), 1);\n        h.style.setProperty(\"--p\", (p * 100).toFixed(1) + \"%\");\n      }\n      addEventListener(\"scroll\", upd, { passive: true }); upd();\n    })();\n  </script>\n</body>\n</html>\n"
}
