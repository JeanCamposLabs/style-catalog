  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Scramble Reveal</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"text-scramble-reveal\",\n    \"title\": \"Scramble Reveal\",\n    \"summary\": \"Letters resolving from random characters.\",\n    \"description\": \"Letters resolving from random characters.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"typography\"],\n    \"tags\": [\"text\", \"type\", \"scramble\", \"reveal\", \"decode\", \"cypher\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative duplicates are aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Resolve duration\", \"default\": \"2s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Decode and unlock moments. Resolve left to right at a steady rate and keep the string length fixed, so the layout never shifts while it settles.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { font-family: ui-monospace, Menlo, monospace; font-size: 1.4rem; font-weight: 700; color: #b9a5ff; letter-spacing: .05em; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" id=\"sc\" aria-label=\"STYLE CATALOG\">STYLE CATALOG</div>\n  <script>\n    (function () {\n      var el = document.getElementById(\"sc\"), target = el.textContent, junk = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ#%&\";\n      if (matchMedia(\"(prefers-reduced-motion: reduce)\").matches) return;\n      function run() {\n        var i = 0;\n        var t = setInterval(function () {\n          el.textContent = target.split(\"\").map(function (ch, k) {\n            if (k < i || ch === \" \") return ch;\n            return junk[Math.floor(Math.random() * junk.length)];\n          }).join(\"\");\n          if (i++ > target.length) clearInterval(t);\n        }, 70);\n      }\n      run(); setInterval(run, 5000);\n    })();\n  </script>\n</body>\n</html>\n"
}
