  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Newton's Cradle</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"pendulum-newton-cradle\",\n    \"title\": \"Newton's Cradle\",\n    \"summary\": \"Swinging spheres transferring momentum.\",\n    \"description\": \"Swinging spheres transferring momentum.\",\n    \"theme\": \"particles-physics\",\n    \"categories\": [\"particles\", \"physics\"],\n    \"tags\": [\"particles\", \"motion\", \"pendulum\", \"cradle\", \"momentum\", \"physics\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Particle fields are decorative and expensive — cap counts, pause when off-screen, and stop entirely under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Swing period\", \"default\": \"1.4s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Idle and waiting states. Only the end spheres move and they must alternate — animating the middle ones destroys the illusion of momentum transfer.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; gap: 2px; height: 150px; align-items: flex-start; }\n    .b { width: 30px; }\n    .b .str { width: 1px; height: 74px; background: #3b465e; margin: 0 auto; transform-origin: top; }\n    .b .ball { width: 28px; height: 28px; border-radius: 50%; background: radial-gradient(circle at 34% 30%, #e2e8f0, #64748b);\n      margin-top: -2px; }\n    .b.l { animation: swl 1.4s ease-in-out infinite; transform-origin: 50% 0; }\n    .b.r { animation: swr 1.4s ease-in-out infinite; transform-origin: 50% 0; }\n    @keyframes swl { 0%, 50%, 100% { transform: rotate(0); } 25% { transform: rotate(-32deg); } }\n    @keyframes swr { 0%, 50%, 100% { transform: rotate(0); } 75% { transform: rotate(32deg); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"b l\"><div class=\"str\"></div><div class=\"ball\"></div></div>\n  <div class=\"b\"><div class=\"str\"></div><div class=\"ball\"></div></div>\n  <div class=\"b\"><div class=\"str\"></div><div class=\"ball\"></div></div>\n  <div class=\"b r\"><div class=\"str\"></div><div class=\"ball\"></div></div></div>\n</body>\n</html>\n"
}
