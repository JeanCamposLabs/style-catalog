  "ai_usage": "Product and feature cards. Multiply the normalized pointer offset by a per-layer depth (0.2 → 1.0) and apply with translate3d; a single shared offset gives a slide, not parallax.",
  "path": "effects/hover-interactions/depth-parallax-card.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Parallax Depth Card</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"depth-parallax-card\",\n    \"title\": \"Parallax Depth Card\",\n    \"summary\": \"Card layers shift by different amounts as the pointer moves.\",\n    \"description\": \"Each layer's translation is scaled by its own depth factor, so foreground elements outrun the background and the card gains real dimension.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"3d\"],\n    \"tags\": [\"parallax\", \"depth\", \"layers\", \"pointer\", \"card\"],\n    \"tech\": [\"css\", \"js\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--max\", \"description\": \"Maximum layer shift\", \"default\": \"18px\" }\n    ],\n    \"variations\": [\"Add a tilt to the whole card\", \"Depth on scroll instead of pointer\", \"Shadow that moves opposite the layers\"],\n    \"ai_usage\": \"Product and feature cards. Multiply the normalized pointer offset by a per-layer depth (0.2 → 1.0) and apply with translate3d; a single shared offset gives a slide, not parallax.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .pcard { position: relative; width: 280px; height: 200px; border-radius: 18px; overflow: hidden;\n      background: linear-gradient(140deg, #1b2338, #10141f); border: 1px solid #263149; }\n    .pcard .layer { position: absolute; inset: 0; display: grid; place-items: center; transition: transform .12s ease-out; }\n    .pcard .glow { background: radial-gradient(circle at 30% 20%, rgba(124,92,255,.5), transparent 60%); }\n    .pcard h3 { margin: 0; font-size: 1.6rem; }\n    .pcard .badge { align-self: start; justify-self: end; margin: 14px; padding: .25rem .6rem; border-radius: 999px;\n      background: #7c5cff; font-size: .75rem; font-weight: 700; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"pcard\" id=\"pc\">\n    <div class=\"layer glow\" data-depth=\".3\" aria-hidden=\"true\"></div>\n    <div class=\"layer\" data-depth=\".7\"><h3>Aurora</h3></div>\n    <div class=\"layer\" data-depth=\"1\"><span class=\"badge\">New</span></div>\n  </div>\n  <script>\n    (function () {\n      var card = document.getElementById(\"pc\"), layers = card.querySelectorAll(\".layer\");\n      card.addEventListener(\"pointermove\", function (e) {\n        var r = card.getBoundingClientRect();\n        var x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;\n        layers.forEach(function (l) {\n          var d = parseFloat(l.dataset.depth);\n          l.style.transform = \"translate3d(\" + (-x * 18 * d) + \"px,\" + (-y * 18 * d) + \"px,0)\";\n        });\n      });\n      card.addEventListener(\"pointerleave\", function () {\n        layers.forEach(function (l) { l.style.transform = \"\"; });\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
