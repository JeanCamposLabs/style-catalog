  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Glass Progress Ring</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"glass-progress-ring\",\n    \"title\": \"Glass Progress Ring\",\n    \"summary\": \"A translucent ring over a colourful backdrop.\",\n    \"description\": \"A translucent ring over a colourful backdrop.\",\n    \"theme\": \"glass-neumorphism\",\n    \"categories\": [\"glass\", \"surface\"],\n    \"tags\": [\"glass\", \"surface\", \"glass\", \"progress\", \"ring\", \"translucent\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Translucent surfaces easily fall below contrast minimums — check text and borders against the busiest part of the backdrop.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Percent complete\", \"default\": \"68\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Progress over imagery. Both the filled and unfilled halves must be translucent white — an opaque track breaks the glass illusion instantly.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    body { background: linear-gradient(140deg, #7c3aed, #0ea5e9); }\n    .fx { position: relative; width: 130px; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center;\n      background: conic-gradient(rgba(255,255,255,.85) calc(var(--p) * 1%), rgba(255,255,255,.22) 0);\n      -webkit-mask: radial-gradient(farthest-side, transparent 66%, #000 67%); mask: radial-gradient(farthest-side, transparent 66%, #000 67%); }\n    .wrap { position: relative; display: grid; place-items: center; }\n    .wrap b { position: absolute; color: #fff; font-size: 1.3rem; font-weight: 900; }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\"><div class=\"fx\" style=\"--p:68\" role=\"img\" aria-label=\"68 percent complete\"></div><b>68%</b></div>\n</body>\n</html>\n"
