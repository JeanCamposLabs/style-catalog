  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Corner Triangle</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"clip-triangle-badge\",\n    \"title\": \"Corner Triangle\",\n    \"summary\": \"A triangular flash in the corner of a card.\",\n    \"description\": \"A triangular flash in the corner of a card. Uses clip-path or mask-image, so the element's box and layout are unaffected by the shape.\",\n    \"theme\": \"masks-clipping\",\n    \"categories\": [\"mask\", \"shape\"],\n    \"tags\": [\"clip-path\", \"mask\", \"corner\", \"triangle\", \"badge\", \"label\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Clipping hides content visually but not from assistive tech — anything fully clipped away should also be removed or aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Flash colour\", \"default\": \"#f472b6\" }\n    ],\n    \"variations\": [\"Animate the shape on hover\", \"Combine with a gradient fill\"],\n    \"ai_usage\": \"Status flashes on cards. A clip-path triangle keeps the label text upright, unlike a rotated ribbon which needs counter-rotation.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .art { width: 210px; height: 210px; background: conic-gradient(from 210deg at 40% 35%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .9rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .card { position: relative; width: 230px; height: 150px; border-radius: 14px; background: #151b2a; border: 1px solid #263149; overflow: hidden; }\n    .card::before { content: \"NEW\"; position: absolute; top: 0; right: 0; width: 92px; height: 92px;\n      background: #f472b6; color: #2a0d1c; font-size: .72rem; font-weight: 800; padding: .4rem .5rem; text-align: right;\n      clip-path: polygon(100% 0, 100% 100%, 0 0); }\n  </style>\n</head>\n<body>\n  <div><div class=\"card\"></div><p class=\"label\">Corner Triangle</p></div>\n</body>\n</html>\n"
