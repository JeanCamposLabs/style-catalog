  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Ping-Pong Bar</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"loader-bar-ping-pong\",\n    \"title\": \"Ping-Pong Bar\",\n    \"summary\": \"A bar bouncing between the track ends.\",\n    \"description\": \"A bar bouncing between the track ends.\",\n    \"theme\": \"loaders-spinners\",\n    \"categories\": [\"loader\", \"spinner\"],\n    \"tags\": [\"loader\", \"waiting\", \"indeterminate\", \"bounce\", \"bar\", \"track\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Pair every indicator with a visually-hidden aria-live status; motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Sweep\", \"default\": \"1.4s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Indeterminate progress in a tight space. An alternate-direction ease reads as searching; a one-way loop reads as slow progress that never completes.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 260px; height: 6px; border-radius: 99px; background: #1b2231; overflow: hidden; }\n    .fx i { display: block; height: 100%; width: 34%; border-radius: 99px; background: #2dd4bf;\n      animation: pong 1.4s cubic-bezier(.65,0,.35,1) infinite alternate; }\n    @keyframes pong { from { transform: translateX(0); } to { transform: translateX(196%); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\" aria-label=\"Loading\"><i></i></div>\n</body>\n</html>\n"
