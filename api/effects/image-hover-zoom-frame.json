  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Contained Zoom</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"image-hover-zoom-frame\",\n    \"title\": \"Contained Zoom\",\n    \"summary\": \"An image scaling inside a fixed frame on hover.\",\n    \"description\": \"An image scaling inside a fixed frame on hover.\",\n    \"theme\": \"images-media\",\n    \"categories\": [\"image\", \"media\"],\n    \"tags\": [\"image\", \"media\", \"zoom\", \"hover\", \"frame\", \"gallery\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative images need empty alt; meaningful ones need real descriptions. Never convey information through a hover-only image treatment.\",\n    \"customization\": [\n      { \"name\": \"--z\", \"description\": \"Zoom scale\", \"default\": \"1.12\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Gallery thumbnails. Overflow hidden on the frame plus a transform on the inner image keeps the card size fixed — scaling the frame itself would reflow the grid.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 260px; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; }\n    .fx .img { width: 100%; height: 100%; background: conic-gradient(from 200deg at 35% 30%, #7c5cff, #2dd4bf, #c2891a, #7c5cff);\n      transition: transform .5s cubic-bezier(.2,.8,.3,1); }\n    .fx:hover .img { transform: scale(1.12); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"img\"></div></div>\n</body>\n</html>\n"
}
