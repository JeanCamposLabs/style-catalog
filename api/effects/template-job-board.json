  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Job Board</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"template-job-board\",\n    \"title\": \"Job Board\",\n    \"summary\": \"Open roles with filters and locations.\",\n    \"description\": \"Open roles with filters and locations.\",\n    \"theme\": \"website-templates\",\n    \"categories\": [\"template\", \"page\"],\n    \"tags\": [\"template\", \"page\", \"jobs\", \"board\", \"filters\", \"careers\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Full pages keep landmark elements (header, nav, main, footer), a single h1, and a visible focus order that matches the layout.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Filter colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Reskin through the custom properties\", \"Swap the copy for your own\"],\n    \"ai_usage\": \"Careers pages. State location and salary band on the card; roles that hide compensation get significantly fewer qualified applicants.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\n    body { padding: 1.4rem; max-width: 34rem; margin: 0 auto; }\n    h1 { margin: 0 0 .3rem; font-size: 1.5rem; }\n    .sub { margin: 0 0 1.1rem; color: #8b93a7; font-size: .88rem; }\n    .filters { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 1rem; }\n    .filters button { padding: .3rem .8rem; border-radius: 99px; border: 1px solid #2b3450; background: transparent;\n      color: #8b93a7; font: inherit; font-size: .78rem; cursor: pointer; }\n    .filters button[aria-pressed=\"true\"] { background: #1e1740; border-color: #7c5cff; color: #b9a5ff; }\n    .job { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .9rem 1rem;\n      border-radius: 12px; background: #151b2a; border: 1px solid #263149; margin-bottom: 8px; }\n    .job b { display: block; font-size: .92rem; }\n    .job span { color: #64748b; font-size: .78rem; }\n    .job a { color: #b9a5ff; text-decoration: none; font-size: .82rem; font-weight: 700; white-space: nowrap; }\n  </style>\n</head>\n<body>\n  <h1>Open roles</h1><p class=\"sub\">Four positions across engineering and design.</p>\n  <div class=\"filters\" role=\"group\" aria-label=\"Filter roles\"><button type=\"button\" aria-pressed=\"true\">All</button>\n  <button type=\"button\" aria-pressed=\"false\">Engineering</button><button type=\"button\" aria-pressed=\"false\">Design</button>\n  <button type=\"button\" aria-pressed=\"false\">Remote</button></div>\n  <main><article class=\"job\"><div><b>Design engineer</b><span>Remote · €70–95k</span></div><a href=\"#\">Apply →</a></article>\n  <article class=\"job\"><div><b>Accessibility specialist</b><span>Lisbon · €60–80k</span></div><a href=\"#\">Apply →</a></article>\n  <article class=\"job\"><div><b>Developer advocate</b><span>Remote · €65–85k</span></div><a href=\"#\">Apply →</a></article></main>\n</body>\n</html>\n"
}
