  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Morphing Icon Button</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"icon-morph-hover\",\n    \"title\": \"Morphing Icon Button\",\n    \"summary\": \"A play icon morphs into a pause icon on hover.\",\n    \"description\": \"Two bars change width, gap, and clip so one shape becomes the other without swapping any SVG paths.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"icon\"],\n    \"tags\": [\"icon\", \"morph\", \"play-pause\", \"transition\", \"media\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Icon color\", \"default\": \"#e7ebf3\" },\n      { \"name\": \"--dur\", \"description\": \"Morph duration\", \"default\": \"0.3s\" }\n    ],\n    \"variations\": [\"Hamburger to close\", \"Plus to minus\", \"Bind to real playback state\"],\n    \"ai_usage\": \"Media controls. Morphing two rectangles by animating width/clip-path is far cheaper and smoother than cross-fading two icons, and it survives colour changes for free.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --c: #e7ebf3; --dur: .3s; }\n    .mor { width: 70px; height: 70px; border-radius: 50%; background: #1b2338; border: 1px solid #2b3450;\n      display: grid; place-items: center; cursor: pointer; }\n    .mor .ico { display: flex; gap: 6px; align-items: center; }\n    .mor .ico i { display: block; width: 8px; height: 26px; background: var(--c);\n      transition: clip-path var(--dur) ease, width var(--dur) ease, transform var(--dur) ease; }\n    .mor .ico i:nth-child(1) { clip-path: polygon(0 0, 100% 22%, 100% 78%, 0 100%); }\n    .mor .ico i:nth-child(2) { clip-path: polygon(0 22%, 100% 50%, 100% 50%, 0 78%); width: 14px; }\n    .mor:hover .ico i, .mor:focus-visible .ico i { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); width: 8px; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <button class=\"mor\" type=\"button\" aria-label=\"Play\"><span class=\"ico\" aria-hidden=\"true\"><i></i><i></i></span></button>\n</body>\n</html>\n"
}
