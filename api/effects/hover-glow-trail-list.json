  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Glow Trail List</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hover-glow-trail-list\",\n    \"title\": \"Glow Trail List\",\n    \"summary\": \"A moving glow that follows the hovered row.\",\n    \"description\": \"A moving glow that follows the hovered row.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"interaction\"],\n    \"tags\": [\"hover\", \"pointer\", \"list\", \"glow\", \"follow\", \"navigation\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover state here is mirrored on :focus-visible so keyboard users get the same information.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Highlight colour\", \"default\": \"#1e2740\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Navigation lists. One shared highlight element that translates between rows is smoother than fading a background on each row, and it costs one node.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .list { position: relative; width: 250px; padding: 4px; border-radius: 14px; background: #10141f; border: 1px solid #263149; }\n    .list .glow { position: absolute; left: 4px; right: 4px; height: 40px; border-radius: 10px; background: #1e2740;\n      transition: transform .28s cubic-bezier(.7,0,.2,1), opacity .2s; opacity: 0; }\n    .list:hover .glow { opacity: 1; }\n    .list a { position: relative; display: flex; align-items: center; height: 40px; padding: 0 .8rem; color: #cbd5e1;\n      text-decoration: none; font-size: .88rem; border-radius: 10px; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <nav class=\"list\" id=\"gl\"><span class=\"glow\"></span><a href=\"#\">Overview</a><a href=\"#\">Specimens</a><a href=\"#\">Themes</a><a href=\"#\">API</a></nav>\n  <script>\n    (function () {\n      var l = document.getElementById(\"gl\"), g = l.querySelector(\".glow\");\n      l.querySelectorAll(\"a\").forEach(function (a, i) {\n        a.addEventListener(\"pointerenter\", function () { g.style.transform = \"translateY(\" + i * 40 + \"px)\"; });\n        a.addEventListener(\"focus\", function () { g.style.transform = \"translateY(\" + i * 40 + \"px)\"; });\n      });\n    })();\n  </script>\n</body>\n</html>\n"
}
