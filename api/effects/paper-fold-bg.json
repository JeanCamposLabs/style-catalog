  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Folded Paper</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"paper-fold-bg\",\n    \"title\": \"Folded Paper\",\n    \"summary\": \"Soft creases divide the surface into folded panels.\",\n    \"description\": \"Alternating light and shadow gradients along fold lines imply a sheet that has been folded and flattened.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"paper\"],\n    \"tags\": [\"fold\", \"paper\", \"crease\", \"texture\", \"subtle\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--paper\", \"description\": \"Paper color\", \"default\": \"#151a26\" },\n      { \"name\": \"--crease\", \"description\": \"Crease strength\", \"default\": \"0.5\" }\n    ],\n    \"variations\": [\"Diagonal folds\", \"Deeper creases for heavier stock\", \"Add grain for realism\"],\n    \"ai_usage\": \"Editorial, packaging, and invitation designs. Fold lines need both a highlight and a shadow immediately adjacent — a single dark line reads as a printed rule, not a crease.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --paper: #151a26; --crease: .5; }\n    .bg { background-color: var(--paper);\n      background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.04) 0 1px, transparent 1px 2px, rgba(0,0,0,.28) 2px 3px, transparent 3px 160px),\n        repeating-linear-gradient(0deg, rgba(255,255,255,.03) 0 1px, transparent 1px 2px, rgba(0,0,0,.22) 2px 3px, transparent 3px 140px); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
