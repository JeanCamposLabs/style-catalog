  "ai_usage": "Success and completion states. Give each piece its own delay, duration, x position, and rotation — shared values make the fall look like a curtain. Mark the confetti layer aria-hidden and keep the message in real text.",
  "path": "effects/text-effects/emoji-rain-text.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Confetti Headline</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"emoji-rain-text\",\n    \"title\": \"Confetti Headline\",\n    \"summary\": \"Confetti falls behind a headline in a self-contained celebration block.\",\n    \"description\": \"Small colored rectangles fall on staggered loops with independent rotation, so the celebration never looks like a repeating tile.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"celebration\"],\n    \"tags\": [\"confetti\", \"celebration\", \"success\", \"particles\", \"stagger\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Fall duration\", \"default\": \"3s\" }\n    ],\n    \"variations\": [\"Burst once on success instead of looping\", \"Brand-colored confetti only\", \"Add a slight horizontal sway\"],\n    \"ai_usage\": \"Success and completion states. Give each piece its own delay, duration, x position, and rotation — shared values make the fall look like a curtain. Mark the confetti layer aria-hidden and keep the message in real text.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: 3s; }\n    .conf { position: relative; padding: 2rem 2.6rem; overflow: hidden; text-align: center; }\n    .conf h1 { position: relative; margin: 0; font-size: clamp(1.6rem, 6vw, 2.6rem); font-weight: 900; }\n    .conf i { position: absolute; top: -14px; width: 8px; height: 14px; border-radius: 2px; opacity: .9;\n      animation: fall var(--d) linear infinite; animation-delay: var(--dl); left: var(--x); background: var(--bg); }\n    @keyframes fall {\n      0% { transform: translateY(0) rotate(0); opacity: 1; }\n      100% { transform: translateY(160px) rotate(540deg); opacity: 0; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"conf\">\n    <i aria-hidden=\"true\" style=\"--x:6%;--d:2.4s;--dl:0s;--bg:#f472b6\"></i>\n    <i aria-hidden=\"true\" style=\"--x:22%;--d:3.1s;--dl:.4s;--bg:#fbbf24\"></i>\n    <i aria-hidden=\"true\" style=\"--x:38%;--d:2.7s;--dl:.9s;--bg:#34d399\"></i>\n    <i aria-hidden=\"true\" style=\"--x:57%;--d:3.4s;--dl:.2s;--bg:#38bdf8\"></i>\n    <i aria-hidden=\"true\" style=\"--x:73%;--d:2.5s;--dl:1.2s;--bg:#a78bfa\"></i>\n    <i aria-hidden=\"true\" style=\"--x:88%;--d:3s;--dl:.7s;--bg:#fb7185\"></i>\n    <h1>Payment complete</h1>\n  </div>\n</body>\n</html>\n"
}
