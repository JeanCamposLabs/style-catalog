tion: transform .35s cubic-bezier(.7,0,.2,1); }\n    .fx .t { clip-path: inset(0 0 50% 0); }\n    .fx .b { position: absolute; inset: 0; padding: .5rem .2rem; clip-path: inset(50% 0 0 0); color: #2dd4bf; }\n    .fx:hover .t { transform: translateX(-6px); }\n    .fx:hover .b { transform: translateX(6px); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <a class=\"fx\" href=\"#\"><span class=\"t\">Explore</span><span class=\"b\">Explore</span></a>\n</body>\n</html>\n"
