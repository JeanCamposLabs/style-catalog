  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Cube Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"loader-cube-grid\",\n    \"title\": \"Cube Grid\",\n    \"summary\": \"A 3×3 grid pulsing in a diagonal wave.\",\n    \"description\": \"A 3×3 grid pulsing in a diagonal wave.\",\n    \"theme\": \"loaders-spinners\",\n    \"categories\": [\"loader\", \"spinner\"],\n    \"tags\": [\"loader\", \"waiting\", \"grid\", \"cubes\", \"wave\", \"stagger\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Pair every indicator with a visually-hidden aria-live status; motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Wave\", \"default\": \"1.3s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Data and dashboard contexts. Delay by row + column so the pulse travels diagonally; a linear index delay produces a row-by-row sweep instead.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; grid-template-columns: repeat(3, 18px); gap: 4px; }\n    .fx i { width: 18px; height: 18px; background: #7c5cff; animation: scale 1.3s ease-in-out infinite;\n      animation-delay: calc((var(--r) + var(--c)) * .12s); }\n    @keyframes scale { 0%, 70%, 100% { transform: scale(.4); opacity: .4; } 35% { transform: scale(1); opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\" aria-label=\"Loading\">\n    <i style=\"--r:0;--c:0\"></i><i style=\"--r:0;--c:1\"></i><i style=\"--r:0;--c:2\"></i>\n    <i style=\"--r:1;--c:0\"></i><i style=\"--r:1;--c:1\"></i><i style=\"--r:1;--c:2\"></i>\n    <i style=\"--r:2;--c:0\"></i><i style=\"--r:2;--c:1\"></i><i style=\"--r:2;--c:2\"></i></div>\n</body>\n</html>\n"
