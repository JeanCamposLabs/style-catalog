  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Composition State</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"ime-composition-state\",\n    \"title\": \"Composition State\",\n    \"summary\": \"Text mid-composition in an input method.\",\n    \"description\": \"Text mid-composition in an input method.\",\n    \"theme\": \"keyboard-input\",\n    \"categories\": [\"keyboard\", \"input\"],\n    \"tags\": [\"keyboard\", \"shortcut\", \"ime\", \"composition\", \"input-method\", \"i18n\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Shortcut hints must reflect the user's platform, and no action should be reachable only by a shortcut.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Composition colour\", \"default\": \"#b9a5ff\" }\n    ],\n    \"variations\": [\"Reskin through the custom properties\", \"Swap the copy for your own\"],\n    \"ai_usage\": \"International input. Never handle keydown for text logic — listen for compositionstart/end, or every CJK user's input will be mangled mid-composition.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; }\n    .fx .field { padding: .75rem .9rem; border-radius: 12px; border: 1px solid #7c5cff; background: #151b2a; color: #e7ebf3;\n      font-size: 1rem; }\n    .fx .comp { border-bottom: 2px dotted #b9a5ff; color: #b9a5ff; }\n    .fx .cands { display: flex; gap: .4rem; margin-top: .5rem; }\n    .fx .cands span { padding: .25rem .6rem; border-radius: 7px; background: #1c2437; color: #cbd5e1; font-size: .82rem; }\n    .fx .cands span:first-child { background: #7c5cff; color: #fff; }\n    .fx .note { margin-top: .6rem; color: #64748b; font-size: .74rem; line-height: 1.5; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"field\">検索<span class=\"comp\">かたろぐ</span></div>\n  <div class=\"cands\"><span>カタログ</span><span>катаlog</span><span>型録</span></div>\n  <p class=\"note\">Dotted underline marks uncommitted text; candidates appear below.</p></div>\n</body>\n</html>\n"
