olute; bottom: 0; background: #06010f; box-shadow: 0 0 22px rgba(168,85,247,.5); }\n    .fx .w { position: absolute; width: 3px; height: 3px; background: #fbbf24; box-shadow: 0 0 5px #fbbf24; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\">\n    <span class=\"b\" style=\"left:8%;width:38px;height:90px\"></span><span class=\"b\" style=\"left:26%;width:28px;height:130px\"></span>\n    <span class=\"b\" style=\"left:44%;width:44px;height:70px\"></span><span class=\"b\" style=\"left:66%;width:32px;height:112px\"></span>\n    <span class=\"b\" style=\"left:84%;width:36px;height:84px\"></span>\n    <span class=\"w\" style=\"left:14%;bottom:60px\"></span><span class=\"w\" style=\"left:30%;bottom:100px\"></span>\n    <span class=\"w\" style=\"left:52%;bottom:40px\"></span><span class=\"w\" style=\"left:72%;bottom:80px\"></span>\n  </div>\n</body>\n</html>\n"
