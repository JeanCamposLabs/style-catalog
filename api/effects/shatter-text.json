  "ai_usage": "Destructive or dramatic moments — deletions, resets, errors. Give each letter its own --x/--y/--r values (hand-picked, not uniform) or the shatter looks like a symmetric bloom.",
  "path": "effects/text-effects/shatter-text.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Shattering Letters</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"shatter-text\",\n    \"title\": \"Shattering Letters\",\n    \"summary\": \"Characters scatter outward and fall away, then reassemble.\",\n    \"description\": \"Per-letter translate, rotate, and fade on staggered delays reads as debris; the reverse half of the loop puts the word back together.\",\n    \"theme\": \"text-effects\",\n    \"categories\": [\"text\", \"animation\"],\n    \"tags\": [\"shatter\", \"explode\", \"letters\", \"stagger\", \"dramatic\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Keep the real text in the DOM so it stays selectable and readable by assistive tech; decorative layers use aria-hidden. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Full cycle\", \"default\": \"3s\" }\n    ],\n    \"variations\": [\"Shatter on click instead of a loop\", \"Gravity: bias every letter downward\", \"Blur pieces as they leave\"],\n    \"ai_usage\": \"Destructive or dramatic moments — deletions, resets, errors. Give each letter its own --x/--y/--r values (hand-picked, not uniform) or the shatter looks like a symmetric bloom.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: 3s; }\n    .shat { font-size: clamp(2rem, 8vw, 3.6rem); font-weight: 900; display: flex; }\n    .shat span { display: inline-block; animation: shat var(--dur) ease-in-out infinite; animation-delay: calc(var(--i) * .04s); }\n    @keyframes shat {\n      0%, 30% { transform: none; opacity: 1; }\n      60% { transform: translate(var(--x), var(--y)) rotate(var(--r)); opacity: 0; }\n      80% { transform: translate(var(--x), var(--y)) rotate(var(--r)); opacity: 0; }\n      100% { transform: none; opacity: 1; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <h1 class=\"shat\" aria-label=\"Shatter\">\n    <span aria-hidden=\"true\" style=\"--i:0;--x:-40px;--y:-30px;--r:-28deg\">S</span><span aria-hidden=\"true\" style=\"--i:1;--x:24px;--y:-46px;--r:18deg\">h</span><span aria-hidden=\"true\" style=\"--i:2;--x:-18px;--y:40px;--r:32deg\">a</span><span aria-hidden=\"true\" style=\"--i:3;--x:44px;--y:26px;--r:-14deg\">t</span><span aria-hidden=\"true\" style=\"--i:4;--x:-52px;--y:12px;--r:22deg\">t</span><span aria-hidden=\"true\" style=\"--i:5;--x:12px;--y:-52px;--r:-36deg\">e</span><span aria-hidden=\"true\" style=\"--i:6;--x:38px;--y:38px;--r:26deg\">r</span>\n  </h1>\n</body>\n</html>\n"
}
