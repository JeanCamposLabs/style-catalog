  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>XP Bar</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"xp-level-bar\",\n    \"title\": \"XP Bar\",\n    \"summary\": \"An experience bar with level badges at both ends.\",\n    \"description\": \"An experience bar with level badges at both ends.\",\n    \"theme\": \"game-ui\",\n    \"categories\": [\"game\", \"ui\"],\n    \"tags\": [\"game\", \"hud\", \"xp\", \"level\", \"progression\", \"rpg\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Game HUDs still need real semantics: use progressbar roles for meters and buttons for slots so the interface is operable without sight.\",\n    \"customization\": [\n      { \"name\": \"--xp\", \"description\": \"Progress percent\", \"default\": \"64\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Progression systems. Show the next level as a dimmed target so players see what they are working toward, not just how far they have come.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: flex; align-items: center; gap: .6rem; width: 290px; }\n    .fx .lv { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; font-weight: 900; font-size: .8rem;\n      background: linear-gradient(160deg, #fbbf24, #b45309); color: #2a1a02; flex: none; }\n    .fx .track { flex: 1; height: 10px; border-radius: 99px; background: #1f2937; overflow: hidden; }\n    .fx .track i { display: block; height: 100%; width: calc(var(--xp) * 1%);\n      background: linear-gradient(90deg, #38bdf8, #a855f7); box-shadow: 0 0 12px rgba(168,85,247,.6); }\n    .fx .next { opacity: .45; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" style=\"--xp:64\"><span class=\"lv\">7</span>\n  <div class=\"track\" role=\"progressbar\" aria-valuenow=\"64\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-label=\"Experience to level 8\"><i></i></div>\n  <span class=\"lv next\">8</span></div>\n</body>\n</html>\n"
