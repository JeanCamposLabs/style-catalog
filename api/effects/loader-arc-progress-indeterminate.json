  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Sweeping Arc</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"loader-arc-progress-indeterminate\",\n    \"title\": \"Sweeping Arc\",\n    \"summary\": \"An arc that grows, sweeps, and shrinks.\",\n    \"description\": \"An arc that grows, sweeps, and shrinks.\",\n    \"theme\": \"loaders-spinners\",\n    \"categories\": [\"loader\", \"spinner\"],\n    \"tags\": [\"loader\", \"waiting\", \"arc\", \"sweep\", \"breathing\", \"spinner\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Pair every indicator with a visually-hidden aria-live status; motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Spin period\", \"default\": \"1s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Long waits. Layering a slow secondary animation onto a fast spin keeps a long-running spinner from feeling frozen in place.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 72px; aspect-ratio: 1; border-radius: 50%; border: 5px solid #1b2231; border-top-color: #c2891a;\n      animation: spin 1s linear infinite, grow 2.4s ease-in-out infinite; }\n    @keyframes spin { to { transform: rotate(1turn); } }\n    @keyframes grow { 0%, 100% { border-width: 5px; } 50% { border-width: 9px; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\" aria-label=\"Loading\"></div>\n</body>\n</html>\n"
