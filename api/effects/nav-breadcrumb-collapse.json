  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Collapsing Breadcrumb</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"nav-breadcrumb-collapse\",\n    \"title\": \"Collapsing Breadcrumb\",\n    \"summary\": \"A long trail that folds its middle.\",\n    \"description\": \"A long trail that folds its middle.\",\n    \"theme\": \"navigation-menus\",\n    \"categories\": [\"navigation\", \"menu\"],\n    \"tags\": [\"navigation\", \"menu\", \"breadcrumb\", \"collapse\", \"overflow\", \"deep\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Navigation must be keyboard-operable: disclosure widgets manage aria-expanded, and the current page carries aria-current.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Link colour\", \"default\": \"#8b93a7\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Deep hierarchies on narrow screens. Always keep the root and the current page visible and collapse the middle behind a button that expands the hidden crumbs.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx ol { display: flex; align-items: center; gap: .4rem; list-style: none; margin: 0; padding: 0; font-size: .85rem; }\n    .fx a { color: #8b93a7; text-decoration: none; }\n    .fx a:hover { color: #e7ebf3; }\n    .fx li + li::before { content: \"/\"; margin-right: .4rem; color: #3b465e; }\n    .fx .more { padding: .1rem .45rem; border-radius: 6px; background: #1e2740; color: #cbd5e1; border: 0; cursor: pointer; font: inherit; font-size: .78rem; }\n    .fx [aria-current] { color: #e7ebf3; font-weight: 600; }\n  </style>\n</head>\n<body>\n  <nav class=\"fx\" aria-label=\"Breadcrumb\"><ol><li><a href=\"#\">Catalog</a></li>\n  <li><button class=\"more\" type=\"button\" aria-label=\"Show 3 hidden levels\">…</button></li>\n  <li><a href=\"#\">Buttons</a></li><li><span aria-current=\"page\">Ripple</span></li></ol></nav>\n</body>\n</html>\n"
