  "path": "effects/buttons/liquid-fill-button.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Liquid Fill Button</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"liquid-fill-button\",\n    \"title\": \"Liquid Fill Button\",\n    \"summary\": \"A wave of color rises to fill the button from the bottom.\",\n    \"description\": \"A pseudo-element with a wavy top edge translates upward on hover, so the fill reads as liquid rather than a bar.\",\n    \"theme\": \"buttons\",\n    \"categories\": [\"button\", \"fill\"],\n    \"tags\": [\"liquid\", \"fill\", \"wave\", \"hover\", \"playful\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use a real <button>; keep a visible :focus-visible ring and never rely on hover alone to convey state. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Liquid color\", \"default\": \"#38bdf8\" },\n      { \"name\": \"--dur\", \"description\": \"Fill duration\", \"default\": \"0.5s\" }\n    ],\n    \"variations\": [\"Drain on mouse-out\", \"Two-tone liquid\", \"Use as a progress-bearing submit button\"],\n    \"ai_usage\": \"Playful primary actions. The wave crest is a border-radius trick on an oversized rotating circle; keep overflow hidden on the button and put the label above the fill with position:relative.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    button { font: inherit; cursor: pointer; border: 0; }\n    button:focus-visible { outline: 2px solid #7c5cff; outline-offset: 3px; }\n    :root { --c: #38bdf8; --dur: .5s; }\n    .liq { position: relative; overflow: hidden; padding: .95rem 2.2rem; border-radius: 12px;\n      background: #151b2a; color: #e7ebf3; font-weight: 700; border: 1px solid #263149; isolation: isolate; }\n    .liq span { position: relative; z-index: 2; }\n    .liq::before { content: \"\"; position: absolute; left: -20%; right: -20%; top: 100%; height: 260%;\n      background: var(--c); border-radius: 45%; transition: transform var(--dur) cubic-bezier(.4,0,.2,1); }\n    .liq:hover::before { transform: translateY(-96%) rotate(6deg); }\n    .liq:hover { color: #06202e; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <button class=\"liq\" type=\"button\"><span>Fill me</span></button>\n</body>\n</html>\n"
}
