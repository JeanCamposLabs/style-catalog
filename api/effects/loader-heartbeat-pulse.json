  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Heartbeat</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"loader-heartbeat-pulse\",\n    \"title\": \"Heartbeat\",\n    \"summary\": \"A pulse with the double-beat rhythm of a heart.\",\n    \"description\": \"A pulse with the double-beat rhythm of a heart.\",\n    \"theme\": \"loaders-spinners\",\n    \"categories\": [\"loader\", \"spinner\"],\n    \"tags\": [\"loader\", \"waiting\", \"heartbeat\", \"pulse\", \"health\", \"rhythm\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Pair every indicator with a visually-hidden aria-live status; motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Heart colour\", \"default\": \"#d1478c\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Health and monitoring products. The double beat (strong then weaker) is what distinguishes a heartbeat from a generic pulse.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 54px; height: 54px; background: #d1478c; transform: rotate(-45deg);\n      animation: beat 1.4s ease-in-out infinite; position: relative; }\n    .fx::before, .fx::after { content: \"\"; position: absolute; width: 54px; height: 54px; border-radius: 50%; background: #d1478c; }\n    .fx::before { top: -27px; left: 0; }\n    .fx::after { top: 0; left: 27px; }\n    @keyframes beat { 0%, 100% { transform: rotate(-45deg) scale(1); } 15% { transform: rotate(-45deg) scale(1.18); }\n      30% { transform: rotate(-45deg) scale(1); } 45% { transform: rotate(-45deg) scale(1.12); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"status\" aria-label=\"Live\"></div>\n</body>\n</html>\n"
