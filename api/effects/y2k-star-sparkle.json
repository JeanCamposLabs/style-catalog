  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Y2K Sparkles</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"y2k-star-sparkle\",\n    \"title\": \"Y2K Sparkles\",\n    \"summary\": \"Four-pointed sparkles twinkling over a gradient.\",\n    \"description\": \"Four-pointed sparkles twinkling over a gradient.\",\n    \"theme\": \"brutalism-y2k\",\n    \"categories\": [\"brutalism\", \"y2k\"],\n    \"tags\": [\"brutalism\", \"raw\", \"sparkle\", \"star\", \"twinkle\", \"glam\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2000s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Deliberately raw does not mean inaccessible: keep contrast, focus states, and hit areas intact.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Twinkle period\", \"default\": \"1.8s\" }\n    ],\n    \"variations\": [\"Retune the palette via the custom properties\", \"Slow the motion for an ambient version\"],\n    \"ai_usage\": \"Y2K and glam branding. The four-point star clip-path with concave sides is the era-correct sparkle — a five-point star reads as a rating.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 260px; height: 150px; border-radius: 16px; overflow: hidden;\n      background: linear-gradient(135deg, #f0abfc, #818cf8); }\n    .fx i { position: absolute; width: 18px; height: 18px; background: #fff;\n      clip-path: polygon(50% 0, 60% 40%, 100% 50%, 60% 60%, 50% 100%, 40% 60%, 0 50%, 40% 40%);\n      animation: tw 1.8s ease-in-out infinite; animation-delay: var(--dl); }\n    @keyframes tw { 0%, 100% { transform: scale(.4); opacity: .3; } 50% { transform: scale(1); opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><i style=\"left:14%;top:22%;--dl:0s\"></i><i style=\"left:64%;top:16%;--dl:.5s\"></i>\n  <i style=\"left:38%;top:62%;--dl:.9s\"></i><i style=\"left:82%;top:66%;--dl:1.3s\"></i></div>\n</body>\n</html>\n"
