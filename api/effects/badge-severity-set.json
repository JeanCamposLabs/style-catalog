ze: .78rem; font-weight: 700; }\n    .info { background: rgba(56,189,248,.14); color: #38bdf8; }\n    .low { background: rgba(52,211,153,.14); color: #34d399; }\n    .med { background: rgba(251,191,36,.14); color: #fbbf24; }\n    .high { background: rgba(248,113,113,.14); color: #f87171; }\n  </style>\n</head>\n<body>\n  <div class=\"row\"><span class=\"b info\"><span aria-hidden=\"true\">ⓘ</span>Info</span><span class=\"b low\"><span aria-hidden=\"true\">▽</span>Low</span>\n  <span class=\"b med\"><span aria-hidden=\"true\">△</span>Medium</span><span class=\"b high\"><span aria-hidden=\"true\">■</span>High</span></div>\n</body>\n</html>\n"
