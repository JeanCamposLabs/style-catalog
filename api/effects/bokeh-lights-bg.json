  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Bokeh Lights</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"bokeh-lights-bg\",\n    \"title\": \"Bokeh Lights\",\n    \"summary\": \"Out-of-focus light circles drift at different depths.\",\n    \"description\": \"Blur and opacity scale with each circle's size, so the smaller, sharper lights read as nearer than the large soft ones.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"ambient\"],\n    \"tags\": [\"bokeh\", \"blur\", \"lights\", \"depth\", \"ambient\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Light A\", \"default\": \"#7c5cff\" },\n      { \"name\": \"--b\", \"description\": \"Light B\", \"default\": \"#2dd4bf\" },\n      { \"name\": \"--dur\", \"description\": \"Drift period\", \"default\": \"18s\" }\n    ],\n    \"variations\": [\"Warm party palette\", \"Faster drift for energy\", \"Mask to the hero area only\"],\n    \"ai_usage\": \"Warm, premium hero backdrops. Vary blur, size, and speed together — uniform blur across all circles flattens the depth illusion instantly.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --a: #7c5cff; --b: #2dd4bf; --dur: 18s; }\n    .bg { background: radial-gradient(circle at 30% 20%, #171029, #0b0d12 60%); overflow: hidden; }\n    .bg i { position: absolute; border-radius: 50%; filter: blur(var(--bl)); opacity: .5;\n      animation: float var(--dur) ease-in-out infinite alternate; animation-delay: var(--d); }\n    @keyframes float { from { transform: translate(0, 0) scale(1); } to { transform: translate(40px, -30px) scale(1.15); } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bg\">\n    <i style=\"left:10%;top:20%;width:180px;height:180px;background:#7c5cff;--bl:40px;--d:0s\"></i>\n    <i style=\"left:60%;top:12%;width:110px;height:110px;background:#2dd4bf;--bl:22px;--d:-4s\"></i>\n    <i style=\"left:74%;top:58%;width:220px;height:220px;background:#f472b6;--bl:56px;--d:-9s\"></i>\n    <i style=\"left:24%;top:66%;width:80px;height:80px;background:#38bdf8;--bl:14px;--d:-13s\"></i>\n  </div>\n</body>\n</html>\n"
}
