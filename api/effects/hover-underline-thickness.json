  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Growing Underline</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hover-underline-thickness\",\n    \"title\": \"Growing Underline\",\n    \"summary\": \"An underline that thickens rather than sliding.\",\n    \"description\": \"An underline that thickens rather than sliding.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"interaction\"],\n    \"tags\": [\"hover\", \"pointer\", \"underline\", \"thickness\", \"native\", \"link\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover state here is mirrored on :focus-visible so keyboard users get the same information.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Underline colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Body links. The native text-decoration properties are now animatable and skip descenders correctly — a pseudo-element underline cannot do either.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { font-size: 1.2rem; color: #e7ebf3; text-decoration: none; text-decoration-line: underline;\n      text-decoration-color: #7c5cff; text-underline-offset: 4px; text-decoration-thickness: 2px;\n      transition: text-decoration-thickness .2s, text-underline-offset .2s; }\n    .fx:hover, .fx:focus-visible { text-decoration-thickness: 6px; text-underline-offset: 3px; }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <a class=\"fx\" href=\"#\">A native animated underline</a>\n</body>\n</html>\n"
