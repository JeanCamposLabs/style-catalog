  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Equalizer Bands</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"eq-sliders-band\",\n    \"title\": \"Equalizer Bands\",\n    \"summary\": \"A five-band EQ with a curve overlay.\",\n    \"description\": \"A five-band EQ with a curve overlay.\",\n    \"theme\": \"audio-music-ui\",\n    \"categories\": [\"audio\", \"music\"],\n    \"tags\": [\"audio\", \"player\", \"equalizer\", \"bands\", \"eq\", \"mixer\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Audio controls need real button semantics and state labels; a play/pause icon swap must also swap the accessible name.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Knob colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Retheme through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Audio settings. Label the frequency of every band — an unlabelled EQ is a row of meaningless sliders.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; display: flex; gap: 14px; align-items: flex-end; padding: 1rem; border-radius: 14px;\n      background: #151b2a; border: 1px solid #263149; }\n    .band { width: 8px; height: 110px; border-radius: 99px; background: #22304a; position: relative; }\n    .band i { position: absolute; left: 50%; translate: -50% 50%; bottom: calc(var(--v) * 1%); width: 22px; height: 10px;\n      border-radius: 3px; background: #7c5cff; }\n    .lbl { position: absolute; left: 0; right: 0; bottom: 4px; display: flex; justify-content: space-around;\n      font-size: .62rem; color: #64748b; font-family: ui-monospace, monospace; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" role=\"group\" aria-label=\"Equalizer\">\n    <div class=\"band\" style=\"--v:40\"><i></i></div><div class=\"band\" style=\"--v:70\"><i></i></div>\n    <div class=\"band\" style=\"--v:55\"><i></i></div><div class=\"band\" style=\"--v:80\"><i></i></div>\n    <div class=\"band\" style=\"--v:35\"><i></i></div>\n    <div class=\"lbl\"><span>60</span><span>250</span><span>1k</span><span>4k</span><span>12k</span></div></div>\n</body>\n</html>\n"
