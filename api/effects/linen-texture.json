  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Linen Weave</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"linen-texture\",\n    \"title\": \"Linen Weave\",\n    \"summary\": \"A fine woven cloth texture.\",\n    \"description\": \"A fine woven cloth texture. Built from tiled CSS gradients on a single element, so it scales to any size without an image request.\",\n    \"theme\": \"patterns-textures\",\n    \"categories\": [\"pattern\", \"background\"],\n    \"tags\": [\"pattern\", \"css-only\", \"tileable\", \"linen\", \"cloth\", \"fabric\", \"texture\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Purely decorative. Keep pattern contrast low behind text, and avoid high-frequency stripes that can trigger visual discomfort.\",\n    \"customization\": [\n      { \"name\": \"--a\", \"description\": \"Thread colour\", \"default\": \"rgba(255,255,255,.035)\" },\n      { \"name\": \"--s\", \"description\": \"Weave pitch\", \"default\": \"5px\" }\n    ],\n    \"variations\": [\"Recolour via the custom properties\", \"Scale the tile with --s\"],\n    \"ai_usage\": \"Card and panel surfaces that need tactility. Keep the alpha very low (3–5%) — visible weave lines look like a bug at large sizes.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --a: rgba(255,255,255,.035); --s: 5px; }\n    .bg { background-color: #1a1f2b;\n      background-image: repeating-linear-gradient(0deg, var(--a) 0 1px, transparent 1px var(--s)),\n        repeating-linear-gradient(90deg, var(--a) 0 1px, transparent 1px var(--s)); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
}
