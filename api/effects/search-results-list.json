  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Result List</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"search-results-list\",\n    \"title\": \"Result List\",\n    \"summary\": \"Results with matched-term highlighting and metadata.\",\n    \"description\": \"Results with matched-term highlighting and metadata.\",\n    \"theme\": \"search-ui\",\n    \"categories\": [\"search\", \"filter\"],\n    \"tags\": [\"search\", \"find\", \"results\", \"highlight\", \"metadata\", \"list\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Result counts belong in an aria-live region; filter groups need fieldset/legend so their scope is announced.\",\n    \"customization\": [\n      { \"name\": \"--hl\", \"description\": \"Highlight colour\", \"default\": \"#b9a5ff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Search results. Highlight the matched substring so users see why each result appeared, and escape the query before injecting it as markup.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; }\n    .fx .count { font-size: .78rem; color: #8b93a7; margin-bottom: .7rem; }\n    .fx .r { padding: .6rem .8rem; border-radius: 10px; margin-bottom: 6px; background: #151b2a; border: 1px solid #263149; }\n    .fx .r:hover { border-color: #7c5cff; }\n    .fx b { display: block; font-size: .9rem; }\n    .fx mark { background: transparent; color: #b9a5ff; font-weight: 700; }\n    .fx p { margin: .15rem 0 .3rem; color: #8b93a7; font-size: .8rem; line-height: 1.4; }\n    .fx .meta { display: flex; gap: .5rem; font-size: .72rem; color: #64748b; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"count\" role=\"status\">14 results for “ripple”</div>\n  <div class=\"r\"><b><mark>Ripple</mark> Button</b><p>A material-style <mark>ripple</mark> that starts at the pointer.</p>\n  <div class=\"meta\"><span>Buttons</span><span>CSS + JS</span></div></div>\n  <div class=\"r\"><b>Water <mark>Ripple</mark>s</b><p>Expanding rings on a dark pool.</p>\n  <div class=\"meta\"><span>Backgrounds</span><span>CSS</span></div></div></div>\n</body>\n</html>\n"
