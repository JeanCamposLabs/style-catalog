  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Temperature Scale</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"temperature-gradient-bar\",\n    \"title\": \"Temperature Scale\",\n    \"summary\": \"A colour scale from cold to hot with a marker.\",\n    \"description\": \"A colour scale from cold to hot with a marker.\",\n    \"theme\": \"weather-ambient\",\n    \"categories\": [\"weather\", \"ambient\"],\n    \"tags\": [\"weather\", \"ambient\", \"temperature\", \"scale\", \"gradient\", \"legend\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Flashing weather effects (lightning) can be a seizure risk — keep flashes infrequent, low-contrast, and disabled under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--p\", \"description\": \"Marker position\", \"default\": \"62\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Slow it down for an ambient version\"],\n    \"ai_usage\": \"Weather and data legends. Always label the ends: a colour ramp without numbers cannot be read accurately by anyone.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; }\n    .fx .bar { height: 14px; border-radius: 99px; background: linear-gradient(90deg, #38bdf8, #22c55e, #fbbf24, #ef4444); position: relative; }\n    .fx .pin { position: absolute; top: -5px; left: calc(var(--p) * 1%); translate: -50% 0; width: 5px; height: 24px;\n      border-radius: 3px; background: #fff; box-shadow: 0 0 0 2px #0b0d12; }\n    .fx .lb { display: flex; justify-content: space-between; margin-top: .5rem; font-size: .75rem; color: #8b93a7; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" style=\"--p:62\"><div class=\"bar\" role=\"img\" aria-label=\"18 degrees, mild\"><span class=\"pin\"></span></div>\n  <div class=\"lb\"><span>-10°</span><span>0°</span><span>20°</span><span>40°</span></div></div>\n</body>\n</html>\n"
