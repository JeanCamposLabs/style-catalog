  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Tiled Wallpaper</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"tiled-background-page\",\n    \"title\": \"Tiled Wallpaper\",\n    \"summary\": \"The repeating background-image page style.\",\n    \"description\": \"The repeating background-image page style.\",\n    \"theme\": \"retro-web\",\n    \"categories\": [\"retro\", \"nostalgia\"],\n    \"tags\": [\"retro\", \"nostalgia\", \"wallpaper\", \"tiled\", \"background\", \"90s\"],\n    \"tech\": [\"css\"],\n    \"era\": \"1990s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"These recreate deprecated tags accessibly: motion respects prefers-reduced-motion and nothing depends on blinking to be readable.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Wallpaper colour\", \"default\": \"#202060\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Personal-page pastiche. Recreate the tile with CSS gradients rather than a GIF — same look, no request, and it scales on high-DPI screens.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 290px; height: 180px; border: 3px ridge #c0c0c0; padding: 1rem; color: #fff;\n      font-family: \"Times New Roman\", serif; text-shadow: 2px 2px 0 #000;\n      background-color: #202060;\n      background-image: radial-gradient(circle at 8px 8px, rgba(255,255,255,.28) 0 3px, transparent 4px),\n        repeating-linear-gradient(45deg, rgba(255,255,255,.06) 0 8px, transparent 8px 16px);\n      background-size: 24px 24px, 32px 32px; }\n    .fx h3 { margin: 0 0 .5rem; font-size: 1.2rem; }\n    .fx p { margin: 0; font-size: .85rem; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><h3>Welcome to my homepage!</h3><p>Best viewed in 800×600.</p></div>\n</body>\n</html>\n"
