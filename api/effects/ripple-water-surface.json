  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Water Ripples</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"ripple-water-surface\",\n    \"title\": \"Water Ripples\",\n    \"summary\": \"Expanding rings spread from three points on a dark pool.\",\n    \"description\": \"Each ripple scales up while its border thins and fades, matching how a real ripple loses energy as it spreads.\",\n    \"theme\": \"backgrounds\",\n    \"categories\": [\"background\", \"water\"],\n    \"tags\": [\"ripple\", \"water\", \"rings\", \"expand\", \"ambient\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative surface — keep contrast with foreground text above 4.5:1 and disable drift under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Ripple color\", \"default\": \"rgba(125,211,252,.4)\" },\n      { \"name\": \"--dur\", \"description\": \"Ripple lifetime\", \"default\": \"4s\" }\n    ],\n    \"variations\": [\"Ripple on click at the pointer\", \"Warmer colour for lava\", \"Fewer, larger ripples\"],\n    \"ai_usage\": \"Calm, meditative sections and water themes. Fade the border-width as well as the opacity while scaling — constant stroke width makes the ring look like a growing circle instead of a wave.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .bg { position: fixed; inset: 0; }\n    :root { --c: rgba(125,211,252,.4); --dur: 4s; }\n    .bg { background: radial-gradient(ellipse at 50% 60%, #08202e, #050b12 70%); overflow: hidden; }\n    .bg i { position: absolute; width: 40px; height: 40px; border-radius: 50%; border: 3px solid var(--c);\n      animation: spread var(--dur) ease-out infinite; animation-delay: var(--dl); }\n    @keyframes spread {\n      0% { transform: scale(.2); opacity: 1; border-width: 4px; }\n      100% { transform: scale(9); opacity: 0; border-width: 1px; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bg\">\n    <i style=\"left:22%;top:34%;--dl:0s\"></i>\n    <i style=\"left:64%;top:52%;--dl:1.3s\"></i>\n    <i style=\"left:44%;top:72%;--dl:2.6s\"></i>\n  </div>\n</body>\n</html>\n"
}
