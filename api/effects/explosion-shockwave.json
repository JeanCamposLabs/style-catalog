  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Shockwave</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"explosion-shockwave\",\n    \"title\": \"Shockwave\",\n    \"summary\": \"An expanding ring with debris.\",\n    \"description\": \"An expanding ring with debris.\",\n    \"theme\": \"particles-physics\",\n    \"categories\": [\"particles\", \"physics\"],\n    \"tags\": [\"particles\", \"motion\", \"explosion\", \"shockwave\", \"impact\", \"burst\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Particle fields are decorative and expensive — cap counts, pause when off-screen, and stop entirely under reduced motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Wave period\", \"default\": \"1.8s\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Impact and error moments. Thinning the ring's border as it expands is what conveys losing energy; constant stroke width reads as a growing circle.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 200px; height: 200px; display: grid; place-items: center; }\n    .fx .ring { position: absolute; width: 40px; height: 40px; border-radius: 50%; border: 3px solid #c2891a;\n      animation: wave 1.8s cubic-bezier(0,.4,.6,1) infinite; }\n    .fx i { position: absolute; width: 6px; height: 6px; border-radius: 50%; background: #d1478c;\n      animation: deb 1.8s ease-out infinite; }\n    @keyframes wave { 0% { transform: scale(.3); opacity: 1; border-width: 6px; } 100% { transform: scale(4); opacity: 0; border-width: 1px; } }\n    @keyframes deb { 0% { transform: translate(0,0); opacity: 1; } 100% { transform: translate(var(--x), var(--y)); opacity: 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><span class=\"ring\"></span><i style=\"--x:-56px;--y:-40px\"></i><i style=\"--x:48px;--y:-52px\"></i>\n  <i style=\"--x:-44px;--y:48px\"></i><i style=\"--x:60px;--y:36px\"></i></div>\n</body>\n</html>\n"
}
