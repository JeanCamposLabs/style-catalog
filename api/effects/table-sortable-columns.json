  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Sortable Columns</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"table-sortable-columns\",\n    \"title\": \"Sortable Columns\",\n    \"summary\": \"Headers with sort direction indicators.\",\n    \"description\": \"Headers with sort direction indicators.\",\n    \"theme\": \"tables-data\",\n    \"categories\": [\"table\", \"data\"],\n    \"tags\": [\"table\", \"data\", \"sort\", \"columns\", \"aria-sort\", \"interactive\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Use real table markup with <th scope> and a <caption>; sortable headers need aria-sort, and row selection needs real checkboxes.\",\n    \"customization\": [\n      { \"name\": \"--hd\", \"description\": \"Header background\", \"default\": \"#1c2437\" }\n    ],\n    \"variations\": [\"Swap in your own brand ramp and re-run the palette validator\", \"Add a table view of the same data\"],\n    \"ai_usage\": \"Sortable data grids. Set aria-sort to ascending/descending on the active header only, and make the header content a button so it is keyboard-operable.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; border-radius: 12px; border: 1px solid #263149; overflow: hidden; }\n    .fx table { width: 100%; border-collapse: collapse; font-size: .82rem; }\n    .fx th { background: #1c2437; padding: 0; }\n    .fx th button { width: 100%; display: flex; justify-content: space-between; gap: .4rem; padding: .55rem .8rem;\n      border: 0; background: transparent; color: #8b93a7; font: inherit; font-size: .7rem; text-transform: uppercase;\n      letter-spacing: .06em; cursor: pointer; }\n    .fx th[aria-sort] button { color: #e7ebf3; }\n    .fx th button .ar { opacity: .35; }\n    .fx th[aria-sort] button .ar { opacity: 1; }\n    .fx td { padding: .55rem .8rem; border-top: 1px solid #1e2740; color: #cbd5e1; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><table><caption class=\"sr\" style=\"position:absolute;left:-9999px\">Themes by size</caption>\n  <thead><tr><th scope=\"col\"><button type=\"button\">Theme <span class=\"ar\">↕</span></button></th>\n  <th scope=\"col\" aria-sort=\"descending\"><button type=\"button\">Effects <span class=\"ar\">↓</span></button></th></tr></thead>\n  <tbody><tr><td>Patterns</td><td>43</td></tr><tr><td>Backgrounds</td><td>39</td></tr><tr><td>Text</td><td>36</td></tr></tbody></table></div>\n</body>\n</html>\n"
