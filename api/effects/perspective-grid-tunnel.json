  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Perspective Tunnel</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"perspective-grid-tunnel\",\n    \"title\": \"Perspective Tunnel\",\n    \"summary\": \"Rings receding into a vanishing point.\",\n    \"description\": \"Rings receding into a vanishing point.\",\n    \"theme\": \"3d-transforms\",\n    \"categories\": [\"3d\", \"transform\"],\n    \"tags\": [\"3d\", \"transform\", \"tunnel\", \"perspective\", \"depth\", \"rings\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"advanced\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"3D motion is a common trigger for vestibular discomfort — keep rotations small and stop them under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Ring period\", \"default\": \"3s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Add a reduced-motion static variant\"],\n    \"ai_usage\": \"Transitions and sci-fi loaders. Stagger identical rings on one keyframe by delay; the perspective value alone controls how aggressive the tunnel feels.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { position: relative; width: 240px; height: 200px; perspective: 400px; overflow: hidden; border-radius: 14px; background: #05070d; }\n    .fx i { position: absolute; inset: 50% auto auto 50%; width: 200px; height: 200px; margin: -100px 0 0 -100px;\n      border: 2px solid #7c5cff; border-radius: 12px; animation: fly 3s linear infinite; animation-delay: var(--dl); opacity: 0; }\n    @keyframes fly {\n      0% { transform: translateZ(-900px); opacity: 0; }\n      20% { opacity: 1; }\n      100% { transform: translateZ(300px); opacity: 0; }\n    }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><i style=\"--dl:0s\"></i><i style=\"--dl:-.6s\"></i><i style=\"--dl:-1.2s\"></i><i style=\"--dl:-1.8s\"></i><i style=\"--dl:-2.4s\"></i></div>\n</body>\n</html>\n"
}
