  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Coloured Lift</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"hover-3d-lift-shadow-color\",\n    \"title\": \"Coloured Lift\",\n    \"summary\": \"A card lifting with a shadow that borrows its own colour.\",\n    \"description\": \"A card lifting with a shadow that borrows its own colour.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"interaction\"],\n    \"tags\": [\"hover\", \"pointer\", \"lift\", \"shadow\", \"color\", \"hover\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover state here is mirrored on :focus-visible so keyboard users get the same information.\",\n    \"customization\": [\n      { \"name\": \"--lift\", \"description\": \"Hover lift\", \"default\": \"6px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Colourful cards on dark grounds. Tint the shadow with the card's own hue; a neutral black shadow disappears entirely against a dark background.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .card { width: 240px; padding: 1.4rem; border-radius: 16px; color: #0b0d12; font-weight: 700;\n      background: linear-gradient(150deg, #7c5cff, #2dd4bf); transition: transform .3s, box-shadow .3s;\n      box-shadow: 0 6px 18px rgba(124,92,255,.3); }\n    .card:hover, .card:focus-visible { transform: translateY(-6px); box-shadow: 0 22px 40px rgba(124,92,255,.5); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"card\" tabindex=\"0\">Coloured shadow lift</div>\n</body>\n</html>\n"
