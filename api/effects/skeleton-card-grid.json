  "path": "effects/empty-skeleton-states/skeleton-card-grid.html",
  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Skeleton Grid</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"skeleton-card-grid\",\n    \"title\": \"Skeleton Grid\",\n    \"summary\": \"Placeholder cards matching the real layout.\",\n    \"description\": \"Placeholder cards matching the real layout.\",\n    \"theme\": \"empty-skeleton-states\",\n    \"categories\": [\"state\", \"empty\"],\n    \"tags\": [\"state\", \"placeholder\", \"skeleton\", \"grid\", \"placeholder\", \"loading\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Loading placeholders must be hidden from assistive tech (aria-hidden) with a single aria-live status instead; empty states need real headings and a focusable action.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Shimmer period\", \"default\": \"1.6s\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Card grids waiting on data. Match the skeleton's box model to the real card exactly so nothing shifts on arrival; hide the whole grid from screen readers and announce 'Loading' once.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; grid-template-columns: repeat(2, 130px); gap: 12px; }\n    .c { border-radius: 12px; background: #151b2a; border: 1px solid #263149; padding: .7rem; }\n    .c .img { aspect-ratio: 16 / 10; border-radius: 8px; margin-bottom: .6rem; }\n    .c .l { height: 9px; border-radius: 5px; margin-bottom: 6px; }\n    .c .l.s { width: 60%; }\n    .sk { background: linear-gradient(90deg, #1b2231 25%, #2b3550 37%, #1b2231 63%); background-size: 400% 100%;\n      animation: sheen 1.6s ease-in-out infinite; }\n    @keyframes sheen { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\" aria-hidden=\"true\"><div class=\"c\"><div class=\"img sk\"></div><div class=\"l sk\"></div><div class=\"l s sk\"></div></div>\n  <div class=\"c\"><div class=\"img sk\"></div><div class=\"l sk\"></div><div class=\"l s sk\"></div></div>\n  <div class=\"c\"><div class=\"img sk\"></div><div class=\"l sk\"></div><div class=\"l s sk\"></div></div>\n  <div class=\"c\"><div class=\"img sk\"></div><div class=\"l sk\"></div><div class=\"l s sk\"></div></div></div>\n  <span class=\"sr\" style=\"position:absolute;left:-9999px\" role=\"status\">Loading specimens</span>\n</body>\n</html>\n"
}
