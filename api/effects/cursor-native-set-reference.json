  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Native Cursor Set</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"cursor-native-set-reference\",\n    \"title\": \"Native Cursor Set\",\n    \"summary\": \"The standard cursor keywords, labelled.\",\n    \"description\": \"The standard cursor keywords, labelled.\",\n    \"theme\": \"cursors-pointers\",\n    \"categories\": [\"cursor\", \"pointer\"],\n    \"tags\": [\"cursor\", \"pointer\", \"cursors\", \"native\", \"reference\", \"semantics\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Custom cursors are gated to fine pointers; touch and reduced-motion users keep the native cursor and full functionality.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Tile background\", \"default\": \"#151b2a\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Use the native cursor that matches the affordance before reaching for a custom one — pointer for links, text for editable areas, grab for draggables, not-allowed for disabled.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; width: 290px; }\n    .fx div { padding: .7rem .5rem; border-radius: 10px; background: #151b2a; border: 1px solid #263149; color: #8b93a7;\n      font-size: .72rem; text-align: center; font-family: ui-monospace, monospace; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div style=\"cursor:pointer\">pointer</div><div style=\"cursor:text\">text</div><div style=\"cursor:grab\">grab</div>\n  <div style=\"cursor:not-allowed\">not-allowed</div><div style=\"cursor:col-resize\">col-resize</div><div style=\"cursor:zoom-in\">zoom-in</div>\n  <div style=\"cursor:crosshair\">crosshair</div><div style=\"cursor:help\">help</div><div style=\"cursor:progress\">progress</div></div>\n</body>\n</html>\n"
