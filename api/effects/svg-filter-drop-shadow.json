  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>SVG Drop Shadow</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"svg-filter-drop-shadow\",\n    \"title\": \"SVG Drop Shadow\",\n    \"summary\": \"A shadow that follows an irregular path.\",\n    \"description\": \"A shadow that follows an irregular path.\",\n    \"theme\": \"svg-effects\",\n    \"categories\": [\"svg\", \"vector\"],\n    \"tags\": [\"svg\", \"vector\", \"filter\", \"drop-shadow\", \"irregular\", \"feDropShadow\"],\n    \"tech\": [\"svg\", \"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Inline SVG needs role=img and a title or aria-label when it carries meaning, and aria-hidden when it is decoration.\",\n    \"customization\": [\n      { \"name\": \"--blur\", \"description\": \"Shadow blur\", \"default\": \"6\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Shadows on non-rectangular art. feDropShadow follows the alpha channel, so a star or blob casts a matching shadow that box-shadow never could.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 190px; }\n    .fx svg { width: 100%; display: block; overflow: visible; }\n    .fx path { fill: #2dd4bf; filter: url(#ds); }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><svg viewBox=\"0 0 190 160\" aria-hidden=\"true\">\n    <defs><filter id=\"ds\" x=\"-30%\" y=\"-30%\" width=\"160%\" height=\"160%\">\n      <feDropShadow dx=\"0\" dy=\"8\" stdDeviation=\"6\" flood-color=\"#0f766e\" flood-opacity=\".8\"/></filter></defs>\n    <path d=\"M95 12 L120 62 L176 70 L136 110 L146 166 L95 140 L44 166 L54 110 L14 70 L70 62 Z\"/></svg></div>\n</body>\n</html>\n"
