  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Rich Popover</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"popover-rich-card\",\n    \"title\": \"Rich Popover\",\n    \"summary\": \"A click popover with a heading, body, and actions.\",\n    \"description\": \"A click popover with a heading, body, and actions.\",\n    \"theme\": \"tooltips-popovers\",\n    \"categories\": [\"tooltip\", \"overlay\"],\n    \"tags\": [\"tooltip\", \"popover\", \"popover\", \"click\", \"rich\", \"actions\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Hover-only content is unreachable by keyboard and touch: show on focus too, link with aria-describedby, and never put interactive content in a hover tooltip.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Panel background\", \"default\": \"#141a28\" }\n    ],\n    \"variations\": [\"Recolour through the custom properties\", \"Scale it for a compact variant\"],\n    \"ai_usage\": \"Anything with interactive content. Popovers open on click, trap nothing but return focus to the trigger on close, and dismiss on Escape and outside click.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .pop { position: relative; display: inline-block; }\n    .pop > button { padding: .6rem 1.1rem; border-radius: 10px; border: 1px solid #2b3450; background: #151b2a; color: #e7ebf3; font: inherit; cursor: pointer; }\n    .panel { position: absolute; top: calc(100% + 10px); left: 0; width: 250px; padding: 1rem; border-radius: 14px;\n      background: #141a28; border: 1px solid #2b3450; box-shadow: 0 20px 50px rgba(0,0,0,.55); display: none; }\n    .pop.is-open .panel { display: block; }\n    .panel h4 { margin: 0 0 .35rem; font-size: .95rem; }\n    .panel p { margin: 0 0 .9rem; color: #8b93a7; font-size: .85rem; line-height: 1.5; }\n    .panel .acts { display: flex; gap: .5rem; }\n    .panel button { padding: .4rem .8rem; border-radius: 8px; border: 0; font: inherit; font-size: .82rem; cursor: pointer; }\n    .panel .primary { background: #7c5cff; color: #fff; }\n    .panel .ghost { background: transparent; color: #8b93a7; }\n  </style>\n</head>\n<body>\n  <span class=\"pop\" id=\"pop\"><button type=\"button\" aria-expanded=\"false\">Share ▾</button>\n  <div class=\"panel\" role=\"dialog\" aria-label=\"Share options\"><h4>Share this project</h4>\n  <p>Anyone with the link can view the current version.</p>\n  <div class=\"acts\"><button class=\"primary\" type=\"button\">Copy link</button><button class=\"ghost\" type=\"button\">Settings</button></div></div></span>\n  <script>\n    (function () {\n      var p = document.getElementById(\"pop\"), b = p.querySelector(\"button\");\n      b.addEventListener(\"click\", function () { b.setAttribute(\"aria-expanded\", String(p.classList.toggle(\"is-open\"))); });\n      addEventListener(\"keydown\", function (e) { if (e.key === \"Escape\") { p.classList.remove(\"is-open\"); b.setAttribute(\"aria-expanded\", \"false\"); } });\n    })();\n  </script>\n</body>\n</html>\n"
}
