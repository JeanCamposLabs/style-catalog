  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Self-Drawing Logo</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"svg-stroke-dash-logo\",\n    \"title\": \"Self-Drawing Logo\",\n    \"summary\": \"A monogram that draws itself stroke by stroke.\",\n    \"description\": \"A monogram that draws itself stroke by stroke.\",\n    \"theme\": \"svg-effects\",\n    \"categories\": [\"svg\", \"vector\"],\n    \"tags\": [\"svg\", \"vector\", \"draw\", \"stroke-dashoffset\", \"logo\", \"monogram\"],\n    \"tech\": [\"svg\", \"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Inline SVG needs role=img and a title or aria-label when it carries meaning, and aria-hidden when it is decoration.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Draw duration\", \"default\": \"3.5s\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Brand intros and loading states. Measure each path with getTotalLength() and set dasharray and dashoffset to that number; a guessed length leaves a gap or finishes early.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 160px; }\n    .fx svg { width: 100%; display: block; }\n    .fx path { fill: none; stroke: #2dd4bf; stroke-width: 6; stroke-linecap: round; stroke-linejoin: round;\n      stroke-dasharray: 420; stroke-dashoffset: 420; animation: draw 3.5s ease-in-out infinite; }\n    .fx path:nth-of-type(2) { animation-delay: .5s; stroke: #7c5cff; }\n    @keyframes draw { 0% { stroke-dashoffset: 420; } 55%, 100% { stroke-dashoffset: 0; } }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><svg viewBox=\"0 0 160 120\" aria-hidden=\"true\">\n    <path d=\"M20 100 L45 20 L70 100\"/><path d=\"M95 100 L95 20 L140 20 L140 60 L95 60\"/></svg></div>\n</body>\n</html>\n"
