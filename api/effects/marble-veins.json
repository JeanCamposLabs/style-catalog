dient(ellipse at 70% 60%, rgba(255,255,255,.06), transparent 40%),\n        repeating-linear-gradient(52deg, transparent 0 40px, rgba(255,255,255,.05) 40px 42px, transparent 42px 90px),\n        repeating-linear-gradient(38deg, transparent 0 60px, rgba(255,255,255,.035) 60px 61px, transparent 61px 130px); }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
