  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Star Clip</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"clip-star\",\n    \"title\": \"Star Clip\",\n    \"summary\": \"A five-pointed star.\",\n    \"description\": \"A five-pointed star. Uses clip-path or mask-image, so the element's box and layout are unaffected by the shape.\",\n    \"theme\": \"masks-clipping\",\n    \"categories\": [\"mask\", \"shape\"],\n    \"tags\": [\"clip-path\", \"mask\", \"star\", \"rating\", \"polygon\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Clipping hides content visually but not from assistive tech — anything fully clipped away should also be removed or aria-hidden.\",\n    \"customization\": [\n      { \"name\": \"--size\", \"description\": \"Star size\", \"default\": \"210px\" }\n    ],\n    \"variations\": [\"Animate the shape on hover\", \"Combine with a gradient fill\"],\n    \"ai_usage\": \"Ratings, awards, and badges. Use the same polygon for a rating widget by clipping a filled bar underneath it.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .art { width: 210px; height: 210px; background: conic-gradient(from 210deg at 40% 35%, #7c5cff, #2dd4bf, #fbbf24, #f472b6, #7c5cff); }\n    .label { margin-top: .9rem; text-align: center; color: #8b93a7; font-size: .82rem; }\n    .shape { clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }\n  </style>\n</head>\n<body>\n  <div><div class=\"art shape\"></div><p class=\"label\">Star Clip</p></div>\n</body>\n</html>\n"
