  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Search with Filters Row</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"search-command-scoped\",\n    \"title\": \"Search with Filters Row\",\n    \"summary\": \"A search field with quick filter chips beneath it.\",\n    \"description\": \"A search field with quick filter chips beneath it.\",\n    \"theme\": \"search-ui\",\n    \"categories\": [\"search\", \"filter\"],\n    \"tags\": [\"search\", \"find\", \"filters\", \"chips\", \"quick\", \"row\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Result counts belong in an aria-live region; filter groups need fieldset/legend so their scope is announced.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Active colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Add a compact variant\"],\n    \"ai_usage\": \"Compact filtering above a result grid. Filters go in one row above the results, never in a modal — users need to see the effect of a change immediately.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 300px; }\n    .fx input { width: 100%; padding: .75rem .9rem; border-radius: 12px; border: 1px solid #2b3450; background: #151b2a;\n      color: #e7ebf3; font: inherit; margin-bottom: .6rem; }\n    .fx .row { display: flex; gap: .4rem; flex-wrap: wrap; }\n    .fx .row button { padding: .3rem .75rem; border-radius: 99px; border: 1px solid #2b3450; background: transparent;\n      color: #8b93a7; font: inherit; font-size: .78rem; cursor: pointer; }\n    .fx .row button[aria-pressed=\"true\"] { background: #1e1740; border-color: #7c5cff; color: #b9a5ff; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><input type=\"search\" aria-label=\"Search\" placeholder=\"Search\" />\n  <div class=\"row\" role=\"group\" aria-label=\"Quick filters\">\n    <button type=\"button\" aria-pressed=\"true\">Animated</button><button type=\"button\" aria-pressed=\"false\">CSS only</button>\n    <button type=\"button\" aria-pressed=\"false\">Beginner</button><button type=\"button\" aria-pressed=\"false\">Retro</button></div></div>\n</body>\n</html>\n"
