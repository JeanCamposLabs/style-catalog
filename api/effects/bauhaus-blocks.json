rent 25%),\n        linear-gradient(-45deg, #457b9d 0 25%, transparent 25%),\n        linear-gradient(135deg, #f4a261 0 25%, transparent 25%);\n      background-size: 110px 110px, 90px 90px, 70px 70px; }\n  </style>\n</head>\n<body>\n  <div class=\"bg\"></div>\n</body>\n</html>\n"
