  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Multi-Line Link Underline</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"underline-multi-link\",\n    \"title\": \"Multi-Line Link Underline\",\n    \"summary\": \"An underline that wraps correctly across multiple lines on hover.\",\n    \"description\": \"background-image with background-size animation underlines wrapped text properly, where a pseudo-element only underlines the last line.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"link\"],\n    \"tags\": [\"underline\", \"wrapping\", \"background-size\", \"link\", \"typography\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Underline color\", \"default\": \"#2dd4bf\" },\n      { \"name\": \"--h\", \"description\": \"Underline weight\", \"default\": \"2px\" }\n    ],\n    \"variations\": [\"Draw from the centre\", \"Thicker weight for headings\", \"Different colour on visited links\"],\n    \"ai_usage\": \"Body-copy links that may wrap. Use background-image: linear-gradient(color,color) with background-size: 0% var(--h) animating to 100% — this is the only underline technique that follows line breaks.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --c: #2dd4bf; --h: 2px; }\n    .ml { max-width: 26ch; line-height: 1.8; font-size: 1.05rem; color: #cbd5e1; }\n    .ml a { color: #e7ebf3; text-decoration: none; background-image: linear-gradient(var(--c), var(--c));\n      background-repeat: no-repeat; background-position: 0 100%; background-size: 0% var(--h);\n      transition: background-size .35s cubic-bezier(.2,.8,.3,1); }\n    .ml a:hover, .ml a:focus-visible { background-size: 100% var(--h); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <p class=\"ml\">Read the <a href=\"#\">complete guide to progressive enhancement and resilient interface patterns</a> before shipping.</p>\n</body>\n</html>\n"
}
