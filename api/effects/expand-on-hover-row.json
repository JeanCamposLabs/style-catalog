  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Expanding Panel Row</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"expand-on-hover-row\",\n    \"title\": \"Expanding Panel Row\",\n    \"summary\": \"A row of panels where the hovered one takes most of the width.\",\n    \"description\": \"Flex-grow transitions on one axis push the siblings aside, so no absolute positioning or JS is needed.\",\n    \"theme\": \"hover-interactions\",\n    \"categories\": [\"hover\", \"layout\"],\n    \"tags\": [\"accordion\", \"flex\", \"expand\", \"gallery\", \"row\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every hover affordance here also responds to :focus-visible so keyboard users get the same information. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--dur\", \"description\": \"Expand duration\", \"default\": \"0.45s\" }\n    ],\n    \"variations\": [\"Vertical stack version\", \"Reveal captions in the expanded panel\", \"Keyboard focus expands too\"],\n    \"ai_usage\": \"Image galleries and feature rows. Transition flex-grow (not width) so the total stays exactly 100%, and give every panel min-width:0 or the collapse will stop short.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    :root { --dur: .45s; }\n    .exp { display: flex; gap: 8px; width: min(90vw, 460px); height: 220px; }\n    .exp div { flex: 1; min-width: 0; border-radius: 14px; display: grid; place-items: end start; padding: .9rem;\n      font-weight: 700; color: #fff; transition: flex var(--dur) cubic-bezier(.7,0,.2,1); cursor: pointer; overflow: hidden; }\n    .exp div:hover, .exp div:focus-visible { flex: 4; }\n    .exp div:nth-child(1) { background: linear-gradient(160deg, #7c5cff, #4c1d95); }\n    .exp div:nth-child(2) { background: linear-gradient(160deg, #2dd4bf, #0f766e); }\n    .exp div:nth-child(3) { background: linear-gradient(160deg, #f472b6, #9d174d); }\n    .exp div:nth-child(4) { background: linear-gradient(160deg, #fbbf24, #b45309); }\n    @media (prefers-reduced-motion: reduce) {\n      * { animation: none !important; transition: none !important; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"exp\">\n    <div tabindex=\"0\">Aurora</div><div tabindex=\"0\">Reef</div><div tabindex=\"0\">Bloom</div><div tabindex=\"0\">Ember</div>\n  </div>\n</body>\n</html>\n"
}
