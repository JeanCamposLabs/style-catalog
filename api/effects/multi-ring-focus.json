  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Concentric Rings</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"multi-ring-focus\",\n    \"title\": \"Concentric Rings\",\n    \"summary\": \"Three rings of decreasing opacity radiate from the box.\",\n    \"description\": \"Stacked box-shadow spreads without blur produce hard concentric rings that read as a focus halo.\",\n    \"theme\": \"borders-shadows\",\n    \"categories\": [\"border\"],\n    \"tags\": [\"rings\", \"halo\", \"focus\", \"concentric\", \"attention\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"beginner\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Decorative edge treatment — never encode meaning in the border colour alone. Motion stops under prefers-reduced-motion.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Ring color\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Animate the rings outward\", \"Single ring for focus states\", \"Colour-coded rings by severity\"],\n    \"ai_usage\": \"Onboarding highlights and focus targets. Use spread-only shadows (no blur) with decreasing alpha; blurred rings merge into a glow and lose the concentric read.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .demo { width: 260px; padding: 1.6rem; color: #e7ebf3; }\n    .demo h3 { margin: 0 0 .4rem; font-size: 1.05rem; }\n    .demo p { margin: 0; color: #8b93a7; font-size: .88rem; }\n    :root { --c: #7c5cff; }\n    .demo { background: #151b2a; border-radius: 16px;\n      box-shadow: 0 0 0 4px color-mix(in srgb, var(--c) 45%, transparent),\n        0 0 0 10px color-mix(in srgb, var(--c) 22%, transparent),\n        0 0 0 18px color-mix(in srgb, var(--c) 10%, transparent); }\n  </style>\n</head>\n<body>\n  <div class=\"demo\"><h3>Look here</h3><p>Concentric attention rings.</p></div>\n</body>\n</html>\n"
}
