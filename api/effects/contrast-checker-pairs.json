  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Contrast Pairs</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"contrast-checker-pairs\",\n    \"title\": \"Contrast Pairs\",\n    \"summary\": \"Text pairs above and below the WCAG threshold.\",\n    \"description\": \"Text pairs above and below the WCAG threshold.\",\n    \"theme\": \"accessibility-patterns\",\n    \"categories\": [\"accessibility\", \"reference\"],\n    \"tags\": [\"accessibility\", \"a11y\", \"contrast\", \"wcag\", \"ratio\", \"text\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"These specimens are the accessibility reference — each demonstrates the correct semantics, not just the visual result.\",\n    \"customization\": [\n      { \"name\": \"--bg\", \"description\": \"Surface\", \"default\": \"#151b2a\" }\n    ],\n    \"variations\": [\"Retune the palette\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Normal text needs 4.5:1 and large text 3:1 against its background. Check the actual rendered pair, not the token names — a muted colour that passes on white can fail on a tinted surface.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; gap: 8px; width: 290px; }\n    .p { display: flex; justify-content: space-between; align-items: center; padding: .7rem .9rem; border-radius: 10px; font-size: .88rem; }\n    .p b { font-size: .74rem; opacity: .9; }\n    .ok { background: #151b2a; color: #e7ebf3; }\n    .mid { background: #151b2a; color: #8b93a7; }\n    .bad { background: #151b2a; color: #3f4a63; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"p ok\"><span>Primary text</span><b>13.9:1 · passes AAA</b></div>\n  <div class=\"p mid\"><span>Muted text</span><b>4.8:1 · passes AA</b></div>\n  <div class=\"p bad\"><span>Too faint</span><b>1.9:1 · fails</b></div></div>\n</body>\n</html>\n"
