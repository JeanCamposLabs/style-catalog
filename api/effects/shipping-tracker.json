  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Shipping Tracker</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"shipping-tracker\",\n    \"title\": \"Shipping Tracker\",\n    \"summary\": \"A delivery timeline with the current stage marked.\",\n    \"description\": \"A delivery timeline with the current stage marked.\",\n    \"theme\": \"ecommerce-ui\",\n    \"categories\": [\"ecommerce\", \"commerce\"],\n    \"tags\": [\"ecommerce\", \"shop\", \"shipping\", \"tracking\", \"timeline\", \"order\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Price, stock, and discount information must be in text, never only a colour or a badge shape.\",\n    \"customization\": [\n      { \"name\": \"--c\", \"description\": \"Current colour\", \"default\": \"#7c5cff\" }\n    ],\n    \"variations\": [\"Adapt to a light theme\", \"Compact variant for dense lists\"],\n    \"ai_usage\": \"Order tracking. Include timestamps for completed steps and an estimate for the next one; a stage list without dates answers nothing.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 270px; }\n    .fx .row { display: flex; gap: .8rem; }\n    .fx .rail { display: grid; }\n    .fx .dot { width: 14px; height: 14px; border-radius: 50%; background: #2b3450; }\n    .fx .row.done .dot { background: #34d399; }\n    .fx .row.now .dot { background: #7c5cff; box-shadow: 0 0 0 4px rgba(124,92,255,.25); }\n    .fx .bar { width: 2px; height: 28px; margin: 2px auto; background: #2b3450; }\n    .fx .row.done .bar { background: #34d399; }\n    .fx .t { padding-bottom: .3rem; }\n    .fx b { font-size: .88rem; }\n    .fx span { display: block; font-size: .76rem; color: #8b93a7; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"row done\"><div class=\"rail\"><span class=\"dot\"></span><span class=\"bar\"></span></div>\n  <div class=\"t\"><b>Ordered</b><span>12 Sept, 09:14</span></div></div>\n  <div class=\"row done\"><div class=\"rail\"><span class=\"dot\"></span><span class=\"bar\"></span></div>\n  <div class=\"t\"><b>Shipped</b><span>13 Sept, 18:02</span></div></div>\n  <div class=\"row now\"><div class=\"rail\"><span class=\"dot\"></span></div>\n  <div class=\"t\"><b>Out for delivery</b><span>Expected today by 18:00</span></div></div></div>\n</body>\n</html>\n"
}
