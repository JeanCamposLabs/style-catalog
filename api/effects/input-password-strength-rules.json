  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Password Rules</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"input-password-strength-rules\",\n    \"title\": \"Password Rules\",\n    \"summary\": \"A live checklist of password requirements.\",\n    \"description\": \"A live checklist of password requirements.\",\n    \"theme\": \"forms-inputs\",\n    \"categories\": [\"form\", \"input\"],\n    \"tags\": [\"form\", \"input\", \"password\", \"rules\", \"checklist\", \"validation\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Every control keeps a real label, a visible focus ring, and error state conveyed by text as well as colour.\",\n    \"customization\": [\n      { \"name\": \"--ok\", \"description\": \"Met colour\", \"default\": \"#10a894\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Adapt for a light theme\"],\n    \"ai_usage\": \"Sign-up forms. A live rule checklist beats a strength meter: it tells users exactly what to change, and each rule flips with an icon as well as a colour.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { width: 280px; }\n    .fx input { width: 100%; padding: .8rem .9rem; border-radius: 12px; border: 1px solid #2b3450; background: #151b2a;\n      color: #e7ebf3; font: inherit; margin-bottom: .6rem; }\n    .fx input:focus { outline: none; border-color: #7c5cff; }\n    .fx li { list-style: none; display: flex; gap: .5rem; align-items: center; font-size: .8rem; color: #64748b; padding: .15rem 0; }\n    .fx li.ok { color: #7fd8cb; }\n    .fx ul { margin: 0; padding: 0; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><label class=\"sr\" for=\"pw2\" style=\"position:absolute;left:-9999px\">Password</label>\n  <input id=\"pw2\" type=\"password\" value=\"catalog2026\" />\n  <ul aria-live=\"polite\"><li class=\"ok\"><span aria-hidden=\"true\">✓</span>At least 10 characters</li>\n  <li class=\"ok\"><span aria-hidden=\"true\">✓</span>Contains a number</li>\n  <li><span aria-hidden=\"true\">○</span>Contains a symbol</li></ul></div>\n</body>\n</html>\n"
