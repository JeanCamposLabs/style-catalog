  "source": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Dashboard Shell</title>\n  <script type=\"application/json\" id=\"effect-meta\">\n  {\n    \"id\": \"layout-dashboard-shell\",\n    \"title\": \"Dashboard Shell\",\n    \"summary\": \"Rail, header, and content region.\",\n    \"description\": \"Rail, header, and content region.\",\n    \"theme\": \"layout-archetypes\",\n    \"categories\": [\"layout\", \"structure\"],\n    \"tags\": [\"layout\", \"grid\", \"dashboard\", \"shell\", \"rail\", \"app\"],\n    \"tech\": [\"css\"],\n    \"era\": \"2020s\",\n    \"difficulty\": \"intermediate\",\n    \"dependencies\": [],\n    \"browser_support\": \"All modern browsers (Chromium, Firefox, Safari).\",\n    \"performance_notes\": \"Lightweight — composited transform/opacity work only.\",\n    \"accessibility_notes\": \"Layouts must reflow rather than scroll horizontally, and the DOM order must match the visual reading order.\",\n    \"customization\": [\n      { \"name\": \"--rail\", \"description\": \"Rail width\", \"default\": \"44px\" }\n    ],\n    \"variations\": [\"Retune through the custom properties\", \"Scale for a compact variant\"],\n    \"ai_usage\": \"Admin interfaces. Give the shell its own grid and let each region scroll independently; a single page scroll makes the rail and header disappear when users need them most.\"\n  }\n  </script>\n  <style>\n    *, *::before, *::after { box-sizing: border-box; }\n    html, body { height: 100%; margin: 0; }\n    body { display: grid; place-items: center; background: #0b0d12; color: #e7ebf3;\n      font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; overflow: hidden; }\n    .fx { display: grid; grid-template: \"rail hd\" 34px \"rail main\" 1fr / 44px 1fr; gap: 6px; width: 300px; height: 190px; }\n    .fx > * { background: #151b2a; border: 1px solid #263149; border-radius: 10px; }\n    .rail { grid-area: rail; display: grid; align-content: start; gap: 6px; padding: 6px; }\n    .rail i { height: 28px; border-radius: 7px; background: #1e2740; }\n    .rail i:first-child { background: #7c5cff; }\n    .hd { grid-area: hd; }\n    .main { grid-area: main; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 6px; background: #10141f; }\n    .main div { border-radius: 8px; background: #151b2a; border: 1px solid #263149; }\n  </style>\n</head>\n<body>\n  <div class=\"fx\"><div class=\"rail\"><i></i><i></i><i></i></div><div class=\"hd\"></div>\n  <div class=\"main\"><div></div><div></div><div></div><div></div></div></div>\n</body>\n</html>\n"
